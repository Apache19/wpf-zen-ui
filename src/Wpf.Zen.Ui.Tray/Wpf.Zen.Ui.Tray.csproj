<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Wpf.Zen.Ui.Tray</PackageId>
    <TargetFrameworks>net8.0-windows;net472</TargetFrameworks>
    <Description>Native tray menu icon support for WPF using the WPF Zen UI library.</Description>
    <CommonTags>$(CommonTags);tray;notifyicon;notify</CommonTags>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="VisualStudioToolsManifest.xml" Pack="true" PackagePath="tools" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Controls\NotifyIcon.bmp" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Controls\NotifyIcon.bmp" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net472'">
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wpf.Zen.Ui\Wpf.Zen.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WpfAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
