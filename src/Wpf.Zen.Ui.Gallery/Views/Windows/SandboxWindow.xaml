<ui:FluentWindow
    x:Class="Wpf.Zen.Ui.Gallery.Views.Windows.SandboxWindow"
    x:Name="RootWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Zen.Ui.Gallery.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    xmlns:wpf="clr-namespace:System.Windows;assembly=PresentationFramework"
    Title="SandboxWindow"
    Width="1450"
    Height="802"
    MinWidth="900"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DataContext="{d:DesignInstance local:SandboxWindow, IsDesignTimeCreatable=False}"
    d:DesignHeight="650"
    d:DesignWidth="1000"
    d:Foreground="{ui:DynamicBrush TextFillPrimary}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <ui:FluentWindow.Resources>
        <!--
            These enum sources intentionally bind directly to the live window. The sandbox is used for manual
            non-client verification, so changing an item must exercise the same dependency-property callbacks that
            an application would use instead of recreating the window with a different startup configuration.
        -->
        <ObjectDataProvider x:Key="BackdropTypes" MethodName="GetValues" ObjectType="{x:Type system:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="ui:WindowBackdropType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="ResizeModes" MethodName="GetValues" ObjectType="{x:Type system:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="wpf:ResizeMode" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="WindowStates" MethodName="GetValues" ObjectType="{x:Type system:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="wpf:WindowState" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </ui:FluentWindow.Resources>
    <StackPanel>
        <ui:TitleBar
            x:Name="TitleBar"
            Title="WPF Zen UI Gallery - Sandbox"
            Margin="0"
            IsIconInteractionEnabled="True">
            <ui:IconAssist.Icon>
                <Image Source="pack://application:,,,/Assets/wpfui.png" Stretch="UniformToFill" />
            </ui:IconAssist.Icon>
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Menu HorizontalAlignment="Left">
                    <MenuItem Header="File">
                        <MenuItem Header="New" />
                        <MenuItem Header="New window" />
                        <MenuItem Header="Open..." />
                        <MenuItem Header="Save" />
                        <MenuItem Header="Save As..." />
                        <Separator />
                        <MenuItem Header="Exit" />
                    </MenuItem>
                    <MenuItem Header="Debug">
                        <MenuItem Header="Undo" />
                        <Separator />
                        <MenuItem Header="Cut" />
                        <MenuItem Header="Copy" />
                        <MenuItem Header="Paste" />
                        <MenuItem Header="Delete" IsEnabled="False" />
                        <Separator />
                        <MenuItem Header="Search with browser" />
                        <MenuItem Header="Find..." />
                        <MenuItem Header="Find next" />
                        <Separator />
                        <MenuItem Header="Select All" />
                    </MenuItem>
                </Menu>
                <Menu Grid.Column="1" HorizontalAlignment="Right">
                    <MenuItem Foreground="{ui:DynamicBrush PaletteDeepOrange}" Icon="{ui:FluentIconSource Fire24, True}" />
                    <MenuItem Foreground="{ui:DynamicBrush PaletteGreen}" Icon="{ui:FluentIconSource Play24}" />
                    <MenuItem Foreground="{ui:DynamicBrush PaletteRed}" Icon="{ui:FluentIconSource Stop24}" />
                    <MenuItem Foreground="{ui:DynamicBrush PaletteLightBlue}" Icon="{ui:FluentIconSource ArrowClockwise24}" />
                </Menu>
            </Grid>
        </ui:TitleBar>

        <StackPanel Margin="24">
            <TextBlock Text="Hello World!" />

            <WrapPanel Margin="0,16,0,0" VerticalAlignment="Center">
                <CheckBox
                    Margin="0,0,24,0"
                    VerticalAlignment="Center"
                    Content="Use native Windows 10/11 border"
                    IsChecked="{Binding UseNativeWindowBorder, ElementName=RootWindow, Mode=TwoWay}" />

                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Backdrop" />
                <ComboBox
                    Width="130"
                    Margin="0,0,24,0"
                    ItemsSource="{Binding Source={StaticResource BackdropTypes}}"
                    SelectedItem="{Binding WindowBackdropType, ElementName=RootWindow, Mode=TwoWay}" />

                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Resize mode" />
                <ComboBox
                    Width="150"
                    Margin="0,0,24,0"
                    ItemsSource="{Binding Source={StaticResource ResizeModes}}"
                    SelectedItem="{Binding ResizeMode, ElementName=RootWindow, Mode=TwoWay}" />

                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Window state" />
                <ComboBox
                    Width="120"
                    ItemsSource="{Binding Source={StaticResource WindowStates}}"
                    SelectedItem="{Binding WindowState, ElementName=RootWindow, Mode=TwoWay}" />
            </WrapPanel>

            <ui:AutoSuggestBox
                Margin="0,24,0,0"
                Text="{Binding ViewModel.AutoSuggestBoxText, Mode=TwoWay}"
                TextChanged="OnAutoSuggestBoxTextChanged" />

            <ui:DropDownButton Content="Hello" ui:IconAssist.Icon="{ui:FluentIconSource Fluent24}">
                <ui:DropDownButton.Flyout>
                    <ContextMenu>
                        <MenuItem Command="ApplicationCommands.Undo" />
                        <MenuItem Command="ApplicationCommands.Redo" />
                        <Separator />
                        <MenuItem Command="ApplicationCommands.Cut" />
                        <MenuItem Command="ApplicationCommands.Copy" />
                        <MenuItem Command="ApplicationCommands.Paste" />
                        <MenuItem Header="OCR Paste" InputGestureText="Ctrl + Shift + V" />
                        <Separator />
                        <MenuItem Header="Isolate Selected Text" InputGestureText="Ctrl + I" />
                        <MenuItem Header="Select Line" InputGestureText="Ctrl + L" />
                        <MenuItem Header="Toggle Case" InputGestureText="Shift + F3" />
                        <Separator />
                        <MenuItem Header="Move Selection _Up" InputGestureText="Alt + Up" />
                        <MenuItem Header="Move Selection _Down" InputGestureText="Alt + Down" />
                    </ContextMenu>
                </ui:DropDownButton.Flyout>
            </ui:DropDownButton>
        </StackPanel>

        <ui:NavigationView x:Name="MyTestNavigationView" />
    </StackPanel>
</ui:FluentWindow>
