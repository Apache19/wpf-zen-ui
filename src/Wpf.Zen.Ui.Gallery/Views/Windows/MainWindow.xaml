<ui:FluentWindow
    x:Class="Wpf.Zen.Ui.Gallery.Views.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i18n="http://schemas.lepo.co/i18n/2022/xaml"
    xmlns:local="clr-namespace:Wpf.Zen.Ui.Gallery.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tray="http://schemas.thezendev.com/wpf/2027/tray"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}"
    Width="1200"
    Height="800"
    MinWidth="600"
    MinHeight="420"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DataContext="{d:DesignInstance local:MainWindow, IsDesignTimeCreatable=False}"
    d:DesignHeight="650"
    d:DesignWidth="800"
    d:Foreground="{ui:DynamicBrush TextFillPrimary}"
    SizeChanged="MainWindow_OnSizeChanged"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <ui:FluentWindow.InputBindings>
        <KeyBinding
            Key="F"
            Command="{Binding ElementName=AutoSuggestBox, Path=FocusCommand}"
            Modifiers="Control" />
    </ui:FluentWindow.InputBindings>

    <ui:ContentDialogHost x:Name="RootContentDialog">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ui:NavigationView
                x:Name="NavigationView"
                Grid.Row="1"
                Padding="42,32,42,0"
                FooterMenuItemsSource="{Binding ViewModel.FooterMenuItems, Mode=OneWay}"
                FrameMargin="0"
                LeftPaneOpenWidth="300"
                MenuItemsSource="{Binding ViewModel.MenuItems, Mode=OneWay}"
                PaneClosed="NavigationView_OnPaneClosed"
                PaneDisplayMode="{Binding ViewModel.NavigationPaneDisplayMode}"
                PaneOpened="NavigationView_OnPaneOpened"
                SelectionChanged="OnNavigationSelectionChanged"
                TitleBar="{Binding ElementName=TitleBar, Mode=OneWay}"
                Transition="FadeInWithSlide">
                <ui:NavigationView.Header>
                    <StackPanel Margin="0,0,0,20">
                        <ui:BreadcrumbBar
                            ui:IconPresenter.IconSize="18"
                            ui:IconPresenter.IconWeight="SemiBold"
                            FontSize="24"
                            ItemClicked="BreadcrumbBar_OnItemClicked"
                            ItemsSource="{Binding ElementName=NavigationView, Path=Breadcrumbs}">
                            <ui:BreadcrumbBar.Style>
                                <Style TargetType="{x:Type ui:BreadcrumbBar}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <!--
                                            Nodes decide whether they participate in the breadcrumb projection.
                                            The shell only collapses the presenter when that projection is empty.
                                        -->
                                        <DataTrigger Binding="{Binding Items.Count, RelativeSource={RelativeSource Self}}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:BreadcrumbBar.Style>
                        </ui:BreadcrumbBar>
                        <controls:PageControlDocumentation Margin="0,10,0,0" NavigationView="{Binding ElementName=NavigationView}" />
                    </StackPanel>
                </ui:NavigationView.Header>
                <ui:NavigationView.AutoSuggestBox>
                    <ui:AutoSuggestBox
                        x:Name="AutoSuggestBox"
                        AutomationProperties.AutomationId="NavigationAutoSuggestBox"
                        PlaceholderText="Search">
                        <ui:AutoSuggestBox.Icon>
                            <ui:FluentIcon Symbol="Search24" />
                        </ui:AutoSuggestBox.Icon>
                    </ui:AutoSuggestBox>
                </ui:NavigationView.AutoSuggestBox>
            </ui:NavigationView>

            <ui:TitleBar
                x:Name="TitleBar"
                Title="{Binding ViewModel.ApplicationTitle}"
                Grid.Row="0"
                IsIconInteractionEnabled="True">
                <ui:TitleBar.Icon>
                    <Image Source="pack://application:,,,/Assets/wpfui.png" Stretch="UniformToFill" />
                </ui:TitleBar.Icon>
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:ComboBox
                        MinWidth="220"
                        Margin="0,0,8,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        ui:PlaceholderService.Content="WindowBackdropType"
                        IsEditable="True"
                        SelectionChanged="BackdropComboBox_OnSelected">
                        <ComboBoxItem Content="None" Tag="{x:Static ui:WindowBackdropType.None}" />
                        <ComboBoxItem Content="Auto" Tag="{x:Static ui:WindowBackdropType.Auto}" />
                        <ComboBoxItem Content="Acrylic" Tag="{x:Static ui:WindowBackdropType.Acrylic}" />
                        <ComboBoxItem Content="Mica" Tag="{x:Static ui:WindowBackdropType.Mica}" />
                        <ComboBoxItem Content="Mica_Alt" Tag="{x:Static ui:WindowBackdropType.Mica_Alt}" />
                    </ui:ComboBox>
                    <ui:Button
                        Grid.Column="1"
                        Padding="9"
                        VerticalAlignment="Center"
                        Icon="{ui:FluentIconSource WeatherSunny24}"
                        Click="ThemeButton_OnClick" />
                </Grid>

            </ui:TitleBar>

            <tray:NotifyIcon
                Grid.Row="0"
                FocusOnLeftClick="True"
                Icon="pack://application:,,,/Assets/wpfui.png"
                MenuOnRightClick="True"
                TooltipText="WPF Zen UI Gallery">
                <tray:NotifyIcon.Menu>
                    <ContextMenu DataContext="{Binding DataContext, Source={x:Reference NavigationView}}" ItemsSource="{Binding ViewModel.TrayMenuItems, Mode=OneWay}" />
                </tray:NotifyIcon.Menu>
            </tray:NotifyIcon>

            <ui:SnackbarPresenter
                x:Name="SnackbarPresenter"
                Grid.Row="0"
                Grid.RowSpan="2"
                d:Visibility="Collapsed" />
        </Grid>
    </ui:ContentDialogHost>
</ui:FluentWindow>
