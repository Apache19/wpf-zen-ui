<Page
    x:Class="Wpf.Zen.Ui.Gallery.Views.Pages.DialogsAndFlyouts.ContentDialogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    xmlns:vm="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Pages.DialogsAndFlyouts"
    Title="ContentDialog"
    controls:PageControlDocumentation.DocumentationType="{x:Type ui:ContentDialog}"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DataContext="{d:DesignInstance vm:ContentDialogViewModel, IsDesignTimeCreatable=False}"
    d:DesignWidth="850"
    ui:NavigationView.IsNavigationFrameScrollEnabled="True"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    mc:Ignorable="d">

    <Page.Resources>
        <Style TargetType="{x:Type ui:Button}">
            <Setter Property="MinWidth" Value="150" />
        </Style>
    </Page.Resources>

    <StackPanel Margin="0,0,0,24">
        <controls:ControlExample HeaderText="ContentDialog">
            <StackPanel Orientation="Horizontal">
                <ui:Button Command="{Binding ShowSaveWorkDialogCommand}" Content="Show" />

                <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                    <ui:TextBlock FontSize="14" Text="{Binding DialogResultText}" />
                    <ui:TextBlock FontSize="12" Text="{Binding SaveWorkDetailsText}" />
                </StackPanel>
            </StackPanel>
        </controls:ControlExample>

        <controls:ControlExample Margin="0,36,0,0" HeaderText="Terms of Use ContentDialog example">
            <ui:Button
                HorizontalAlignment="Left"
                Command="{Binding ShowTermsOfUseDialogCommand}"
                Content="Show" />
        </controls:ControlExample>

        <controls:ControlExample Margin="0,36,0,0" HeaderText="Reusable ContentDialog prompts">
            <StackPanel>
                <WrapPanel>
                    <ui:Button
                        Margin="0,0,8,8"
                        Command="{Binding ShowInformationPromptCommand}"
                        Content="Information" />
                    <ui:Button
                        Margin="0,0,8,8"
                        Command="{Binding ShowConfirmationPromptCommand}"
                        Content="Confirmation" />
                    <ui:Button
                        Margin="0,0,0,8"
                        Command="{Binding ShowDestructivePromptCommand}"
                        Content="Destructive" />
                </WrapPanel>

                <ui:TextBlock
                    Margin="0,8,0,0"
                    FontSize="14"
                    Text="{Binding PromptResultText}" />
            </StackPanel>
        </controls:ControlExample>
        <controls:ControlExample Margin="0,36,0,0" HeaderText="Custom login dialog">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,12"
                    Text="A content-only template with no header or footer. The view model validates a local demo account."
                    TextWrapping="Wrap" />
                <ui:Button
                    HorizontalAlignment="Left"
                    Command="{Binding ShowLoginCommand}"
                    Content="Sign in" />
                <TextBlock
                    Margin="0,12,0,0"
                    Text="{Binding LoginResultText}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </controls:ControlExample>
    </StackPanel>
</Page>
