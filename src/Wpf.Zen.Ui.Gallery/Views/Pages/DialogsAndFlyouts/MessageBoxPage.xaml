<Page
    x:Class="Wpf.Zen.Ui.Gallery.Views.Pages.DialogsAndFlyouts.MessageBoxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    xmlns:vm="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Pages.DialogsAndFlyouts"
    Title="MessageBoxPage"
    controls:PageControlDocumentation.DocumentationType="{x:Type ui:MessageBox}"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DataContext="{d:DesignInstance vm:MessageBoxViewModel, IsDesignTimeCreatable=False}"
    d:DesignWidth="800"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    Style="{ui:DynamicStyle DynamicScrollPage}"
    mc:Ignorable="d">

    <StackPanel Margin="0,0,0,24">
        <controls:ControlExample
            Margin="0"
            HeaderText="Standard MessageBox."
            XamlCode="&lt;MessageBox /&gt;">
            <ui:Button
                HorizontalAlignment="Left"
                Command="{Binding OpenStandardMessageBoxCommand, Mode=OneWay}"
                CommandParameter="{Binding RelativeSource={RelativeSource Self}, Mode=OneWay}"
                Content="Open standard MessageBox" />
        </controls:ControlExample>

        <controls:ControlExample Margin="0,36,0,0" HeaderText="WPF Zen UI MessageBox.">
            <ui:Button
                HorizontalAlignment="Left"
                Command="{Binding OpenCustomMessageBoxCommand, Mode=OneWay}"
                CommandParameter="{Binding RelativeSource={RelativeSource Self}, Mode=OneWay}"
                Content="Open custom MessageBox" />
        </controls:ControlExample>
    </StackPanel>
</Page>
