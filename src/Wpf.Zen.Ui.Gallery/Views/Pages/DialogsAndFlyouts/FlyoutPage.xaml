<Page
    x:Class="Wpf.Zen.Ui.Gallery.Views.Pages.DialogsAndFlyouts.FlyoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    xmlns:vm="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Pages.DialogsAndFlyouts"
    Title="FlyoutPage"
    controls:PageControlDocumentation.DocumentationType="{x:Type ui:Flyout}"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DataContext="{d:DesignInstance vm:FlyoutViewModel, IsDesignTimeCreatable=False}"
    d:DesignWidth="800"
    ui:NavigationView.IsNavigationFrameScrollEnabled="True"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    mc:Ignorable="d">

    <Page.Resources>
        <Style TargetType="{x:Type ui:Flyout}">
            <Setter Property="Placement" Value="Bottom" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="ui:PopupSlideAnimator.IsEnabled" Value="True" />
            <Setter Property="ui:PopupPlacementGap.Vertical" Value="4" />
        </Style>
        <!--  An attached Flyout can remain in resources and be shared by multiple owners.  -->
        <ui:Flyout x:Key="DetailsFlyout" Placement="Top">
            <StackPanel Width="280">
                <TextBlock FontWeight="SemiBold" Text="A reusable attached flyout" />
                <TextBlock
                    Margin="0,8,0,12"
                    Text="This panel opens above whichever attached owner was focused or clicked. Escape or an outside click closes it."
                    TextWrapping="Wrap" />
                <ui:TextBox Text="Right-click to open the editor menu" />
            </StackPanel>
        </ui:Flyout>
    </Page.Resources>

    <StackPanel Margin="0,0,0,24">
        <controls:ControlExample
            CsharpCode="FlyoutService.ShowAttachedFlyout(target); // Optional manual trigger"
            HeaderText="Attach one reusable Flyout to different owners."
            XamlCode="&lt;Page.Resources&gt;&#xA;    &lt;ui:Flyout x:Key=&quot;DetailsFlyout&quot; Placement=&quot;Top&quot; /&gt;&#xA;&lt;/Page.Resources&gt;&#xA;&#xA;&lt;ui:Button&#xA;    ui:FlyoutService.AttachedFlyout=&quot;{StaticResource DetailsFlyout}&quot;&#xA;    ui:FlyoutService.ShowOnFocusOrClick=&quot;True&quot;&#xA;    Content=&quot;Open above this button&quot; /&gt;">
            <StackPanel>
                <ui:Button
                    HorizontalAlignment="Left"
                    ui:FlyoutService.AttachedFlyout="{StaticResource DetailsFlyout}"
                    ui:FlyoutService.ShowOnFocusOrClick="True"
                    Content="Open above this button" />
                <Border
                    Margin="0,20,0,0"
                    Padding="16"
                    HorizontalAlignment="Left"
                    ui:FlyoutService.AttachedFlyout="{StaticResource DetailsFlyout}"
                    ui:FlyoutService.ShowOnFocusOrClick="True"
                    Background="{ui:DynamicBrush SubtleFillSecondary}"
                    CornerRadius="8"
                    Focusable="True">
                    <TextBlock Text="Click or focus this card to open the same Flyout above a different owner." />
                </Border>
            </StackPanel>
        </controls:ControlExample>

        <controls:ControlExample
            Margin="0,24,0,0"
            HeaderText="DropDownButton opens a Flyout directly."
            XamlCode="&lt;ui:DropDownButton Content=&quot;Options&quot;&gt;&#xA;    &lt;ui:DropDownButton.Flyout&gt;&#xA;        &lt;ui:Flyout Placement=&quot;Bottom&quot;&gt;&#xA;            &lt;CheckBox Content=&quot;Show details&quot; /&gt;&#xA;        &lt;/ui:Flyout&gt;&#xA;    &lt;/ui:DropDownButton.Flyout&gt;&#xA;&lt;/ui:DropDownButton&gt;">
            <ui:DropDownButton
                HorizontalAlignment="Left"
                Content="Options"
                IsDropDownOpen="{Binding IsFlyoutOpen}">
                <ui:DropDownButton.Flyout>
                    <ui:Flyout HorizontalAlignment="Left">
                        <StackPanel Width="260">
                            <TextBlock FontWeight="SemiBold" Text="Panel content, not a menu" />
                            <CheckBox Margin="0,12,0,0" Content="Show details" />
                            <CheckBox Margin="0,8,0,0" Content="Use compact spacing" />
                        </StackPanel>
                    </ui:Flyout>
                </ui:DropDownButton.Flyout>
            </ui:DropDownButton>
        </controls:ControlExample>
        <controls:ControlExample
            Margin="0,24,0,0"
            CsharpCode="// Keyboard focus or a completed primary click opens the Flyout.&#xA;// Focus moves to its first focusable child; repeated clicks do not toggle it.&#xA;FlyoutService.ShowAttachedFlyout(target); // Optional manual trigger"
            HeaderText="Open an attached Flyout from keyboard focus or a primary click."
            XamlCode="&lt;ui:TextBox ui:FlyoutService.ShowOnFocusOrClick=&quot;True&quot;&gt;&#xA;    &lt;ui:FlyoutService.AttachedFlyout&gt;&#xA;        &lt;ui:Flyout&gt;&#xA;            &lt;!-- Suggestion content --&gt;&#xA;        &lt;/ui:Flyout&gt;&#xA;    &lt;/ui:FlyoutService.AttachedFlyout&gt;&#xA;&lt;/ui:TextBox&gt;">
            <StackPanel>
                <TextBlock Margin="0,0,0,8" Text="Destination" />
                <ui:TextBox
                    x:Name="DestinationTextBox"
                    Width="350"
                    HorizontalAlignment="Left"
                    ui:FlyoutService.ShowOnFocusOrClick="True"
                    PlaceholderText="Focus or click here to choose a destination">
                    <ui:FlyoutService.AttachedFlyout>
                        <ui:Flyout>
                            <StackPanel Width="260">
                                <TextBlock
                                    Margin="0,0,0,8"
                                    FontWeight="SemiBold"
                                    Text="Choose a destination" />
                                <ui:Button
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Stretch"
                                    Click="OnDestinationClick"
                                    Content="Beijing" />
                                <ui:Button
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Stretch"
                                    Click="OnDestinationClick"
                                    Content="Shanghai" />
                                <ui:Button
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Stretch"
                                    Click="OnDestinationClick"
                                    Content="Hangzhou" />
                            </StackPanel>
                            <ui:Flyout.Style>
                                <Style TargetType="{x:Type ui:Flyout}">
                                    <Setter Property="ui:PopupPlacementGap.Vertical" Value="4" />
                                </Style>
                            </ui:Flyout.Style>
                        </ui:Flyout>
                    </ui:FlyoutService.AttachedFlyout>
                </ui:TextBox>
                <TextBlock
                    Margin="0,8,0,0"
                    Text="Focus moves into the panel when it opens. A repeated owner click leaves it open; press Escape, click outside, or move focus away to close it."
                    TextWrapping="Wrap" />
            </StackPanel>
        </controls:ControlExample>
    </StackPanel>
</Page>
