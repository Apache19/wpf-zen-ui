<Page
    x:Class="Wpf.Zen.Ui.Gallery.Views.Pages.DialogsAndFlyouts.FlyoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    xmlns:vm="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Pages.DialogsAndFlyouts"
    Title="FlyoutPage"
    controls:PageControlDocumentation.DocumentationType="{x:Type ui:Flyout}"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DataContext="{d:DesignInstance vm:FlyoutViewModel, IsDesignTimeCreatable=False}"
    d:DesignWidth="800"
    ui:NavigationView.IsNavigationFrameScrollEnabled="True"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  Resources do not occupy layout space. ShowAt chooses the anchor at the time of opening.  -->
        <ui:Flyout
            x:Key="DetailsFlyout"
            Placement="Top">
            <StackPanel Width="280">
                <TextBlock FontWeight="SemiBold" Text="An independent content flyout" />
                <TextBlock
                    Margin="0,8,0,12"
                    Text="This panel opens above the element passed to ShowAt. Escape or an outside click closes it."
                    TextWrapping="Wrap" />
                <ui:TextBox Text="You can edit content here" />
                <ui:Button
                    Margin="0,12,0,0"
                    HorizontalAlignment="Right"
                    Click="OnCloseDetailsClick"
                    Content="Done" />
            </StackPanel>
            <ui:Flyout.Style>
                <Style TargetType="{x:Type ui:Flyout}">
                    <Setter Property="VerticalOffset" Value="4" />
                    <Style.Triggers>
                        <Trigger Property="ui:PopupPlacementTracker.ActualPlacement" Value="Top">
                            <Setter Property="VerticalOffset" Value="-4" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ui:Flyout.Style>
        </ui:Flyout>
        <ui:Flyout x:Key="TextSelectionFlyout" Placement="Bottom">
            <ui:Flyout.Style>
                <Style TargetType="{x:Type ui:Flyout}">
                    <Setter Property="VerticalOffset" Value="4" />
                    <Style.Triggers>
                        <Trigger Property="ui:PopupPlacementTracker.ActualPlacement" Value="Top">
                            <Setter Property="VerticalOffset" Value="-4" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ui:Flyout.Style>
            <StackPanel Width="260">
                <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Choose a destination" />
                <ui:Button Margin="0,4,0,0" HorizontalAlignment="Stretch" Click="OnDestinationClick" Content="Beijing" />
                <ui:Button Margin="0,4,0,0" HorizontalAlignment="Stretch" Click="OnDestinationClick" Content="Shanghai" />
                <ui:Button Margin="0,4,0,0" HorizontalAlignment="Stretch" Click="OnDestinationClick" Content="Hangzhou" />
            </StackPanel>
        </ui:Flyout>
    </Page.Resources>

    <StackPanel Margin="0,0,0,24">
        <controls:ControlExample
            CsharpCode="((Flyout)Resources[&quot;DetailsFlyout&quot;]).ShowAt(target);"
            HeaderText="Open a Flyout above an explicit target."
            XamlCode="&lt;ui:Flyout x:Key=&quot;DetailsFlyout&quot; Placement=&quot;Top&quot; /&gt;">
            <StackPanel>
                <ui:Button
                    HorizontalAlignment="Left"
                    Click="OnShowDetailsClick"
                    Content="Open above this button" />
                <Border
                    Margin="0,20,0,0"
                    Padding="16"
                    HorizontalAlignment="Left"
                    Background="{ui:DynamicBrush SubtleFillSecondary}"
                    CornerRadius="8"
                    Focusable="True"
                    KeyDown="OnAnchorKeyDown"
                    MouseLeftButtonUp="OnAnchorMouseLeftButtonUp">
                    <TextBlock Text="Click this card, or focus it and press Enter, to use a different anchor." />
                </Border>
            </StackPanel>
        </controls:ControlExample>

        <controls:ControlExample
            Margin="0,24,0,0"
            HeaderText="DropDownButton opens a Flyout directly."
            XamlCode="&lt;ui:DropDownButton Content=&quot;Options&quot;&gt;&#xA;    &lt;ui:DropDownButton.Flyout&gt;&#xA;        &lt;ui:Flyout Placement=&quot;Bottom&quot;&gt;&#xA;            &lt;CheckBox Content=&quot;Show details&quot; /&gt;&#xA;        &lt;/ui:Flyout&gt;&#xA;    &lt;/ui:DropDownButton.Flyout&gt;&#xA;&lt;/ui:DropDownButton&gt;">
            <ui:DropDownButton
                HorizontalAlignment="Left"
                Content="Options"
                IsDropDownOpen="{Binding IsFlyoutOpen}">
                <ui:DropDownButton.Flyout>
                    <ui:Flyout Placement="Bottom" VerticalOffset="4">
                        <StackPanel Width="260">
                            <TextBlock FontWeight="SemiBold" Text="Panel content, not a menu" />
                            <CheckBox Margin="0,12,0,0" Content="Show details" />
                            <CheckBox Margin="0,8,0,0" Content="Use compact spacing" />
                        </StackPanel>
                    </ui:Flyout>
                </ui:DropDownButton.Flyout>
            </ui:DropDownButton>
        </controls:ControlExample>
        <controls:ControlExample
            Margin="0,24,0,0"
            HeaderText="Focus a TextBox and select a value from a Flyout."
            XamlCode="&lt;ui:TextBox GotKeyboardFocus=&quot;OnDestinationGotKeyboardFocus&quot; /&gt;&#xA;&lt;!-- Declare the selection Flyout in Page.Resources. --&gt;"
            CsharpCode="// Open after keyboard focus settles; ignore focus returning from the Flyout.&#xA;flyout.ShowAt(DestinationTextBox);&#xA;// When an option is clicked:&#xA;DestinationTextBox.SetCurrentValue(TextBox.TextProperty, selectedValue);&#xA;flyout.Hide();">
            <StackPanel>
                <TextBlock Margin="0,0,0,8" Text="Destination" />
                <ui:TextBox
                    x:Name="DestinationTextBox"
                    Width="300"
                    HorizontalAlignment="Left"
                    GotKeyboardFocus="OnDestinationGotKeyboardFocus"
                    PlaceholderText="Focus here to choose a destination" />
                <TextBlock
                    Margin="0,8,0,0"
                    Text="Choose with a click, or use Tab and Enter. The selected value remains editable. Move focus away and back to choose again."
                    TextWrapping="Wrap" />
            </StackPanel>
        </controls:ControlExample>
    </StackPanel>
</Page>
