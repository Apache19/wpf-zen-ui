<Page
    x:Class="Wpf.Zen.Ui.Gallery.Views.Pages.BasicInput.ToggleSwitchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    xmlns:vm="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Pages.BasicInput"
    Title="ToggleSwitchPage"
    controls:PageControlDocumentation.DocumentationType="{x:Type ui:ToggleSwitch}"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DataContext="{d:DesignInstance vm:ToggleSwitchViewModel, IsDesignTimeCreatable=False}"
    d:DesignWidth="800"
    ui:NavigationView.IsNavigationFrameScrollEnabled="True"
    FontSize="{ui:DynamicValue DefaultThemeFontSize}"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SkinSwitchTrackStyle" TargetType="{x:Type ui:ToggleSwitchPart}">
            <Setter Property="Width" Value="58" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="#FF5A6068" />
            <Setter Property="BorderBrush" Value="#FF25282C" />
            <Setter Property="CheckedBackground" Value="#FF638A45" />
            <Setter Property="CheckedBorderBrush" Value="#FF314A22" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ui:ToggleSwitchPart}">
                        <Grid>
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="5"
                                        Direction="270"
                                        Opacity="0.55"
                                        ShadowDepth="2" />
                                </Border.Effect>
                            </Border>
                            <Border
                                Background="{TemplateBinding CheckedBackground}"
                                BorderBrush="{TemplateBinding CheckedBorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="{TemplateBinding TransitionProgress}" />
                            <Border
                                Margin="2"
                                BorderBrush="#55FFFFFF"
                                BorderThickness="1"
                                CornerRadius="13" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!--
                    ToggleSwitch publishes its orientation to both visual parts. Keeping the
                    directional geometry in the part style allows this skin to remain reusable
                    without binding back to a particular owner template.
                -->
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="30" />
                    <Setter Property="Height" Value="58" />
                </Trigger>
                <Trigger Property="IsPointerOver" Value="True">
                    <Setter Property="BorderBrush" Value="#FF181A1D" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SkinSwitchThumbStyle" TargetType="{x:Type ui:ToggleSwitchPart}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Background" Value="#FFF2EEE3" />
            <Setter Property="BorderBrush" Value="#FFB8B2A5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ui:ToggleSwitchPart}">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="4"
                                    Direction="270"
                                    Opacity="0.6"
                                    ShadowDepth="2" />
                            </Border.Effect>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsPointerOver" Value="True">
                    <Setter Property="Background" Value="#FFFFFFFF" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="Orientation" Value="Horizontal" />
                        <Condition Property="IsPressed" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Width" Value="28" />
                    <Setter Property="Margin" Value="3" />
                </MultiTrigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="Orientation" Value="Vertical" />
                        <Condition Property="IsPressed" Value="True" />
                    </MultiTrigger.Conditions>
                    <!-- The pressed thumb stretches along the vertical travel axis. -->
                    <Setter Property="Height" Value="28" />
                    <Setter Property="Margin" Value="3" />
                </MultiTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.65" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <StackPanel Margin="0,0,0,24">
        <controls:ControlExample
            Margin="0"
            HeaderText="A ToggleSwitch control."
            XamlCode="&lt;StackPanel Orientation=&quot;Horizontal&quot;&gt;&#x0a;    &lt;TextBlock Margin=&quot;0,0,8,0&quot; Text=&quot;Wi-Fi&quot; /&gt;&#x0a;    &lt;ui:ToggleSwitch /&gt;&#x0a;&lt;/StackPanel&gt;">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Text="Wi-Fi" />
                    <ui:ToggleSwitch IsEnabled="{Binding IsToggleSwitchDisabled, Converter={StaticResource BoolInvertConverter}}" />
                </StackPanel>
                <CheckBox
                    Grid.Column="1"
                    Content="Disable switch"
                    IsChecked="{Binding IsToggleSwitchDisabled}" />
            </Grid>
        </controls:ControlExample>

        <controls:ControlExample
            Margin="0,32,0,0"
            HeaderText="A ToggleSwitch with Vertical mode."
            XamlCode="&lt;Grid&gt;&#x0a;    &lt;TextBlock Text=&quot;Use vertical mode&quot; /&gt;&#x0a;    &lt;ui:ToggleSwitch Orientation=&quot;Vertical&quot; /&gt;&#x0a;&lt;/Grid&gt;">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    Text="Use vertical mode" />
                <ui:ToggleSwitch Orientation="Vertical" />
                <ui:ToggleSwitch IsChecked="True" Orientation="Vertical" />
                <ui:ToggleSwitch Orientation="Vertical" />
            </StackPanel>
        </controls:ControlExample>

        <controls:ControlExample
            Margin="0,32,0,0"
            HeaderText="A custom two-part skin ToggleSwitch."
            XamlCode="&lt;StackPanel Orientation=&quot;Horizontal&quot;&gt;&#x0a;    &lt;ui:ToggleSwitch&#x0a;        TrackStyle=&quot;{StaticResource SkinSwitchTrackStyle}&quot;&#x0a;        ThumbStyle=&quot;{StaticResource SkinSwitchThumbStyle}&quot; /&gt;&#x0a;    &lt;ui:ToggleSwitch&#x0a;        Orientation=&quot;Vertical&quot;&#x0a;        TrackStyle=&quot;{StaticResource SkinSwitchTrackStyle}&quot;&#x0a;        ThumbStyle=&quot;{StaticResource SkinSwitchThumbStyle}&quot; /&gt;&#x0a;&lt;/StackPanel&gt;">
            <StackPanel Orientation="Horizontal">
                <ui:ToggleSwitch
                    Margin="0,0,12,0"
                    ThumbStyle="{StaticResource SkinSwitchThumbStyle}"
                    TrackStyle="{StaticResource SkinSwitchTrackStyle}"
                    TransitionDuration="0:0:0.24" />
                <ui:ToggleSwitch
                    Orientation="Vertical"
                    ThumbStyle="{StaticResource SkinSwitchThumbStyle}"
                    TrackStyle="{StaticResource SkinSwitchTrackStyle}"
                    TransitionDuration="0:0:0.24" />
            </StackPanel>
        </controls:ControlExample>
    </StackPanel>
</Page>
