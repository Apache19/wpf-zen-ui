<Page
    x:Class="Wpf.Zen.Ui.Gallery.Views.Pages.BasicInput.ToggleSwitchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Zen.Ui.Gallery.Views.Pages.BasicInput"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    xmlns:vm="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Pages.BasicInput"
    Title="ToggleSwitchPage"
    controls:PageControlDocumentation.DocumentationType="{x:Type ui:ToggleSwitch}"
    d:DataContext="{d:DesignInstance vm:ToggleSwitchViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignWidth="800"
    d:Background="{ui:DynamicBrush WindowBackground}"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    ui:NavigationView.IsNavigationFrameScrollEnabled="True"
    mc:Ignorable="d">

    <StackPanel Margin="0,0,0,24">
        <controls:ControlExample
            Margin="0"
            HeaderText="WPF Zen UI toggle switch."
            XamlCode="&lt;ui:ToggleSwitch OffContent=&quot;Off&quot; OnContent=&quot;On&quot;  /&gt;">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:ToggleSwitch
                    Grid.Column="0"
                    IsEnabled="{Binding IsToggleSwitchDisabled, Converter={StaticResource BoolInvertConverter}}"
                    OffContent="Off"
                    OnContent="On" />
                <CheckBox
                    Grid.Column="1"
                    IsChecked="{Binding IsToggleSwitchDisabled}"
                    Content="Disable switch" />
            </Grid>
        </controls:ControlExample>

        <controls:ControlExample
            Margin="0,32,0,0"
            HeaderText="ToggleSwitch with ContentPlacement property."
            XamlCode="&lt;ui:ToggleSwitch Content=&quot;Label on Right&quot; ContentPlacement=&quot;Right&quot; /&gt;&#10; &lt;ui:ToggleSwitch Content=&quot;Label on Left&quot; ContentPlacement=&quot;Left&quot; /&gt;">
            <StackPanel>
                <ui:ToggleSwitch
                    Margin="0,0,0,8"
                    Content="Content on Right"
                    ContentPlacement="Right" />
                <ui:ToggleSwitch Content="Content on Left" ContentPlacement="Left" />
            </StackPanel>
        </controls:ControlExample>
    </StackPanel>
</Page>
