<Page
    x:Class="Wpf.Zen.Ui.Gallery.Views.Pages.BasicInput.CheckBoxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    xmlns:vm="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Pages.BasicInput"
    Title="CheckBoxPage"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DataContext="{d:DesignInstance vm:CheckBoxViewModel, IsDesignTimeCreatable=False}"
    d:DesignWidth="800"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    ui:NavigationView.IsNavigationFrameScrollEnabled="True"
    mc:Ignorable="d">

    <StackPanel Margin="0,0,0,24">
        <controls:ControlExample HeaderText="A 2-state CheckBox." XamlCode="&lt;CheckBox Content=&quot;Standard WPF checkbox&quot; /&gt;">
            <CheckBox Content="Two-state CheckBox" />
        </controls:ControlExample>

        <controls:ControlExample
            Margin="0,32,0,0"
            HeaderText="A 3-state CheckBox."
            XamlCode="&lt;CheckBox IsThreeState=&quot;True&quot; /&gt;">
            <CheckBox
                Content="Three-state CheckBox"
                IsChecked="{x:Null}"
                IsThreeState="True" />
        </controls:ControlExample>

        <controls:ControlExample
            Margin="0,32,0,0"
            HeaderText="Using a 3-state CheckBox."
            XamlCode="&lt;CheckBox IsThreeState=&quot;True&quot; /&gt;">
            <StackPanel>
                <CheckBox
                    Content="Select all"
                    IsChecked="{Binding SelectAllCheckBoxChecked, Mode=TwoWay}"
                    IsThreeState="True" />
                <CheckBox
                    Margin="24,0,0,0"
                    Content="Option 1"
                    IsChecked="{Binding OptionOneCheckBoxChecked, Mode=TwoWay}" />
                <CheckBox
                    Margin="24,0,0,0"
                    Content="Option 2"
                    IsChecked="{Binding OptionTwoCheckBoxChecked, Mode=TwoWay}" />
                <CheckBox
                    Margin="24,0,0,0"
                    Content="Option 3"
                    IsChecked="{Binding OptionThreeCheckBoxChecked, Mode=TwoWay}" />
            </StackPanel>
        </controls:ControlExample>
    </StackPanel>
</Page>
