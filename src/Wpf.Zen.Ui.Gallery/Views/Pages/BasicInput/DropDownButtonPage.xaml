<Page
    x:Class="Wpf.Zen.Ui.Gallery.Views.Pages.BasicInput.DropDownButtonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    xmlns:vm="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Pages.BasicInput"
    Title="DropDownButtonPage"
    controls:PageControlDocumentation.DocumentationType="{x:Type ui:DropDownButton}"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DataContext="{d:DesignInstance vm:DropDownButtonViewModel, IsDesignTimeCreatable=False}"
    d:DesignWidth="800"
    ui:NavigationView.IsNavigationFrameScrollEnabled="True"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    mc:Ignorable="d">

    <StackPanel Margin="0,0,0,24">
        <controls:ControlExample
            Margin="0"
            HeaderText="A DropDownButton with file and edit operations."
            XamlCodeSource="/CodeSamples/BasicInput/DropDownButton_xaml.txt">
            <StackPanel>
                <ui:DropDownButton
                    HorizontalAlignment="Left"
                    Content="Menu"
                    Icon="{ui:FluentIconSource Fluent24}">
                    <ui:DropDownButton.Flyout>
                        <ContextMenu>
                            <MenuItem
                                Command="{Binding NewCommand}"
                                Header="New"
                                Icon="{ui:FluentIconSource Add24}"
                                InputGestureText="Ctrl+N" />
                            <MenuItem
                                Command="{Binding OpenCommand}"
                                Header="Open..."
                                Icon="{ui:FluentIconSource Open24}"
                                InputGestureText="Ctrl+O" />
                            <MenuItem
                                Command="{Binding SaveCommand}"
                                Header="Save"
                                Icon="{ui:FluentIconSource Save24}"
                                InputGestureText="Ctrl+S" />
                            <Separator />
                            <MenuItem
                                Command="{Binding CutCommand}"
                                Header="Cut"
                                Icon="{ui:FluentIconSource Cut24}"
                                InputGestureText="Ctrl+X" />
                            <MenuItem
                                Command="{Binding CopyCommand}"
                                Header="Copy"
                                Icon="{ui:FluentIconSource Copy24}"
                                InputGestureText="Ctrl+C" />
                            <MenuItem
                                Command="{Binding PasteCommand}"
                                Header="Paste"
                                Icon="{ui:FluentIconSource ClipboardPaste24}"
                                InputGestureText="Ctrl+V" />
                        </ContextMenu>
                    </ui:DropDownButton.Flyout>
                </ui:DropDownButton>

                <!--  Status feedback  -->
                <TextBlock
                    Margin="12,12,0,0"
                    FontSize="13"
                    Foreground="{ui:DynamicBrush TextFillSecondary}"
                    Text="{Binding StatusMessage}" />
            </StackPanel>
        </controls:ControlExample>

        <controls:ControlExample
            Margin="0,24,0,0"
            CsharpCodeSource="/CodeSamples/BasicInput/DropDownButtonPopup_cs.txt"
            HeaderText="A DropDownButton with interactive Popup content."
            XamlCodeSource="/CodeSamples/BasicInput/DropDownButtonPopup_xaml.txt">
            <ui:DropDownButton
                x:Name="PopupSettingsButton"
                HorizontalAlignment="Left"
                Content="Display options"
                Icon="{ui:FluentIconSource Settings24}">
                <ui:DropDownButton.Flyout>
                    <Popup
                        ui:PopupShadow.IsEnabled="True"
                        AllowsTransparency="True"
                        PopupAnimation="Fade">
                        <Border
                            Width="300"
                            Padding="20"
                            Background="{ui:DynamicBrush AcrylicBackgroundFillDefault}"
                            BorderBrush="{ui:DynamicBrush SurfaceStrokeFlyout}"
                            BorderThickness="1"
                            CornerRadius="8"
                            TextElement.Foreground="{ui:DynamicBrush TextFillPrimary}">
                            <StackPanel>
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="Display options" />
                                <TextBlock Margin="0,12,0,6" Text="View name" />
                                <ui:TextBox Text="My workspace" />
                                <CheckBox
                                    Margin="0,12,0,0"
                                    Content="Show item details"
                                    IsChecked="True" />
                                <TextBlock
                                    Margin="0,12,0,0"
                                    Foreground="{ui:DynamicBrush TextFillSecondary}"
                                    Text="Interact with the panel, then click Done or click outside to close."
                                    TextWrapping="Wrap" />
                                <ui:Button
                                    Margin="0,16,0,0"
                                    HorizontalAlignment="Right"
                                    Appearance="Accent"
                                    Click="OnPopupDoneClick"
                                    Content="Done" />
                            </StackPanel>
                        </Border>
                        <Popup.Style>
                            <Style TargetType="{x:Type Popup}">
                                <Setter Property="ui:PopupPlacementGap.Vertical" Value="4" />
                            </Style>
                        </Popup.Style>
                    </Popup>
                </ui:DropDownButton.Flyout>
            </ui:DropDownButton>
        </controls:ControlExample>
        <controls:ControlExample
            Margin="0,24,0,0"
            HeaderText="Data-driven flyout with a DataTemplate."
            XamlCodeSource="/CodeSamples/BasicInput/DropDownButtonData_xaml.txt">
            <ui:DropDownButton
                HorizontalAlignment="Left"
                Content="Status panel"
                Flyout="{Binding}">
                <ui:DropDownButton.FlyoutTemplate>
                    <DataTemplate>
                        <StackPanel Width="280">
                            <TextBlock FontWeight="SemiBold" Text="Current operation" />
                            <TextBlock
                                Margin="0,8,0,12"
                                Text="{Binding StatusMessage}"
                                TextWrapping="Wrap" />
                            <ui:Button
                                HorizontalAlignment="Left"
                                Command="{Binding RefreshCommand}"
                                Content="Refresh" />
                        </StackPanel>
                    </DataTemplate>
                </ui:DropDownButton.FlyoutTemplate>
            </ui:DropDownButton>
        </controls:ControlExample>
        <controls:ControlExample
            Margin="0,24,0,0"
            HeaderText="UI content with automatic Popup wrapping."
            XamlCodeSource="/CodeSamples/BasicInput/DropDownButtonContent_xaml.txt">
            <ui:DropDownButton HorizontalAlignment="Left" Content="Quick settings">
                <ui:DropDownButton.Flyout>
                    <StackPanel Width="280">
                        <TextBlock FontWeight="SemiBold" Text="Quick settings" />
                        <CheckBox
                            Margin="0,12,0,0"
                            Content="Show item details"
                            IsChecked="True" />
                        <TextBlock
                            Margin="0,12,0,0"
                            Text="{Binding StatusMessage}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:DropDownButton.Flyout>
            </ui:DropDownButton>
        </controls:ControlExample>
        <controls:ControlExample
            Margin="0,24,0,0"
            HeaderText="Text formatting without a data template."
            XamlCodeSource="/CodeSamples/BasicInput/DropDownButtonFormat_xaml.txt">
            <ui:DropDownButton
                HorizontalAlignment="Left"
                Content="Operation summary"
                Flyout="{Binding StatusMessage}"
                FlyoutStringFormat="Status: {0}" />
        </controls:ControlExample>
    </StackPanel>
</Page>
