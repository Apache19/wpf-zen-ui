<Page
    x:Class="Wpf.Zen.Ui.Gallery.Views.Pages.BasicInput.ToggleButtonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    xmlns:vm="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Pages.BasicInput"
    Title="ToggleButtonPage"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DataContext="{d:DesignInstance vm:ToggleButtonViewModel, IsDesignTimeCreatable=False}"
    d:DesignWidth="800"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    ui:NavigationView.IsNavigationFrameScrollEnabled="True"
    mc:Ignorable="d">

    <Grid Margin="0,0,0,24">
        <controls:ControlExample
            Margin="0"
            HeaderText="Toggle button."
            XamlCode="&lt;ToggleButton Content=&quot;ToggleButton&quot; /&gt;">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:ToggleButton
                    Grid.Column="0"
                    MinWidth="200"
                    HorizontalAlignment="Left"
                    Content="ToggleButton"
                    IsEnabled="{Binding IsToggleButtonDisabled, Converter={StaticResource BoolInvertConverter}}">
                    <ui:ToggleButton.Style>
                        <Style TargetType="ui:ToggleButton">
                            <Setter Property="ui:IconAssist.Icon">
                                <Setter.Value>
                                    <ui:FluentIcon Filled="False" Symbol="LockOpen24" />
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="ui:IconAssist.Icon">
                                        <Setter.Value>
                                            <ui:FluentIcon Filled="True" Symbol="LockClosed24" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ui:ToggleButton.Style>
                </ui:ToggleButton>
                <CheckBox
                    Grid.Column="1"
                    Content="Disable toggle button"
                    IsChecked="{Binding IsToggleButtonDisabled}" />
            </Grid>
        </controls:ControlExample>
    </Grid>
</Page>
