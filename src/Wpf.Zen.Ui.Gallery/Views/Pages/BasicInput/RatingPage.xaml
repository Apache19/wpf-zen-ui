<Page
    x:Class="Wpf.Zen.Ui.Gallery.Views.Pages.BasicInput.RatingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    xmlns:vm="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Pages.BasicInput"
    Title="RatingPage"
    controls:PageControlDocumentation.DocumentationType="{x:Type ui:RatingControl}"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DataContext="{d:DesignInstance vm:RatingViewModel, IsDesignTimeCreatable=False}"
    d:DesignWidth="800"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    ui:NavigationView.IsNavigationFrameScrollEnabled="True"
    mc:Ignorable="d">

    <StackPanel Margin="0,0,0,24">
        <controls:ControlExample
            Margin="0"
            Foreground="{ui:DynamicBrush TextFillPrimary}"
            HeaderText="Rating with quarter-star precision and a placeholder value."
            XamlCode="&lt;ui:RatingControl\n    IsClearEnabled=&quot;True&quot;\n    PlaceholderRating=&quot;2.5&quot;\n    Precision=&quot;QuarterStar&quot;\n    Rating=&quot;{Binding FirstRatingValue}&quot; /&gt;">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:RatingControl
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsClearEnabled="True"
                    IsEnabled="{Binding IsFirstRatingDisabled, Converter={StaticResource BoolInvertConverter}}"
                    PlaceholderRating="2.5"
                    Precision="QuarterStar"
                    Rating="{Binding FirstRatingValue}" />
                <StackPanel
                    Grid.Column="1"
                    MinWidth="60"
                    Margin="0,4,0,0"
                    VerticalAlignment="Center">
                    <Label Margin="0,0,0,-4" Content="Rating:" />
                    <TextBlock Margin="0" Text="{Binding FirstRatingValue, Mode=OneWay}" />
                </StackPanel>
                <CheckBox
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Content="Disable rating"
                    IsChecked="{Binding IsFirstRatingDisabled}" />
            </Grid>
        </controls:ControlExample>

        <controls:ControlExample
            Margin="0,36,0,0"
            HeaderText="WPF Zen UI rating with full stars only."
            XamlCode="&lt;ui:RatingControl Precision=&quot;FullStar&quot; /&gt;">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:RatingControl
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsEnabled="{Binding IsSecondRatingDisabled, Converter={StaticResource BoolInvertConverter}}"
                    Precision="FullStar"
                    Rating="{Binding SecondRatingValue, Mode=TwoWay}" />
                <StackPanel
                    Grid.Column="1"
                    MinWidth="60"
                    Margin="0,4,0,0"
                    VerticalAlignment="Center">
                    <Label Margin="0,0,0,-4" Content="Rating:" />
                    <TextBlock Margin="0" Text="{Binding SecondRatingValue, Mode=TwoWay}" />
                </StackPanel>
                <CheckBox
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Content="Disable rating"
                    IsChecked="{Binding IsSecondRatingDisabled}" />
            </Grid>
        </controls:ControlExample>
    </StackPanel>
</Page>
