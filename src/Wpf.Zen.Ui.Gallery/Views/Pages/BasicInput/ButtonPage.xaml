<Page
    x:Class="Wpf.Zen.Ui.Gallery.Views.Pages.BasicInput.ButtonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    xmlns:vm="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Pages.BasicInput"
    Title="ButtonPage"
    controls:PageControlDocumentation.DocumentationType="{x:Type ui:Button}"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DataContext="{d:DesignInstance vm:ButtonViewModel, IsDesignTimeCreatable=True}"
    d:DesignWidth="800"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    ui:NavigationView.IsNavigationFrameScrollEnabled="True"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Wpf.Zen.Ui;component/Controls/Button/Button.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="ViewBoxCustomButtonContentTemplate">
                <Viewbox
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Stretch="Uniform"
                    StretchDirection="Both">
                    <ContentPresenter
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Content="{TemplateBinding Content}" />
                </Viewbox>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <StackPanel Margin="0,0,0,24">
        <controls:ControlExample
            Margin="0"
            HeaderText="Standard button."
            XamlCode="&lt;Button Content=&quot;Standard WPF button&quot; /&gt;">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    MinWidth="200"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="Standard WPF button"
                    IsEnabled="{Binding IsSimpleButtonDisabled, Converter={StaticResource BoolInvertConverter}}" />
                <CheckBox
                    Grid.Column="1"
                    Content="Disable button"
                    IsChecked="{Binding IsSimpleButtonDisabled}" />
            </Grid>
        </controls:ControlExample>

        <controls:ControlExample
            Margin="0,32,0,0"
            HeaderText="WPF Zen UI button."
            XamlCode="&lt;ui:Button Content=&quot;WPF Zen UI button&quot; Icon=&quot;Fluent24&quot; /&gt;">
            <controls:ControlExample.Resources>
                <ObjectDataProvider
                    x:Key="AppearanceList"
                    MethodName="GetValues"
                    ObjectType="{x:Type ui:ControlAppearance}">
                    <ObjectDataProvider.MethodParameters>
                        <x:Type TypeName="ui:ControlAppearance" />
                    </ObjectDataProvider.MethodParameters>
                </ObjectDataProvider>
            </controls:ControlExample.Resources>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button
                    Grid.Column="0"
                    MinWidth="200"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Appearance="{Binding UiButtonAppearance}"
                    Content="WPF Zen UI button"
                    Icon="{ui:FluentIconSource Fluent24}"
                    IsEnabled="{Binding IsUiButtonDisabled, Converter={StaticResource BoolInvertConverter}}" />
                <StackPanel Grid.Column="1" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Text="Appearance" />
                        <ComboBox
                            MinWidth="180"
                            ItemsSource="{Binding Source={StaticResource AppearanceList}}"
                            SelectedItem="{Binding UiButtonAppearance}" />
                    </StackPanel>
                    <ui:Separator Margin="0,12" Orientation="Horizontal" />
                    <CheckBox
                        HorizontalAlignment="Right"
                        Content="Disable button"
                        IsChecked="{Binding IsUiButtonDisabled}" />
                </StackPanel>
            </Grid>
        </controls:ControlExample>

        <controls:ControlExample
            Margin="0,32,0,0"
            HeaderText="WPF Zen UI button with FontIcon."
            XamlCode="&lt;ui:Button Appearance=&quot;Primary&quot; /&gt;">
            <ui:Button
                MinWidth="200"
                HorizontalAlignment="Left"
                Appearance="Normal"
                Content="WPF Zen UI button with font icon"
                Icon="{ui:FontIcon '&#x1F308;'}" />
        </controls:ControlExample>

        <controls:ControlExample
            Margin="0,32,0,0"
            HeaderText="WPF Zen UI button with ImageIcon."
            XamlCode="&lt;ui:Button Appearance=&quot;Primary&quot; /&gt;">
            <ui:Button
                MinWidth="200"
                HorizontalAlignment="Left"
                Appearance="Normal"
                Content="WPF Zen UI button with image icon"
                Icon="{ui:ImageIcon 'pack://application:,,,/Assets/wpfui.png'}" />
        </controls:ControlExample>

        <controls:ControlExample
            Margin="0,32,0,0"
            HeaderText="WPF Zen UI button with modified content template."
            XamlCode="&lt;ui:Button Appearance=&quot;Primary&quot; /&gt;">
            <ui:Button
                Width="40"
                HorizontalAlignment="Left"
                ContentTemplate="{StaticResource ViewBoxCustomButtonContentTemplate}">
                <Canvas Width="47" Height="99">
                    <Path Data="M0,19H18V84h29v15H0V19Z" Fill="{ui:DynamicBrush TextFillSecondary}" />
                    <Path Data="M46,80H29V15H0V0H46V80Z" Fill="{ui:DynamicBrush TextFillSecondary}" />
                </Canvas>
            </ui:Button>
        </controls:ControlExample>
    </StackPanel>
</Page>
