<Page
    x:Class="Wpf.Zen.Ui.Gallery.Views.Pages.BasicInput.ComboBoxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    xmlns:vm="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Pages.BasicInput"
    Title="ComboBoxPage"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DataContext="{d:DesignInstance vm:ComboBoxViewModel, IsDesignTimeCreatable=False}"
    d:DesignWidth="800"
    FontSize="{ui:DynamicValue DefaultThemeFontSize}"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    ui:NavigationView.IsNavigationFrameScrollEnabled="True"
    mc:Ignorable="d">

    <StackPanel Margin="0,0,0,24">
        <controls:ControlExample
            Margin="0"
            HeaderText="A Native ComboBox with items defined inline."
            XamlCode="&lt;ComboBox /&gt;">
            <ComboBox
                MinWidth="200"
                HorizontalAlignment="Left"
                SelectedIndex="0">
                <ComboBoxItem Content="Blue" />
                <ComboBoxItem Content="Green" />
                <ComboBoxItem Content="Red" />
                <ComboBoxItem Content="Yellow" />
            </ComboBox>
        </controls:ControlExample>

        <controls:ControlExample
            Margin="0,32,0,0"
            HeaderText="A ComboBox with ItemsSource and an Icon."
            XamlCode="&lt;ComboBox ItemsSource=&quot;{Binding FontFamilies}&quot; /&gt;">
            <ui:ComboBox
                MinWidth="200"
                HorizontalAlignment="Left"
                ui:PlaceholderService.Content="Placeholder"
                Icon="{ui:FluentIconSource TextFont24}"
                ItemsSource="{Binding ComboBoxFontFamilies}">
                <ui:ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock FontFamily="{Binding}" Text="{Binding}" />
                    </DataTemplate>
                </ui:ComboBox.ItemTemplate>
            </ui:ComboBox>
        </controls:ControlExample>

        <controls:ControlExample
            Margin="0,32,0,0"
            HeaderText="An editable ComboBox."
            XamlCode="&lt;ComboBox IsEditable=&quot;True&quot; /&gt;">
            <ui:ComboBox
                MinWidth="200"
                HorizontalAlignment="Left"
                ui:PlaceholderService.Content="Placeholder"
                IsEditable="True"
                ItemsSource="{Binding ComboBoxFontSizes}"
                SelectedIndex="0" />
        </controls:ControlExample>

        <controls:ControlExample
            Margin="0,32,0,0"
            HeaderText="A ComboBox with grouped items using GroupStyle."
            XamlCode="&lt;ComboBox&gt;&#x0a;  &lt;ComboBox.GroupStyle&gt;&#x0a;    &lt;GroupStyle /&gt;&#x0a;  &lt;/ComboBox.GroupStyle&gt;&#x0a;&lt;/ComboBox&gt;">
            <controls:ControlExample.Resources>
                <CollectionViewSource x:Key="GroupedItemsSource" Source="{Binding GroupedItems}">
                    <CollectionViewSource.GroupDescriptions>
                        <PropertyGroupDescription PropertyName="Category" />
                    </CollectionViewSource.GroupDescriptions>
                </CollectionViewSource>
            </controls:ControlExample.Resources>
            <ui:ComboBox
                MinWidth="200"
                HorizontalAlignment="Left"
                DisplayMemberPath="Name"
                ItemsSource="{Binding Source={StaticResource GroupedItemsSource}}"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectedIndex="0">
                <ui:ComboBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate DataType="{x:Type vm:GroupedComboBoxItem}">
                                <TextBlock
                                    Margin="8,4,0,4"
                                    FontWeight="SemiBold"
                                    Foreground="{ui:DynamicBrush TextFillPrimary}"
                                    Text="{Binding Name}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ui:ComboBox.GroupStyle>
            </ui:ComboBox>
        </controls:ControlExample>
        <controls:ControlExample
            Margin="0,32,0,0"
            HeaderText="Choose an interaction, then type box, box item, cbi, or tb. Enter or Match confirms."
            XamlCode="&lt;ui:ComboBox IsEditable=&quot;True&quot; IsTextSearchEnabled=&quot;True&quot; TextSearchMode=&quot;Fuzzy&quot; /&gt;">
            <StackPanel HorizontalAlignment="Left">
                <ui:ComboBox
                    x:Name="SearchInteractionPicker"
                    Margin="0,0,0,8"
                    SelectedValuePath="Tag"
                    SelectedIndex="0">
                    <ComboBoxItem Content="Confirm with Enter / Match"
                        Tag="{x:Static ui:ComboBoxSearchInteraction.ExplicitCommit}" />
                    <ComboBoxItem Content="Select while typing; show all items"
                        Tag="{x:Static ui:ComboBoxSearchInteraction.AutoSelect}" />
                    <ComboBoxItem Content="Filter candidates; confirm to select"
                        Tag="{x:Static ui:ComboBoxSearchInteraction.Filter}" />
                </ui:ComboBox>
                <ui:ComboBox
                    x:Name="SearchComboBox"
                    SearchInteraction="{Binding SelectedValue, ElementName=SearchInteractionPicker}"
                    MinWidth="280"
                    ui:PlaceholderService.Content="Search anywhere in an item"
                    IsEditable="True"
                    IsTextSearchEnabled="True"
                    TextSearchMode="Fuzzy">
                    <ComboBoxItem Content="ComboBoxItem" />
                    <ComboBoxItem Content="TextBlock" />
                    <ComboBoxItem Content="TextBox" />
                    <ComboBoxItem Content="VirtualizingStackPanel" />
                    <ComboBoxItem Content="露天矿山设备编号" />
                </ui:ComboBox>
                <ui:Button
                    Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    Click="OnMatchSearchClick"
                    Content="Match" />
                <TextBlock Margin="0,8,0,0">
                    <Run Text="Selected: " />
                    <Run Text="{Binding SelectedItem.Content, ElementName=SearchComboBox, Mode=OneWay, TargetNullValue=(none), FallbackValue=(none)}" />
                </TextBlock>
            </StackPanel>
        </controls:ControlExample>
    </StackPanel>
</Page>
