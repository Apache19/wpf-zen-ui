<Page
    x:Class="Wpf.Zen.Ui.Gallery.Views.Pages.BasicInput.AnchorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    xmlns:vm="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Pages.BasicInput"
    Title="AnchorPage"
    controls:PageControlDocumentation.DocumentationType="{x:Type ui:Anchor}"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DataContext="{d:DesignInstance vm:AnchorViewModel, IsDesignTimeCreatable=False}"
    d:DesignWidth="800"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    Style="{ui:DynamicStyle DynamicScrollPage}"
    mc:Ignorable="d">

    <Grid Margin="0,0,0,24">
        <controls:ControlExample
            Grid.Row="0"
            Margin="0"
            HeaderText="WPF Zen UI anchor."
            XamlCode="&lt;ui:Anchor NavigateUri=&quot;https://&quot; /&gt;">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:Anchor
                        HorizontalAlignment="Left"
                        Content="WPF Zen UI anchor"
                        Icon="{ui:SymbolIcon Link24}"
                        IsEnabled="{Binding IsAnchorDisabled, Converter={StaticResource BoolInvertConverter}}"
                        NavigateUri="https://thezendev.com/" />
                </StackPanel>
                <CheckBox
                    Grid.Column="1"
                    Content="Disable anchor"
                    IsChecked="{Binding IsAnchorDisabled}" />
            </Grid>
        </controls:ControlExample>
    </Grid>
</Page>
