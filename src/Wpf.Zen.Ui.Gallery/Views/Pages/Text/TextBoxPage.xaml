<Page
    x:Class="Wpf.Zen.Ui.Gallery.Views.Pages.Text.TextBoxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    xmlns:vm="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Pages.Text"
    Title="TextBoxPage"
    controls:PageControlDocumentation.DocumentationType="{x:Type ui:TextBox}"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DataContext="{d:DesignInstance vm:TextBoxViewModel, IsDesignTimeCreatable=False}"
    d:DesignWidth="800"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    ui:NavigationView.IsNavigationFrameScrollEnabled="True"
    mc:Ignorable="d">

    <StackPanel Margin="0,0,0,24">
        <controls:ControlExample HeaderText="A simple TextBox." XamlCode="&lt;TextBox /&gt;">
            <TextBox
                Width="250"
                HorizontalAlignment="Left"
                ui:PlaceholderService.Content="A WPF Native TextBox" />
        </controls:ControlExample>

        <controls:ControlExample
            Margin="0,36,0,0"
            HeaderText="A WPF Zen UI TextBox."
            XamlCode="&lt;ui:TextBox PlaceholderText=&quot;Type something...&quot; /&gt;">
            <StackPanel Orientation="Horizontal">
                <ui:TextBox Width="200" PlaceholderText="Type something..." />
                <ui:TextBox
                    Width="200"
                    Margin="8,0,0,0"
                    ui:IconAssist.Icon="{ui:FluentIconSource Edit24}"
                    PlaceholderText="Iconic Text Editor" />
                <ui:TextBox
                    Width="200"
                    Margin="8,0,0,0"
                    IsReadOnly="True"
                    IsReadOnlyCaretVisible="True"
                    Text="Readonly Text Editor" />
            </StackPanel>

        </controls:ControlExample>

        <controls:ControlExample
            Margin="0,36,0,0"
            HeaderText="A multi-line TextBox."
            XamlCode="&lt;ui:TextBox PlaceholderText=&quot;Type something...&quot;TextWrapping=&quot;Wrap&quot; /&gt;">
            <ui:TextBox
                MinHeight="100"
                MaxHeight="150"
                ui:ScrollViewerAssist.HideButtons="True"
                AcceptsReturn="True"
                HorizontalScrollBarVisibility="Disabled"
                ui:IconAssist.Icon="{ui:FluentIconSource DocumentBulletList24}"
                PlaceholderText="Type something..."
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto" />
        </controls:ControlExample>
    </StackPanel>
</Page>
