<Page
    x:Class="Wpf.Zen.Ui.Gallery.Views.Pages.Text.TextBlockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Zen.Ui.Gallery.Views.Pages.Text"
    xmlns:vm="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Pages.Text"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    Title="TextBlockPage"
    controls:PageControlDocumentation.DocumentationType="{x:Type ui:TextBlock}"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DataContext="{d:DesignInstance vm:TextBlockViewModel, IsDesignTimeCreatable=False}"
    d:DesignWidth="800"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    mc:Ignorable="d"
    Style="{ui:DynamicStyle DynamicScrollPage}">

    <StackPanel Margin="0,0,0,24">
        <controls:ControlExample
            Margin="0"
            HeaderText="A simple TextBlock."
            XamlCode="&lt;TextBlock Text=&quot;I am a text block.&quot; /&gt;">
            <TextBlock Text="I am a text block." />
        </controls:ControlExample>

        <controls:ControlExample
            Margin="0,36,0,0"
            HeaderText="A TextBlock with style applied."
            XamlCode="&lt;TextBlock FontFamily=&quot;Comic Sans MS&quot; FontStyle=&quot;Italic&quot; /&gt;">
            <TextBlock
                FontFamily="Comic Sans MS"
                FontStyle="Italic"
                Text="I am a styled TextBlock." />
        </controls:ControlExample>

        <controls:ControlExample Margin="0,36,0,0" HeaderText="A TextBlock with inline text elements.">
            <controls:ControlExample.XamlCode>
                &lt;TextBlock&gt;\n
                \t&lt;Run FontFamily=&quot;Times New Roman&quot; Foreground=&quot;DarkGray&quot;&gt;\n
                \t\t\'Text in a TextBlock doesnt have to be a simple string.'\n
                \t&lt;/Run&gt;\n
                \t&lt;LineBreak /&gt;\n
                &lt;/TextBlock&gt;
            </controls:ControlExample.XamlCode>
            <TextBlock FontSize="14">
                <Run FontFamily="Times New Roman" Foreground="DarkGray">
                    Text in a TextBlock doesn't have to be a simple string.
                </Run>
                <LineBreak />
                <Span>
                    Text can be<Bold>bold</Bold>
                    ,<Italic>italic</Italic>
                    , or<Underline>underlined</Underline>
                    .</Span>
            </TextBlock>
        </controls:ControlExample>

        <controls:ControlExample Margin="0,36,0,0" HeaderText="A TextBlock with an inline Fluent Symbol.">
            <controls:ControlExample.XamlCode>
                &lt;TextBlock&gt;\n
                \t&lt;ui:SymbolSpan Symbol=&quot;Document24&quot; Filled=&quot;True&quot; FontSize=&quot;16&quot; /&gt;\n
                \t&lt;Run Text=&quot; Document.txt&quot; /&gt;\n
                &lt;/TextBlock&gt;
            </controls:ControlExample.XamlCode>
            <TextBlock>
                <Run Foreground="{ui:DynamicBrush TextFillTertiary}" Text="file:" />
                <ui:SymbolSpan
                    Filled="True"
                    FontSize="16"
                    Foreground="{ui:DynamicBrush PaletteBlueGrey}"
                    Symbol="Document24" />
                <Run Text="Document.txt" />
            </TextBlock>
        </controls:ControlExample>
    </StackPanel>
</Page>
