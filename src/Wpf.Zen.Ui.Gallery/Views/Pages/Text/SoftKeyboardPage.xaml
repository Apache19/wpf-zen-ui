<Page
    x:Class="Wpf.Zen.Ui.Gallery.Views.Pages.Text.SoftKeyboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:keyboard="http://schemas.thezendev.com/wpf/2027/virtual-input"
    xmlns:keyboardExt="clr-namespace:Wpf.Zen.Ui.VirtualInput.Extensions;assembly=Wpf.Zen.Ui.VirtualInput.Extensions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    xmlns:vm="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Pages.Text"
    Title="SoftKeyboardPage"
    controls:PageControlDocumentation.DocumentationType="{x:Type keyboard:SoftKeyboard}"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DataContext="{d:DesignInstance vm:SoftKeyboardViewModel, IsDesignTimeCreatable=False}"
    d:DesignWidth="900"
    ui:NavigationView.IsNavigationFrameScrollEnabled="True"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    mc:Ignorable="d">

    <StackPanel Margin="0,0,0,24">
        <controls:ControlExample HeaderText="Embedded keyboard with automatic target tracking and input-scope-aware layouts." XamlCode="&lt;ui:TextBox InputScope=&quot;TelephoneNumber&quot; /&gt;&#xA;&lt;ui:TextBox InputScope=&quot;Number&quot; /&gt;&#xA;&lt;ui:TextBox InputScope=&quot;EmailSmtpAddress&quot; /&gt;&#xA;&lt;keyboard:SoftKeyboard IsOpen=&quot;True&quot; TargetScope=&quot;{Binding ElementName=FormScope}&quot; /&gt;">
            <Grid x:Name="FormScope">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <WrapPanel>
                    <ui:TextBox
                        Width="260"
                        Margin="0,0,12,10"
                        InputScope="Default"
                        PlaceholderText="Text / IME composition" />
                    <ui:TextBox
                        Width="260"
                        Margin="0,0,12,10"
                        InputScope="TelephoneNumber"
                        PlaceholderText="Telephone number" />
                    <ui:TextBox
                        Width="260"
                        Margin="0,0,12,10"
                        InputScope="Number"
                        PlaceholderText="Decimal number" />
                    <ui:TextBox
                        Width="260"
                        Margin="0,0,12,10"
                        InputScope="Digits"
                        PlaceholderText="Digits" />
                    <ui:TextBox
                        Width="260"
                        Margin="0,0,12,10"
                        InputScope="CurrencyAmount"
                        PlaceholderText="Currency amount" />
                    <ui:TextBox
                        Width="260"
                        Margin="0,0,12,10"
                        InputScope="EmailSmtpAddress"
                        PlaceholderText="Email address" />
                    <ui:TextBox
                        Width="260"
                        Margin="0,0,12,10"
                        InputScope="Url"
                        PlaceholderText="Website URL" />
                    <ui:PasswordBox
                        Width="260"
                        Margin="0,0,12,10"
                        PlaceholderText="Password" />
                </WrapPanel>

                <ui:RichTextBox
                    Grid.Row="2"
                    Width="480"
                    Height="80"
                    HorizontalAlignment="Left" />

                <StackPanel
                    Grid.Row="6"
                    HorizontalAlignment="Left">
                    <WrapPanel>
                        <CheckBox
                            Margin="0,0,24,0"
                            Content="Keyboard open"
                            IsChecked="{Binding IsOpen, ElementName=Keyboard, Mode=TwoWay}" />
                        <CheckBox
                            x:Name="CandidateWindowBoundsCheckBox"
                            Checked="OnCandidateWindowBoundsChecked"
                            Content="Outline native window below pointer"
                            Unchecked="OnCandidateWindowBoundsUnchecked" />
                    </WrapPanel>
                    <TextBlock
                        x:Name="CandidateWindowDiagnosticStatus"
                        Margin="0,6,0,0"
                        FontFamily="Consolas"
                        Text="Enable the outline, then move the pointer over the blocked key area."
                        TextWrapping="Wrap" />
                </StackPanel>

                <keyboard:SoftKeyboard
                    x:Name="Keyboard"
                    Grid.Row="4"
                    AutoHideMode="Manual"
                    AutoShowMode="TouchAndPen"
                    ExtensionProvider="{x:Static keyboardExt:DefaultSoftKeyboardExtensionProvider.Default}"
                    IsOpen="True"
                    TargetScope="{Binding ElementName=FormScope}" />
            </Grid>
        </controls:ControlExample>

        <ui:TextBlock Margin="0,24,0,0" TextWrapping="Wrap">
            The keyboard remains part of page layout, keeps focus in the active editor, hides the
            window-scoped Windows input pane when supported, and falls back to native IME candidate
            UI when a text service does not expose a controllable UI-less candidate element.
        </ui:TextBlock>
    </StackPanel>
</Page>
