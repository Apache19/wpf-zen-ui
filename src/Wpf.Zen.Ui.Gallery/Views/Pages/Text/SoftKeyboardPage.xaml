<Page
    x:Class="Wpf.Zen.Ui.Gallery.Views.Pages.Text.SoftKeyboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    xmlns:vm="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Pages.Text"
    Title="SoftKeyboardPage"
    controls:PageControlDocumentation.DocumentationType="{x:Type ui:SoftKeyboard}"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DataContext="{d:DesignInstance vm:SoftKeyboardViewModel, IsDesignTimeCreatable=False}"
    d:DesignWidth="900"
    ui:NavigationView.IsNavigationFrameScrollEnabled="True"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    mc:Ignorable="d">

    <StackPanel Margin="0,0,0,24">
        <controls:ControlExample HeaderText="Embedded keyboard with automatic target tracking." XamlCode="&lt;ui:SoftKeyboard IsOpen=&quot;True&quot; TargetScope=&quot;{Binding ElementName=FormScope}&quot; /&gt;">
            <Grid x:Name="FormScope" MinWidth="560">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ui:TextBox
                    x:Name="NameEditor"
                    MinWidth="320"
                    HorizontalAlignment="Left"
                    PlaceholderText="Name or IME composition" />
                <ui:PasswordBox
                    Grid.Row="2"
                    MinWidth="320"
                    HorizontalAlignment="Left"
                    PlaceholderText="Password" />
                <ui:RichTextBox
                    Grid.Row="4"
                    Width="480"
                    Height="80"
                    HorizontalAlignment="Left" />

                <CheckBox
                    Grid.Row="6"
                    HorizontalAlignment="Left"
                    Content="Keyboard open"
                    IsChecked="{Binding IsOpen, ElementName=Keyboard, Mode=TwoWay}" />

                <ui:SoftKeyboard
                    x:Name="Keyboard"
                    Grid.Row="8"
                    AutoShowMode="TouchAndPen"
                    IsOpen="True"
                    TargetScope="{Binding ElementName=FormScope}" />
            </Grid>
        </controls:ControlExample>

        <ui:TextBlock Margin="0,24,0,0" TextWrapping="Wrap">
            The keyboard remains part of page layout, keeps focus in the active editor, hides the
            window-scoped Windows input pane when supported, and falls back to native IME candidate
            UI when a text service does not expose a controllable UI-less candidate element.
        </ui:TextBlock>
    </StackPanel>
</Page>
