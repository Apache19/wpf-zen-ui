<Page
    x:Class="Wpf.Zen.Ui.Gallery.Views.Pages.Text.AutoSuggestBoxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    xmlns:vm="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Pages.Text"
    Title="AutoSuggestBoxPage"
    controls:PageControlDocumentation.DocumentationType="{x:Type ui:AutoSuggestBox}"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DataContext="{d:DesignInstance vm:AutoSuggestBoxViewModel, IsDesignTimeCreatable=False}"
    d:DesignWidth="800"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    Style="{ui:DynamicStyle DynamicScrollPage}"
    mc:Ignorable="d">

    <controls:ControlExample
        Margin="0"
        HeaderText="WPF Zen UI AutoSuggestBox."
        XamlCode="&lt;ui:AutoSuggestBox Icon=&quot;{ui:FluentIconSource Search24}&quot; OriginalItemsSource=&quot;{Binding AutoSuggestBoxSuggestions, Mode=OneWay}&quot; PlaceholderText=&quot;Search...&quot; ClearButtonEnabled=&quot;{Binding ShowClearButtonDisabled, Converter={StaticResource BoolInvertConverter}}&quot; /&gt;">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:AutoSuggestBox
                Grid.Column="0"
                MinWidth="250"
                HorizontalAlignment="Left"
                ClearButtonEnabled="{Binding ShowClearButtonDisabled, Converter={StaticResource BoolInvertConverter}}"
                ui:IconAssist.Icon="{ui:FluentIconSource Search24}"
                OriginalItemsSource="{Binding AutoSuggestBoxSuggestions, Mode=OneWay}"
                PlaceholderText="Search..." />
            <CheckBox
                Grid.Column="1"
                Content="Show clear button"
                IsChecked="{Binding ShowClearButtonDisabled}" />
        </Grid>
    </controls:ControlExample>
</Page>
