<Page
    x:Class="Wpf.Zen.Ui.Gallery.Views.Pages.Text.PasswordBoxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Zen.Ui.Gallery.Views.Pages.Text"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    xmlns:vm="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Pages.Text"
    Title="PasswordBoxPage"
    controls:PageControlDocumentation.DocumentationType="{x:Type ui:PasswordBox}"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DataContext="{d:DesignInstance vm:PasswordBoxViewModel, IsDesignTimeCreatable=False}"
    d:DesignWidth="800"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    ui:NavigationView.IsNavigationFrameScrollEnabled="True"
    mc:Ignorable="d">

    <StackPanel Margin="0,0,0,24">
        <controls:ControlExample
            Margin="0"
            HeaderText="A simple PasswordBox."
            XamlCode="&lt;PasswordBox /&gt;">
            <PasswordBox MinWidth="250" HorizontalAlignment="Left" />
        </controls:ControlExample>

        <controls:ControlExample
            Margin="0,36,0,0"
            HeaderText="WPF Zen UI PasswordBox."
            XamlCode="&lt;ui:PasswordBox PlaceholderText=&quot;Password...&quot; Icon=&quot;Password24&quot; /&gt;">
            <ui:PasswordBox
                MinWidth="250"
                HorizontalAlignment="Left"
                ui:IconAssist.Icon="{ui:FluentIconSource Password24}"
                PlaceholderEnabled="True"
                PlaceholderText="Password..." />
        </controls:ControlExample>
    </StackPanel>
</Page>
