<Page
    x:Class="Wpf.Zen.Ui.Gallery.Views.Pages.Collections.ListBoxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    xmlns:vm="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Pages.Collections"
    Title="ListBoxPage"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DataContext="{d:DesignInstance vm:ListBoxViewModel, IsDesignTimeCreatable=False}"
    d:DesignWidth="800"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    ui:NavigationView.IsNavigationFrameScrollEnabled="True"
    mc:Ignorable="d">

    <StackPanel Margin="0,0,0,24">
        <controls:ControlExample Margin="0" HeaderText="ListBox with items defined inline.">
            <controls:ControlExample.XamlCode>
                &lt;ListBox&gt;\n
                \t&lt;ListBoxItem Content=&quot;Blue&quot;/&gt;\n
                \t&lt;ListBoxItem Content=&quot;Green&quot;/&gt;\n
                &lt;/ListBox&gt;
            </controls:ControlExample.XamlCode>
            <ui:ListBox SelectedIndex="0">
                <ListBoxItem>Blue</ListBoxItem>
                <ListBoxItem>Green</ListBoxItem>
                <ListBoxItem>Red</ListBoxItem>
                <ListBoxItem>Yellow</ListBoxItem>
            </ui:ListBox>
        </controls:ControlExample>

        <controls:ControlExample
            Margin="0,36,0,0"
            HeaderText="A ListBox with its ItemsSource and Height set."
            XamlCode="&lt;ListBox Height=&quot;100&quot; ItemsSource=&quot;{Binding ListBoxItems}&quot; /&gt;">
            <ui:ListBox
                Height="164"
                ItemsSource="{Binding ListBoxItems, Mode=TwoWay}"
                SelectedIndex="2" />
        </controls:ControlExample>
    </StackPanel>
</Page>
