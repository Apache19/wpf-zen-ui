<Page
    x:Class="Wpf.Zen.Ui.Gallery.Views.Pages.Collections.DataGridPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    xmlns:vm="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Pages.Collections"
    Title="DataGridPage"
    controls:PageControlDocumentation.DocumentationType="{x:Type ui:DataGrid}"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DataContext="{d:DesignInstance vm:DataGridViewModel, IsDesignTimeCreatable=False}"
    d:DesignWidth="800"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    ui:NavigationView.IsNavigationFrameScrollEnabled="True"
    mc:Ignorable="d">
    <Page.Resources>
        <system:String x:Key="PageXamlUrl">https://github.com/apachezy/wpfui/blob/development/src/Wpf.Zen.Ui/Resources/Controls/DataGrid.xaml</system:String>
        <system:String x:Key="PageCsharpUrl">https://github.com/dotnet/wpf/blob/main/src/Microsoft.DotNet.Wpf/src/PresentationFramework/System/Windows/Controls/DataGrid.cs</system:String>
    </Page.Resources>

    <StackPanel Margin="0,0,0,24">
        <controls:ControlExample
            Margin="0"
            HeaderText="Standard DataGrid with ItemsSource."
            XamlCode="&lt;DataGrid ItemsSource=&quot;{Binding ProductsCollection, Mode=TwoWay}&quot; /&gt;">
            <DataGrid Height="400" ItemsSource="{Binding ProductsCollection, Mode=TwoWay}" />
        </controls:ControlExample>

        <controls:ControlExample
            Margin="0,36,0,0"
            HeaderText="WPF Zen UI DataGrid with ItemsSource."
            XamlCode="&lt;ui:DataGrid ItemsSource=&quot;{Binding ProductsCollection, Mode=TwoWay}&quot; /&gt;">
            <ui:DataGrid
                Height="400"
                ItemsSource="{Binding ProductsCollection, Mode=TwoWay}"
                SelectionMode="Single"
                SelectionUnit="CellOrRowHeader" />
        </controls:ControlExample>
    </StackPanel>
</Page>
