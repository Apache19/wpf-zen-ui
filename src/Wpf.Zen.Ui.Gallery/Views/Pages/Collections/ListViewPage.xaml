<Page
    x:Class="Wpf.Zen.Ui.Gallery.Views.Pages.Collections.ListViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Wpf.Zen.Ui.Gallery.Models"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    xmlns:vm="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Pages.Collections"
    Title="ListViewPage"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DataContext="{d:DesignInstance vm:ListViewViewModel, IsDesignTimeCreatable=False}"
    d:DesignWidth="800"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    ui:NavigationView.IsNavigationFrameScrollEnabled="True"
    mc:Ignorable="d">

    <StackPanel Margin="0,0,0,24">
        <controls:ControlExample Margin="0" HeaderText="Basic ListView with Simple DataTemplate.">
            <controls:ControlExample.XamlCode>
                &lt;ListView ItemsSource=&quot;{Binding ViewModel.MyCollection}&quot;&gt;&lt;&gt;\n
                \t&lt;ListView.ItemTemplate&gt;\n
                \t\t&lt;DataTemplate DataType=&quot;{x:Type models:Person}&quot; &gt;\n
                \t\t\t&lt;TextBlock Margin=&quot;8,4&quot; Text=&quot;{Binding Name}&quot;/&gt;\n
                \t\t&lt;/DataTemplate&gt;\n
                \t&lt;/ListView.ItemTemplate&gt;\n
                &lt;/ListView&gt;
            </controls:ControlExample.XamlCode>
            <ui:ListView
                MaxHeight="200"
                d:ItemsSource="{d:SampleData ItemCount=5}"
                ItemsSource="{Binding BasicListViewItems, Mode=TwoWay}"
                SelectedIndex="2"
                SelectionMode="Single">
                <ui:ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:Person}">
                        <ui:TextBlock Margin="6,4" Text="{Binding Name, Mode=OneWay}" />
                    </DataTemplate>
                </ui:ListView.ItemTemplate>
            </ui:ListView>
        </controls:ControlExample>

        <controls:ControlExample Margin="0,36,0,0" HeaderText="ListView with Selection Support.">
            <controls:ControlExample.XamlCode>
                &lt;ListView ItemsSource=&quot;{Binding ViewModel.MyCollection}&quot;&gt;&lt;&gt;\n
                \t&lt;ListView.ItemTemplate&gt;\n
                \t\t&lt;DataTemplate DataType=&quot;{x:Type models:Person}&quot; &gt;\n
                \t\t\t&lt;TextBlock Margin=&quot;0,5,0,5&quot; Text=&quot;{Binding Name}&quot;/&gt;\n
                \t\t&lt;/DataTemplate&gt;\n
                \t&lt;/ListView.ItemTemplate&gt;\n
                &lt;/ListView&gt;
            </controls:ControlExample.XamlCode>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:ListView
                    Grid.Column="0"
                    MaxHeight="200"
                    d:ItemsSource="{d:SampleData ItemCount=5}"
                    ItemsSource="{Binding BasicListViewItems, Mode=TwoWay}"
                    SelectedIndex="1"
                    SelectionMode="{Binding ListViewSelectionMode, Mode=OneWay}">
                    <ui:ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Person}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse
                                    x:Name="Ellipse"
                                    Grid.RowSpan="2"
                                    Width="32"
                                    Height="32"
                                    Margin="6"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Fill="{ui:DynamicBrush ControlStrongStrokeDefault}" />
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="12,6,0,0"
                                    FontWeight="Bold"
                                    Text="{Binding Name, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="12,0,0,6"
                                    Foreground="{ui:DynamicBrush TextFillSecondary}"
                                    Text="{Binding Company, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ui:ListView.ItemTemplate>
                </ui:ListView>
                <StackPanel
                    Grid.Column="1"
                    MinWidth="120"
                    Margin="12,0,0,0"
                    VerticalAlignment="Top">
                    <Label Content="Selection mode" Target="{Binding ElementName=SelectionModeComboBox}" />
                    <ComboBox x:Name="SelectionModeComboBox" SelectedIndex="{Binding ListViewSelectionModeComboBoxSelectedIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Single" />
                        <ComboBoxItem Content="Multiple" />
                        <ComboBoxItem Content="Extended" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </controls:ControlExample>

        <controls:ControlExample Margin="0,36,0,0" HeaderText="ListView with GridView">
            <controls:ControlExample.XamlCode>
                &lt;ListView ItemsSource=&quot;{Binding ViewModel.BasicListViewItems}&quot;&gt;\n
                \t&lt;ListView.View&gt;\n
                \t\t&lt;ui:GridView&gt;\n
                \t\t\t&lt;ui:GridViewColumn Width=&quot;*&quot; DisplayMemberBinding=&quot;{Binding FirstName}&quot; Header=&quot;First Name&quot;/&gt;\n
                \t\t\t&lt;ui:GridViewColumn Width=&quot;*&quot; DisplayMemberBinding=&quot;{Binding LastName}&quot; Header=&quot;Last Name&quot;/&gt;\n
                \t\t\t&lt;ui:GridViewColumn Width=&quot;1.3*&quot; DisplayMemberBinding=&quot;{Binding Name}&quot; Header=&quot;Full Name&quot;/&gt;\n
                \t\t\t&lt;ui:GridViewColumn Width=&quot;2*&quot; DisplayMemberBinding=&quot;{Binding Company}&quot; Header=&quot;Company&quot;/&gt;\n
                \t\t\t&lt;ui:GridViewColumn Width=&quot;*&quot; DisplayMemberBinding=&quot;{Binding Email}&quot; Header=&quot;Email&quot;/&gt;\n
                \t\t&lt;/ui:GridView&gt;\n
                \t&lt;/ListView.View&gt;\n
                &lt;/ListView&gt;
            </controls:ControlExample.XamlCode>
            <ui:ListView
                MaxHeight="238"
                d:ItemsSource="{d:SampleData ItemCount=10}"
                d:SelectedIndex="4"
                ui:UiScrollViewer.ScrollSpillMode="Disabled"
                BorderThickness="1"
                ItemsSource="{Binding BasicListViewItems, Mode=TwoWay}"
                ScrollViewer.CanContentScroll="False">
                <ui:ListView.Style>
                    <Style TargetType="{x:Type ui:ListView}">
                        <Setter Property="Border.CornerRadius" Value="8" />
                        <Setter Property="ItemContainerStyleSelector">
                            <Setter.Value>
                                <ui:ListItemContainerStyleSelector>
                                    <ui:ListItemContainerStyleSelector.LastItemStyle>
                                        <Style TargetType="{x:Type ListViewItem}">
                                            <Setter Property="BorderThickness" Value="0" />
                                        </Style>
                                    </ui:ListItemContainerStyleSelector.LastItemStyle>
                                </ui:ListItemContainerStyleSelector>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ui:ListView.Style>
                <ui:ListView.View>
                    <ui:GridView>
                        <ui:GridViewColumn
                            Width="*"
                            DisplayMemberBinding="{Binding FirstName}"
                            Header="First Name" />
                        <ui:GridViewColumn
                            Width="*"
                            DisplayMemberBinding="{Binding LastName}"
                            Header="Last Name" />
                        <ui:GridViewColumn
                            Width="1.3*"
                            DisplayMemberBinding="{Binding Name}"
                            Header="Full Name" />
                        <ui:GridViewColumn
                            Width="1.8*"
                            DisplayMemberBinding="{Binding Company}"
                            Header="Company" />
                        <ui:GridViewColumn
                            Width="2*"
                            DisplayMemberBinding="{Binding Email}"
                            Header="Email" />
                    </ui:GridView>
                </ui:ListView.View>
            </ui:ListView>
        </controls:ControlExample>
    </StackPanel>
</Page>
