<Page
    x:Class="Wpf.Zen.Ui.Gallery.Views.Pages.Collections.VirtualizingWrapPanelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Wpf.Zen.Ui.Gallery.Models"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    xmlns:vm="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Pages.Collections"
    Title="VirtualizingWrapPanelPage"
    controls:PageControlDocumentation.Show="False"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DataContext="{d:DesignInstance vm:VirtualizingWrapPanelViewModel, IsDesignTimeCreatable=True}"
    d:DesignHeight="760"
    d:DesignWidth="1100"
    ui:NavigationView.IsNavigationFrameScrollEnabled="False"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    mc:Ignorable="d">

    <Page.Resources>
        <!--
            A small tiled circuit pattern provides recognizable poster texture without introducing
            image assets. Keeping it as one shared DrawingBrush also avoids per-item bitmap memory.
        -->
        <DrawingBrush
            x:Key="CircuitTextureBrush"
            TileMode="Tile"
            Viewport="0,0,48,48"
            ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#3CFFFFFF" Thickness="1" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0,8" EndPoint="20,8" />
                                <LineGeometry StartPoint="20,8" EndPoint="28,16" />
                                <LineGeometry StartPoint="28,16" EndPoint="48,16" />
                                <LineGeometry StartPoint="8,48" EndPoint="8,28" />
                                <LineGeometry StartPoint="8,28" EndPoint="16,20" />
                                <LineGeometry StartPoint="16,20" EndPoint="16,0" />
                                <EllipseGeometry
                                    Center="28,16"
                                    RadiusX="2"
                                    RadiusY="2" />
                                <EllipseGeometry
                                    Center="8,28"
                                    RadiusX="2"
                                    RadiusY="2" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <LinearGradientBrush x:Key="PosterFadeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#00000000" />
            <GradientStop Offset="0.28" Color="#60000000" />
            <GradientStop Offset="1" Color="#E9000000" />
        </LinearGradientBrush>

        <Style x:Key="MetricPillStyle" TargetType="{x:Type Border}">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="{ui:DynamicBrush CardBackgroundFillDefault}" />
            <Setter Property="BorderBrush" Value="{ui:DynamicBrush CardStrokeDefault}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
    </Page.Resources>

    <Grid Margin="0,0,0,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="Movie library" />
                <TextBlock
                    MaxWidth="660"
                    Margin="0,7,0,0"
                    HorizontalAlignment="Left"
                    Foreground="{ui:DynamicBrush TextFillSecondary}"
                    Text="Resize the gallery window to watch the panel choose a new column count and distribute the available width across uniformly sized portrait cards."
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Grid.Column="1"
                Margin="24,2,0,0"
                Padding="12,7"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="#1824D7C8"
                BorderBrush="#6624D7C8"
                BorderThickness="1"
                CornerRadius="16">
                <StackPanel Orientation="Horizontal">
                    <Ellipse
                        Width="7"
                        Height="7"
                        Margin="0,0,7,0"
                        VerticalAlignment="Center"
                        Fill="#49F3D0" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#49F3D0"
                        Text="LIVE LAYOUT" />
                </StackPanel>
            </Border>
        </Grid>

        <WrapPanel
            x:Name="LayoutMetrics"
            Grid.Row="1"
            Margin="0,0,0,10">
            <CheckBox
                x:Name="SmoothScrollingToggle"
                Margin="0,0,16,8"
                VerticalAlignment="Center"
                Content="Smooth scrolling"
                IsChecked="True" />
            <Border Style="{StaticResource MetricPillStyle}">
                <TextBlock>
                    <Run Foreground="{ui:DynamicBrush TextFillSecondary}" Text="MODE  " />
                    <Run FontWeight="SemiBold" Text="{Binding ActualItemSizingMode, Mode=OneWay}" />
                </TextBlock>
            </Border>
            <Border Style="{StaticResource MetricPillStyle}">
                <TextBlock>
                    <Run Foreground="{ui:DynamicBrush TextFillSecondary}" Text="COLUMNS  " />
                    <Run FontWeight="SemiBold" Text="{Binding Columns, Mode=OneWay}" />
                </TextBlock>
            </Border>
            <Border Style="{StaticResource MetricPillStyle}">
                <TextBlock>
                    <Run Foreground="{ui:DynamicBrush TextFillSecondary}" Text="ITEM  " />
                    <Run FontWeight="SemiBold">
                        <Run.Text>
                            <MultiBinding StringFormat="{}{0:F0} × {1:F0} DIPs">
                                <Binding Mode="OneWay" Path="ActualItemWidth" />
                                <Binding Mode="OneWay" Path="ActualItemHeight" />
                            </MultiBinding>
                        </Run.Text>
                    </Run>
                </TextBlock>
            </Border>
            <Border Style="{StaticResource MetricPillStyle}">
                <TextBlock>
                    <Run Foreground="{ui:DynamicBrush TextFillSecondary}" Text="VIRTUALIZATION  " />
                    <Run FontWeight="SemiBold" Text="{Binding IsVirtualizationActive, Mode=OneWay}" />
                </TextBlock>
            </Border>
        </WrapPanel>

        <Border
            Grid.Row="2"
            MinHeight="280"
            Padding="8"
            Background="{ui:DynamicBrush CardBackgroundFillSecondary}"
            BorderBrush="{ui:DynamicBrush CardStrokeDefault}"
            BorderThickness="1"
            CornerRadius="12">
            <!--
                The page disables navigation-frame scrolling and gives this ItemsControl the
                remaining finite height. VirtualizingWrapPanel can therefore derive a real viewport
                and recycle rows instead of being measured to the full catalogue height.
            -->
            <ItemsControl
                ui:PassiveScrollViewer.IsSmoothScrollingEnabled="{Binding IsChecked, ElementName=SmoothScrollingToggle}"
                ItemsSource="{Binding Movies, Mode=OneWay}"
                Loaded="HandleMovieItemsControlLoaded"
                ScrollViewer.CanContentScroll="True"
                VirtualizingPanel.CacheLength="1"
                VirtualizingPanel.CacheLengthUnit="Page"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.ScrollUnit="Pixel"
                VirtualizingPanel.VirtualizationMode="Recycling">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="{x:Type ItemsControl}">
                        <ui:PassiveScrollViewer
                            Padding="0,0,12,0"
                            CanContentScroll="True"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </ui:PassiveScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!--
                            Width constraints opt into responsive sizing. The portrait ratio derives
                            height from each calculated width, so a resize changes both dimensions
                            without card-specific converters or size-change handlers.
                        -->
                        <ui:VirtualizingWrapPanel
                            x:Name="MoviePanel"
                            HorizontalSpacing="8"
                            ItemAspectRatio="0.64"
                            ItemsAlignment="Center"
                            MaximumItemWidth="220"
                            MinimumItemWidth="150"
                            VerticalSpacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:MoviePoster}">
                        <ui:ClippingBorder
                            Background="{Binding PosterBrush, Mode=OneTime}"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                            <Grid ClipToBounds="True">
                                <Rectangle Fill="{StaticResource CircuitTextureBrush}" Opacity="0.55" />

                                <Viewbox Stretch="Fill">
                                    <Canvas Width="240" Height="360">
                                        <Ellipse
                                            Canvas.Left="106"
                                            Canvas.Top="24"
                                            Width="176"
                                            Height="176"
                                            Fill="#22FFFFFF" />
                                        <Ellipse
                                            Canvas.Left="132"
                                            Canvas.Top="50"
                                            Width="124"
                                            Height="124"
                                            Stroke="#55FFFFFF"
                                            StrokeThickness="2" />
                                        <Path Data="M 0,245 L 78,158 L 121,202 L 185,112 L 240,180 L 240,360 L 0,360 Z" Fill="#20FFFFFF" />
                                        <Path
                                            Data="M -8,272 L 78,168 L 121,212 L 185,122 L 252,198"
                                            Stroke="#54FFFFFF"
                                            StrokeThickness="2" />
                                        <TextBlock
                                            Canvas.Left="16"
                                            Canvas.Top="104"
                                            FontFamily="Consolas"
                                            FontSize="82"
                                            FontWeight="Black"
                                            Foreground="#2EFFFFFF"
                                            Text="{Binding Monogram, Mode=OneTime}" />
                                    </Canvas>
                                </Viewbox>

                                <Border
                                    Margin="12"
                                    Padding="8,4"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="#52000000"
                                    BorderBrush="#4AFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <TextBlock
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="{Binding Genre, Mode=OneTime}" />
                                </Border>

                                <Border
                                    Height="148"
                                    VerticalAlignment="Bottom"
                                    Background="{StaticResource PosterFadeBrush}"
                                    CornerRadius="0 0 8 8" />

                                <Grid Margin="14" VerticalAlignment="Bottom">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        FontSize="17"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="{Binding Title, Mode=OneTime}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0,3,0,10"
                                        FontSize="11"
                                        Foreground="#CFFFFFFF"
                                        Text="{Binding Tagline, Mode=OneTime}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="#B8FFFFFF"
                                            Text="{Binding Year, Mode=OneTime}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock
                                                Margin="0,0,4,0"
                                                Foreground="#FFD766"
                                                Text="★" />
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="{Binding Rating, Mode=OneTime}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </ui:ClippingBorder>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</Page>
