<Page
    x:Class="Wpf.Zen.Ui.Gallery.Views.Pages.Media.ImagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    xmlns:vm="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Pages.Media"
    Title="ImagePage"
    controls:PageControlDocumentation.DocumentationType="{x:Type ui:Image}"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DataContext="{d:DesignInstance vm:ImageViewModel, IsDesignTimeCreatable=False}"
    d:DesignWidth="800"
    FontSize="{ui:DynamicValue DefaultThemeFontSize}"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    ui:NavigationView.IsNavigationFrameScrollEnabled="True"
    mc:Ignorable="d">
    <Page.Resources>
        <system:String x:Key="PageXamlUrl">https://github.com/dotnet/wpf</system:String>
        <system:String x:Key="PageCsharpUrl">https://github.com/dotnet/wpf/blob/main/src/Microsoft.DotNet.Wpf/src/PresentationFramework/System/Windows/Controls/Image.cs</system:String>
    </Page.Resources>

    <StackPanel Margin="0,0,0,24">
        <controls:ControlExample
            Margin="0"
            HeaderText="Standand Image from a local file."
            XamlCode="&lt;Image Height=&quot;100&quot; Source=&quot;Assets\MyImage.jpg&quot; /&gt;">
            <Image
                Height="200"
                HorizontalAlignment="Left"
                Source="pack://application:,,,/Assets/pexels-johannes-plenio-1103970.jpg" />
        </controls:ControlExample>

        <controls:ControlExample
            Margin="0,32,0,0"
            HeaderText="WPF Zen UI Image with rounded corners and color adjustment"
            XamlCode="&lt;ui:Image Brightness=&quot;{Binding Value, ElementName=BrightnessSlider}&quot;&#xA;          Contrast=&quot;{Binding Value, ElementName=ContrastSlider}&quot;&#xA;          Saturation=&quot;{Binding Value, ElementName=SaturationSlider}&quot;&#xA;          HueAngle=&quot;{Binding Value, ElementName=HueAngleSlider}&quot; /&gt;">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Height="204"
                    HorizontalAlignment="Left"
                    BorderBrush="#33000000"
                    BorderThickness="2"
                    CornerRadius="10">
                    <ui:Image
                        Brightness="{Binding Value, ElementName=BrightnessSlider}"
                        Contrast="{Binding Value, ElementName=ContrastSlider}"
                        CornerRadius="9"
                        HueAngle="{Binding Value, ElementName=HueAngleSlider}"
                        Saturation="{Binding Value, ElementName=SaturationSlider}"
                        Source="pack://application:,,,/Assets/pexels-johannes-plenio-1103970.jpg" />
                </Border>

                <StackPanel
                    Grid.Column="1"
                    MinWidth="200"
                    Margin="32,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=BrightnessSlider, StringFormat=F2}" />
                        <TextBlock Text="Brightness" />
                    </DockPanel>
                    <ui:Slider
                        x:Name="BrightnessSlider"
                        Margin="0,0,0,12"
                        Maximum="2"
                        Minimum="0"
                        TickFrequency="0.05"
                        Value="1.05" />

                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=ContrastSlider, StringFormat=F2}" />
                        <TextBlock Text="Contrast" />
                    </DockPanel>
                    <ui:Slider
                        x:Name="ContrastSlider"
                        Margin="0,0,0,12"
                        Maximum="2"
                        Minimum="0"
                        TickFrequency="0.05"
                        Value="1.1" />

                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=SaturationSlider, StringFormat=F2}" />
                        <TextBlock Text="Saturation" />
                    </DockPanel>
                    <ui:Slider
                        x:Name="SaturationSlider"
                        Margin="0,0,0,12"
                        Maximum="2"
                        Minimum="0"
                        TickFrequency="0.05"
                        Value="0.75" />

                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=HueAngleSlider, StringFormat={}{0:F0}°}" />
                        <TextBlock Text="Hue angle" />
                    </DockPanel>
                    <ui:Slider
                        x:Name="HueAngleSlider"
                        Maximum="180"
                        Minimum="-180"
                        TickFrequency="1"
                        Value="0" />
                </StackPanel>
            </Grid>
        </controls:ControlExample>
    </StackPanel>
</Page>
