<Page
    x:Class="Wpf.Zen.Ui.Gallery.Views.Pages.Samples.MultilevelNavigationSamplePage3"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:samples1="clr-namespace:Wpf.Zen.Ui.Gallery.Views.Pages.Samples"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    xmlns:vm="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Pages.Navigation"
    Title="MultilevelNavigationSamplePage"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DataContext="{d:DesignInstance vm:MultilevelNavigationSample, IsDesignTimeCreatable=False}"
    d:DesignHeight="400"
    d:DesignWidth="600"
    ui:NavigationView.BreadcrumbContent="Page 3"
    FontSize="{ui:DynamicValue DefaultThemeFontSize}"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    ui:NavigationView.IsNavigationFrameScrollEnabled="True"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="1.2*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ui:TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,0,0,10"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            FontSize="20"
            Text="Third page." />

        <ui:Button
            Grid.Row="1"
            Grid.Column="0"
            Width="72"
            Height="48"
            Margin="0,10,18,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Command="{Binding NavigateBackCommand}"
            FontSize="24"
            Icon="{ui:FluentIconSource ArrowLeft24}" />

        <ui:Button
            Grid.Row="1"
            Grid.Column="1"
            Width="72"
            Height="48"
            Margin="18,10,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Command="{Binding NavigateForwardCommand}"
            CommandParameter="{x:Type samples1:MultilevelNavigationSamplePage1}"
            FontSize="24"
            Icon="{ui:FluentIconSource ArrowHookUpLeft24}" />
    </Grid>
</Page>
