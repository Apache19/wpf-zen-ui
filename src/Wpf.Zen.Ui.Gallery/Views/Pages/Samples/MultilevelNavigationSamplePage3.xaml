<Page
    x:Class="Wpf.Zen.Ui.Gallery.Views.Pages.Samples.MultilevelNavigationSamplePage3"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Zen.Ui.Gallery.Views.Pages.Samples"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    xmlns:vm="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Pages.Navigation"
    Title="MultilevelNavigationSamplePage3"
    d:DataContext="{d:DesignInstance vm:MultilevelNavigationSample,
                                     IsDesignTimeCreatable=False}"
    d:DesignWidth="800"
    d:Background="{ui:DynamicBrush WindowBackground}"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    Style="{ui:DynamicStyle DynamicScrollPage}"
    ui:NavigationView.BreadcrumbContent="Page 3"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ui:Button
            Grid.Column="0"
            HorizontalAlignment="Center"
            Command="{Binding NavigateBackCommand}"
            Content="Navigate back"
            FontSize="24" />

        <ui:Button
            Grid.Column="1"
            HorizontalAlignment="Center"
            Command="{Binding NavigateForwardCommand}"
            CommandParameter="{x:Type local:MultilevelNavigationSamplePage1}"
            Content="Navigate to the first page"
            FontSize="24" />
    </Grid>
</Page>
