<Page
    x:Class="Wpf.Zen.Ui.Gallery.Views.Pages.DateAndTime.DatePickerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    xmlns:vm="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Pages.DateAndTime"
    Title="DatePickerPage"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DataContext="{d:DesignInstance vm:DatePickerViewModel, IsDesignTimeCreatable=False}"
    d:DesignWidth="800"
    ui:NavigationView.IsNavigationFrameScrollEnabled="True"
    FontSize="{ui:DynamicValue DefaultThemeFontSize}"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    mc:Ignorable="d">

    <StackPanel Margin="0,0,0,24">
        <controls:ControlExample Margin="0" HeaderText="A basic DatePicker control.">
            <controls:ControlExample.XamlCode>
                &lt;DatePicker/&gt;
            </controls:ControlExample.XamlCode>
            <DatePicker MinWidth="250" HorizontalAlignment="Left" />
        </controls:ControlExample>
        <controls:ControlExample Margin="0,24,0,0" HeaderText="Date and time with explicit OK / Cancel.">
            <controls:ControlExample.XamlCode>
                &lt;ui:DateTimePicker SelectedDateTime="{Binding SelectedDateTime, Mode=TwoWay}"
                DateTimeFormat="yyyy-MM-dd HH:mm:ss"
                ui:PlaceholderService.Content="请选择日期和时间" Language="zh-CN" /&gt;
            </controls:ControlExample.XamlCode>
            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                <ui:DateTimePicker
                    x:Name="DateTimeSample"
                    Width="280"
                    Margin="0,0,8,0"
                    ui:PlaceholderService.Content="请选择日期和时间"
                    FirstDayOfWeek="Monday"
                    Language="zh-CN" />
                <TextBlock VerticalAlignment="Center" Text="{Binding SelectedDateTime, ElementName=DateTimeSample, StringFormat={}{0:O}, TargetNullValue=(null)}" />
            </StackPanel>
        </controls:ControlExample>
        <controls:ControlExample Margin="0,24,0,0" HeaderText="Custom format and date constraints.">
            <controls:ControlExample.XamlCode>
                &lt;ui:DateTimePicker DateTimeFormat="yyyy/MM/dd HH:mm"
                DisplayDateStart="2026-01-01" DisplayDateEnd="2026-12-31" /&gt;
            </controls:ControlExample.XamlCode>
            <ui:DateTimePicker
                Width="280"
                HorizontalAlignment="Left"
                DateTimeFormat="yyyy/MM/dd HH:mm"
                DisplayDateEnd="2026-12-31"
                DisplayDateStart="2026-01-01">
                <CalendarDateRange End="2026-10-12" Start="2026-10-10" />
            </ui:DateTimePicker>
        </controls:ControlExample>
    </StackPanel>
</Page>
