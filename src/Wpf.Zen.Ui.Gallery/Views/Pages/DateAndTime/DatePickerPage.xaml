<Page
    x:Class="Wpf.Zen.Ui.Gallery.Views.Pages.DateAndTime.DatePickerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    xmlns:vm="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Pages.DateAndTime"
    Title="DatePickerPage"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DataContext="{d:DesignInstance vm:DatePickerViewModel, IsDesignTimeCreatable=False}"
    d:DesignWidth="800"
    FontSize="{ui:DynamicValue DefaultThemeFontSize}"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    ui:NavigationView.IsNavigationFrameScrollEnabled="True"
    mc:Ignorable="d">

    <Grid Margin="0,0,0,24">
        <controls:ControlExample Margin="0" HeaderText="A basic DatePicker control.">
            <controls:ControlExample.XamlCode>
                &lt;DatePicker/&gt;
            </controls:ControlExample.XamlCode>
            <DatePicker MinWidth="250" HorizontalAlignment="Left" />
        </controls:ControlExample>
    </Grid>
</Page>
