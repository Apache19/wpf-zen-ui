<Page
    x:Class="Wpf.Zen.Ui.Gallery.Views.Pages.DateAndTime.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Zen.Ui.Gallery.Views.Pages.DateAndTime"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    xmlns:vm="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Pages.DateAndTime"
    Title="CalendarPage"
    ui:NavigationView.IsNavigationFrameScrollEnabled="True"
    d:DataContext="{d:DesignInstance vm:CalendarViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignWidth="800"
    d:Background="{ui:DynamicBrush WindowBackground}"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    mc:Ignorable="d">

    <Grid Margin="0,0,0,24">
        <controls:ControlExample Margin="0" HeaderText="A basic Calendar control.">
            <controls:ControlExample.XamlCode>
                &lt;Calendar/&gt;
            </controls:ControlExample.XamlCode>
            <Calendar HorizontalAlignment="Left" />
        </controls:ControlExample>
    </Grid>
</Page>
