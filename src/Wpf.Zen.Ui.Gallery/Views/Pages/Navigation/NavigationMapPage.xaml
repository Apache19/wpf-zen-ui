<Page
    x:Class="Wpf.Zen.Ui.Gallery.Views.Pages.Navigation.NavigationMapPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    xmlns:vm="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Pages.Navigation"
    Title="NavigationMapPage"
    controls:PageControlDocumentation.DocumentationType="{x:Type ui:NavigationMapView}"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DataContext="{d:DesignInstance vm:NavigationMapViewModel, IsDesignTimeCreatable=False}"
    d:DesignHeight="600"
    d:DesignWidth="1000"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    mc:Ignorable="d">

    <Grid Margin="0,0,0,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TextBlock Text="Navigation map layout editor." />

        <Border
            Grid.Row="1"
            Background="{ui:DynamicBrush LayerFillDefault}"
            BorderBrush="{ui:DynamicBrush CardStrokeDefault}"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel ui:IconPresenter.IconSize="18" Orientation="Vertical">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type ui:Button}">
                            <Setter Property="Appearance" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </StackPanel.Resources>
                    <ToolBar Background="Transparent">
                        <ui:Button Click="OnLoadLayoutClick" Icon="{ui:FluentIconSource FolderOpen24}" />
                        <ui:Button Click="OnSaveLayoutClick" Icon="{ui:FluentIconSource Save24}" />
                        <ui:Button
                            Command="{x:Static ui:NavigationMapCommands.ResetLayout}"
                            CommandTarget="{Binding ElementName=GalleryNavigationMap}"
                            Icon="{ui:FluentIconSource ArrowCounterclockwise24}" />

                        <ui:Separator Orientation="Vertical" />

                        <ui:Button
                            Command="{x:Static ApplicationCommands.Undo}"
                            CommandTarget="{Binding ElementName=GalleryNavigationMap}"
                            Icon="{ui:FluentIconSource ArrowUndo24}"
                            ToolTip="Undo" />
                        <ui:Button
                            Command="{x:Static ApplicationCommands.Redo}"
                            CommandTarget="{Binding ElementName=GalleryNavigationMap}"
                            Icon="{ui:FluentIconSource ArrowRedo24}"
                            ToolTip="Redo" />

                        <ui:Separator Orientation="Vertical" />

                        <ui:AutoSuggestBox
                            Width="220"
                            HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="NavigationMapSearchBox"
                            Icon="{ui:FluentIconSource Search24}"
                            PlaceholderText="Search"
                            Text="{Binding SearchText, ElementName=GalleryNavigationMap, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button
                            Command="{x:Static ui:NavigationMapCommands.FindPrevious}"
                            CommandTarget="{Binding ElementName=GalleryNavigationMap}"
                            Icon="{ui:FluentIconSource ArrowUp24}"
                            ToolTip="Previous search result" />
                        <ui:Button
                            Command="{x:Static ui:NavigationMapCommands.FindNext}"
                            CommandTarget="{Binding ElementName=GalleryNavigationMap}"
                            Icon="{ui:FluentIconSource ArrowDown24}"
                            ToolTip="Next search result" />
                        <TextBlock VerticalAlignment="Center">
                            <Run Text="{Binding CurrentSearchResultIndex, ElementName=GalleryNavigationMap, Mode=OneWay}" />
                            <Run Text=" / " />
                            <Run Text="{Binding SearchResultCount, ElementName=GalleryNavigationMap, Mode=OneWay}" />
                        </TextBlock>

                        <ui:Separator Orientation="Vertical" />

                        <ui:ComboBox
                            Width="112"
                            AutomationProperties.AutomationId="NavigationMapLayoutPicker"
                            SelectedValue="{Binding LayoutMode, ElementName=GalleryNavigationMap, Mode=TwoWay}"
                            SelectedValuePath="Tag">
                            <ComboBoxItem Content="Hierarchical" Tag="{x:Static ui:NavigationMapLayoutMode.Hierarchical}" />
                            <ComboBoxItem Content="Manual" Tag="{x:Static ui:NavigationMapLayoutMode.Manual}" />
                        </ui:ComboBox>
                        <ui:ComboBox
                            Width="126"
                            Margin="0,0,14,0"
                            AutomationProperties.AutomationId="NavigationMapDirectionPicker"
                            SelectedValue="{Binding Direction, ElementName=GalleryNavigationMap, Mode=TwoWay}"
                            SelectedValuePath="Tag">
                            <ComboBoxItem Content="Top to bottom" Tag="{x:Static ui:NavigationMapDirection.TopToBottom}" />
                            <ComboBoxItem Content="Left to right" Tag="{x:Static ui:NavigationMapDirection.LeftToRight}" />
                        </ui:ComboBox>
                        <ui:Separator Orientation="Vertical" />
                        <ui:Button
                            Command="{x:Static NavigationCommands.DecreaseZoom}"
                            CommandTarget="{Binding ElementName=GalleryNavigationMap}"
                            Icon="{ui:FluentIconSource ZoomOut24}"
                            ToolTip="Zoom out" />
                        <ui:Button
                            Command="{x:Static ui:NavigationMapCommands.ZoomToFit}"
                            CommandTarget="{Binding ElementName=GalleryNavigationMap}"
                            Icon="{ui:FluentIconSource ZoomFit24}"
                            ToolTip="Zoom to fit" />
                        <ui:Button
                            Command="{x:Static NavigationCommands.IncreaseZoom}"
                            CommandTarget="{Binding ElementName=GalleryNavigationMap}"
                            Icon="{ui:FluentIconSource ZoomIn24}"
                            ToolTip="Zoom in" />
                        <TextBlock
                            Margin="0,0,14,0"
                            VerticalAlignment="Center"
                            Text="{Binding ZoomFactor, ElementName=GalleryNavigationMap, StringFormat={}{0:P0}}" />
                    </ToolBar>

                    <ToolBar Background="Transparent">
                        <ui:ToggleButton
                            Content="Edit"
                            Icon="{ui:FluentIconSource Edit24}"
                            IsChecked="{Binding IsEditing, ElementName=GalleryNavigationMap, Mode=TwoWay}">
                            <ui:ToggleButton.Style>
                                <Style TargetType="{x:Type ui:ToggleButton}">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LayoutMode, ElementName=GalleryNavigationMap}" Value="{x:Static ui:NavigationMapLayoutMode.Manual}">
                                            <Setter Property="IsEnabled" Value="True" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:ToggleButton.Style>
                        </ui:ToggleButton>
                        <ui:ToggleButton
                            Content="Snap"
                            Icon="{ui:FluentIconSource TableCellCenter24}"
                            IsChecked="{Binding SnapToGrid, ElementName=GalleryNavigationMap, Mode=TwoWay}" />
                        <ui:ToggleButton
                            Content="Grid"
                            Icon="{ui:FluentIconSource Table24}"
                            IsChecked="{Binding ShowGrid, ElementName=GalleryNavigationMap, Mode=TwoWay}" />
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Text="Grid size" />
                        <ui:NumberBox
                            Width="120"
                            Margin="0,0,14,0"
                            ClearButtonEnabled="False"
                            Maximum="64"
                            Minimum="4"
                            SmallStep="4"
                            Value="{Binding GridSize, ElementName=GalleryNavigationMap, Mode=TwoWay}" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding GridSize, ElementName=GalleryNavigationMap, Mode=OneWay}" />

                        <ui:Button
                            Command="{x:Static ApplicationCommands.SelectAll}"
                            CommandTarget="{Binding ElementName=GalleryNavigationMap}"
                            Icon="{ui:FluentIconSource SelectAllOn24}"
                            ToolTip="Select all" />
                        <ui:Button
                            Command="{x:Static ui:NavigationMapCommands.AlignToGrid}"
                            CommandTarget="{Binding ElementName=GalleryNavigationMap}"
                            Icon="{ui:FluentIconSource TableLightning24}"
                            ToolTip="Align the selection, or every node when nothing is selected" />

                        <ui:Separator Orientation="Vertical" />

                        <ui:Button
                            Command="{x:Static ui:NavigationMapCommands.AlignSelection}"
                            CommandParameter="{x:Static ui:NavigationMapAlignment.Left}"
                            CommandTarget="{Binding ElementName=GalleryNavigationMap}"
                            Icon="{ui:FluentIconSource AlignLeft24}" />
                        <ui:Button
                            Command="{x:Static ui:NavigationMapCommands.AlignSelection}"
                            CommandParameter="{x:Static ui:NavigationMapAlignment.HorizontalCenter}"
                            CommandTarget="{Binding ElementName=GalleryNavigationMap}"
                            Icon="{ui:FluentIconSource AlignCenterHorizontal24}" />
                        <ui:Button
                            Command="{x:Static ui:NavigationMapCommands.AlignSelection}"
                            CommandParameter="{x:Static ui:NavigationMapAlignment.Right}"
                            CommandTarget="{Binding ElementName=GalleryNavigationMap}"
                            Icon="{ui:FluentIconSource AlignRight24}" />
                        <ui:Button
                            Command="{x:Static ui:NavigationMapCommands.AlignSelection}"
                            CommandParameter="{x:Static ui:NavigationMapAlignment.Top}"
                            CommandTarget="{Binding ElementName=GalleryNavigationMap}"
                            Icon="{ui:FluentIconSource AlignTop24}" />
                        <ui:Button
                            Command="{x:Static ui:NavigationMapCommands.AlignSelection}"
                            CommandParameter="{x:Static ui:NavigationMapAlignment.VerticalCenter}"
                            CommandTarget="{Binding ElementName=GalleryNavigationMap}"
                            Icon="{ui:FluentIconSource AlignCenterVertical24}" />
                        <ui:Button
                            Command="{x:Static ui:NavigationMapCommands.AlignSelection}"
                            CommandParameter="{x:Static ui:NavigationMapAlignment.Bottom}"
                            CommandTarget="{Binding ElementName=GalleryNavigationMap}"
                            Icon="{ui:FluentIconSource AlignBottom24}" />

                        <!--  用 TextBox 测试绑定  -->
                        <TextBox Width="50" Text="{Binding GridSize, ElementName=GalleryNavigationMap}" />
                    </ToolBar>

                </StackPanel>

                <Border Grid.Row="1" Background="{ui:DynamicBrush CardStrokeDefault}" />

                <ui:NavigationMapView
                    x:Name="GalleryNavigationMap"
                    Grid.Row="2"
                    AutomationProperties.AutomationId="GalleryNavigationMap"
                    AutomationProperties.ItemStatus="{Binding Direction, RelativeSource={RelativeSource Self}}"
                    Command="{Binding NavigateToNodeCommand}"
                    GridSize="16"
                    IsEditing="False"
                    ItemsSource="{Binding NavigationMap, Mode=OneWay}"
                    LayoutDefinition="{Binding Layout}"
                    LayoutMode="Manual"
                    NodeWidth="168"
                    SnapToGrid="True">
                    <ui:NavigationMapView.Style>
                        <Style TargetType="{x:Type ui:NavigationMapView}">
                            <Setter Property="HorizontalSpacing" Value="22" />
                            <Setter Property="VerticalSpacing" Value="44" />
                            <Style.Triggers>
                                <Trigger Property="Direction" Value="LeftToRight">
                                    <Setter Property="HorizontalSpacing" Value="44" />
                                    <Setter Property="VerticalSpacing" Value="22" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ui:NavigationMapView.Style>
                </ui:NavigationMapView>
            </Grid>
        </Border>
        <ui:TextBlock
            x:Name="EditorStatus"
            Grid.Row="2"
            Margin="4,12,4,0"
            Foreground="{ui:DynamicBrush TextFillSecondary}"
            Text="Drag empty map space to marquee-select. Ctrl/Shift adds nodes; drag a selected node to move the group. Ctrl+A selects all, arrow keys nudge, Ctrl+wheel or Ctrl+plus/minus zooms." />
    </Grid>
</Page>
