<Page
    x:Class="Wpf.Zen.Ui.Gallery.Views.Pages.Navigation.TabControlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Zen.Ui.Gallery.Views.Pages.Navigation"
    xmlns:vm="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Pages.Navigation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    Title="TabControlPage"
    d:DataContext="{d:DesignInstance vm:TabControlViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignWidth="800"
    d:Background="{ui:DynamicBrush WindowBackground}"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    mc:Ignorable="d"
    ui:NavigationView.IsNavigationFrameScrollEnabled="True">

    <Grid Margin="0,0,0,24">
        <controls:ControlExample
            Margin="0"
            HeaderText="Standard TabControl."
            XamlCode="&lt;TabControl /&gt;">
            <ui:TabControl Margin="0,8,0,0">
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:FluentIcon Margin="0,0,6,0" Symbol="XboxConsole24" />
                            <TextBlock Text="Hello" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <TextBlock Margin="12" Text="World" />
                    </Grid>
                </TabItem>
                <TabItem IsSelected="True">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:FluentIcon Margin="0,0,6,0" Symbol="StoreMicrosoft16" />
                            <TextBlock Text="The cake" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <TextBlock Margin="12" Text="Is a lie." />
                    </Grid>
                </TabItem>
            </ui:TabControl>
        </controls:ControlExample>
    </Grid>
</Page>
