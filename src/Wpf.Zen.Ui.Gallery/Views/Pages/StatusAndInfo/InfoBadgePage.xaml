<Page
    x:Class="Wpf.Zen.Ui.Gallery.Views.Pages.StatusAndInfo.InfoBadgePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Zen.Ui.Gallery.Views.Pages.StatusAndInfo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Pages.StatusAndInfo"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    Title="InfoBadgePage"
    controls:PageControlDocumentation.DocumentationType="{x:Type ui:InfoBadge}"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DataContext="{d:DesignInstance vm:InfoBadgeViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignWidth="800"
    FontSize="{ui:DynamicValue DefaultThemeFontSize}"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    ui:NavigationView.IsNavigationFrameScrollEnabled="True"
    mc:Ignorable="d">

    <StackPanel Margin="0,0,0,24">

        <controls:ControlExample
            Margin="0,0,0,42"
            Padding="0"
            HeaderText="WPF Zen UI NavigationView.">
            <ui:NavigationView
                MinHeight="300"
                Margin="0"
                IsBackButtonVisible="Auto"
                IsPaneOpen="True"
                IsPaneToggleVisible="True"
                PaneDisplayMode="Left">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem Header="Dashboard" Icon="{ui:FluentIconSource Home24}" />
                    <ui:NavigationViewItem Header="Items" Icon="{ui:FluentIconSource Library24}">
                        <ui:NavigationViewItem.InfoBadge>
                            <ui:InfoBadge Severity="Attention" Content="3" />
                        </ui:NavigationViewItem.InfoBadge>
                    </ui:NavigationViewItem>
                </ui:NavigationView.MenuItems>
                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem Header="Settings" Icon="{ui:FluentIconSource Settings24}" />
                </ui:NavigationView.FooterMenuItems>
            </ui:NavigationView>
            <controls:ControlExample.XamlCode>
                &lt;ui:NavigationView IsBackButtonVisible=&quot;Auto&quot; &gt;\n
                \t&lt;ui:NavigationView.MenuItems&gt;\n
                \t\t&lt;ui:NavigationViewItem Header=&quot;Home&quot; Icon=&quot;Home24&quot; /&gt;\n
                \t&lt;/ui:NavigationView.MenuItems&gt;\n
                &lt;/ui:NavigationView&gt;
            </controls:ControlExample.XamlCode>
        </controls:ControlExample>
        <controls:ControlExample
            Margin="0,0,0,42"
            HeaderText="InfoBadge Content and Icon Placement"
            XamlCode="&lt;ui:InfoBadge Icon=&quot;{ui:FluentIconSource Alert16}&quot; /&gt;\n&lt;ui:InfoBadge Content=&quot;1&quot; /&gt;\n&lt;ui:InfoBadge Width=&quot;6&quot; Height=&quot;6&quot; Padding=&quot;0&quot; CornerRadius=&quot;3&quot; /&gt;">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:InfoBadge Margin="10" Icon="{ui:FluentIconSource Checkmark16}"
                                  Content="Left icon" Severity="{Binding Severity}" />
                    <ui:InfoBadge Margin="10" Icon="{ui:FluentIconSource Checkmark16}"
                                  Content="Right icon" IconPlacement="Right" Severity="{Binding Severity}" />
                    <ui:InfoBadge Margin="10" Width="48" Height="20" CornerRadius="4"
                                  Severity="{Binding Severity}" />
                    <ui:InfoBadge
                        Margin="10"
                        CornerRadius="30"
                        Icon="{ui:FluentIconSource Alert16}"
                        Severity="{Binding Severity}" />

                    <ui:InfoBadge
                        Margin="10"
                        Severity="{Binding Severity}"
                        Content="1" />

                    <ui:InfoBadge
                        Margin="10"
                        Severity="{Binding Severity}"
                        Width="6" Height="6" Padding="0" CornerRadius="3" />
                </WrapPanel>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">

                    <ui:TextBlock Text="InfoBadge Severity" />
                    <ComboBox
                        MinWidth="140"
                        Margin="0,8,0,0"
                        SelectedIndex="{Binding SeverityComboBoxSelectedIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Attention" />
                        <ComboBoxItem Content="Informational" />
                        <ComboBoxItem Content="Success" />
                        <ComboBoxItem Content="Caution" />
                        <ComboBoxItem Content="Critical" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </controls:ControlExample>
        <controls:ControlExample
            Margin="0,0,0,42"
            HeaderText="InfoBadge with Dynamic Content"
            XamlCode="&lt;ui:InfoBadge Content=&quot;{Binding Value, ElementName=ValueNumberBox}&quot; /&gt;\n&lt;ui:NumberBox x:Name=&quot;ValueNumberBox&quot; Value=&quot;1&quot; Minimum=&quot;0&quot; Maximum=&quot;100&quot; /&gt;">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:InfoBadge
                    Padding="6,0"
                    Severity="{Binding Severity}"
                    Content="{Binding Value, ElementName=ValueNumberBox}" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <ui:TextBlock Text="InfoBadge Content" />
                    <ui:NumberBox
                        x:Name="ValueNumberBox"
                        Maximum="100"
                        Minimum="0"
                        Value="1" />
                    <ui:TextBlock Text="InfoBadge Severity" />
                    <ComboBox
                        MinWidth="140"
                        Margin="0,8,0,0"
                        SelectedIndex="{Binding SeverityComboBoxSelectedIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Attention" />
                        <ComboBoxItem Content="Informational" />
                        <ComboBoxItem Content="Success" />
                        <ComboBoxItem Content="Caution" />
                        <ComboBoxItem Content="Critical" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </controls:ControlExample>
        <controls:ControlExample
            Margin="0,0,0,42"
            HeaderText="Placing an InfoBadge on a Button"
            XamlCode="&lt;ui:InfoBadge HorizontalAlignment=&quot;Right&quot; VerticalAlignment=&quot;Top&quot; Severity=&quot;Critical&quot; Width=&quot;6&quot; Height=&quot;6&quot; Padding=&quot;0&quot; CornerRadius=&quot;3&quot; /&gt;">
            <Grid>
                <ui:Button
                    Width="200"
                    Height="60"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Stretch"
                    ToolTip="Refresh required">
                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <ui:FontIcon
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            Source="{ui:FluentIconSource ArrowSync24}" />
                        <ui:InfoBadge
                            Margin="0,-10,5,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Severity="Critical"
                            Width="6" Height="6" Padding="0" CornerRadius="3" />
                    </Grid>
                </ui:Button>
            </Grid>
        </controls:ControlExample>
        <controls:ControlExample
            Margin="0,0,0,42"
            HeaderText="InfoBadge with a ContentTemplate">
            <ui:InfoBadge Content="New" Severity="Success" Padding="6,2" CornerRadius="4">
                <ui:InfoBadge.ContentTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon Margin="0,0,4,0" Source="{ui:FluentIconSource Checkmark16}" />
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ui:InfoBadge.ContentTemplate>
            </ui:InfoBadge>
        </controls:ControlExample>
        <controls:ControlExample
            Margin="0,0,0,42"
            HeaderText="Badge: Lightweight Text and Font Icons"
            XamlCode="&lt;ui:Badge Text=&quot;Ready&quot; Severity=&quot;Success&quot; /&gt;\n&lt;ui:Badge Icon=&quot;{ui:FluentIconSource Checkmark16}&quot; Severity=&quot;Success&quot; /&gt;">
            <StackPanel Orientation="Horizontal">
                <ui:Badge Margin="0,0,8,0" Text="Info" />
                <ui:Badge Margin="0,0,8,0" Text="New" Severity="Attention" />
                <ui:Badge Margin="0,0,8,0" Text="Ready" Severity="Success" />
                <ui:Badge Margin="0,0,8,0" Text="Warning" Severity="Caution" />
                <ui:Badge Margin="0,0,8,0" Text="Error" Severity="Critical" />
                <ui:Badge Margin="0,0,8,0" Icon="{ui:FluentIconSource Checkmark16}"
                          Severity="Success" Width="28" Height="28" />
                <ui:Badge Text="Right" Width="100" Height="32" Padding="8,2"
                          HorizontalContentAlignment="Right" VerticalContentAlignment="Center" />
            </StackPanel>
        </controls:ControlExample>
    </StackPanel>
</Page>
