<Page
    x:Class="Wpf.Zen.Ui.Gallery.Views.Pages.StatusAndInfo.ProgressBarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    xmlns:vm="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Pages.StatusAndInfo"
    Title="ProgressBarPage"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DataContext="{d:DesignInstance vm:ProgressBarViewModel, IsDesignTimeCreatable=False}"
    d:DesignWidth="800"
    FontSize="{ui:DynamicValue DefaultThemeFontSize}"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    ui:NavigationView.IsNavigationFrameScrollEnabled="True"
    mc:Ignorable="d">

    <controls:ControlExample
        Margin="0"
        HeaderText="An indeterminate progress bar."
        XamlCode="&lt;ProgressBar IsIndeterminate=&quot;True&quot; /&gt;">
        <ProgressBar Margin="24" IsIndeterminate="True" />
    </controls:ControlExample>
</Page>
