<Page
    x:Class="Wpf.Zen.Ui.Gallery.Views.Pages.StatusAndInfo.InfoBarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    xmlns:vm="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Pages.StatusAndInfo"
    Title="InfoBarPage"
    controls:PageControlDocumentation.DocumentationType="{x:Type ui:InfoBar}"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DataContext="{d:DesignInstance vm:InfoBarViewModel, IsDesignTimeCreatable=True}"
    d:DesignWidth="800"
    ui:NavigationView.IsNavigationFrameScrollEnabled="True"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    mc:Ignorable="d">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <StackPanel Margin="0,0,0,24">
        <controls:ControlExample
            Margin="0,0,0,42"
            HeaderText="A persistent InfoBar without an icon and with customized corners."
            XamlCode="&lt;ui:InfoBar Title=&quot;Title&quot; IsClosable=&quot;True&quot; IsIconVisible=&quot;True&quot; CornerRadius=&quot;8&quot;&gt;Essential message.&lt;/ui:InfoBar&gt;">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:InfoBar
                    Title="Title"
                    Grid.Column="0"
                    VerticalAlignment="Top"
                    CornerRadius="8"
                    IsAutoVisibilityEnabled="False"
                    IsClosable="True"
                    IsIconVisible="{Binding ShowIcon}"
                    Severity="{Binding ShortInfoBarSeverity, Mode=OneWay}"
                    Visibility="{Binding IsShortInfoBarVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    Essential app message.
                </ui:InfoBar>
                <Grid Grid.Column="1" Margin="12,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <CheckBox
                        Grid.Row="0"
                        Content="Is visible"
                        IsChecked="{Binding IsShortInfoBarVisible, Mode=TwoWay}" />
                    <CheckBox
                        Grid.Row="1"
                        Content="Show Icon"
                        IsChecked="{Binding ShowIcon}" />
                    <ComboBox
                        Grid.Row="2"
                        MinWidth="180"
                        Margin="0,8,0,0"
                        SelectedIndex="{Binding ShortInfoBarSeverityComboBoxSelectedIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Informational" />
                        <ComboBoxItem Content="Success" />
                        <ComboBoxItem Content="Warning" />
                        <ComboBoxItem Content="Error" />
                    </ComboBox>
                </Grid>
            </Grid>
        </controls:ControlExample>

        <controls:ControlExample
            Margin="0"
            HeaderText="A closable InfoBar with a long message."
            XamlCode="&lt;ui:InfoBar Title=&quot;Title&quot;&gt;Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.&lt;/ui:InfoBar&gt;">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:InfoBar
                    Title="Title"
                    Grid.Column="0"
                    VerticalAlignment="Top"
                    IsAutoVisibilityEnabled="False"
                    Severity="{Binding LongInfoBarSeverity, Mode=OneWay}"
                    Visibility="{Binding IsLongInfoBarVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
                </ui:InfoBar>
                <Grid Grid.Column="1" Margin="12,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <CheckBox
                        Grid.Row="0"
                        MinWidth="0"
                        Content="Is visible"
                        IsChecked="{Binding IsLongInfoBarVisible, Mode=TwoWay}" />
                    <ComboBox
                        Grid.Row="1"
                        MinWidth="180"
                        Margin="0,8,0,0"
                        SelectedIndex="{Binding LongInfoBarSeverityComboBoxSelectedIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Informational" />
                        <ComboBoxItem Content="Success" />
                        <ComboBoxItem Content="Warning" />
                        <ComboBoxItem Content="Error" />
                    </ComboBox>
                </Grid>
            </Grid>
        </controls:ControlExample>
    </StackPanel>
</Page>
