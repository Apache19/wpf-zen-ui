<Page
    x:Class="Wpf.Zen.Ui.Gallery.Views.Pages.DesignGuidance.IconsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Zen.Ui.Gallery.Views.Pages.DesignGuidance"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Wpf.Zen.Ui.Gallery.Models"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    xmlns:vm="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Pages.DesignGuidance"
    Title="IconsPage"
    controls:PageControlDocumentation.DocumentationType="{x:Type ui:FluentIcon}"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DataContext="{d:DesignInstance vm:IconsViewModel, IsDesignTimeCreatable=False}"
    d:DesignWidth="800"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TextBlock
            Grid.Row="0"
            Text="WPF Zen UI uses Fluent System Icons. Although this font was also created by Microsoft, it does not contain all the icons for Windows 11. If you need the missing icons, add Segoe Fluent Icons to your application."
            TextWrapping="WrapWithOverflow" />
        <ui:HyperlinkButton
            Grid.Row="1"
            Margin="0,4,0,0"
            Padding="0"
            HorizontalAlignment="Left"
            Content="Find out more about Fluent System Icons"
            NavigateUri="https://github.com/microsoft/fluentui-system-icons" />
        <ui:TextBlock
            Grid.Row="2"
            Margin="0,24,0,0"
            FontTypography="BodyStrong"
            Text="Fluent System Icons Library" />
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:AutoSuggestBox
                Grid.Column="0"
                MinWidth="320"
                Margin="0,4,0,0"
                HorizontalAlignment="Left"
                PlaceholderText="Search icons"
                Text="{Binding AutoSuggestBoxText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox
                Grid.Column="1"
                MinWidth="0"
                Margin="12,0,0,0"
                Content="Is filled"
                IsChecked="{Binding IsIconFilled}" />
        </Grid>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                BorderBrush="{ui:DynamicBrush CardBackgroundFillDefault}"
                BorderThickness="1,1,0,0"
                CornerRadius="8,0,0,0">
                <!--
                    Each icon item contains an interactive button template. Keep only viewport rows
                    realized while dragging the scrollbar and recycle their containers so distant
                    jumps update content instead of rebuilding the complete visual subtree.
                -->
                <ItemsControl
                    Margin="16,16,0,0"
                    ItemsSource="{Binding FilteredIconsCollection, Mode=OneWay}"
                    ScrollViewer.CanContentScroll="True"
                    VirtualizingPanel.CacheLength="0"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.ScrollUnit="Pixel"
                    VirtualizingPanel.VirtualizationMode="Recycling">
                    <ItemsControl.Template>
                        <ControlTemplate>
                            <ui:PassiveScrollViewer Padding="0,0,16,0">
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </ui:PassiveScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:DisplayableIcon}">
                            <ui:Button
                                Padding="0"
                                Command="{Binding ViewModel.IconSelectedCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:IconsPage}}"
                                CommandParameter="{Binding Path=Id, Mode=OneTime}"
                                ToolTip="{Binding Name, Mode=OneTime}"
                                ToolTipService.InitialShowDelay="240">
                                <ui:FluentIcon FontSize="28" Symbol="{Binding Icon, Mode=OneTime}" />
                            </ui:Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ui:VirtualizingWrapPanel
                                HorizontalSpacing="4"
                                ItemHeight="80"
                                ItemWidth="80"
                                ItemsAlignment="Center"
                                VerticalSpacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Border>
            <Border
                Grid.Column="1"
                MinWidth="300"
                Background="{ui:DynamicBrush CardBackgroundFillSecondary}"
                BorderBrush="{ui:DynamicBrush CardBackgroundFillDefault}"
                BorderThickness="0,1,1,0"
                CornerRadius="0,8,0,0">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ui:TextBlock
                        Grid.Row="0"
                        FontTypography="BodyStrong"
                        Text="{Binding SelectedSymbolName, Mode=OneWay}" />
                    <ui:FluentIcon
                        Grid.Row="1"
                        Margin="0,30,0,24"
                        HorizontalAlignment="Left"
                        Filled="{Binding IsIconFilled, Mode=OneWay}"
                        FontSize="62"
                        Symbol="{Binding SelectedSymbol, Mode=OneWay}" />
                    <ui:TextBlock
                        Grid.Row="2"
                        FontTypography="BodyStrong"
                        Text="Icon name" />
                    <ui:TextBox
                        Grid.Row="3"
                        Margin="0,4,0,0"
                        Foreground="{ui:DynamicBrush TextFillSecondary}"
                        Text="{Binding SelectedSymbolName, Mode=OneWay}"
                        UseTextBlockAppearance="True" />
                    <ui:TextBlock
                        Grid.Row="4"
                        Margin="0,8,0,0"
                        FontTypography="BodyStrong"
                        Text="Unicode point" />
                    <ui:TextBox
                        Grid.Row="5"
                        Margin="0,4,0,0"
                        Foreground="{ui:DynamicBrush TextFillSecondary}"
                        Text="{Binding SelectedSymbolUnicodePoint, Mode=OneWay}"
                        UseTextBlockAppearance="True" />
                    <ui:TextBlock
                        Grid.Row="6"
                        Margin="0,8,0,0"
                        FontTypography="BodyStrong"
                        Text="Text glyph" />
                    <ui:TextBox
                        Grid.Row="7"
                        Margin="0,4,0,0"
                        Foreground="{ui:DynamicBrush TextFillSecondary}"
                        Text="{Binding SelectedSymbolTextGlyph, Mode=OneWay}"
                        UseTextBlockAppearance="True" />
                    <ui:TextBlock
                        Grid.Row="8"
                        Margin="0,8,0,0"
                        FontTypography="BodyStrong"
                        Text="XAML" />
                    <ui:TextBox
                        Grid.Row="9"
                        MaxWidth="250"
                        Margin="0,4,0,0"
                        Foreground="{ui:DynamicBrush TextFillSecondary}"
                        Text="{Binding SelectedSymbolXaml, Mode=OneWay}"
                        TextWrapping="WrapWithOverflow"
                        UseTextBlockAppearance="True" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
