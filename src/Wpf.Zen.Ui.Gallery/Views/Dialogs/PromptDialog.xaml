<ui:ContentDialog
    x:Class="Wpf.Zen.Ui.Gallery.Views.Dialogs.PromptDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    xmlns:viewModels="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Dialogs"
    MinWidth="360"
    MaxWidth="600"
    d:DataContext="{d:DesignInstance viewModels:PromptDialogViewModel, IsDesignTimeCreatable=False}"
    Header="{Binding Title}"
    IsDismissible="{Binding IsDismissible}"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ui:FontIcon
            Margin="0,1,16,0"
            VerticalAlignment="Top"
            FontSize="28"
            Foreground="{ui:DynamicBrush TextFillSecondary}"
            Source="{Binding IconSource}"
            Visibility="{Binding HasIcon, Converter={ui:BoolToVisibilityConverter}}" />

        <TextBlock
            Grid.Column="1"
            VerticalAlignment="Center"
            Text="{Binding Message}"
            TextWrapping="Wrap" />
    </Grid>

    <ui:ContentDialog.Footer>
        <ui:ContentDialogActionBar ItemsSource="{Binding Actions}">
            <ui:ContentDialogActionBar.ItemTemplate>
                <DataTemplate DataType="{x:Type viewModels:PromptDialogActionViewModel}">
                    <ui:Button
                        Appearance="{Binding Appearance}"
                        Command="{x:Static ui:ContentDialog.CloseCommand}"
                        CommandParameter="{Binding Result}"
                        Content="{Binding Text}"
                        IsCancel="{Binding IsCancel}"
                        IsDefault="{Binding IsDefault}" />
                </DataTemplate>
            </ui:ContentDialogActionBar.ItemTemplate>
        </ui:ContentDialogActionBar>
    </ui:ContentDialog.Footer>
</ui:ContentDialog>
