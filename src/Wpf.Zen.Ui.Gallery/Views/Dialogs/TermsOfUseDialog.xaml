<ui:ContentDialog
    x:Class="Wpf.Zen.Ui.Gallery.Views.Dialogs.TermsOfUseDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    MaxWidth="750"
    MaxHeight="500"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DataContext="{d:DesignInstance dialogs:TermsOfUseDialogViewModel, IsDesignTimeCreatable=False}"
    d:DesignWidth="750"
    d:Foreground="{ui:DynamicBrush TextFillPrimary}"
    Header="{Binding Title}"
    IsDismissible="False"
    mc:Ignorable="d">

    <ui:ContentDialog.Footer>
        <ui:ContentDialogActionBar>
            <ui:Button
                MaxWidth="200"
                Appearance="Accent"
                Click="OnAcceptClick"
                Content="{Binding AcceptButtonText}"
                IsDefault="True" />
        </ui:ContentDialogActionBar>
    </ui:ContentDialog.Footer>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            FontSize="14"
            Text="{Binding TermsText}"
            TextWrapping="WrapWithOverflow" />

        <StackPanel
            Grid.Row="1"
            Margin="0,20,0,0"
            HorizontalAlignment="Center">
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="16"
                Foreground="Red"
                Text="{Binding ValidationMessage}"
                Visibility="{Binding HasValidationError, Converter={ui:BoolToVisibilityConverter}}" />

            <CheckBox
                x:Name="AgreementCheckBox"
                Margin="0,15,0,0"
                HorizontalAlignment="Center"
                VerticalContentAlignment="Center"
                Content="{Binding AgreementText}"
                FontSize="16"
                IsChecked="{Binding IsAccepted, Mode=TwoWay}" />
        </StackPanel>
    </Grid>
</ui:ContentDialog>
