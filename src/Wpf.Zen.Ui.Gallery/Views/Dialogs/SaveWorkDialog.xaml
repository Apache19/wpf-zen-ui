<ui:ContentDialog
    x:Class="Wpf.Zen.Ui.Gallery.Views.Dialogs.SaveWorkDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:Wpf.Zen.Ui.Gallery.ViewModels.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Wpf.Zen.Ui.Gallery.Models"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    d:DataContext="{d:DesignInstance dialogs:SaveWorkDialogViewModel, IsDesignTimeCreatable=False}"
    Header="{Binding Title}"
    mc:Ignorable="d">

    <StackPanel>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        <CheckBox
            Margin="0,12,0,0"
            Content="{Binding UploadToCloudText}"
            IsChecked="{Binding UploadToCloud, Mode=TwoWay}" />
    </StackPanel>

    <ui:ContentDialog.Footer>
        <ui:ContentDialogActionBar>
            <ui:Button
                Appearance="Accent"
                Command="{x:Static ui:ContentDialog.CloseCommand}"
                CommandParameter="{x:Static models:SaveWorkChoice.Save}"
                Content="Save"
                IsDefault="True" />
            <ui:Button
                Command="{x:Static ui:ContentDialog.CloseCommand}"
                CommandParameter="{x:Static models:SaveWorkChoice.Discard}"
                Content="Don't Save" />
            <ui:Button
                Command="{x:Static ui:ContentDialog.DismissCommand}"
                Content="Cancel"
                IsCancel="True" />
        </ui:ContentDialogActionBar>
    </ui:ContentDialog.Footer>
</ui:ContentDialog>
