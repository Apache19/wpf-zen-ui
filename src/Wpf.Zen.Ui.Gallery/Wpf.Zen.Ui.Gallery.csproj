<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <IsPackable>false</IsPackable>
    <StartupObject>Wpf.Zen.Ui.Gallery.Program</StartupObject>
    <TargetFrameworks>net472;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>wpfui.ico</ApplicationIcon>
    <PolySharpExcludeGeneratedTypes>System.Runtime.CompilerServices.OverloadResolutionPriorityAttribute</PolySharpExcludeGeneratedTypes>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="wpfui.ico" />
  </ItemGroup>

  <!-- Share the passive TSF interop contracts without exposing library internals. -->
  <ItemGroup>
    <Compile Include="..\Wpf.Zen.Ui.VirtualInput\Interop\WpfReflectionBridge.cs" Link="Diagnostics\Interop\WpfReflectionBridge.cs" />
    <Compile Include="..\Wpf.Zen.Ui.VirtualInput\Interop\TextServicesFramework\ITfLangBarItemMgr.cs" Link="Diagnostics\Interop\ITfLangBarItemMgr.cs" />
    <Compile Include="..\Wpf.Zen.Ui.VirtualInput\Interop\TextServicesFramework\ITfSource.cs" Link="Diagnostics\Interop\ITfSource.cs" />
    <Compile Include="..\Wpf.Zen.Ui.VirtualInput\Interop\TextServicesFramework\ITfCompartment.cs" Link="Diagnostics\Interop\ITfCompartment.cs" />
    <Compile Include="..\Wpf.Zen.Ui.VirtualInput\Interop\TextServicesFramework\ITfCompartmentMgr.cs" Link="Diagnostics\Interop\ITfCompartmentMgr.cs" />
    <Compile Include="..\Wpf.Zen.Ui.VirtualInput\Interop\TextServicesFramework\WpfTextServicesAccessor.cs" Link="Diagnostics\Interop\WpfTextServicesAccessor.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Windows.CsWin32">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wpf.Zen.Ui.DependencyInjection\Wpf.Zen.Ui.DependencyInjection.csproj" />

    <ProjectReference Include="..\Wpf.Zen.Ui.Tray\Wpf.Zen.Ui.Tray.csproj" />

    <ProjectReference Include="..\Wpf.Zen.Ui.VirtualInput.Extensions\Wpf.Zen.Ui.VirtualInput.Extensions.csproj" />
    <ProjectReference Include="..\Wpf.Zen.Ui.VirtualInput\Wpf.Zen.Ui.VirtualInput.csproj" />
    <ProjectReference Include="..\Wpf.Zen.Ui\Wpf.Zen.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\geo_icons.png" />
    <Resource Include="Assets\octonaut.jpg" />
    <Resource Include="Assets\pexels-johannes-plenio-1103970.jpg" />
    <Resource Include="Assets\WinUiGallery\Button.png" />
    <Resource Include="Assets\WinUiGallery\Flyout.png" />
    <Resource Include="Assets\WinUiGallery\MenuBar.png" />
    <Resource Include="Assets\wpfui.png" />
    <Resource Include="Assets\wpfui_full.png" />
    <Resource Include="CodeSamples\BasicInput\DropDownButtonContent_xaml.txt" />
    <Resource Include="CodeSamples\BasicInput\DropDownButtonData_xaml.txt" />
    <Resource Include="CodeSamples\BasicInput\DropDownButtonFormat_xaml.txt" />
    <Resource Include="CodeSamples\BasicInput\DropDownButton_xaml.txt" />
    <Resource Include="CodeSamples\BasicInput\DropDownButtonPopup_xaml.txt" />
    <Resource Include="CodeSamples\BasicInput\DropDownButtonPopup_cs.txt" />
    <Resource Include="CodeSamples\Typography\TypographySample_xaml.txt" />    
  </ItemGroup>

  <ItemGroup>
    <None Update="License - Images.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Translations.pl-PL.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Translations.pl-PL.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\Translations.pl-PL.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Translations.pl-PL.resx</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
