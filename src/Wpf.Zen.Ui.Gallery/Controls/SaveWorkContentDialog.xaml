<ui:ContentDialog
    x:Class="Wpf.Zen.Ui.Gallery.Controls.SaveWorkContentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:Wpf.Zen.Ui.Gallery.Models"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    Header="Save your work?">

    <StackPanel>
        <TextBlock Text="Lorem ipsum dolor sit amet, adipisicing elit." TextWrapping="Wrap" />
        <CheckBox Content="Upload your content to the cloud." IsChecked="{Binding UploadToCloud, Mode=TwoWay}" />
    </StackPanel>

    <ui:ContentDialog.Footer>
        <ui:AdaptiveUniformGrid
            Margin="20"
            ColumnSpacing="8"
            Columns="3"
            RowSpacing="8">
            <ui:Button
                Appearance="Accent"
                Command="{x:Static ui:ContentDialog.CloseCommand}"
                CommandParameter="{x:Static models:SaveWorkChoice.Save}"
                Content="Save"
                IsDefault="True" />
            <ui:Button
                Command="{x:Static ui:ContentDialog.CloseCommand}"
                CommandParameter="{x:Static models:SaveWorkChoice.Discard}"
                Content="Don't Save" />
            <ui:Button
                Command="{x:Static ui:ContentDialog.DismissCommand}"
                Content="Cancel"
                IsCancel="True" />
        </ui:AdaptiveUniformGrid>
    </ui:ContentDialog.Footer>

</ui:ContentDialog>
