<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Wpf.Zen.Ui.DependencyInjection</PackageId>
    <TargetFrameworks>net8.0-windows;net462</TargetFrameworks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Description>Dependency injection for the WPF Zen UI.</Description>
    <CommonTags>$(CommonTags);dependency;injection;abstractions;standard</CommonTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" VersionOverride="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wpf.Zen.Ui.Abstractions\Wpf.Zen.Ui.Abstractions.csproj" />
  </ItemGroup>

</Project>
