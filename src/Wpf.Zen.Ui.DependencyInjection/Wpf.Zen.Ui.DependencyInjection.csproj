<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Wpf.Zen.Ui.DependencyInjection</PackageId>
    <TargetFrameworks>net8.0-windows;net472</TargetFrameworks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Description>Dependency injection for the WPF Zen UI.</Description>
    <CommonTags>$(CommonTags);dependency;injection;standard</CommonTags>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wpf.Zen.Ui\Wpf.Zen.Ui.csproj" />
  </ItemGroup>

</Project>
