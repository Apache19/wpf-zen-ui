<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:theming="clr-namespace:Wpf.Ui.Theming"
    xmlns:m="clr-namespace:Wpf.Ui.Markup">

    <Style x:Key="{x:Static theming:StyleKeys.DefaultControlFocusVisualStyle}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle
                        RadiusX="4"
                        RadiusY="4"
                        SnapsToDevicePixels="True"
                        Stroke="{m:DynamicBrush KeyboardFocusBorder}"
                        StrokeThickness="1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}" BasedOn="{StaticResource {x:Static theming:StyleKeys.DefaultControlFocusVisualStyle}}" />

</ResourceDictionary>
