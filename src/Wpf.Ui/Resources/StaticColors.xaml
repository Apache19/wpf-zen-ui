<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:t="clr-namespace:Wpf.Ui.Theming"
    xmlns:m="clr-namespace:Wpf.Ui.Markup">

    <Color x:Key="{x:Static t:ColorKey.TextFillColorLightPrimary}">#FFFFFF</Color>
    <Color x:Key="{x:Static t:ColorKey.TextFillColorLightSecondary}">#C5FFFFFF</Color>
    <Color x:Key="{x:Static t:ColorKey.TextFillColorLightTertiary}">#87FFFFFF</Color>
    <Color x:Key="{x:Static t:ColorKey.TextFillColorLightDisabled}">#5DFFFFFF</Color>
    <Color x:Key="{x:Static t:ColorKey.TextFillColorLightInverse}">#E4000000</Color>

    <SolidColorBrush x:Key="{x:Static t:BrushKeys.TextFillColorLightPrimaryBrush}" Color="{m:ColorResource TextFillColorLightPrimary, True}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.TextFillColorLightSecondaryBrush}" Color="{m:ColorResource TextFillColorLightSecondary, True}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.TextFillColorLightTertiaryBrush}" Color="{m:ColorResource TextFillColorLightTertiary, True}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.TextFillColorLightDisabledBrush}" Color="{m:ColorResource TextFillColorLightDisabled, True}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.TextFillColorLightInverseBrush}" Color="{m:ColorResource TextFillColorLightInverse, True}" />

    <Color x:Key="{x:Static t:ColorKey.TextFillColorDarkPrimary}">#E4000000</Color>
    <Color x:Key="{x:Static t:ColorKey.TextFillColorDarkSecondary}">#BE000000</Color>
    <Color x:Key="{x:Static t:ColorKey.TextFillColorDarkTertiary}">#A2000000</Color>
    <Color x:Key="{x:Static t:ColorKey.TextFillColorDarkDisabled}">#5C000000</Color>
    <Color x:Key="{x:Static t:ColorKey.TextFillColorDarkInverse}">#FFFFFF</Color>

    <SolidColorBrush x:Key="{x:Static t:BrushKeys.TextFillColorDarkPrimaryBrush}" Color="{m:ColorResource TextFillColorDarkPrimary, True}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.TextFillColorDarkSecondaryBrush}" Color="{m:ColorResource TextFillColorDarkSecondary, True}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.TextFillColorDarkTertiaryBrush}" Color="{m:ColorResource TextFillColorDarkTertiary, True}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.TextFillColorDarkDisabledBrush}" Color="{m:ColorResource TextFillColorDarkDisabled, True}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.TextFillColorDarkInverseBrush}" Color="{m:ColorResource TextFillColorDarkInverse, True}" />

    <Color x:Key="{x:Static t:ColorKey.ApplicationBackgroundColorLight}">#FFFAFAFA</Color>
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.ApplicationBackgroundColorLightBrush}" Color="{m:ColorResource ApplicationBackgroundColorLight, True}" />

    <Color x:Key="{x:Static t:ColorKey.ApplicationBackgroundColorDark}">#FF202020</Color>
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.ApplicationBackgroundColorDarkBrush}" Color="{m:ColorResource ApplicationBackgroundColorDark, True}" />

    <Color x:Key="{x:Static t:ColorKey.ControlStrongFillColorLight}">#B3FFFFFF</Color>
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.ControlStrongFillColorLightBrush}" Color="{m:ColorResource ControlStrongFillColorLight, True}" />

    <Color x:Key="{x:Static t:ColorKey.ControlStrongFillColorDark}">#72000000</Color>
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.ControlStrongFillColorDarkBrush}" Color="{m:ColorResource ControlStrongFillColorDark, True}" />

</ResourceDictionary>
