<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:theming="clr-namespace:Wpf.Ui.Theming">

    <system:Double x:Key="{x:Static theming:VariableKeys.DefaultIconFontSize}">16</system:Double>

    <system:Double x:Key="{x:Static theming:VariableKeys.ControlContentThemeFontSize}">14</system:Double>

    <CornerRadius x:Key="{x:Static theming:VariableKeys.ControlCornerRadius}">4,4,4,4</CornerRadius>
    <CornerRadius x:Key="{x:Static theming:VariableKeys.OverlayCornerRadius}">4,4,4,4</CornerRadius>
    <CornerRadius x:Key="{x:Static theming:VariableKeys.PopupCornerRadius}">8,8,8,8</CornerRadius>

    <!--
    <system:String x:Key="ControlFastOutSlowInKeySpline">0,0,0,1</system:String>
    <Duration x:Key="ControlNormalAnimationDuration">00:00:00.250</Duration>
    <Duration x:Key="ControlFastAnimationDuration">00:00:00.167</Duration>
    <Duration x:Key="ControlFastAnimationAfterDuration">00:00:00.168</Duration>
    <Duration x:Key="ControlFasterAnimationDuration">00:00:00.083</Duration>
    -->

    <Thickness x:Key="{x:Static theming:VariableKeys.TextControlBorderThemeThickness}">1</Thickness>
    <Thickness x:Key="{x:Static theming:VariableKeys.TextControlBorderThemeThicknessFocused}">2</Thickness>
    <Thickness x:Key="{x:Static theming:VariableKeys.TextControlThemePadding}">10,7,10,7</Thickness>

    <system:Double x:Key="{x:Static theming:VariableKeys.ContentControlFontSize}">14</system:Double>
    <system:Double x:Key="{x:Static theming:VariableKeys.TextControlThemeMinHeight}">24</system:Double>
    <system:Double x:Key="{x:Static theming:VariableKeys.TextControlThemeMinWidth}">0</system:Double>
    <system:Double x:Key="{x:Static theming:VariableKeys.ListViewItemMinHeight}">32</system:Double>
    <system:Double x:Key="{x:Static theming:VariableKeys.TreeViewItemMinHeight}">24</system:Double>
    <system:Double x:Key="{x:Static theming:VariableKeys.TreeViewItemMultiSelectCheckBoxMinHeight}">24</system:Double>
    <system:Double x:Key="{x:Static theming:VariableKeys.TreeViewItemPresenterMargin}">0</system:Double>
    <system:Double x:Key="{x:Static theming:VariableKeys.TreeViewItemPresenterPadding}">0</system:Double>

    <Thickness x:Key="{x:Static theming:VariableKeys.TimePickerHostPadding}">0,1,0,2</Thickness>
    <Thickness x:Key="{x:Static theming:VariableKeys.DatePickerHostPadding}">0,1,0,2</Thickness>
    <Thickness x:Key="{x:Static theming:VariableKeys.DatePickerHostMonthPadding}">9,0,0,1</Thickness>
    <system:Double x:Key="{x:Static theming:VariableKeys.ComboBoxMinHeight}">24</system:Double>
    <system:Double x:Key="{x:Static theming:VariableKeys.NavigationViewItemOnLeftMinHeight}">32</system:Double>

</ResourceDictionary>
