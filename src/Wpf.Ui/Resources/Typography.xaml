<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:keys="clr-namespace:Wpf.Ui.Markup"
    xmlns:controls="clr-namespace:Wpf.Ui.Controls">

    <controls:FontTypographyPreset
        x:Key="{x:Static keys:TypographyKeys.CaptionFontTypography}"
        FontSize="12"
        FontWeight="Regular" />

    <controls:FontTypographyPreset
        x:Key="{x:Static keys:TypographyKeys.BodyFontTypography}"
        FontSize="14"
        FontWeight="Regular" />

    <controls:FontTypographyPreset
        x:Key="{x:Static keys:TypographyKeys.BodyStrongFontTypography}"
        FontSize="14"
        FontWeight="SemiBold" />

    <controls:FontTypographyPreset
        x:Key="{x:Static keys:TypographyKeys.SubtitleFontTypography}"
        FontSize="20"
        FontWeight="SemiBold" />

    <controls:FontTypographyPreset
        x:Key="{x:Static keys:TypographyKeys.TitleFontTypography}"
        FontSize="28"
        FontWeight="SemiBold" />

    <controls:FontTypographyPreset
        x:Key="{x:Static keys:TypographyKeys.TitleLargeFontTypography}"
        FontSize="40"
        FontWeight="SemiBold" />

    <controls:FontTypographyPreset
        x:Key="{x:Static keys:TypographyKeys.DisplayFontTypography}"
        FontSize="68"
        FontWeight="SemiBold" />

</ResourceDictionary>
