<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Controls">

    <controls:FontTypographyPreset
        x:Key="CaptionFontTypography"
        FontSize="12"
        FontWeight="Regular" />

    <controls:FontTypographyPreset
        x:Key="BodyFontTypography"
        FontSize="14"
        FontWeight="Regular" />

    <controls:FontTypographyPreset
        x:Key="BodyStrongFontTypography"
        FontSize="14"
        FontWeight="SemiBold" />

    <controls:FontTypographyPreset
        x:Key="SubtitleFontTypography"
        FontSize="20"
        FontWeight="SemiBold" />

    <controls:FontTypographyPreset
        x:Key="TitleFontTypography"
        FontSize="28"
        FontWeight="SemiBold" />

    <controls:FontTypographyPreset
        x:Key="TitleLargeFontTypography"
        FontSize="40"
        FontWeight="SemiBold" />

    <controls:FontTypographyPreset
        x:Key="DisplayFontTypography"
        FontSize="68"
        FontWeight="SemiBold" />

</ResourceDictionary>
