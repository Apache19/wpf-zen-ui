    <!--  LeftNavigationViewTemplate  -->
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.LeftNavigationViewSeparatorBrush}" Color="{StaticResource SystemColorWindowTextColor}">

    </SolidColorBrush>

