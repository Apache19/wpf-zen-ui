<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:t="clr-namespace:Wpf.Ui.Theming">

    <!--
        简化并优化的明亮模式主题资源，暂未使用，将来按照此资源结构重构所有控件引用。
        主要目的是减少资源数量，优化性能，并提供更一致的视觉体验。
    -->

    <!--  =========================================================  -->
    <!--  BASE BACKGROUND                                            -->
    <!--  =========================================================  -->

    <Color x:Key="ApplicationBackgroundColor">#F3F3F3</Color>

    <Color x:Key="LayerFillColorDefault">#FFFFFF</Color>
    <Color x:Key="LayerFillColorSecondary">#F9F9F9</Color>
    <Color x:Key="LayerFillColorTertiary">#F3F3F3</Color>

    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource ApplicationBackgroundColor}" />
    <SolidColorBrush x:Key="LayerFillBrushDefault" Color="{StaticResource LayerFillColorDefault}" />
    <SolidColorBrush x:Key="LayerFillBrushSecondary" Color="{StaticResource LayerFillColorSecondary}" />
    <SolidColorBrush x:Key="LayerFillBrushTertiary" Color="{StaticResource LayerFillColorTertiary}" />

    <!--  =========================================================  -->
    <!--  CONTROL BACKGROUND                                         -->
    <!--  =========================================================  -->

    <Color x:Key="ControlFillColorDefault">#FFFFFF</Color>
    <Color x:Key="ControlFillColorSecondary">#F3F3F3</Color>
    <Color x:Key="ControlFillColorTertiary">#EAEAEA</Color>
    <Color x:Key="ControlFillColorDisabled">#F5F5F5</Color>

    <SolidColorBrush x:Key="ControlFillBrushDefault" Color="{StaticResource ControlFillColorDefault}" />
    <SolidColorBrush x:Key="ControlFillBrushSecondary" Color="{StaticResource ControlFillColorSecondary}" />
    <SolidColorBrush x:Key="ControlFillBrushTertiary" Color="{StaticResource ControlFillColorTertiary}" />
    <SolidColorBrush x:Key="ControlFillBrushDisabled" Color="{StaticResource ControlFillColorDisabled}" />

    <!--  =========================================================  -->
    <!--  TEXT COLORS                                                -->
    <!--  =========================================================  -->

    <Color x:Key="{x:Static t:ColorKeys.TextFillColorPrimary}">#1A1A1A</Color>
    <Color x:Key="{x:Static t:ColorKeys.TextFillColorSecondary}">#444444</Color>
    <Color x:Key="{x:Static t:ColorKeys.TextFillColorTertiary}">#6E6E6E</Color>
    <Color x:Key="{x:Static t:ColorKeys.TextFillColorDisabled}">#A0A0A0</Color>
    <Color x:Key="{x:Static t:ColorKeys.TextPlaceholderColor}">#8A8A8A</Color>

    <SolidColorBrush x:Key="TextFillBrushPrimary" Color="{StaticResource {x:Static t:ColorKeys.TextFillColorPrimary}}" />
    <SolidColorBrush x:Key="TextFillBrushSecondary" Color="{StaticResource {x:Static t:ColorKeys.TextFillColorSecondary}}" />
    <SolidColorBrush x:Key="TextFillBrushTertiary" Color="{StaticResource {x:Static t:ColorKeys.TextFillColorTertiary}}" />
    <SolidColorBrush x:Key="TextFillBrushDisabled" Color="{StaticResource {x:Static t:ColorKeys.TextFillColorDisabled}}" />
    <SolidColorBrush x:Key="TextPlaceholderBrush" Color="{StaticResource {x:Static t:ColorKeys.TextPlaceholderColor}}" />

    <!--  =========================================================  -->
    <!--  BORDER / STROKE                                            -->
    <!--  =========================================================  -->

    <Color x:Key="ControlStrokeColorDefault">#D6D6D6</Color>
    <Color x:Key="ControlStrokeColorSecondary">#C8C8C8</Color>
    <Color x:Key="ControlStrokeColorDisabled">#E6E6E6</Color>

    <SolidColorBrush x:Key="ControlStrokeBrushDefault" Color="{StaticResource ControlStrokeColorDefault}" />
    <SolidColorBrush x:Key="ControlStrokeBrushSecondary" Color="{StaticResource ControlStrokeColorSecondary}" />
    <SolidColorBrush x:Key="ControlStrokeBrushDisabled" Color="{StaticResource ControlStrokeColorDisabled}" />

    <!--  =========================================================  -->
    <!--  ACCENT                                                     -->
    <!--  =========================================================  -->

    <Color x:Key="AccentFillColorDefault">#0078D4</Color>
    <Color x:Key="AccentFillColorSecondary">#106EBE</Color>
    <Color x:Key="AccentFillColorTertiary">#0F5EA6</Color>
    <Color x:Key="AccentFillColorDisabled">#BFD6EA</Color>

    <SolidColorBrush x:Key="AccentFillBrushDefault" Color="{StaticResource AccentFillColorDefault}" />
    <SolidColorBrush x:Key="AccentFillBrushSecondary" Color="{StaticResource AccentFillColorSecondary}" />
    <SolidColorBrush x:Key="AccentFillBrushTertiary" Color="{StaticResource AccentFillColorTertiary}" />
    <SolidColorBrush x:Key="AccentFillBrushDisabled" Color="{StaticResource AccentFillColorDisabled}" />

    <!--  =========================================================  -->
    <!--  SELECTION                                                  -->
    <!--  =========================================================  -->

    <Color x:Key="SelectionBackgroundColor">#CCE4F7</Color>
    <Color x:Key="SelectionBackgroundInactiveColor">#E6E6E6</Color>
    <Color x:Key="SelectionTextColor">#000000</Color>

    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="{StaticResource SelectionBackgroundColor}" />
    <SolidColorBrush x:Key="SelectionBackgroundInactiveBrush" Color="{StaticResource SelectionBackgroundInactiveColor}" />
    <SolidColorBrush x:Key="SelectionTextBrush" Color="{StaticResource SelectionTextColor}" />

    <!--  =========================================================  -->
    <!--  FOCUS                                                      -->
    <!--  =========================================================  -->

    <Color x:Key="FocusStrokeColorOuter">#0078D4</Color>
    <Color x:Key="FocusStrokeColorInner">#FFFFFF</Color>

    <SolidColorBrush x:Key="FocusStrokeBrushOuter" Color="{StaticResource FocusStrokeColorOuter}" />
    <SolidColorBrush x:Key="FocusStrokeBrushInner" Color="{StaticResource FocusStrokeColorInner}" />

    <!--  =========================================================  -->
    <!--  MENU / FLYOUT                                              -->
    <!--  =========================================================  -->

    <Color x:Key="MenuBackgroundColor">#FFFFFF</Color>
    <Color x:Key="MenuBorderColor">#D6D6D6</Color>

    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="{StaticResource MenuBackgroundColor}" />
    <SolidColorBrush x:Key="MenuBorderBrush" Color="{StaticResource MenuBorderColor}" />

    <!--  =========================================================  -->
    <!--  LIST / ITEMS                                               -->
    <!--  =========================================================  -->

    <Color x:Key="ListItemHoverColor">#F3F3F3</Color>
    <Color x:Key="ListItemPressedColor">#EAEAEA</Color>

    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{StaticResource ListItemHoverColor}" />
    <SolidColorBrush x:Key="ListItemPressedBrush" Color="{StaticResource ListItemPressedColor}" />

    <!--  =========================================================  -->
    <!--  SEPARATORS                                                 -->
    <!--  =========================================================  -->

    <Color x:Key="SeparatorColor">#E0E0E0</Color>

    <SolidColorBrush x:Key="SeparatorBrush" Color="{StaticResource SeparatorColor}" />

</ResourceDictionary>