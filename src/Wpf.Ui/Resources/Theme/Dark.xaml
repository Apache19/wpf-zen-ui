    <!--  Brushes  -->

    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.TextFillColorPrimaryBrush}" Color="{StaticResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.TextFillColorSecondaryBrush}" Color="{StaticResource TextFillColorSecondary}" />
