    <Color x:Key="SolidBackgroundFillColorBase">#F3F3F3</Color>
    <Color x:Key="SolidBackgroundFillColorSecondary">#EEEEEE</Color>
    <Color x:Key="SolidBackgroundFillColorTertiary">#F9F9F9</Color>
    <Color x:Key="SolidBackgroundFillColorQuarternary">#FFFFFF</Color>
    <Color x:Key="SolidBackgroundFillColorTransparent">#00F3F3F3</Color>
    <Color x:Key="SolidBackgroundFillColorBaseAlt">#DADADA</Color>


    <Color x:Key="SystemFillColorAttention">#0078d4</Color>
    <Color x:Key="SystemFillColorInformational">#8A8A8A</Color>
    <Color x:Key="SystemFillColorSuccess">#0F7B0F</Color>
    <Color x:Key="SystemFillColorCaution">#9D5D00</Color>
    <Color x:Key="SystemFillColorCritical">#C42B1C</Color>
    <Color x:Key="SystemFillColorNeutral">#72000000</Color>
    <Color x:Key="SystemFillColorSolidNeutral">#8A8A8A</Color>
    <Color x:Key="SystemFillColorAttentionBackground">#80F6F6F6</Color>
    <Color x:Key="SystemFillColorSuccessBackground">#DFF6DD</Color>
    <Color x:Key="SystemFillColorCautionBackground">#FFF4CE</Color>
    <Color x:Key="SystemFillColorCriticalBackground">#FDE7E9</Color>
    <Color x:Key="SystemFillColorNeutralBackground">#06000000</Color>
    <Color x:Key="SystemFillColorSolidAttentionBackground">#F7F7F7</Color>
    <Color x:Key="SystemFillColorSolidNeutralBackground">#F3F3F3</Color>

    <!--  Brushes  -->

    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.TextFillColorPrimaryBrush}" Color="{StaticResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.TextFillColorSecondaryBrush}" Color="{StaticResource TextFillColorSecondary}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.TextFillColorTertiaryBrush}" Color="{StaticResource TextFillColorTertiary}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.TextFillColorDisabledBrush}" Color="{StaticResource TextFillColorDisabled}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.TextPlaceholderColorBrush}" Color="{StaticResource TextPlaceholderColor}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.TextFillColorInverseBrush}" Color="{StaticResource TextFillColorInverse}" />

    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.AccentTextFillColorDisabledBrush}" Color="{StaticResource AccentTextFillColorDisabled}" />

    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.TextOnAccentFillColorSelectedTextBrush}" Color="{StaticResource TextOnAccentFillColorSelectedText}" />

    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.TextOnAccentFillColorPrimaryBrush}" Color="{StaticResource TextOnAccentFillColorPrimary}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.TextOnAccentFillColorSecondaryBrush}" Color="{StaticResource TextOnAccentFillColorSecondary}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.TextOnAccentFillColorDisabledBrush}" Color="{StaticResource TextOnAccentFillColorDisabled}" />

    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.ControlFillColorDefaultBrush}" Color="{StaticResource ControlFillColorDefault}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.ControlFillColorSecondaryBrush}" Color="{StaticResource ControlFillColorSecondary}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.ControlFillColorTertiaryBrush}" Color="{StaticResource ControlFillColorTertiary}" />
