    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.ControlFillColorTransparentBrush}" Color="{StaticResource ControlFillColorTransparent}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.ControlFillColorInputActiveBrush}" Color="{StaticResource ControlFillColorInputActive}" />

    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.ControlStrongFillColorDefaultBrush}" Color="{StaticResource ControlStrongFillColorDefault}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.ControlStrongFillColorDisabledBrush}" Color="{StaticResource ControlStrongFillColorDisabled}" />

    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.ControlSolidFillColorDefaultBrush}" Color="{StaticResource ControlSolidFillColorDefault}" />

    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.SubtleFillColorTransparentBrush}" Color="{StaticResource SubtleFillColorTransparent}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.SubtleFillColorSecondaryBrush}" Color="{StaticResource SubtleFillColorSecondary}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.SubtleFillColorTertiaryBrush}" Color="{StaticResource SubtleFillColorTertiary}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.SubtleFillColorDisabledBrush}" Color="{StaticResource SubtleFillColorDisabled}" />

    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.ControlAltFillColorTransparentBrush}" Color="{StaticResource ControlAltFillColorTransparent}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.ControlAltFillColorSecondaryBrush}" Color="{StaticResource ControlAltFillColorSecondary}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.ControlAltFillColorTertiaryBrush}" Color="{StaticResource ControlAltFillColorTertiary}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.ControlAltFillColorQuarternaryBrush}" Color="{StaticResource ControlAltFillColorQuarternary}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.ControlAltFillColorDisabledBrush}" Color="{StaticResource ControlAltFillColorDisabled}" />

    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.ControlOnImageFillColorDefaultBrush}" Color="{StaticResource ControlOnImageFillColorDefault}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.ControlOnImageFillColorSecondaryBrush}" Color="{StaticResource ControlOnImageFillColorSecondary}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.ControlOnImageFillColorTertiaryBrush}" Color="{StaticResource ControlOnImageFillColorTertiary}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.ControlOnImageFillColorDisabledBrush}" Color="{StaticResource ControlOnImageFillColorDisabled}" />

    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.ControlStrokeColorDefaultBrush}" Color="{StaticResource ControlStrokeColorDefault}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.ControlStrokeColorSecondaryBrush}" Color="{StaticResource ControlStrokeColorSecondary}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.ControlStrokeColorTertiaryBrush}" Color="{StaticResource ControlStrokeColorTertiary}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.ControlStrokeColorOnAccentDefaultBrush}" Color="{StaticResource ControlStrokeColorOnAccentDefault}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.ControlStrokeColorOnAccentSecondaryBrush}" Color="{StaticResource ControlStrokeColorOnAccentSecondary}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.ControlStrokeColorOnAccentTertiaryBrush}" Color="{StaticResource ControlStrokeColorOnAccentTertiary}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.ControlStrokeColorOnAccentDisabledBrush}" Color="{StaticResource ControlStrokeColorOnAccentDisabled}" />

    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.ControlStrokeColorForStrongFillWhenOnImageBrush}" Color="{StaticResource ControlStrokeColorForStrongFillWhenOnImage}" />

    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.CardStrokeColorDefaultBrush}" Color="{StaticResource CardStrokeColorDefault}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.CardStrokeColorDefaultSolidBrush}" Color="{StaticResource CardStrokeColorDefaultSolid}" />

    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.ControlStrongStrokeColorDefaultBrush}" Color="{StaticResource ControlStrongStrokeColorDefault}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.ControlStrongStrokeColorDisabledBrush}" Color="{StaticResource ControlStrongStrokeColorDisabled}" />

    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.SurfaceStrokeColorDefaultBrush}" Color="{StaticResource SurfaceStrokeColorDefault}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.SurfaceStrokeColorFlyoutBrush}" Color="{StaticResource SurfaceStrokeColorFlyout}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.SurfaceStrokeColorInverseBrush}" Color="{StaticResource SurfaceStrokeColorInverse}" />

    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.DividerStrokeColorDefaultBrush}" Color="{StaticResource DividerStrokeColorDefault}" />

    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.FocusStrokeColorOuterBrush}" Color="{StaticResource FocusStrokeColorOuter}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.FocusStrokeColorInnerBrush}" Color="{StaticResource FocusStrokeColorInner}" />

    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.CardBackgroundFillColorDefaultBrush}" Color="{StaticResource CardBackgroundFillColorDefault}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.CardBackgroundFillColorSecondaryBrush}" Color="{StaticResource CardBackgroundFillColorSecondary}" />

    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.SmokeFillColorDefaultBrush}" Color="{StaticResource SmokeFillColorDefault}" />

    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.LayerFillColorDefaultBrush}" Color="{StaticResource LayerFillColorDefault}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.LayerFillColorAltBrush}" Color="{StaticResource LayerFillColorAlt}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.LayerOnAcrylicFillColorDefaultBrush}" Color="{StaticResource LayerOnAcrylicFillColorDefault}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.LayerOnAccentAcrylicFillColorDefaultBrush}" Color="{StaticResource LayerOnAccentAcrylicFillColorDefault}" />

    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.LayerOnMicaBaseAltFillColorDefaultBrush}" Color="{StaticResource LayerOnMicaBaseAltFillColorDefault}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.LayerOnMicaBaseAltFillColorSecondaryBrush}" Color="{StaticResource LayerOnMicaBaseAltFillColorSecondary}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.LayerOnMicaBaseAltFillColorTertiaryBrush}" Color="{StaticResource LayerOnMicaBaseAltFillColorTertiary}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.LayerOnMicaBaseAltFillColorTransparentBrush}" Color="{StaticResource LayerOnMicaBaseAltFillColorTransparent}" />

    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.SolidBackgroundFillColorBaseBrush}" Color="{StaticResource SolidBackgroundFillColorBase}" />
