    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.SolidBackgroundFillColorTertiaryBrush}" Color="{StaticResource SolidBackgroundFillColorTertiary}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.SolidBackgroundFillColorQuarternaryBrush}" Color="{StaticResource SolidBackgroundFillColorQuarternary}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.SolidBackgroundFillColorBaseAltBrush}" Color="{StaticResource SolidBackgroundFillColorBaseAlt}" />

    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.SystemFillColorSuccessBrush}" Color="{StaticResource SystemFillColorSuccess}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.SystemFillColorCautionBrush}" Color="{StaticResource SystemFillColorCaution}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.SystemFillColorCriticalBrush}" Color="{StaticResource SystemFillColorCritical}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.SystemFillColorNeutralBrush}" Color="{StaticResource SystemFillColorNeutral}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.SystemFillColorSolidNeutralBrush}" Color="{StaticResource SystemFillColorSolidNeutral}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.SystemFillColorAttentionBackgroundBrush}" Color="{StaticResource SystemFillColorAttentionBackground}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.SystemFillColorSuccessBackgroundBrush}" Color="{StaticResource SystemFillColorSuccessBackground}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.SystemFillColorCautionBackgroundBrush}" Color="{StaticResource SystemFillColorCautionBackground}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.SystemFillColorCriticalBackgroundBrush}" Color="{StaticResource SystemFillColorCriticalBackground}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.SystemFillColorNeutralBackgroundBrush}" Color="{StaticResource SystemFillColorNeutralBackground}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.SystemFillColorSolidAttentionBackgroundBrush}" Color="{StaticResource SystemFillColorSolidAttentionBackground}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.SystemFillColorSolidNeutralBackgroundBrush}" Color="{StaticResource SystemFillColorSolidNeutralBackground}" />

    <!--  Elevation border brushes  -->

    <LinearGradientBrush x:Key="{x:Static theming:BrushKeys.ControlElevationBorderBrush}" x:Shared="false" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,3">
        <LinearGradientBrush.RelativeTransform>
            <ScaleTransform CenterY="0.5" ScaleY="-1" />
        </LinearGradientBrush.RelativeTransform>
        <LinearGradientBrush.GradientStops>
            <GradientStop Offset="0.33" Color="{StaticResource ControlStrokeColorSecondary}" />
            <GradientStop Offset="1.0" Color="{StaticResource ControlStrokeColorDefault}" />
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="{x:Static theming:BrushKeys.CircleElevationBorderBrush}" MappingMode="RelativeToBoundingBox" StartPoint="0,0" EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Offset="0.50" Color="{StaticResource ControlStrokeColorDefault}" />
            <GradientStop Offset="0.70" Color="{StaticResource ControlStrokeColorSecondary}" />
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="{x:Static theming:BrushKeys.AccentControlElevationBorderBrush}" x:Shared="false" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,3">
        <LinearGradientBrush.RelativeTransform>
            <ScaleTransform CenterY="0.5" ScaleY="-1" />
        </LinearGradientBrush.RelativeTransform>
        <LinearGradientBrush.GradientStops>
            <GradientStop Offset="0.33" Color="{StaticResource ControlStrokeColorOnAccentSecondary}" />
            <GradientStop Offset="1.0" Color="{StaticResource ControlStrokeColorOnAccentDefault}" />
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="{x:Static theming:BrushKeys.TextControlElevationBorderBrush}" x:Shared="false" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,3">
        <LinearGradientBrush.RelativeTransform>
            <ScaleTransform CenterY="0.5" ScaleY="-1" />
        </LinearGradientBrush.RelativeTransform>
        <LinearGradientBrush.GradientStops>
            <GradientStop Offset="0.33" Color="{StaticResource ControlStrokeColorSecondary}" />
            <GradientStop Offset="1.0" Color="{StaticResource ControlStrokeColorDefault}" />
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <DrawingBrush
        x:Key="{x:Static theming:BrushKeys.StripedBackgroundBrush}"
        Stretch="UniformToFill"
        TileMode="Tile"
        Viewport="0,0,10,10"
        ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <DrawingGroup.Children>
                    <GeometryDrawing Brush="#0E000000">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup FillRule="Nonzero">
                                <PathGeometry>
                                    <PathFigure StartPoint="0,0">
                                        <LineSegment Point="25,0" />
                                        <LineSegment Point="100,75" />
                                        <LineSegment Point="100,100" />
                                        <LineSegment Point="75,100" />
                                        <LineSegment Point="0,25" />
                                        <LineSegment Point="0,0" />
                                    </PathFigure>
                                    <PathFigure StartPoint="75,0">
                                        <LineSegment Point="100,25" />
                                        <LineSegment Point="100,0" />
                                    </PathFigure>
                                    <PathFigure StartPoint="0,75">
                                        <LineSegment Point="25,100" />
                                        <LineSegment Point="0,100" />
                                    </PathFigure>
                                </PathGeometry>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup.Children>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.AcrylicBackgroundFillColorDefaultBrush}" Color="{StaticResource AcrylicBackgroundFillColorDefault}" />

    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.WindowBackgroundBrush}" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.WindowForegroundBrush}" Color="{StaticResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.WindowBorderBrush}" Color="{StaticResource WindowBorderColor}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.WindowBorderInactiveBrush}" Color="{StaticResource WindowBorderColorInactive}" />

    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.SystemFillColorInformationalBrush}" Color="{StaticResource SystemFillColorInformational}" />

    <!--  LeftNavigationViewTemplate  -->
    <LinearGradientBrush x:Key="{x:Static theming:BrushKeys.LeftNavigationViewSeparatorBrush}" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#00000000" />
        <GradientStop Offset="0.3" Color="#E0E0E0" />
        <GradientStop Offset="0.7" Color="#E0E0E0" />
        <GradientStop Offset="1" Color="#00000000" />
    </LinearGradientBrush>
</ResourceDictionary>
