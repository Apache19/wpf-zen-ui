    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.SystemAccentColorBrush}" Color="{DynamicResource SystemAccentColor}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.SystemAccentColorPrimaryBrush}" Color="{DynamicResource SystemAccentColorPrimary}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.SystemAccentColorSecondaryBrush}" Color="{DynamicResource SystemAccentColorSecondary}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.SystemAccentColorTertiaryBrush}" Color="{DynamicResource SystemAccentColorTertiary}" />

