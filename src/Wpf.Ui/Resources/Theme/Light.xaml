    <Color x:Key="KeyboardFocusBorderColor">#BE000000</Color>
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.KeyboardFocusBorderColorBrush}" Color="{StaticResource KeyboardFocusBorderColor}" />

