<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="clr-namespace:Wpf.Ui.Markup"
    xmlns:t="clr-namespace:Wpf.Ui.Theming">

    <!--
        A set of a consistent color palette for use inside the application
        PaletteRedColor is used for TitleBar > Close
    -->

    <Color x:Key="{x:Static t:ColorKeys.PalettePrimaryColor}">#333333</Color>
    <Color x:Key="{x:Static t:ColorKeys.PaletteRedColor}">#F44336</Color>
    <Color x:Key="{x:Static t:ColorKeys.PalettePinkColor}">#E91E63</Color>
    <Color x:Key="{x:Static t:ColorKeys.PalettePurpleColor}">#9C27B0</Color>
    <Color x:Key="{x:Static t:ColorKeys.PaletteDeepPurpleColor}">#673AB7</Color>
    <Color x:Key="{x:Static t:ColorKeys.PaletteIndigoColor}">#3F51B5</Color>
    <Color x:Key="{x:Static t:ColorKeys.PaletteBlueColor}">#2196F3</Color>
    <Color x:Key="{x:Static t:ColorKeys.PaletteLightBlueColor}">#03A9F4</Color>
    <Color x:Key="{x:Static t:ColorKeys.PaletteCyanColor}">#00BCD4</Color>
    <Color x:Key="{x:Static t:ColorKeys.PaletteTealColor}">#009688</Color>
    <Color x:Key="{x:Static t:ColorKeys.PaletteGreenColor}">#4CAF50</Color>
    <Color x:Key="{x:Static t:ColorKeys.PaletteLightGreenColor}">#8BC34A</Color>
    <Color x:Key="{x:Static t:ColorKeys.PaletteLimeColor}">#CDDC39</Color>
    <Color x:Key="{x:Static t:ColorKeys.PaletteYellowColor}">#FFEB3B</Color>
    <Color x:Key="{x:Static t:ColorKeys.PaletteAmberColor}">#FFC107</Color>
    <Color x:Key="{x:Static t:ColorKeys.PaletteOrangeColor}">#FF9800</Color>
    <Color x:Key="{x:Static t:ColorKeys.PaletteDeepOrangeColor}">#FF5722</Color>
    <Color x:Key="{x:Static t:ColorKeys.PaletteBrownColor}">#795548</Color>
    <Color x:Key="{x:Static t:ColorKeys.PaletteGreyColor}">#9E9E9E</Color>
    <Color x:Key="{x:Static t:ColorKeys.PaletteBlueGreyColor}">#607D8B</Color>

    <SolidColorBrush x:Key="{x:Static t:BrushKeys.PalettePrimaryBrush}" Color="{m:ColorStaticResource PalettePrimaryColor}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.PaletteRedBrush}" Color="{m:ColorStaticResource PaletteRedColor}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.PalettePinkBrush}" Color="{m:ColorStaticResource PalettePinkColor}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.PalettePurpleBrush}" Color="{m:ColorStaticResource PalettePurpleColor}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.PaletteDeepPurpleBrush}" Color="{m:ColorStaticResource PaletteDeepPurpleColor}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.PaletteIndigoBrush}" Color="{m:ColorStaticResource PaletteIndigoColor}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.PaletteBlueBrush}" Color="{m:ColorStaticResource PaletteBlueColor}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.PaletteLightBlueBrush}" Color="{m:ColorStaticResource PaletteLightBlueColor}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.PaletteCyanBrush}" Color="{m:ColorStaticResource PaletteCyanColor}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.PaletteTealBrush}" Color="{m:ColorStaticResource PaletteTealColor}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.PaletteGreenBrush}" Color="{m:ColorStaticResource PaletteGreenColor}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.PaletteLightGreenBrush}" Color="{m:ColorStaticResource PaletteLightGreenColor}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.PaletteLimeBrush}" Color="{m:ColorStaticResource PaletteLimeColor}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.PaletteYellowBrush}" Color="{m:ColorStaticResource PaletteYellowColor}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.PaletteAmberBrush}" Color="{m:ColorStaticResource PaletteAmberColor}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.PaletteOrangeBrush}" Color="{m:ColorStaticResource PaletteOrangeColor}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.PaletteDeepOrangeBrush}" Color="{m:ColorStaticResource PaletteDeepOrangeColor}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.PaletteBrownBrush}" Color="{m:ColorStaticResource PaletteBrownColor}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.PaletteGreyBrush}" Color="{m:ColorStaticResource PaletteGreyColor}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.PaletteBlueGreyBrush}" Color="{m:ColorStaticResource PaletteBlueGreyColor}" />

</ResourceDictionary>