<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:theming="clr-namespace:Wpf.Ui.Theming">

    <!--
        A set of a consistent color palette for use inside the application
        PaletteRedColor is used for TitleBar > Close
    -->

    <Color x:Key="PalettePrimaryColor">#333333</Color>
    <Color x:Key="PaletteRedColor">#F44336</Color>
    <Color x:Key="PalettePinkColor">#E91E63</Color>
    <Color x:Key="PalettePurpleColor">#9C27B0</Color>
    <Color x:Key="PaletteDeepPurpleColor">#673AB7</Color>
    <Color x:Key="PaletteIndigoColor">#3F51B5</Color>
    <Color x:Key="PaletteBlueColor">#2196F3</Color>
    <Color x:Key="PaletteLightBlueColor">#03A9F4</Color>
    <Color x:Key="PaletteCyanColor">#00BCD4</Color>
    <Color x:Key="PaletteTealColor">#009688</Color>
    <Color x:Key="PaletteGreenColor">#4CAF50</Color>
    <Color x:Key="PaletteLightGreenColor">#8BC34A</Color>
    <Color x:Key="PaletteLimeColor">#CDDC39</Color>
    <Color x:Key="PaletteYellowColor">#FFEB3B</Color>
    <Color x:Key="PaletteAmberColor">#FFC107</Color>
    <Color x:Key="PaletteOrangeColor">#FF9800</Color>
    <Color x:Key="PaletteDeepOrangeColor">#FF5722</Color>
    <Color x:Key="PaletteBrownColor">#795548</Color>
    <Color x:Key="PaletteGreyColor">#9E9E9E</Color>
    <Color x:Key="PaletteBlueGreyColor">#607D8B</Color>

    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.PalettePrimaryBrush}" Color="{StaticResource PalettePrimaryColor}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.PaletteRedBrush}" Color="{StaticResource PaletteRedColor}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.PalettePinkBrush}" Color="{StaticResource PalettePinkColor}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.PalettePurpleBrush}" Color="{StaticResource PalettePurpleColor}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.PaletteDeepPurpleBrush}" Color="{StaticResource PaletteDeepPurpleColor}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.PaletteIndigoBrush}" Color="{StaticResource PaletteIndigoColor}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.PaletteBlueBrush}" Color="{StaticResource PaletteBlueColor}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.PaletteLightBlueBrush}" Color="{StaticResource PaletteLightBlueColor}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.PaletteCyanBrush}" Color="{StaticResource PaletteCyanColor}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.PaletteTealBrush}" Color="{StaticResource PaletteTealColor}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.PaletteGreenBrush}" Color="{StaticResource PaletteGreenColor}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.PaletteLightGreenBrush}" Color="{StaticResource PaletteLightGreenColor}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.PaletteLimeBrush}" Color="{StaticResource PaletteLimeColor}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.PaletteYellowBrush}" Color="{StaticResource PaletteYellowColor}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.PaletteAmberBrush}" Color="{StaticResource PaletteAmberColor}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.PaletteOrangeBrush}" Color="{StaticResource PaletteOrangeColor}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.PaletteDeepOrangeBrush}" Color="{StaticResource PaletteDeepOrangeColor}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.PaletteBrownBrush}" Color="{StaticResource PaletteBrownColor}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.PaletteGreyBrush}" Color="{StaticResource PaletteGreyColor}" />
    <SolidColorBrush x:Key="{x:Static theming:BrushKeys.PaletteBlueGreyBrush}" Color="{StaticResource PaletteBlueGreyColor}" />

</ResourceDictionary>