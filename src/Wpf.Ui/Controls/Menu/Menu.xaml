<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Controls"
    xmlns:m="clr-namespace:Wpf.Ui.Markup">

    <Style x:Key="UiMenuStyle" TargetType="{x:Type Menu}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="{m:DynamicValue ControlContentThemeFontSize}" />
        <Setter Property="Foreground" Value="{m:DynamicBrush TextFillPrimary}" />
        <Setter Property="controls:OrientationAssist.Orientation" Value="Vertical" />
    </Style>

    <Style BasedOn="{StaticResource UiMenuStyle}" TargetType="{x:Type Menu}" />

</ResourceDictionary>
