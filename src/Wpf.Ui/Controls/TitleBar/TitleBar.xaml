<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Controls">

    <!--  ToolWindow TitleBar  -->
    <ControlTemplate x:Key="ToolWindowTitleBarTemplate" TargetType="{x:Type controls:TitleBar}">
        <Grid controls:TitleBar.ElementIdentity="Caption" Background="{TemplateBinding Background}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!--  Title  -->
            <ContentPresenter
                Grid.Column="0"
                Margin="8,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                controls:TextBlock.FontTypography="Caption"
                Content="{TemplateBinding Title}"
                TextBlock.FontSize="12" />
            <!--  User content  -->
            <ContentPresenter
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                controls:TitleBar.ElementIdentity="UserContent"
                Content="{TemplateBinding UserContent}" />
            <!--  Close Button  -->
            <controls:TitleBarButton
                Grid.Column="2"
                Width="22"
                Height="22"
                Margin="0,0,8,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                controls:TitleBar.ElementIdentity="CloseButton"
                Style="{DynamicResource SmallCloseTitleBarButtonStyle}" />
        </Grid>
    </ControlTemplate>

    <Style x:Key="DefaultTitleBarStyle" TargetType="{x:Type controls:TitleBar}">
        <Setter Property="Foreground" Value="{DynamicResource TitleBarForeground}" />
        <Setter Property="Padding" Value="16,4,16,4" />
        <Setter Property="Height" Value="48" />
        <Setter Property="ElementIdentity" Value="Caption" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:TitleBar}">
                    <Grid
                        x:Name="MainGrid"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid
                            x:Name="TitleGrid"
                            Grid.Column="0"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  Custom application icon  -->
                            <ContentPresenter
                                x:Name="Icon"
                                Grid.Column="0"
                                Height="16"
                                VerticalAlignment="Center"
                                controls:TitleBar.ElementIdentity="Icon"
                                AutomationProperties.AutomationId="TitleBarIcon"
                                Content="{TemplateBinding Icon}"
                                Focusable="False"
                                RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>

                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  Title  -->
                            <ContentPresenter
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                controls:TextBlock.FontTypography="Caption"
                                Content="{TemplateBinding Title}" />

                            <!--  User content  -->
                            <ContentPresenter
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                controls:TitleBar.ElementIdentity="UserContent"
                                Content="{TemplateBinding UserContent}" />

                            <!--  System buttons - Close, Restore, Maximize, Minimize  -->
                            <Grid
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <controls:TitleBarButton
                                    x:Name="MinimizeButton"
                                    Grid.Column="0"
                                    Width="44"
                                    Height="30"
                                    controls:TitleBar.ElementIdentity="MinimizeButton"
                                    AutomationProperties.AutomationId="TitleBarMinimizeButton" />

                                <controls:TitleBarButton
                                    x:Name="MaximizeButton"
                                    Grid.Column="1"
                                    Width="44"
                                    Height="30"
                                    controls:TitleBar.ElementIdentity="MaximizeButton"
                                    AutomationProperties.AutomationId="TitleBarMaximizeButton" />

                                <controls:TitleBarButton
                                    x:Name="CloseButton"
                                    Grid.Column="2"
                                    Width="44"
                                    Height="30"
                                    controls:TitleBar.ElementIdentity="CloseButton"
                                    AutomationProperties.AutomationId="TitleBarCloseButton" />
                            </Grid>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Icon" Value="{x:Null}" />
                                <Condition Property="Title" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="TitleGrid" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Icon" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="WindowResizeMode" Value="NoResize">
                            <Setter TargetName="MaximizeButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="MinimizeButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="WindowResizeMode" Value="CanMinimize">
                            <Setter TargetName="MaximizeButton" Property="IsEnabled" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsNcActive" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TitleBarForegroundInactive}" />
            </Trigger>
            <Trigger Property="WindowStyle" Value="ToolWindow">
                <Setter Property="Height" Value="28" />
                <Setter Property="Template" Value="{DynamicResource ToolWindowTitleBarTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource DefaultTitleBarStyle}" TargetType="{x:Type controls:TitleBar}" />

</ResourceDictionary>
