<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Controls">

    <!-- ReSharper disable once Xaml.StaticResourceNotResolved -->
    <!-- ReSharper disable once Xaml.RedundantStyledValue -->

    <Style x:Key="DefaultTextBlockStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">

        <!--
            This setter attaches an internal DynamicResource reference used by WPFUI
            to provide a themed fallback Foreground for framework TextBlock instances
            when no explicit Foreground is set.
        -->
        <Setter Property="controls:TextBlock.DefaultForeground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style BasedOn="{StaticResource DefaultTextBlockStyle}" TargetType="{x:Type TextBlock}" />

</ResourceDictionary>