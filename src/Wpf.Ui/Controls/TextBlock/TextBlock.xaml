<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Controls"
    xmlns:theming="clr-namespace:Wpf.Ui.Theming">

    <!--  ReSharper disable once Xaml.StaticResourceNotResolved  -->
    <!--  ReSharper disable once Xaml.RedundantStyledValue  -->

    <Style
        x:Key="DefaultTextBlockStyle"
        BasedOn="{StaticResource {x:Type TextBlock}}"
        TargetType="{x:Type TextBlock}">

        <!--
            todo: 使用 ThemeInfo 不会加载原生 TextBlock 样式了，此设置已无效。
            应改机制，使用排版样式，并使用组件键，外观关联的前景色也使用键
        -->
        <Setter Property="controls:TextBlock.DefaultForeground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style BasedOn="{StaticResource DefaultTextBlockStyle}" TargetType="{x:Type TextBlock}" />

</ResourceDictionary>