<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Controls"
    xmlns:converters="clr-namespace:Wpf.Ui.Converters"
    xmlns:m="clr-namespace:Wpf.Ui.Markup">

    <Style x:Key="UiButtonFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <!--  ReSharper disable once Xaml.BindingWithContextNotResolved  -->
                    <Border
                        BorderBrush="{m:BrushResource KeyboardFocusBorderColorBrush}"
                        BorderThickness="1"
                        CornerRadius="{Binding AdornedElement.CornerRadius, RelativeSource={RelativeSource AncestorType={x:Type Adorner}}}"
                        IsHitTestVisible="False"
                        SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="UiButtonControlTemplate" TargetType="{x:Type controls:Button}">
        <controls:UiBorder
            x:Name="border"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding VisualBackground}"
            BorderBrush="{TemplateBinding VisualBorderBrush}"
            BorderPlacement="{TemplateBinding controls:UiBorder.BorderPlacement}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}"
            SnapsToDevicePixels="True">
            <Grid HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ContentPresenter
                    x:Name="iconPresenter"
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    ContentSource="Icon"
                    Focusable="False"
                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                    TextElement.FontSize="{TemplateBinding FontSize, Converter={converters:DoubleToDoubleConverter Add=1}}"
                    TextElement.Foreground="{TemplateBinding VisualForeground}" />

                <ContentPresenter
                    Grid.Column="1"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    Focusable="False"
                    RecognizesAccessKey="True"
                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                    TextElement.Foreground="{TemplateBinding VisualForeground}" />

                <ContentPresenter
                    x:Name="rightIconPresenter"
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    ContentSource="RightIcon"
                    Focusable="False"
                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                    TextElement.FontSize="{TemplateBinding FontSize, Converter={converters:DoubleToDoubleConverter Add=1}}"
                    TextElement.Foreground="{TemplateBinding VisualForeground}" />
            </Grid>
        </controls:UiBorder>
        <ControlTemplate.Triggers>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="iconPresenter" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="Content" Value="">
                <Setter TargetName="iconPresenter" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="iconPresenter" Property="Margin" Value="0" />
                <Setter TargetName="iconPresenter" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="RightIcon" Value="{x:Null}">
                <Setter TargetName="rightIconPresenter" Property="Margin" Value="0" />
                <Setter TargetName="rightIconPresenter" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="Icon" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <Setter TargetName="rightIconPresenter" Property="Margin" Value="0" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="" />
                    <Condition Property="Icon" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <Setter TargetName="rightIconPresenter" Property="Margin" Value="0" />
            </MultiTrigger>

            <Trigger Property="Appearance" Value="Normal">
                <Setter TargetName="border" Property="BorderPlacement" Value="Outside" />
            </Trigger>
            <Trigger Property="Appearance" Value="Transparent">
                <Setter TargetName="border" Property="BorderPlacement" Value="Outside" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="UiButtonStyle" TargetType="{x:Type controls:Button}">
        <Setter Property="Padding" Value="{m:VariableResource ButtonThemePadding}" />
        <Setter Property="CornerRadius" Value="{m:VariableResource ControlCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="PressedForeground" Value="{m:BrushResource TextFillColorTertiaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{m:BrushResource ControlFillColorSecondaryBrush}" />
        <Setter Property="MouseOverBackground" Value="{m:BrushResource ControlFillColorPrimaryBrush}" />
        <Setter Property="PressedBackground" Value="{m:BrushResource ControlFillColorTertiaryBrush}" />
        <Setter Property="BorderBrush" Value="{m:BrushResource ControlElevationBorderBrush}" />
        <Setter Property="MouseOverBorderBrush" Value="{m:BrushResource ControlElevationBorderBrush}" />
        <Setter Property="PressedBorderBrush" Value="{m:BrushResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="Template" Value="{StaticResource UiButtonControlTemplate}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource UiButtonFocusVisualStyle}" />
        <Setter Property="controls:UiBorder.BorderPlacement" Value="Inside" />

        <Style.Triggers>
            <!--  TRANSPARENT  -->
            <Trigger Property="Appearance" Value="Transparent">
                <Setter Property="Background" Value="Transparent" />
            </Trigger>

            <!--  ACCENT  -->
            <Trigger Property="Appearance" Value="Accent">
                <Setter Property="Background" Value="{m:BrushResource AccentFillColorDefaultBrush}" />
                <Setter Property="MouseOverBackground" Value="{m:BrushResource AccentFillColorSecondaryBrush}" />
                <Setter Property="PressedBackground" Value="{m:BrushResource AccentFillColorTertiaryBrush}" />
                <Setter Property="Foreground" Value="{m:BrushResource TextOnAccentFillColorPrimaryBrush}" />
                <Setter Property="PressedForeground" Value="{m:BrushResource TextOnAccentFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{m:BrushResource AccentControlElevationBorderBrush}" />
                <Setter Property="MouseOverBorderBrush" Value="{m:BrushResource AccentControlElevationBorderBrush}" />
                <Setter Property="PressedBorderBrush" Value="Transparent" />
            </Trigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Appearance, RelativeSource={RelativeSource Self}}" Value="Accent" />
                    <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="PressedBorderBrush" Value="{m:BrushResource AccentControlElevationBorderBrush}" />
            </MultiDataTrigger>

            <!--  DARK  -->
            <Trigger Property="Appearance" Value="Dark">
                <Setter Property="Background" Value="{m:BrushResource ControlStrongFillColorDarkBrush}" />
                <Setter Property="Foreground" Value="{m:BrushResource TextFillColorLightPrimaryBrush}" />
                <Setter Property="MouseOverBackground" Value="#62000000" />
                <Setter Property="PressedBackground" Value="#52000000" />
                <Setter Property="PressedForeground" Value="{m:BrushResource TextFillColorLightSecondaryBrush}" />
                <Setter Property="PressedBorderBrush" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{m:BrushResource AccentControlElevationBorderBrush}" />
                <Setter Property="MouseOverBorderBrush" Value="{m:BrushResource AccentControlElevationBorderBrush}" />
            </Trigger>

            <!--  LIGHT  -->
            <Trigger Property="Appearance" Value="Light">
                <Setter Property="Background" Value="{m:BrushResource ControlStrongFillColorLightBrush}" />
                <Setter Property="Foreground" Value="{m:BrushResource TextFillColorDarkPrimaryBrush}" />
                <Setter Property="MouseOverBackground" Value="#D3FFFFFF" />
                <Setter Property="PressedBackground" Value="#F3FFFFFF" />
                <Setter Property="PressedForeground" Value="{m:BrushResource TextFillColorDarkSecondaryBrush}" />
                <Setter Property="PressedBorderBrush" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{m:BrushResource AccentControlElevationBorderBrush}" />
                <Setter Property="MouseOverBorderBrush" Value="{m:BrushResource AccentControlElevationBorderBrush}" />
            </Trigger>

            <!--  INFO  -->
            <Trigger Property="Appearance" Value="Info">
                <Setter Property="Background" Value="{m:BrushResource PaletteBlueBrush}" />
                <Setter Property="MouseOverBackground" Value="{m:BrushResource PaletteBlueBrushBright}" />
                <Setter Property="PressedBackground" Value="{m:BrushResource PaletteBlueBrushDim}" />
                <Setter Property="BorderBrush" Value="{m:BrushResource AccentControlElevationBorderBrush}" />
                <Setter Property="MouseOverBorderBrush" Value="{m:BrushResource AccentControlElevationBorderBrush}" />
            </Trigger>

            <!--  DANGER  -->
            <Trigger Property="Appearance" Value="Danger">
                <Setter Property="Background" Value="{m:BrushResource PaletteRedBrush}" />
                <Setter Property="MouseOverBackground" Value="{m:BrushResource PaletteRedBrushBright}" />
                <Setter Property="PressedBackground" Value="{m:BrushResource PaletteRedBrushDim}" />
                <Setter Property="BorderBrush" Value="{m:BrushResource AccentControlElevationBorderBrush}" />
                <Setter Property="MouseOverBorderBrush" Value="{m:BrushResource AccentControlElevationBorderBrush}" />
                <Setter Property="PressedBorderBrush" Value="Transparent" />
            </Trigger>

            <!--  SUCCESS  -->
            <Trigger Property="Appearance" Value="Success">
                <Setter Property="Background" Value="{m:BrushResource PaletteGreenBrush}" />
                <Setter Property="MouseOverBackground" Value="{m:BrushResource PaletteGreenBrushBright}" />
                <Setter Property="PressedBackground" Value="{m:BrushResource PaletteGreenBrushDim}" />
                <Setter Property="BorderBrush" Value="{m:BrushResource AccentControlElevationBorderBrush}" />
                <Setter Property="MouseOverBorderBrush" Value="{m:BrushResource AccentControlElevationBorderBrush}" />
                <Setter Property="PressedBorderBrush" Value="Transparent" />
            </Trigger>

            <!--  CAUTION  -->
            <Trigger Property="Appearance" Value="Caution">
                <Setter Property="Background" Value="{m:BrushResource PaletteOrangeBrush}" />
                <Setter Property="MouseOverBackground" Value="{m:BrushResource PaletteOrangeBrushBright}" />
                <Setter Property="PressedBackground" Value="{m:BrushResource PaletteOrangeBrushDim}" />
                <Setter Property="BorderBrush" Value="{m:BrushResource AccentControlElevationBorderBrush}" />
                <Setter Property="MouseOverBorderBrush" Value="{m:BrushResource AccentControlElevationBorderBrush}" />
                <Setter Property="PressedBorderBrush" Value="Transparent" />
            </Trigger>

            <!--  Disabled  -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{m:BrushResource ControlFillColorDisabledBrush}" />
                <Setter Property="BorderBrush" Value="{m:BrushResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{m:BrushResource TextFillColorDisabledBrush}" />
            </Trigger>

            <!--  Transparent appearance should stay transparent when disabled  -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Appearance" Value="Transparent" />
                    <Condition Property="IsEnabled" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="Transparent" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource UiButtonStyle}" TargetType="{x:Type controls:Button}" />

</ResourceDictionary>
