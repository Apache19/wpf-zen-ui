<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Controls"
    xmlns:converters="clr-namespace:Wpf.Ui.Converters"
    xmlns:m="clr-namespace:Wpf.Ui.Markup">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Controls/Button/ButtonAppearance.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="UiButtonFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <!--  ReSharper disable once Xaml.BindingWithContextNotResolved  -->
                    <Border
                        BorderBrush="{m:DynamicBrush KeyboardFocusBorder}"
                        BorderThickness="1"
                        CornerRadius="{Binding AdornedElement.CornerRadius, RelativeSource={RelativeSource AncestorType={x:Type Adorner}}}"
                        IsHitTestVisible="False"
                        SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="UiButtonControlTemplate" TargetType="{x:Type controls:Button}">
        <controls:UiBorder
            x:Name="border"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding VisualBackground}"
            BorderBrush="{TemplateBinding VisualBorderBrush}"
            BorderPlacement="{TemplateBinding controls:UiBorder.BorderPlacement}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}"
            SnapsToDevicePixels="True">
            <Grid HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ContentPresenter
                    x:Name="iconPresenter"
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    ContentSource="Icon"
                    Focusable="False"
                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                    TextElement.FontSize="{TemplateBinding FontSize, Converter={converters:DoubleToDoubleConverter Add=1}}"
                    TextElement.Foreground="{TemplateBinding VisualForeground}" />

                <ContentPresenter
                    Grid.Column="1"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    Focusable="False"
                    RecognizesAccessKey="True"
                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                    TextElement.Foreground="{TemplateBinding VisualForeground}" />

                <ContentPresenter
                    x:Name="rightIconPresenter"
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    ContentSource="RightIcon"
                    Focusable="False"
                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                    TextElement.FontSize="{TemplateBinding FontSize, Converter={converters:DoubleToDoubleConverter Add=1}}"
                    TextElement.Foreground="{TemplateBinding VisualForeground}" />
            </Grid>
        </controls:UiBorder>
        <ControlTemplate.Triggers>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="iconPresenter" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="Content" Value="">
                <Setter TargetName="iconPresenter" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="iconPresenter" Property="Margin" Value="0" />
                <Setter TargetName="iconPresenter" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="RightIcon" Value="{x:Null}">
                <Setter TargetName="rightIconPresenter" Property="Margin" Value="0" />
                <Setter TargetName="rightIconPresenter" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="Icon" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <Setter TargetName="rightIconPresenter" Property="Margin" Value="0" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="" />
                    <Condition Property="Icon" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <Setter TargetName="rightIconPresenter" Property="Margin" Value="0" />
            </MultiTrigger>

            <Trigger Property="Appearance" Value="Normal">
                <Setter TargetName="border" Property="BorderPlacement" Value="Outside" />
            </Trigger>
            <Trigger Property="Appearance" Value="Transparent">
                <Setter TargetName="border" Property="BorderPlacement" Value="Outside" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="UiButtonStyle" BasedOn="{StaticResource UiButtonAppearanceStyle}" TargetType="{x:Type controls:Button}">
        <Setter Property="Padding" Value="{m:DynamicValue ButtonThemePadding}" />
        <Setter Property="CornerRadius" Value="{m:DynamicValue ControlCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template" Value="{StaticResource UiButtonControlTemplate}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource UiButtonFocusVisualStyle}" />
        <Setter Property="controls:UiBorder.BorderPlacement" Value="Inside" />
    </Style>

    <Style BasedOn="{StaticResource UiButtonStyle}" TargetType="{x:Type controls:Button}" />

</ResourceDictionary>
