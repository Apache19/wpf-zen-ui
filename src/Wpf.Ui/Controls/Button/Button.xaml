<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Controls"
    xmlns:m="clr-namespace:Wpf.Ui.Markup"
    xmlns:t="clr-namespace:Wpf.Ui.Theming">

    <Thickness x:Key="ButtonPadding">11,6,11,6</Thickness>
    <Thickness x:Key="ButtonBorderThemeThickness">1</Thickness>
    <Thickness x:Key="ButtonIconMargin">0,0,8,0</Thickness>

    <!--  明暗主题下的主次颜色逻辑不太一样，让人困惑  -->

    <Style x:Key="{x:Static t:StyleKeys.ButtonStyle}" TargetType="{x:Type Button}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="{m:BrushResource ControlFillColorSecondaryBrush}" />
        <Setter Property="Border.CornerRadius" Value="{m:VariableResource ControlCornerRadius}" />
        <Setter Property="BorderBrush" Value="{m:BrushResource ControlElevationBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource ButtonBorderThemeThickness}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource {x:Static t:StyleKeys.DefaultControlFocusVisualStyle}}" />
        <Setter Property="Foreground" Value="{m:BrushResource TextFillColorPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="{StaticResource ButtonPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <controls:UiBorder
                        x:Name="PART_RootBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding Border.CornerRadius}">
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True" />
                    </controls:UiBorder>
                    <ControlTemplate.Triggers>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDefault" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_RootBorder" Property="Background" Value="{m:BrushResource ControlFillColorPrimaryBrush}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDefault" Value="False" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_RootBorder" Property="Background" Value="{m:BrushResource ControlFillColorTertiaryBrush}" />
                            <Setter TargetName="PART_RootBorder" Property="BorderBrush" Value="{m:BrushResource ControlStrokeColorDefaultBrush}" />
                            <Setter TargetName="ContentPresenter" Property="Control.Foreground" Value="{m:BrushResource TextFillColorTertiaryBrush}" />
                        </MultiTrigger>

                        <Trigger Property="IsDefault" Value="True">
                            <Setter TargetName="PART_RootBorder" Property="Background" Value="{m:BrushResource AccentFillColorDefaultBrush}" />
                            <Setter TargetName="PART_RootBorder" Property="BorderBrush" Value="{m:BrushResource AccentControlElevationBorderBrush}" />
                            <Setter TargetName="ContentPresenter" Property="Control.Foreground" Value="{m:BrushResource TextOnAccentFillColorPrimaryBrush}" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDefault" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_RootBorder" Property="Background" Value="{m:BrushResource AccentFillColorSecondaryBrush}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDefault" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_RootBorder" Property="Background" Value="{m:BrushResource AccentFillColorTertiaryBrush}" />
                            <Setter TargetName="PART_RootBorder" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="ContentPresenter" Property="Control.Foreground" Value="{m:BrushResource TextOnAccentFillColorSecondaryBrush}" />
                        </MultiTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_RootBorder" Property="Background" Value="{m:BrushResource ControlFillColorDisabledBrush}" />
                            <Setter TargetName="PART_RootBorder" Property="BorderBrush" Value="{m:BrushResource ControlStrokeColorDefaultBrush}" />
                            <Setter TargetName="ContentPresenter" Property="Control.Foreground" Value="{m:BrushResource TextFillColorDisabledBrush}" />
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static t:StyleKeys.RepeatButtonStyle}" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{m:BrushResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="{m:BrushResource ControlFillColorSecondaryBrush}" />
        <Setter Property="Border.CornerRadius" Value="{DynamicResource {x:Static t:VariableKeys.ControlCornerRadius}}" />
        <Setter Property="BorderBrush" Value="{m:BrushResource ControlElevationBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource ButtonBorderThemeThickness}" />
        <Setter Property="FocusVisualStyle" Value="{m:StyleResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="{StaticResource ButtonPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border
                        x:Name="PART_RootBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding Border.CornerRadius}">
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_RootBorder" Property="Background" Value="{m:BrushResource ControlFillColorPrimaryBrush}" />
                            <Setter TargetName="PART_RootBorder" Property="BorderBrush" Value="{m:BrushResource ControlElevationBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PART_RootBorder" Property="Background" Value="{m:BrushResource ControlFillColorTertiaryBrush}" />
                            <Setter TargetName="PART_RootBorder" Property="BorderBrush" Value="{m:BrushResource ControlStrokeColorDefaultBrush}" />
                            <Setter TargetName="ContentPresenter" Property="Control.Foreground" Value="{m:BrushResource TextFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_RootBorder" Property="Background" Value="{m:BrushResource SubtleFillColorDisabledBrush}" />
                            <Setter TargetName="PART_RootBorder" Property="BorderBrush" Value="{m:BrushResource ControlStrokeColorDefaultBrush}" />
                            <Setter TargetName="ContentPresenter" Property="Control.Foreground" Value="{m:BrushResource TextFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="UiButtonControlTemplate" TargetType="{x:Type controls:Button}">
        <Border
            x:Name="PART_RootBorder"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding VisualBackground}"
            BorderBrush="{TemplateBinding VisualBorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}"
            SnapsToDevicePixels="True">
            <Grid HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ContentPresenter
                    x:Name="ControlIcon"
                    Grid.Column="0"
                    Margin="{StaticResource ButtonIconMargin}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    ContentSource="Icon"
                    Focusable="False"
                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                    TextElement.Foreground="{TemplateBinding VisualForeground}" />

                <ContentPresenter
                    x:Name="ContentPresenter"
                    Grid.Column="1"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    Focusable="False"
                    RecognizesAccessKey="True"
                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                    TextElement.Foreground="{TemplateBinding VisualForeground}" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="ControlIcon" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="Content" Value="">
                <Setter TargetName="ControlIcon" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="ControlIcon" Property="Margin" Value="0" />
                <Setter TargetName="ControlIcon" Property="Visibility" Value="Collapsed" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="{x:Static t:StyleKeys.UiButtonStyle}" TargetType="{x:Type controls:Button}">
        <Setter Property="Padding" Value="{StaticResource ButtonPadding}" />
        <Setter Property="CornerRadius" Value="{m:VariableResource ControlCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="PressedForeground" Value="{m:BrushResource TextFillColorTertiaryBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource ButtonBorderThemeThickness}" />
        <Setter Property="Background" Value="{m:BrushResource ControlFillColorSecondaryBrush}" />
        <Setter Property="MouseOverBackground" Value="{m:BrushResource ControlFillColorPrimaryBrush}" />
        <Setter Property="PressedBackground" Value="{m:BrushResource ControlFillColorTertiaryBrush}" />
        <Setter Property="BorderBrush" Value="{m:BrushResource ControlStrokeColorSecondaryBrush}" />
        <Setter Property="PressedBorderBrush" Value="{m:BrushResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="Template" Value="{StaticResource UiButtonControlTemplate}" />

        <Setter Property="FocusVisualStyle">
            <Setter.Value>
                <Style>
                    <Setter Property="Control.Template">
                        <Setter.Value>
                            <ControlTemplate>
                                <!--
                                    WPF renders FocusVisualStyle with a separate Control hosted by a
                                    FocusVisualAdorner, so the templated parent here is not the Button.
                                    Bind through Adorner.AdornedElement to keep all four corner radii in
                                    sync with the button, including non-uniform CornerRadius values.
                                -->
                                <!--  ReSharper disable once Xaml.BindingWithContextNotResolved  -->
                                <Border
                                    BorderBrush="{m:BrushResource KeyboardFocusBorderColorBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{Binding AdornedElement.CornerRadius, RelativeSource={RelativeSource AncestorType={x:Type Adorner}}}"
                                    IsHitTestVisible="False"
                                    SnapsToDevicePixels="True" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <!--  TRANSPARENT  -->
            <Trigger Property="Appearance" Value="Transparent">
                <Setter Property="Background" Value="Transparent" />
            </Trigger>

            <!--  ACCENT  -->
            <Trigger Property="Appearance" Value="Accent">
                <Setter Property="BorderThickness" Value="0"></Setter>
                <Setter Property="Background" Value="{m:BrushResource AccentFillColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{m:BrushResource TextOnAccentFillColorPrimaryBrush}" />
                <Setter Property="MouseOverBackground" Value="{m:BrushResource AccentFillColorSecondaryBrush}" />
                <Setter Property="PressedBackground" Value="{m:BrushResource AccentFillColorTertiaryBrush}" />
                <Setter Property="PressedForeground" Value="{m:BrushResource TextOnAccentFillColorSecondaryBrush}" />
            </Trigger>

            <!--  DARK  -->
            <Trigger Property="Appearance" Value="Dark">
                <Setter Property="Background" Value="{m:BrushResource ControlStrongFillColorDarkBrush}" />
                <Setter Property="BorderBrush" Value="{m:BrushResource AccentControlElevationBorderBrush}" />
                <Setter Property="Foreground" Value="{m:BrushResource TextFillColorLightPrimaryBrush}" />
                <Setter Property="MouseOverBackground" Value="#62000000" />
                <Setter Property="MouseOverBorderBrush" Value="{m:BrushResource AccentControlElevationBorderBrush}" />
                <Setter Property="PressedBackground" Value="#52000000" />
                <Setter Property="PressedBorderBrush" Value="Transparent" />
                <Setter Property="PressedForeground" Value="{m:BrushResource TextFillColorLightSecondaryBrush}" />
            </Trigger>

            <!--  LIGHT  -->
            <Trigger Property="Appearance" Value="Light">
                <Setter Property="Background" Value="{m:BrushResource ControlStrongFillColorLightBrush}" />
                <Setter Property="Foreground" Value="{m:BrushResource TextFillColorDarkPrimaryBrush}" />
                <Setter Property="MouseOverBackground" Value="#D3FFFFFF" />
                <Setter Property="PressedBackground" Value="#F3FFFFFF" />
                <Setter Property="PressedForeground" Value="{m:BrushResource TextFillColorDarkSecondaryBrush}" />
            </Trigger>

            <!--  INFO  -->
            <Trigger Property="Appearance" Value="Info">
                <Setter Property="Background" Value="{m:BrushResource PaletteBlueBrush}" />
                <Setter Property="BorderBrush" Value="{m:BrushResource AccentControlElevationBorderBrush}" />
                <Setter Property="Foreground" Value="{m:BrushResource TextFillColorLightPrimaryBrush}" />
                <Setter Property="MouseOverBackground" Value="{m:BrushResource PaletteLightBlueBrush}" />
                <Setter Property="MouseOverBorderBrush" Value="{m:BrushResource AccentControlElevationBorderBrush}" />
                <Setter Property="PressedBackground" Value="{m:BrushResource PaletteCyanBrush}" />
                <Setter Property="PressedBorderBrush" Value="Transparent" />
            </Trigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsDefault, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="PressedBorderBrush" Value="{m:BrushResource AccentControlElevationBorderBrush}" />
            </MultiDataTrigger>

            <!--  DANGER  -->
            <Trigger Property="Appearance" Value="Danger">
                <Setter Property="Background" Value="{m:BrushResource PaletteRedBrush}" />
                <Setter Property="BorderBrush" Value="{m:BrushResource AccentControlElevationBorderBrush}" />
                <Setter Property="MouseOverBackground">
                    <Setter.Value>
                        <SolidColorBrush Opacity="0.8" Color="{m:ColorResource PaletteRedColor}" />
                    </Setter.Value>
                </Setter>
                <Setter Property="MouseOverBorderBrush" Value="{m:BrushResource AccentControlElevationBorderBrush}" />
                <Setter Property="PressedBackground">
                    <Setter.Value>
                        <SolidColorBrush Opacity="0.6" Color="{m:ColorResource PaletteRedColor}" />
                    </Setter.Value>
                </Setter>
                <Setter Property="PressedBorderBrush" Value="Transparent" />
            </Trigger>

            <!--  SUCCESS  -->
            <Trigger Property="Appearance" Value="Success">
                <Setter Property="Background" Value="{m:BrushResource PaletteGreenBrush}" />
                <Setter Property="BorderBrush" Value="{m:BrushResource AccentControlElevationBorderBrush}" />
                <Setter Property="MouseOverBackground">
                    <Setter.Value>
                        <SolidColorBrush Opacity="0.8" Color="{m:ColorResource PaletteGreenColor}" />
                    </Setter.Value>
                </Setter>
                <Setter Property="MouseOverBorderBrush" Value="{m:BrushResource AccentControlElevationBorderBrush}" />
                <Setter Property="PressedBackground">
                    <Setter.Value>
                        <SolidColorBrush Opacity="0.6" Color="{m:ColorResource PaletteGreenColor}" />
                    </Setter.Value>
                </Setter>
                <Setter Property="PressedBorderBrush" Value="Transparent" />
            </Trigger>

            <!--  CAUTION  -->
            <Trigger Property="Appearance" Value="Caution">
                <Setter Property="Background" Value="{m:BrushResource PaletteOrangeBrush}" />
                <Setter Property="BorderBrush" Value="{m:BrushResource AccentControlElevationBorderBrush}" />
                <Setter Property="MouseOverBackground">
                    <Setter.Value>
                        <SolidColorBrush Opacity="0.8" Color="{m:ColorResource PaletteOrangeColor}" />
                    </Setter.Value>
                </Setter>
                <Setter Property="MouseOverBorderBrush" Value="{m:BrushResource AccentControlElevationBorderBrush}" />
                <Setter Property="PressedBackground">
                    <Setter.Value>
                        <SolidColorBrush Opacity="0.6" Color="{m:ColorResource PaletteOrangeColor}" />
                    </Setter.Value>
                </Setter>
                <Setter Property="PressedBorderBrush" Value="Transparent" />
            </Trigger>

            <!--  Disabled  -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{m:BrushResource ControlFillColorDisabledBrush}" />
                <Setter Property="BorderBrush" Value="{m:BrushResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{m:BrushResource TextFillColorDisabledBrush}" />
            </Trigger>

            <!--  Transparent appearance should stay transparent when disabled  -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Appearance" Value="Transparent" />
                    <Condition Property="IsEnabled" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="Transparent" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource {x:Static t:StyleKeys.UiButtonStyle}}" TargetType="{x:Type controls:Button}" />

</ResourceDictionary>
