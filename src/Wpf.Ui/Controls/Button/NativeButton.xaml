<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="clr-namespace:Wpf.Ui.Markup">

    <ControlTemplate x:Key="NativeButtonBaseControlTemplate" TargetType="{x:Type ButtonBase}">
        <Border
            x:Name="border"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding Border.CornerRadius}"
            SnapsToDevicePixels="True">
            <ContentPresenter
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                Focusable="False"
                RecognizesAccessKey="True"
                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="border" Property="Background" Value="{m:BrushResource ControlFillColorPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="true">
                <Setter TargetName="border" Property="Background" Value="{m:BrushResource ControlFillColorTertiaryBrush}" />
                <Setter TargetName="border" Property="BorderBrush" Value="{m:BrushResource ControlStrokeColorDefaultBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="False" />
                    <Condition Property="ToggleButton.IsChecked" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{m:BrushResource ControlFillColorDisabledBrush}" />
                <Setter Property="BorderBrush" Value="{m:BrushResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{m:BrushResource TextFillColorDisabledBrush}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="False" />
                    <Condition Property="ToggleButton.IsChecked" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{m:BrushResource AccentFillColorDisabledBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{m:BrushResource TextOnAccentFillColorDisabledBrush}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="True" />
                    <Condition Property="ToggleButton.IsChecked" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{m:BrushResource SystemAccentColorPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{m:BrushResource TextOnAccentFillColorPrimaryBrush}" />
            </MultiTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="NativeButtonBaseStyle" TargetType="{x:Type ButtonBase}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Padding" Value="{m:VariableResource ButtonThemePadding}" />
        <Setter Property="Border.CornerRadius" Value="{m:VariableResource ControlCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{m:BrushResource ControlFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{m:BrushResource ControlStrokeColorSecondaryBrush}" />
        <Setter Property="Template" Value="{StaticResource NativeButtonBaseControlTemplate}" />
        <Setter Property="FocusVisualStyle" Value="{m:StyleResource DefaultControlFocusVisualStyle}" />
    </Style>

    <Style x:Key="NativeRepeatButtonStyle" BasedOn="{StaticResource NativeButtonBaseStyle}" TargetType="{x:Type RepeatButton}">
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false" />
    </Style>

    <Style BasedOn="{StaticResource NativeRepeatButtonStyle}" TargetType="{x:Type RepeatButton}" />

    <Style BasedOn="{StaticResource NativeButtonBaseStyle}" TargetType="{x:Type ToggleButton}" />

    <Style BasedOn="{StaticResource NativeButtonBaseStyle}" TargetType="{x:Type Button}" />
</ResourceDictionary>