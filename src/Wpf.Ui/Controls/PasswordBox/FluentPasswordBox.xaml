<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Controls"
    xmlns:converters="clr-namespace:Wpf.Ui.Converters">

    <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True"/>
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    <converters:HasTextToVisibilityConverter x:Key="PlaceholderVisibilityConverter"/>

    <Style TargetType="{x:Type controls:FluentPasswordBox}">
        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="{x:Type controls:FluentPasswordBox}">

                    <Grid>

                        <TextBlock
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="#888"
                            IsHitTestVisible="False"
                            Text="{TemplateBinding PlaceholderText}">

                            <TextBlock.Visibility>
                                <MultiBinding Converter="{StaticResource PlaceholderVisibilityConverter}">
                                    <Binding Path="Password" RelativeSource="{RelativeSource TemplatedParent}" />
                                </MultiBinding>
                            </TextBlock.Visibility>

                        </TextBlock>

                        <PasswordBox
                            x:Name="PART_PasswordBox"
                            Padding="6"
                            Visibility="{Binding IsPasswordRevealed, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource InverseBoolToVisibility}}" />

                        <TextBox
                            x:Name="PART_TextBox"
                            Padding="6"
                            Visibility="{Binding IsPasswordRevealed, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibility}}" />

                        <ToggleButton
                            x:Name="PART_RevealButton"
                            Width="32"
                            Margin="0,0,4,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="👁"
                            IsChecked="{Binding IsPasswordRevealed, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            Visibility="{TemplateBinding RevealButtonVisibility}" />

                        <TextBlock
                            Margin="0,0,4,-18"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Foreground="OrangeRed"
                            Text="Caps Lock"
                            Visibility="{Binding IsCapsLockOn, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibility}}" />

                    </Grid>

                </ControlTemplate>

            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>