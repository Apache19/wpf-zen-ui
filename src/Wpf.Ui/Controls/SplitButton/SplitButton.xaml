<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Controls"
    xmlns:converters="clr-namespace:Wpf.Ui.Converters"
    xmlns:m="clr-namespace:Wpf.Ui.Markup"
    xmlns:t="clr-namespace:Wpf.Ui.Theming">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Controls/Button/ButtonAppearance.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Each segment paints only the outside half of the composite outline. In particular, neither
        button paints the shared edge; this avoids a double-width seam and lets the independently
        animated button backgrounds meet cleanly.
    -->
    <converters:ThicknessTransformConverter x:Key="SplitButtonLeftBorderThicknessConverter" CopySides="Left,Top,Bottom" />
    <converters:ThicknessTransformConverter x:Key="SplitButtonRightBorderThicknessConverter" CopySides="Top,Right,Bottom" />
    <converters:CornerRadiusTransformConverter x:Key="SplitButtonLeftCornerRadiusConverter" CopyCorners="TopLeft,BottomLeft" />
    <converters:CornerRadiusTransformConverter x:Key="SplitButtonRightCornerRadiusConverter" CopyCorners="TopRight,BottomRight" />

    <Style x:Key="{x:Static t:StyleKeys.UiSplitButtonStyle}" BasedOn="{StaticResource UiButtonAppearanceStyle}" TargetType="{x:Type controls:SplitButton}">
        <Setter Property="Padding" Value="{m:VariableResource ButtonThemePadding}" />
        <Setter Property="CornerRadius" Value="{m:VariableResource ControlCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{m:StyleResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SplitButton}">
                    <!--
                        The wrapper has no input surface of its own. The two ui:Button instances are
                        intentional: each segment owns its pressed/hover state, while code-behind
                        translates their ButtonBase.Click events into the SplitButton contract.
                    -->
                    <Grid SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <controls:Button
                            x:Name="PART_PrimaryButton"
                            Grid.Column="0"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Appearance="{TemplateBinding Appearance}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness, Converter={StaticResource SplitButtonLeftBorderThicknessConverter}}"
                            ClickMode="{TemplateBinding ClickMode}"
                            Command="{TemplateBinding Command}"
                            CommandParameter="{TemplateBinding CommandParameter}"
                            CommandTarget="{TemplateBinding CommandTarget}"
                            Content="{TemplateBinding Content}"
                            ContentStringFormat="{TemplateBinding ContentStringFormat}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                            CornerRadius="{TemplateBinding CornerRadius, Converter={StaticResource SplitButtonLeftCornerRadiusConverter}}"
                            DisabledBackground="{TemplateBinding DisabledBackground}"
                            DisabledBorderBrush="{TemplateBinding DisabledBorderBrush}"
                            DisabledForeground="{TemplateBinding DisabledForeground}"
                            Focusable="False"
                            Foreground="{TemplateBinding Foreground}"
                            Icon="{TemplateBinding Icon}"
                            IsTabStop="False"
                            MouseOverBackground="{TemplateBinding MouseOverBackground}"
                            MouseOverBorderBrush="{TemplateBinding MouseOverBorderBrush}"
                            PressedBackground="{TemplateBinding PressedBackground}"
                            PressedBorderBrush="{TemplateBinding PressedBorderBrush}"
                            PressedForeground="{TemplateBinding PressedForeground}"
                            TabIndex="{TemplateBinding TabIndex}" />

                        <controls:Button
                            x:Name="PART_DropDownButton"
                            Grid.Column="1"
                            MinWidth="32"
                            Padding="11,0"
                            VerticalContentAlignment="Center"
                            Appearance="{TemplateBinding Appearance}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness, Converter={StaticResource SplitButtonRightBorderThicknessConverter}}"
                            ClickMode="Press"
                            CornerRadius="{TemplateBinding CornerRadius, Converter={StaticResource SplitButtonRightCornerRadiusConverter}}"
                            DisabledBackground="{TemplateBinding DisabledBackground}"
                            DisabledBorderBrush="{TemplateBinding DisabledBorderBrush}"
                            DisabledForeground="{TemplateBinding DisabledForeground}"
                            Focusable="False"
                            Foreground="{TemplateBinding Foreground}"
                            IsTabStop="False"
                            MouseOverBackground="{TemplateBinding MouseOverBackground}"
                            MouseOverBorderBrush="{TemplateBinding MouseOverBorderBrush}"
                            PressedBackground="{TemplateBinding PressedBackground}"
                            PressedBorderBrush="{TemplateBinding PressedBorderBrush}"
                            PressedForeground="{TemplateBinding PressedForeground}">
                            <controls:Button.Icon>
                                <controls:SymbolIcon FontSize="10" Symbol="ChevronDown24" />
                            </controls:Button.Icon>
                        </controls:Button>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource {x:Static t:StyleKeys.UiSplitButtonStyle}}" TargetType="{x:Type controls:SplitButton}" />

</ResourceDictionary>
