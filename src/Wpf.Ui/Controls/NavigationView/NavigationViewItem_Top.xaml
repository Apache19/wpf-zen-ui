<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Controls"
    xmlns:m="clr-namespace:Wpf.Ui.Markup">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Controls/NavigationView/NavigationViewItem_Submenu.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <ControlTemplate x:Key="NavigationViewItemTopTemplate" TargetType="{x:Type controls:NavigationViewItem}">
        <Grid>
            <Button
                x:Name="PART_HeaderButton"
                MinHeight="44"
                Padding="12,0"
                HorizontalContentAlignment="Stretch"
                Background="{m:BrushResource SubtleFillColorTransparentBrush}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Content="{TemplateBinding Header}"
                ContentTemplate="{TemplateBinding HeaderTemplate}"
                ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                OverridesDefaultStyle="True"
                Style="{x:Null}">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Border
                                x:Name="HeaderSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <ContentPresenter
                                        x:Name="IconPresenter"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Content="{Binding Icon, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationViewItem}}}" />
                                    <ContentPresenter
                                        VerticalAlignment="Center"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                        RecognizesAccessKey="True" />
                                    <ContentPresenter
                                        x:Name="InfoBadgePresenter"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Content="{Binding InfoBadge, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationViewItem}}}" />
                                </StackPanel>
                            </Border>
                            <Rectangle
                                x:Name="ActiveIndicator"
                                Width="16"
                                Height="3"
                                Margin="0,0,0,3"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Fill="{m:BrushResource AccentSelectionBrush}"
                                RadiusX="1.5"
                                RadiusY="1.5"
                                Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsBranchActive, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationViewItem}}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderSurface" Property="Background" Value="{m:BrushResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HeaderSurface" Property="Background" Value="{m:BrushResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <!--<DataTrigger Binding="{Binding IsSubmenuOpen, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationViewItem}}}" Value="True">
                                <Setter TargetName="HeaderSurface" Property="Background" Value="{m:BrushResource SubtleFillColorSecondaryBrush}" />
                            </DataTrigger>-->
                            <DataTrigger Binding="{Binding Icon, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationViewItem}}}" Value="{x:Null}">
                                <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding InfoBadge, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationViewItem}}}" Value="{x:Null}">
                                <Setter TargetName="InfoBadgePresenter" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Button.ContextMenu>
                    <!--
                        The control populates this root with a complete native MenuItem projection
                        before opening. ContextMenu/MenuItem therefore own the entire detached menu
                        session, including every cascading Popup, focus transition, capture and
                        keyboard gesture; no NavigationViewItem visual enters this presentation tree.
                    -->
                    <ContextMenu
                        x:Name="PART_SubMenuContextMenu"
                        Placement="Bottom"
                        Style="{Binding SubmenuContextMenuStyle, RelativeSource={RelativeSource TemplatedParent}}" />
                </Button.ContextMenu>
            </Button>
        </Grid>
    </ControlTemplate>

</ResourceDictionary>
