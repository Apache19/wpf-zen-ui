<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Controls"
    xmlns:m="clr-namespace:Wpf.Ui.Markup">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Controls/NavigationView/NavigationViewItem_Left.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Controls/NavigationView/NavigationViewItem_LeftFluent.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Controls/NavigationView/NavigationViewItem_Top.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Controls/NavigationView/NavigationViewItem_Bottom.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="NavigationViewItemDefaultStyle" TargetType="{x:Type controls:NavigationViewItem}">
        <Setter Property="Border.CornerRadius" Value="{m:DynamicValue ControlCornerRadius}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel IsItemsHost="True" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="SubmenuContextMenuStyle" Value="{StaticResource NavigationViewItemSubmenuContextMenuStyle}" />
        <Setter Property="SubmenuMenuItemStyle" Value="{StaticResource NavigationViewItemSubmenuMenuItemStyle}" />
        <Setter Property="Template" Value="{StaticResource NavigationViewItemLeftTemplate}" />
        <!--
            Generated containers receive HeaderTemplate, child ItemTemplate, and hierarchical
            ItemsSource through WPF's HeaderedItemsControl preparation pipeline. Keeping those
            properties unset here is essential: a style value would mask values supplied by a
            HierarchicalDataTemplate and make child generation depend on property inheritance.
        -->
        <Style.Triggers>
            <Trigger Property="PaneDisplayMode" Value="LeftMinimal">
                <Setter Property="Template" Value="{StaticResource NavigationViewItemLeftCompactTemplate}" />
            </Trigger>
            <Trigger Property="PaneDisplayMode" Value="LeftFluent">
                <Setter Property="Template" Value="{StaticResource NavigationViewItemLeftFluentTemplate}" />
            </Trigger>
            <Trigger Property="PaneDisplayMode" Value="Top">
                <Setter Property="Template" Value="{StaticResource NavigationViewItemTopTemplate}" />
            </Trigger>
            <Trigger Property="PaneDisplayMode" Value="Bottom">
                <Setter Property="Template" Value="{StaticResource NavigationViewItemBottomTemplate}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="PaneDisplayMode" Value="Left" />
                    <Condition Property="IsPaneOpen" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="Template" Value="{StaticResource NavigationViewItemLeftCompactTemplate}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource NavigationViewItemDefaultStyle}" TargetType="{x:Type controls:NavigationViewItem}" />

</ResourceDictionary>
