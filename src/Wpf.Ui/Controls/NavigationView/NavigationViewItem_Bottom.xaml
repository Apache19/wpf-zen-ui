<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Controls"
    xmlns:m="clr-namespace:Wpf.Ui.Markup">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Controls/NavigationView/NavigationViewItem_Submenu.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <ControlTemplate x:Key="NavigationViewItemBottomTemplate" TargetType="{x:Type controls:NavigationViewItem}">
        <Grid>
            <Button
                x:Name="PART_HeaderButton"
                MinHeight="40"
                Padding="12,0"
                HorizontalContentAlignment="Stretch"
                Background="{m:DynamicBrush SubtleFillTransparent}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Content="{TemplateBinding Header}"
                ContentTemplate="{TemplateBinding HeaderTemplate}"
                ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                OverridesDefaultStyle="True"
                Style="{x:Null}">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border
                            x:Name="HeaderSurface"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <ContentPresenter
                                    x:Name="IconPresenter"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Content="{Binding Icon, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationViewItem}}}" />
                                <ContentPresenter
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                    RecognizesAccessKey="True" />
                                <ContentPresenter
                                    x:Name="InfoBadgePresenter"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Content="{Binding InfoBadge, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationViewItem}}}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderSurface" Property="Background" Value="{m:DynamicBrush SubtleFillSecondary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HeaderSurface" Property="Background" Value="{m:DynamicBrush SubtleFillTertiary}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationViewItem}}}" Value="True">
                                <Setter TargetName="HeaderSurface" Property="Background" Value="{m:DynamicBrush SubtleFillSecondary}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDescendantActive, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationViewItem}}}" Value="True">
                                <Setter TargetName="HeaderSurface" Property="Background" Value="{m:DynamicBrush SubtleFillSecondary}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSubmenuOpen, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationViewItem}}}" Value="True">
                                <Setter TargetName="HeaderSurface" Property="Background" Value="{m:DynamicBrush SubtleFillSecondary}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Icon, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationViewItem}}}" Value="{x:Null}">
                                <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding InfoBadge, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationViewItem}}}" Value="{x:Null}">
                                <Setter TargetName="InfoBadgePresenter" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Button.ContextMenu>
                    <!--  See NavigationViewItemTopTemplate for the native projection contract.  -->
                    <ContextMenu
                        x:Name="PART_SubMenuContextMenu"
                        Placement="Top"
                        Style="{Binding SubmenuContextMenuStyle, RelativeSource={RelativeSource TemplatedParent}}"
                        VerticalOffset="-8" />
                </Button.ContextMenu>
            </Button>
        </Grid>
    </ControlTemplate>

</ResourceDictionary>
