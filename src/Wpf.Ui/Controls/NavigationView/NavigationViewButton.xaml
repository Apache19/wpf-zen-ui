<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Controls"
    xmlns:m="clr-namespace:Wpf.Ui.Markup">

    <!--
        Shared visual contract for NavigationView-owned commands. Host-specific layout
        belongs to the derived Pane and TitleBar styles below, so neither host needs to
        impose NavigationView-specific values on contributed content.
    -->
    <Style x:Key="BaseNavigationViewButtonStyle" TargetType="{x:Type controls:NavigationViewButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="Border.CornerRadius" Value="{m:VariableResource ControlCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:NavigationViewButton}">
                    <Border
                        x:Name="LayoutRoot"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding Border.CornerRadius}"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="GridColumn1" Width="38" />
                                <ColumnDefinition x:Name="GridColumn2" Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--
                                The layout is fairly rigid — at minimum the icon must align with
                                NavigationViewItem, so Padding is applied to Content while the icon
                                strictly occupies a 40×40 layout region at 16 FontSize.
                            -->

                            <!--
                                Icon is an unconstrained content slot. The surrounding Style chooses
                                role-based defaults, while this template only presents the resulting
                                object. An explicit or derived-style Icon value can therefore replace
                                the default and can use implicit data templates.

                                The SymbolRegular template deliberately lives on this presenter rather
                                than in the containing theme dictionary. Its implicit lookup is therefore
                                confined to this icon slot and cannot change how an application presents
                                SymbolRegular values elsewhere. Keeping the template implicit locally also
                                lets UIElement values use ContentPresenter's native direct-visual path.
                            -->
                            <Grid
                                x:Name="IconRoot"
                                Grid.Column="0"
                                Margin="1,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0.5, 0.5"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                TextElement.FontSize="16">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="IconScaleTransform" ScaleX="1.0" ScaleY="1.0" />
                                </Grid.RenderTransform>

                                <ContentPresenter
                                    x:Name="iconPresenter"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Icon}"
                                    Focusable="False"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                    <ContentPresenter.Resources>
                                        <!--
                                            Role defaults are value objects because a Style setter is shared
                                            by all controls, whereas a UIElement can have only one visual parent.
                                            The template creates an independent SymbolIcon for each presenter.
                                        -->
                                        <DataTemplate DataType="{x:Type controls:SymbolRegular}">
                                            <controls:SymbolIcon Symbol="{Binding}" />
                                        </DataTemplate>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Grid>

                            <ContentPresenter
                                x:Name="contentPresenter"
                                Grid.Column="1"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />

                            <!--
                                PaneTitle is navigation state rather than button Content. Keeping a
                                separate presenter lets an application supply Content independently,
                                replace this presenter, or choose another rendering primitive in a
                                custom template. Access-key recognition is enabled because this value
                                labels an actionable button rather than passive text.
                            -->
                            <ContentPresenter
                                x:Name="paneTitlePresenter"
                                Grid.Column="1"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding PaneTitle}"
                                Focusable="False"
                                RecognizesAccessKey="True"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="LayoutRoot" Property="Background" Value="{m:BrushResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="LayoutRoot" Property="Background" Value="{m:BrushResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{m:BrushResource SubtleFillColorDisabledBrush}" />
                            <Setter Property="Foreground" Value="{m:BrushResource TextFillColorDisabledBrush}" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="contentPresenter" Property="Margin" Value="0" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Content" Value="{x:Null}" />
                                <Condition Property="IsPaneOpen" Value="True" />
                                <Condition Property="Placement" Value="Pane" />
                                <Condition Property="Role" Value="PaneToggle" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="contentPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="paneTitlePresenter" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <!--  A null title must not contribute Padding to an otherwise icon-only button.  -->
                        <Trigger Property="PaneTitle" Value="{x:Null}">
                            <Setter TargetName="paneTitlePresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <EventTrigger RoutedEvent="ButtonBase.PreviewMouseLeftButtonDown">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                                        Storyboard.TargetName="IconScaleTransform"
                                        Storyboard.TargetProperty="(ScaleTransform.ScaleX)"
                                        From="1.0"
                                        To="0.66"
                                        Duration="0:0:0.08" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="ButtonBase.PreviewMouseLeftButtonUp">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                                        Storyboard.TargetName="IconScaleTransform"
                                        Storyboard.TargetProperty="(ScaleTransform.ScaleX)"
                                        From="0.66"
                                        To="1.0"
                                        Duration="0:0:0.08" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Role" Value="Back">
                <Setter Property="Icon" Value="{x:Static controls:SymbolRegular.ArrowLeft48}" />
            </Trigger>
            <Trigger Property="Role" Value="PaneToggle">
                <Setter Property="Icon" Value="{x:Static controls:SymbolRegular.LineHorizontal320}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource BaseNavigationViewButtonStyle}" TargetType="{x:Type controls:NavigationViewButton}">
        <Style.Triggers>
            <Trigger Property="Placement" Value="Pane">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Trigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Placement, RelativeSource={RelativeSource Self}}" Value="Pane" />
                    <Condition Binding="{Binding PaneTitle, RelativeSource={RelativeSource AncestorType=controls:NavigationView}}" Value="{x:Null}" />
                </MultiDataTrigger.Conditions>
                <Setter Property="HorizontalAlignment" Value="Left" />
            </MultiDataTrigger>
            <Trigger Property="Placement" Value="TitleBar">
                <Setter Property="Margin" Value="4,0" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
