<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Controls"
    xmlns:markup="clr-namespace:Wpf.Ui.Markup">

    <!--
        All operating-system strategies share this visual tree. FluentWindow coerces BorderThickness to a Win10
        top line, a four-sided pre-Win11 client fallback, or zero when DWM owns the visible outline. Win11's fully
        client-rendered mode retains a one-physical-pixel DWM extension even without a Backdrop, so it does not need
        a second WPF border. Keeping the decision in the window prevents templates from branching on OS versions.
    -->
    <ControlTemplate x:Key="FluentWindowTemplate" TargetType="{x:Type controls:FluentWindow}">
        <Border
            x:Name="WindowBorder"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}">
            <Grid>
                <AdornerDecorator>
                    <ContentPresenter />
                </AdornerDecorator>
                <ResizeGrip
                    x:Name="WindowResizeGrip"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    IsTabStop="False"
                    Visibility="Collapsed" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="ResizeMode" Value="CanResizeWithGrip" />
                    <Condition Property="ActualWindowState" Value="Normal" />
                </MultiTrigger.Conditions>
                <Setter TargetName="WindowResizeGrip" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <Trigger Property="IsNcActive" Value="False">
                <Setter TargetName="WindowBorder" Property="BorderBrush" Value="{markup:BrushResource WindowBorderInactiveBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsAccentOnTitleBarAndBorder" Value="True" />
                    <Condition Property="IsNcActive" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="WindowBorder" Property="BorderBrush" Value="{markup:BrushResource AccentStrokeBrush}" />
            </MultiTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="DefaultFluentWindowStyle" TargetType="{x:Type controls:FluentWindow}">
        <Setter Property="Background" Value="{markup:BrushResource WindowBackgroundBrush}" />
        <Setter Property="Foreground" Value="{markup:BrushResource WindowForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{markup:BrushResource WindowBorderBrush}" />
        <Setter Property="Template" Value="{StaticResource FluentWindowTemplate}" />
    </Style>

    <Style BasedOn="{StaticResource DefaultFluentWindowStyle}" TargetType="{x:Type controls:FluentWindow}" />

</ResourceDictionary>
