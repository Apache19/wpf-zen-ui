<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Controls"
    xmlns:markup="clr-namespace:Wpf.Ui.Markup">

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <Style x:Key="DropDownButtonFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                    <Border
                        BorderBrush="{markup:BrushResource KeyboardFocusBorderColorBrush}"
                        BorderThickness="1"
                        CornerRadius="{Binding AdornedElement.CornerRadius, RelativeSource={RelativeSource AncestorType={x:Type Adorner}}}"
                        IsHitTestVisible="False"
                        SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultUiDropDownButtonStyle" TargetType="{x:Type controls:DropDownButton}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource DropDownButtonFocusVisualStyle}" />
        <Setter Property="Padding" Value="11,6" />
        <Setter Property="CornerRadius" Value="{markup:VariableResource ControlCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="PressedForeground" Value="{markup:BrushResource TextFillColorTertiaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{markup:BrushResource ControlFillColorSecondaryBrush}" />
        <Setter Property="MouseOverBackground" Value="{markup:BrushResource ControlFillColorPrimaryBrush}" />
        <Setter Property="PressedBackground" Value="{markup:BrushResource ControlFillColorTertiaryBrush}" />
        <Setter Property="BorderBrush" Value="{markup:BrushResource ControlStrokeColorSecondaryBrush}" />
        <Setter Property="PressedBorderBrush" Value="{markup:BrushResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="IsDropDownOpen" Value="False" />
        <Setter Property="ContextMenu.Placement" Value="Bottom" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:DropDownButton}">
                    <Border
                        x:Name="ContentBorder"
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        MinWidth="{TemplateBinding MinWidth}"
                        MinHeight="{TemplateBinding MinHeight}"
                        HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalAlignment}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <Grid HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter
                                    x:Name="ControlIcon"
                                    Grid.Column="0"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Icon}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Focusable="False"
                                    TextElement.FontSize="{TemplateBinding FontSize}"
                                    TextElement.Foreground="{TemplateBinding Foreground}" />

                                <ContentPresenter
                                    x:Name="ContentPresenter"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}"
                                    RecognizesAccessKey="True"
                                    TextElement.Foreground="{TemplateBinding Foreground}" />

                                <Grid
                                    x:Name="ChevronGrid"
                                    Grid.Column="2"
                                    Margin="8,0,0,0"
                                    Visibility="{TemplateBinding IsDropDownArrowVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <controls:SymbolIcon FontSize="10" Symbol="ChevronDown24" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsPressed" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ContentBorder" Property="Background" Value="{Binding MouseOverBackground, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{Binding MouseOverBorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ContentBorder" Property="Background" Value="{Binding PressedBackground, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{Binding PressedBorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="ContentPresenter" Property="TextElement.Foreground" Value="{Binding PressedForeground, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="ControlIcon" Property="TextElement.Foreground" Value="{Binding PressedForeground, RelativeSource={RelativeSource TemplatedParent}}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ContentBorder" Property="Background" Value="{markup:BrushResource ControlFillColorDisabledBrush}" />
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{markup:BrushResource ControlStrokeColorDefaultBrush}" />
                            <Setter TargetName="ContentPresenter" Property="TextElement.Foreground" Value="{markup:BrushResource TextFillColorDisabledBrush}" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="ControlIcon" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="Content" Value="">
                            <Setter TargetName="ControlIcon" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="ControlIcon" Property="Margin" Value="0" />
                            <Setter TargetName="ControlIcon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Appearance" Value="Transparent">
                <Setter Property="Background" Value="Transparent" />
            </Trigger>
            <Trigger Property="Appearance" Value="Accent">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="BorderBrush" Value="{x:Null}" />
                <Setter Property="Background" Value="{markup:BrushResource AccentFillColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{markup:BrushResource TextOnAccentFillColorPrimaryBrush}" />
                <Setter Property="MouseOverBackground" Value="{markup:BrushResource AccentFillColorSecondaryBrush}" />
                <Setter Property="PressedBackground" Value="{markup:BrushResource AccentFillColorTertiaryBrush}" />
                <Setter Property="PressedForeground" Value="{markup:BrushResource TextOnAccentFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="Appearance" Value="Dark">
                <Setter Property="Background" Value="{markup:BrushResource ControlStrongFillColorDarkBrush}" />
                <Setter Property="Foreground" Value="{markup:BrushResource TextFillColorLightPrimaryBrush}" />
                <Setter Property="MouseOverBackground" Value="#62000000" />
                <Setter Property="PressedBackground" Value="#52000000" />
                <Setter Property="PressedForeground" Value="{markup:BrushResource TextFillColorLightSecondaryBrush}" />
            </Trigger>
            <Trigger Property="Appearance" Value="Light">
                <Setter Property="Background" Value="{markup:BrushResource ControlStrongFillColorLightBrush}" />
                <Setter Property="Foreground" Value="{markup:BrushResource TextFillColorDarkPrimaryBrush}" />
                <Setter Property="MouseOverBackground" Value="#D3FFFFFF" />
                <Setter Property="PressedBackground" Value="#F3FFFFFF" />
                <Setter Property="PressedForeground" Value="{markup:BrushResource TextFillColorDarkSecondaryBrush}" />
            </Trigger>
            <Trigger Property="Appearance" Value="Info">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="BorderBrush" Value="{x:Null}" />
                <Setter Property="Background" Value="{markup:BrushResource PaletteBlueBrush}" />
                <Setter Property="Foreground" Value="{markup:BrushResource TextFillColorLightPrimaryBrush}" />
                <Setter Property="MouseOverBackground" Value="{markup:BrushResource PaletteLightBlueBrush}" />
                <Setter Property="PressedBackground" Value="{markup:BrushResource PaletteCyanBrush}" />
                <Setter Property="PressedForeground" Value="{markup:BrushResource TextOnAccentFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="Appearance" Value="Danger">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="BorderBrush" Value="{x:Null}" />
                <Setter Property="Background" Value="{markup:BrushResource PaletteRedBrush}" />
                <Setter Property="MouseOverBackground">
                    <Setter.Value>
                        <SolidColorBrush Opacity="0.8" Color="{markup:ColorResource PaletteRedColor}" />
                    </Setter.Value>
                </Setter>
                <Setter Property="PressedBackground">
                    <Setter.Value>
                        <SolidColorBrush Opacity="0.6" Color="{markup:ColorResource PaletteRedColor}" />
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="Appearance" Value="Success">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="BorderBrush" Value="{x:Null}" />
                <Setter Property="Background" Value="{markup:BrushResource PaletteGreenBrush}" />
                <Setter Property="MouseOverBackground">
                    <Setter.Value>
                        <SolidColorBrush Opacity="0.8" Color="{markup:ColorResource PaletteGreenColor}" />
                    </Setter.Value>
                </Setter>
                <Setter Property="PressedBackground">
                    <Setter.Value>
                        <SolidColorBrush Opacity="0.6" Color="{markup:ColorResource PaletteGreenColor}" />
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="Appearance" Value="Caution">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="BorderBrush" Value="{x:Null}" />
                <Setter Property="Background" Value="{markup:BrushResource PaletteOrangeBrush}" />
                <Setter Property="MouseOverBackground">
                    <Setter.Value>
                        <SolidColorBrush Opacity="0.8" Color="{markup:ColorResource PaletteOrangeColor}" />
                    </Setter.Value>
                </Setter>
                <Setter Property="PressedBackground">
                    <Setter.Value>
                        <SolidColorBrush Opacity="0.6" Color="{markup:ColorResource PaletteOrangeColor}" />
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{markup:BrushResource ControlFillColorDisabledBrush}" />
                <Setter Property="BorderBrush" Value="{markup:BrushResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{markup:BrushResource TextFillColorDisabledBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Appearance" Value="Transparent" />
                    <Condition Property="IsEnabled" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="Transparent" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource DefaultUiDropDownButtonStyle}" TargetType="{x:Type controls:DropDownButton}" />

</ResourceDictionary>
