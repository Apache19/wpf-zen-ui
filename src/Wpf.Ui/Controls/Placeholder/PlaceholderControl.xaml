<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Controls"
    xmlns:markup="clr-namespace:Wpf.Ui.Markup">

    <Style BasedOn="{StaticResource {x:Type ContentControl}}" TargetType="{x:Type controls:PlaceholderControl}">
        <Setter Property="Foreground" Value="{markup:BrushResource TextPlaceholderColorBrush}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

</ResourceDictionary>