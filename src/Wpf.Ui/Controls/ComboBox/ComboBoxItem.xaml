<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Wpf.Ui.Converters"
    xmlns:m="clr-namespace:Wpf.Ui.Markup"
    xmlns:t="clr-namespace:Wpf.Ui.Theming">

    <converters:DoubleToDoubleConverter x:Key="ComboBoxItemActiveIndicatorHeightConverter" Multiply="0.5" />

    <Style x:Key="{x:Static t:StyleKeys.DefaultComboBoxItemStyle}" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Border.CornerRadius" Value="{m:VariableResource ControlCornerRadius}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{m:StyleResource DefaultControlFocusVisualStyle}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="10,8,8,8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Grid Background="Transparent">
                        <Border
                            Name="ContentBorder"
                            Margin="6,4,6,0"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding Border.CornerRadius}"
                            SnapsToDevicePixels="True">
                            <Grid>
                                <ContentPresenter
                                    x:Name="PART_ContentPresenter"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <Rectangle
                                    x:Name="ActiveIndicator"
                                    Width="3"
                                    Height="{Binding ActualHeight, ElementName=ContentBorder, Converter={StaticResource ComboBoxItemActiveIndicatorHeightConverter}}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Fill="{m:BrushResource AccentSelectionBrush}"
                                    RadiusX="1.5"
                                    RadiusY="1.5"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ContentBorder" Property="Background" Value="{m:BrushResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="PART_ContentPresenter" Property="TextElement.Foreground" Value="{m:BrushResource TextFillColorPrimaryBrush}" />
                            <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{m:BrushResource TextFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource {x:Static t:StyleKeys.DefaultComboBoxItemStyle}}" TargetType="{x:Type ComboBoxItem}" />

</ResourceDictionary>