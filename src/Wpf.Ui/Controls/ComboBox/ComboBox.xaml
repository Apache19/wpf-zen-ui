<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ani="clr-namespace:Wpf.Ui.Animations"
    xmlns:controls="clr-namespace:Wpf.Ui.Controls"
    xmlns:converters="clr-namespace:Wpf.Ui.Converters"
    xmlns:m="clr-namespace:Wpf.Ui.Markup"
    xmlns:t="clr-namespace:Wpf.Ui.Theming">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Resources/DefaultEditorContextMenu.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <converters:DoubleToDoubleConverter x:Key="ActiveRectHeightConverter" Multiply="0.5" />

    <Style x:Key="DefaultComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Border.CornerRadius" Value="{m:VariableResource ControlCornerRadius}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{m:StyleResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Foreground" Value="{m:BrushResource TextFillColorPrimaryBrush}" />
        <Setter Property="Padding" Value="10,8,8,8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Grid Background="Transparent">
                        <Border
                            Name="ContentBorder"
                            Margin="6,4,6,0"
                            Padding="0"
                            VerticalAlignment="Stretch"
                            CornerRadius="{TemplateBinding Border.CornerRadius}"
                            SnapsToDevicePixels="True">
                            <Grid>
                                <ContentPresenter
                                    x:Name="PART_ContentPresenter"
                                    Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="Center" />
                                <Rectangle
                                    x:Name="ActiveRectangle"
                                    Width="3"
                                    Height="{Binding ActualHeight, ElementName=ContentBorder, Converter={StaticResource ActiveRectHeightConverter}}"
                                    Margin="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Fill="{m:BrushResource SystemAccentColorPrimaryBrush}"
                                    RadiusX="2"
                                    RadiusY="2"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ContentBorder" Property="Background" Value="{m:BrushResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="PART_ContentPresenter" Property="TextElement.Foreground" Value="{m:BrushResource TextFillColorPrimaryBrush}" />
                            <Setter TargetName="ActiveRectangle" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{m:BrushResource TextFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="DefaultComboBoxTemplate" TargetType="{x:Type ComboBox}">
        <Grid>
            <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
            <Border
                x:Name="ContentBorder"
                BorderThickness="{TemplateBinding BorderThickness}"
                SnapsToDevicePixels="True">
                <Border.Background>
                    <!--
                        The template is intentionally shared by native ComboBox and ui:ComboBox.
                        PriorityBinding lets the derived control provide its resolved state brush,
                        while native controls fall back to their standard brush property.
                    -->
                    <PriorityBinding>
                        <Binding Path="VisualBackground" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="Background" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </Border.Background>
                <Border.BorderBrush>
                    <PriorityBinding>
                        <Binding Path="VisualBorderBrush" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="BorderBrush" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </Border.BorderBrush>
                <Border.CornerRadius>
                    <PriorityBinding>
                        <Binding Path="CornerRadius" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="(Border.CornerRadius)" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </Border.CornerRadius>
                <TextElement.Foreground>
                    <PriorityBinding>
                        <Binding Path="VisualForeground" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="Foreground" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </TextElement.Foreground>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:PlaceholderControl
                        x:Name="PART_Placeholder"
                        Margin="2,0"
                        Padding="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        Foreground="{m:BrushResource TextPlaceholderColorBrush}" />

                    <!--  这个 Grid 用于模仿 TextBoxView.Margin  -->
                    <Grid
                        Grid.Column="0"
                        Margin="2,0"
                        IsHitTestVisible="False">
                        <ContentPresenter
                            Name="PART_ContentPresenter"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding SelectionBoxItem}"
                            ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Grid>

                    <!--  下拉按钮小箭头图标，切换时用动画翻转  -->
                    <controls:SymbolIcon
                        x:Name="ChevronIcon"
                        Grid.Column="1"
                        Margin="8,0,10,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{m:BrushResource TextFillColorSecondaryBrush}"
                        RenderTransformOrigin="0.5, 0.5"
                        Symbol="ChevronDown24">
                        <controls:SymbolIcon.RenderTransform>
                            <RotateTransform Angle="0" />
                        </controls:SymbolIcon.RenderTransform>
                    </controls:SymbolIcon>

                    <!--  可编辑状态的文本编辑框，仅在可编辑时可见  -->
                    <controls:TextBox
                        x:Name="PART_EditableTextBox"
                        Grid.Column="0"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        CaretBrush="{Binding Foreground, RelativeSource={RelativeSource Self}}"
                        ContextMenu="{StaticResource DefaultEditorContextMenu}"
                        IsReadOnly="{TemplateBinding IsReadOnly}"
                        OverridesDefaultStyle="True"
                        VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                        <controls:TextBox.Foreground>
                            <!--
                                TextBoxView reads Foreground from its owning editor instead of from
                                inherited TextElement values, so the editable path needs an explicit
                                binding to the same resolved foreground as the selection presenter.
                            -->
                            <PriorityBinding>
                                <Binding Path="VisualForeground" RelativeSource="{RelativeSource TemplatedParent}" />
                                <Binding Path="Foreground" RelativeSource="{RelativeSource TemplatedParent}" />
                            </PriorityBinding>
                        </controls:TextBox.Foreground>
                        <controls:TextBox.Template>
                            <ControlTemplate TargetType="{x:Type TextBox}">
                                <controls:PassiveScrollViewer
                                    x:Name="PART_ContentHost"
                                    Focusable="false"
                                    HorizontalScrollBarVisibility="Hidden"
                                    ScrollSpillMode="Disabled"
                                    VerticalScrollBarVisibility="Hidden" />
                            </ControlTemplate>
                        </controls:TextBox.Template>
                    </controls:TextBox>

                    <!--  全透明的 ToggleButton，接受交互。可编辑时，缩回图标列；不可编辑时，扩展到2列，铺满整个控件。  -->
                    <ToggleButton
                        Name="ToggleButton"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        ClickMode="Press"
                        Focusable="False"
                        IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                        IsTabStop="False"
                        OverridesDefaultStyle="True">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                <Border
                                    Background="Transparent"
                                    CornerRadius="{m:VariableResource ControlCornerRadius}"
                                    SnapsToDevicePixels="True" />
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </Grid>
            </Border>
            <Border
                x:Name="AccentBorder"
                BorderBrush="{m:BrushResource SystemAccentColorPrimaryBrush}"
                BorderThickness="0,0,0,2"
                IsHitTestVisible="False"
                Visibility="Collapsed">
                <Border.CornerRadius>
                    <PriorityBinding>
                        <Binding Path="CornerRadius" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="(Border.CornerRadius)" RelativeSource="{RelativeSource TemplatedParent}" />
                    </PriorityBinding>
                </Border.CornerRadius>
            </Border>
            <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->

            <!--  弹出框，采用 PopupShadowChrome 用 PopupShadow 呈现阴影  -->
            <Popup
                x:Name="Popup"
                controls:PopupAnimator.IsEnabled="True"
                controls:PopupShadow.IsEnabled="True"
                AllowsTransparency="True"
                Focusable="False"
                IsOpen="{TemplateBinding IsDropDownOpen}"
                Placement="{TemplateBinding Popup.Placement}"
                PlacementTarget="{Binding ElementName=ContentBorder}"
                PopupAnimation="{TemplateBinding Popup.PopupAnimation}"
                VerticalOffset="1">
                <Border
                    x:Name="DropDownBorder"
                    MinWidth="{TemplateBinding ActualWidth}"
                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                    Margin="0"
                    Padding="0,4,0,6"
                    Background="{m:BrushResource AcrylicBackgroundFillColorDefaultBrush}"
                    BorderBrush="{m:BrushResource SurfaceStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{m:VariableResource PopupCornerRadius}"
                    SnapsToDevicePixels="True">
                    <controls:PassiveScrollViewer
                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        Margin="0"
                        HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                        SnapsToDevicePixels="True"
                        VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                        <ItemsPresenter
                            x:Name="ItemsPresenter"
                            KeyboardNavigation.DirectionalNavigation="Contained"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </controls:PassiveScrollViewer>
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsDropDownOpen" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ani:InterruptibleDoubleAnimation
                                Storyboard.TargetName="ChevronIcon"
                                Storyboard.TargetProperty="(controls:SymbolIcon.RenderTransform).(RotateTransform.Angle)"
                                From="0"
                                To="180"
                                Duration="00:00:00.167" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ani:InterruptibleDoubleAnimation
                                Storyboard.TargetName="ChevronIcon"
                                Storyboard.TargetProperty="(controls:SymbolIcon.RenderTransform).(RotateTransform.Angle)"
                                From="180"
                                To="0"
                                Duration="00:00:00.167" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="HasItems" Value="False">
                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="32.0" />
            </Trigger>
            <Trigger SourceName="Popup" Property="Popup.AllowsTransparency" Value="False">
                <Setter TargetName="DropDownBorder" Property="CornerRadius" Value="0" />
            </Trigger>
            <Trigger Property="IsGrouping" Value="True">
                <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
            </Trigger>
            <Trigger Property="IsEditable" Value="True">
                <Setter Property="IsTabStop" Value="False" />
                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                <Setter TargetName="PART_ContentPresenter" Property="Visibility" Value="Hidden" />
                <Setter TargetName="ToggleButton" Property="Grid.Column" Value="1" />
                <Setter TargetName="ToggleButton" Property="Grid.ColumnSpan" Value="1" />
            </Trigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsKeyboardFocusWithin" Value="True" />
                    <Condition Property="IsEditable" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="AccentBorder" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="PART_Placeholder" Property="Opacity" Value="0.5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="ComboBoxBaseStyle" TargetType="{x:Type ComboBox}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="{m:BrushResource ControlFillColorSecondaryBrush}" />
        <Setter Property="Border.CornerRadius" Value="{m:VariableResource ControlCornerRadius}" />
        <Setter Property="BorderBrush" Value="{m:BrushResource ControlStrokeColorSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{m:StyleResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Foreground" Value="{m:BrushResource TextFillColorPrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource DefaultComboBoxItemStyle}" />
        <Setter Property="MinHeight" Value="{m:VariableResource TextControlThemeMinHeight}" />
        <Setter Property="MinWidth" Value="{m:VariableResource TextControlThemeMinWidth}" />
        <Setter Property="Padding" Value="{m:VariableResource TextControlThemePadding}" />
        <Setter Property="Popup.Placement" Value="Bottom" />
        <Setter Property="Popup.PopupAnimation" Value="None" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Validation.ErrorTemplate" Value="{m:StyleResource DefaultValidationTemplate}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Template" Value="{StaticResource DefaultComboBoxTemplate}" />
    </Style>

    <!--
        Native ComboBox remains supported because DataGridComboBoxColumn creates that exact type.
        Its style retains the old trigger-driven behavior; ui:ComboBox resolves the equivalent
        states in code so consumers can replace each brush with a local value or style setter.
    -->
    <Style x:Key="{x:Static t:StyleKeys.DefaultComboBoxStyle}" BasedOn="{StaticResource ComboBoxBaseStyle}" TargetType="{x:Type ComboBox}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{m:BrushResource ControlFillColorPrimaryBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEditable" Value="False" />
                    <Condition Property="IsDropDownOpen" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{m:BrushResource ControlFillColorTertiaryBrush}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsKeyboardFocusWithin" Value="True" />
                    <Condition Property="IsEditable" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{m:BrushResource ControlFillColorInputActiveBrush}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{m:BrushResource ControlFillColorDisabledBrush}" />
                <Setter Property="BorderBrush" Value="{m:BrushResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{m:BrushResource TextFillColorDisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="{x:Static t:StyleKeys.DefaultUiComboBoxStyle}" BasedOn="{StaticResource ComboBoxBaseStyle}" TargetType="{x:Type controls:ComboBox}">
        <Setter Property="CornerRadius" Value="{m:VariableResource ControlCornerRadius}" />
        <Setter Property="MouseOverBackground" Value="{m:BrushResource ControlFillColorPrimaryBrush}" />
        <Setter Property="FocusedBackground" Value="{m:BrushResource ControlFillColorInputActiveBrush}" />
        <Setter Property="DropDownOpenBackground" Value="{m:BrushResource ControlFillColorTertiaryBrush}" />
        <Setter Property="DisabledForeground" Value="{m:BrushResource TextFillColorDisabledBrush}" />
        <Setter Property="DisabledBackground" Value="{m:BrushResource ControlFillColorDisabledBrush}" />
        <Setter Property="DisabledBorderBrush" Value="{m:BrushResource ControlStrokeColorDefaultBrush}" />
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEditable" Value="True" />
                    <Condition Property="IsReadOnly" Value="True" />
                </MultiTrigger.Conditions>
                <!--
                    IsReadOnly has meaning only for the embedded editor. Giving that editor a
                    quieter focused fill matches TextBox while leaving non-editable selectors
                    unaffected; a local FocusedBackground still has higher precedence.
                -->
                <Setter Property="FocusedBackground" Value="{m:BrushResource ControlFillColorTertiaryBrush}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource {x:Static t:StyleKeys.DefaultComboBoxStyle}}" TargetType="{x:Type ComboBox}" />

    <Style BasedOn="{StaticResource {x:Static t:StyleKeys.DefaultUiComboBoxStyle}}" TargetType="{x:Type controls:ComboBox}" />

</ResourceDictionary>
