<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Controls"
    xmlns:converters="clr-namespace:Wpf.Ui.Converters"
    xmlns:markup="clr-namespace:Wpf.Ui.Markup">

    <converters:ProgressThicknessConverter x:Key="ProgressThicknessConverter" />

    <Style TargetType="{x:Type controls:ProgressRing}">
        <Setter Property="Height" Value="60" />
        <Setter Property="Width" Value="60" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{markup:BrushResource SystemAccentColorPrimaryBrush}" />
        <Setter Property="CoverRingStroke" Value="{markup:BrushResource ControlFillColorTransparentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ProgressRing}">
                    <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                        <controls:Arc
                            EndAngle="359"
                            StartAngle="0"
                            Stroke="{TemplateBinding CoverRingStroke}"
                            Visibility="{TemplateBinding CoverRingVisibility}">
                            <controls:Arc.StrokeThickness>
                                <MultiBinding Converter="{StaticResource ProgressThicknessConverter}">
                                    <Binding Path="Height" RelativeSource="{RelativeSource TemplatedParent}" Mode="OneWay" />
                                    <Binding Path="StrokeThickness" RelativeSource="{RelativeSource TemplatedParent}" Mode="OneWay" />
                                </MultiBinding>
                            </controls:Arc.StrokeThickness>
                        </controls:Arc>
                        <controls:Arc
                            EndAngle="{TemplateBinding EndAngle}"
                            StartAngle="0"
                            Stroke="{TemplateBinding Foreground}">
                            <controls:Arc.StrokeThickness>
                                <MultiBinding Converter="{StaticResource ProgressThicknessConverter}">
                                    <Binding Path="Height" RelativeSource="{RelativeSource TemplatedParent}" Mode="OneWay" />
                                    <Binding Path="StrokeThickness" RelativeSource="{RelativeSource TemplatedParent}" Mode="OneWay" />
                                </MultiBinding>
                            </controls:Arc.StrokeThickness>
                        </controls:Arc>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsIndeterminate" Value="True">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type controls:ProgressRing}">
                            <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                                <controls:Arc
                                    EndAngle="359"
                                    StartAngle="0"
                                    Stroke="{TemplateBinding CoverRingStroke}"
                                    Visibility="{TemplateBinding CoverRingVisibility}">
                                    <controls:Arc.StrokeThickness>
                                        <MultiBinding Converter="{StaticResource ProgressThicknessConverter}">
                                            <Binding Path="Height" RelativeSource="{RelativeSource TemplatedParent}" Mode="OneWay" />
                                            <Binding Path="StrokeThickness" RelativeSource="{RelativeSource TemplatedParent}" Mode="OneWay" />
                                        </MultiBinding>
                                    </controls:Arc.StrokeThickness>
                                </controls:Arc>
                                <controls:Arc
                                    EndAngle="{TemplateBinding IndeterminateAngle}"
                                    RenderTransformOrigin="0.5, 0.5"
                                    StartAngle="0"
                                    Stroke="{TemplateBinding Foreground}">
                                    <controls:Arc.StrokeThickness>
                                        <MultiBinding Converter="{StaticResource ProgressThicknessConverter}">
                                            <Binding Path="Height" RelativeSource="{RelativeSource TemplatedParent}" Mode="OneWay" />
                                            <Binding Path="StrokeThickness" RelativeSource="{RelativeSource TemplatedParent}" Mode="OneWay" />
                                        </MultiBinding>
                                    </controls:Arc.StrokeThickness>
                                    <controls:Arc.RenderTransform>
                                        <RotateTransform />
                                    </controls:Arc.RenderTransform>
                                    <controls:Arc.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        RepeatBehavior="Forever"
                                                        Storyboard.TargetProperty="(Canvas.RenderTransform).(RotateTransform.Angle)"
                                                        To="360"
                                                        Duration="0:0:2" />
                                                    <DoubleAnimation
                                                        AutoReverse="True"
                                                        RepeatBehavior="Forever"
                                                        Storyboard.TargetProperty="EndAngle"
                                                        From="100"
                                                        To="320"
                                                        Duration="0:0:5" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </controls:Arc.Triggers>
                                </controls:Arc>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
