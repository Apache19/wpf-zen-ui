    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Controls/ListBox/DefaultListBoxItem.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style BasedOn="{StaticResource DefaultListBoxItemStyle}" TargetType="{x:Type controls:ListBoxItem}" />

</ResourceDictionary>