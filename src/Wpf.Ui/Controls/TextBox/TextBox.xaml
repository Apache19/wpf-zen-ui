<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Controls"
    xmlns:converters="clr-namespace:Wpf.Ui.Converters"
    xmlns:m="clr-namespace:Wpf.Ui.Markup"
    xmlns:t="clr-namespace:Wpf.Ui.Theming">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Resources/DefaultEditorContextMenu.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <converters:ThicknessTransformConverter x:Key="IconTopPaddingConverter" CopySides="Top" Offset="0 1 0 0" />
    <converters:ThicknessTransformConverter x:Key="IconBottomPaddingConverter" CopySides="Bottom" Offset="0 0 0 -1" />
    <converters:ThicknessTransformConverter x:Key="ButtonTopPaddingConverter" CopySides="Top" Offset="0 -3 0 0" />
    <converters:ThicknessTransformConverter x:Key="ButtonBottomPaddingConverter" CopySides="Bottom" Offset="0 0 0 -3" />

    <ControlTemplate x:Key="DefaultUiTextBoxControlTemplate" TargetType="{x:Type controls:TextBox}">
        <Grid>
            <Border
                x:Name="ContentBorder"
                Background="{TemplateBinding VisualBackground}"
                BorderBrush="{TemplateBinding VisualBorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                TextElement.Foreground="{TemplateBinding VisualForeground}"
                SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--
                        Uses a Border to sense VerticalContentAlignment while keeping the icon's own vertical
                        alignment fixed at the top, in order to match TextBoxViewer's intrinsic layout behavior:
                        
                        - When VerticalContentAlignment is Stretch, TextBoxViewer positions its text at the top.
                        The Border stretches vertically to fill the full height, while the icon stays top-anchored.
                        A converter clones the top and bottom values of Padding onto the icon, giving it exactly
                        the same vertical offsets as the text, so that it aligns with the text at the top under
                        any Padding setting.
                        
                        - For Top, Center, or Bottom, the Border collapses to fit its content and moves as a unit
                        with the icon. The icon carries the full top and bottom Padding offsets as well, so it
                        aligns precisely according to the specified VerticalContentAlignment, staying in sync with
                        the text position.
                    -->
                    <Border
                        x:Name="IconContainer"
                        Grid.Column="0"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        IsHitTestVisible="False">
                        <ContentPresenter
                            x:Name="IconPresenter"
                            VerticalAlignment="Top"
                            ContentSource="Icon"
                            Focusable="False"
                            TextElement.FontSize="{TemplateBinding FontSize, Converter={converters:DoubleToDoubleConverter Add=1}}" />
                    </Border>

                    <!--
                        Placeholder text simulates the internal layout:
                        
                        Margin = TextBoxViewer.Margin. The TextBoxViewer has a 2,0,2,0 margin from
                        CaretElement.BidiCaretIndicatorWidth.
                        
                        Padding = TextBox.Padding. The TextBox internally applies this to PART_ContentHost
                        automatically; no explicit binding is needed.
                        
                        VerticalAlignment = TextBox.VerticalContentAlignment, also applied internally;
                        no explicit template binding is needed.
                        
                        HorizontalAlignment follows the same pattern.
                    -->
                    <TextBlock
                        x:Name="PlaceholderTextBox"
                        Grid.Column="1"
                        Margin="2,0"
                        Padding="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        Foreground="{m:DynamicBrush TextPlaceholder}"
                        IsHitTestVisible="False"
                        Text="{TemplateBinding PlaceholderText}" />

                    <controls:PassiveScrollViewer
                        x:Name="PART_ContentHost"
                        Grid.Column="1"
                        Focusable="false"
                        HorizontalScrollBarVisibility="Hidden"
                        ScrollSpillMode="Disabled"
                        VerticalScrollBarVisibility="Hidden" />

                    <!--
                        Applies the same vertical alignment mechanism as the icon container above to keep
                        the clear button's layout behavior consistent with TextBoxViewer.
                        See the IconContainer comments for detailed explanation.
                    -->
                    <Border
                        x:Name="ClearButtonContainer"
                        Grid.Column="2"
                        Margin="0,0,4,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                        <controls:Button
                            x:Name="ClearButton"
                            MinWidth="24"
                            MinHeight="24"
                            Padding="0"
                            VerticalAlignment="Top"
                            Appearance="Transparent"
                            BorderThickness="0"
                            Command="{Binding Path=TemplateButtonCommand, RelativeSource={RelativeSource TemplatedParent}}"
                            Focusable="False"
                            Icon="{m:SymbolIcon Dismiss24}"
                            IsEnabled="{TemplateBinding ClearButtonEnabled}"
                            IsTabStop="False" />
                    </Border>
                </Grid>
            </Border>
            <Border
                x:Name="FocusIndicator"
                BorderBrush="{m:DynamicBrush AccentStroke}"
                BorderThickness="0,0,0,2"
                CornerRadius="{TemplateBinding CornerRadius}"
                IsHitTestVisible="False"
                Visibility="Collapsed" />
        </Grid>
        <ControlTemplate.Triggers>

            <!--  Layout triggers  -->

            <Trigger Property="VerticalContentAlignment" Value="Stretch">
                <Setter TargetName="IconPresenter" Property="Margin" Value="{Binding Padding, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IconTopPaddingConverter}}" />
                <Setter TargetName="ClearButton" Property="Margin" Value="{Binding Padding, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ButtonTopPaddingConverter}}" />
            </Trigger>
            <Trigger Property="VerticalContentAlignment" Value="Top">
                <Setter TargetName="IconPresenter" Property="Margin" Value="{Binding Padding, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IconTopPaddingConverter}}" />
                <Setter TargetName="ClearButton" Property="Margin" Value="{Binding Padding, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ButtonTopPaddingConverter}}" />
            </Trigger>
            <Trigger Property="VerticalContentAlignment" Value="Bottom">
                <Setter TargetName="IconPresenter" Property="Margin" Value="{Binding Padding, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IconBottomPaddingConverter}}" />
                <Setter TargetName="ClearButton" Property="Margin" Value="{Binding Padding, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ButtonBottomPaddingConverter}}" />
            </Trigger>

            <Trigger Property="IsPlaceholderVisible" Value="False">
                <Setter TargetName="PlaceholderTextBox" Property="Visibility" Value="Collapsed" />
            </Trigger>

            <Trigger Property="IsClearButtonVisible" Value="False">
                <Setter TargetName="ClearButtonContainer" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="ClearButtonEnabled" Value="False">
                <Setter TargetName="ClearButtonContainer" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter TargetName="ClearButtonContainer" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IconPlacement" Value="Right">
                <Setter TargetName="IconContainer" Property="Grid.Column" Value="3" />
                <Setter TargetName="IconContainer" Property="Margin" Value="0,0,10,0" />
            </Trigger>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="IconContainer" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="IconContainer" Property="Margin" Value="0" />
            </Trigger>

            <!--  Visual triggers  -->

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsKeyboardFocused" Value="True" />
                    <Condition Property="IsFocusIndicatorVisible" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="FocusIndicator" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="PlaceholderTextBox" Property="Opacity" Value="0.5" />
                <Setter Property="ClearButtonEnabled" Value="False" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="DefaultUiTextBoxTextBlockAppearanceControlTemplate" TargetType="{x:Type controls:TextBox}">
        <!--
            A text-selection-only TextBox should subtract the CaretElement.BidiCaretIndicatorWidth margin,
            since there is no caret to worry about being clipped.
        -->
        <controls:PassiveScrollViewer
            x:Name="PART_ContentHost"
            Margin="-2,0"
            Focusable="false"
            HorizontalScrollBarVisibility="Hidden"
            VerticalScrollBarVisibility="Hidden" />
    </ControlTemplate>

    <Style x:Key="{x:Static t:StyleKeys.DefaultUiTextBoxStyle}" TargetType="{x:Type controls:TextBox}">
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="AllowDrop" Value="true" />
        <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="CaretBrush" Value="{Binding Foreground, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Background" Value="{m:DynamicBrush ControlFillSecondary}" />
        <Setter Property="BorderBrush" Value="{m:DynamicBrush ControlStrokeSecondary}" />
        <Setter Property="MouseOverBackground" Value="{m:DynamicBrush ControlFillPrimary}" />
        <Setter Property="FocusedBackground" Value="{m:DynamicBrush ControlFillInputActive}" />
        <Setter Property="DisabledForeground" Value="{m:DynamicBrush TextFillDisabled}" />
        <Setter Property="DisabledBackground" Value="{m:DynamicBrush ControlFillDisabled}" />
        <Setter Property="DisabledBorderBrush" Value="{m:DynamicBrush ControlStrokeDefault}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="{m:DynamicValue TextControlThemePadding}" />
        <Setter Property="CornerRadius" Value="{m:DynamicValue ControlCornerRadius}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Validation.ErrorTemplate" Value="{m:DynamicTemplate DefaultValidation}" />
        <Setter Property="ContextMenu" Value="{StaticResource DefaultEditorContextMenu}" />
        <Style.Triggers>
            <Trigger Property="UseTextBlockAppearance" Value="False">
                <Setter Property="Template" Value="{StaticResource DefaultUiTextBoxControlTemplate}" />
            </Trigger>
            <Trigger Property="UseTextBlockAppearance" Value="True">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Template" Value="{StaticResource DefaultUiTextBoxTextBlockAppearanceControlTemplate}" />
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
                <!--
                    Read-only is a semantic mode rather than a separate rendering path.
                    Supplying its focused color through the public state property keeps a
                    local FocusedBackground value free to override this theme default.
                -->
                <Setter Property="FocusedBackground" Value="{m:DynamicBrush ControlFillTertiary}" />
            </Trigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsInactiveSelectionHighlightEnabled" Value="true" />
                    <Condition Property="IsSelectionActive" Value="false" />
                </MultiTrigger.Conditions>
                <!--
                    todo: 主题资源中尚未有文本选择色，增加后把这里替换掉
                    <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}" />
                    todo: 旧版.NET Framework 中的 TextBox 没有这个属性，可在控件中引入桥接属性，以便新版 .NET 的 ui:TextBox 能正常工作。
                    <Setter Property="SelectionTextBrush" Value="{m:DynamicBrush TextFillPrimary}" />
                -->
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource {x:Static t:StyleKeys.DefaultUiTextBoxStyle}}" TargetType="{x:Type controls:TextBox}" />

</ResourceDictionary>
