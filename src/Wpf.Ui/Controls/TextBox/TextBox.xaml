<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Controls"
    xmlns:m="clr-namespace:Wpf.Ui.Markup"
    xmlns:t="clr-namespace:Wpf.Ui.Theming">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Resources/DefaultEditorContextMenu.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <ControlTemplate x:Key="DefaultUiTextBoxControlTemplate" TargetType="{x:Type controls:TextBox}">
        <Grid>
            <Border
                x:Name="ContentBorder"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding Border.CornerRadius}">
                <Grid HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--
                        The icon can only be vertically centered. For multi-line text (AcceptsReturn == true),
                        it is recommended to disable the icon.
                    -->
                    <ContentPresenter
                        x:Name="iconPresenter"
                        Grid.Column="0"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        ContentSource="Icon"
                        Focusable="False" />

                    <!--
                        Placeholder text simulates the internal layout:
                        
                        Margin = TextBoxViewer.Margin. The TextBoxViewer has a 2,0,2,0 margin from
                        CaretElement.BidiCaretIndicatorWidth.
                        
                        Padding = TextBox.Padding. The TextBox internally applies this to PART_ContentHost
                        automatically; no explicit binding is needed.
                        
                        VerticalAlignment = TextBox.VerticalContentAlignment, also applied internally;
                        no explicit template binding is needed.
                        
                        HorizontalAlignment follows the same pattern.
                    -->
                    <TextBlock
                        x:Name="PlaceholderTextBox"
                        Grid.Column="1"
                        Margin="2,0"
                        Padding="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding VerticalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        Foreground="{m:BrushResource TextPlaceholderColorBrush}"
                        Text="{TemplateBinding PlaceholderText}" />

                    <!--
                        Do not set excessive noise properties on PART_ContentHost; the TextBox internally
                        applies layout automatically.
                    -->
                    <controls:PassiveScrollViewer
                        x:Name="PART_ContentHost"
                        Grid.Column="1"
                        Focusable="false"
                        HorizontalScrollBarVisibility="Hidden"
                        IsScrollSpillEnabled="False"
                        VerticalScrollBarVisibility="Hidden" />

                    <!--  Buttons and Icons have no padding from the main element to allow absolute positions if height is larger than the text entry zone  -->
                    <controls:Button
                        x:Name="ClearButton"
                        Grid.Column="2"
                        MinWidth="24"
                        MinHeight="24"
                        Margin="0,0,4,0"
                        Padding="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Command="{Binding Path=TemplateButtonCommand, RelativeSource={RelativeSource TemplatedParent}}"
                        Focusable="False"
                        Foreground="{m:BrushResource TextFillColorSecondaryBrush}"
                        IsEnabled="{TemplateBinding ClearButtonEnabled}"
                        IsTabStop="False"
                        MouseOverBackground="{m:BrushResource SubtleFillColorSecondaryBrush}"
                        MouseOverBorderBrush="Transparent"
                        PressedBackground="{m:BrushResource SubtleFillColorTertiaryBrush}"
                        PressedBorderBrush="Transparent">
                        <controls:Button.Icon>
                            <controls:SymbolIcon FontSize="{TemplateBinding FontSize}" Symbol="Dismiss24" />
                        </controls:Button.Icon>
                    </controls:Button>
                </Grid>
            </Border>
            <Border
                x:Name="FocusIndicator"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                BorderBrush="{m:BrushResource SystemAccentColorPrimaryBrush}"
                BorderThickness="0,0,0,2"
                CornerRadius="{TemplateBinding Border.CornerRadius}"
                Visibility="Collapsed" />
        </Grid>
        <ControlTemplate.Triggers>

            <!--  Layout triggers  -->

            <Trigger Property="CurrentPlaceholderEnabled" Value="False">
                <Setter TargetName="PlaceholderTextBox" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsClearButtonVisible" Value="False">
                <Setter TargetName="ClearButton" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="ClearButton" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="ClearButtonEnabled" Value="False">
                <Setter TargetName="ClearButton" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="ClearButton" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter TargetName="ClearButton" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="ClearButton" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IconPlacement" Value="Right">
                <Setter TargetName="iconPresenter" Property="Grid.Column" Value="3" />
                <Setter TargetName="iconPresenter" Property="Margin" Value="0,0,10,0" />
            </Trigger>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="iconPresenter" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="iconPresenter" Property="Margin" Value="0" />
            </Trigger>

            <!--  Visual triggers  -->

            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ContentBorder" Property="Background" Value="{m:BrushResource ControlFillColorPrimaryBrush}" />
                <!--  TODO: Update theme style — change ControlStrokeColorDefault to Primary and apply it to the border here  -->
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ContentBorder" Property="Background" Value="{m:BrushResource ControlFillColorInputActiveBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsKeyboardFocused" Value="True" />
                    <Condition Property="IsFocusIndicatorVisible" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="FocusIndicator" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsReadOnly" Value="True" />
                    <Condition Property="IsKeyboardFocused" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="ContentBorder" Property="Background" Value="{m:BrushResource ControlFillColorTertiaryBrush}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ContentBorder" Property="Background" Value="{m:BrushResource ControlFillColorDisabledBrush}" />
                <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{m:BrushResource ControlStrokeColorDefaultBrush}" />
                <Setter TargetName="FocusIndicator" Property="BorderBrush" Value="{m:BrushResource ControlStrokeColorDefaultBrush}" />
                <Setter TargetName="PlaceholderTextBox" Property="Opacity" Value="0.5" />
                <Setter Property="Foreground" Value="{m:BrushResource TextFillColorDisabledBrush}" />
                <Setter Property="ClearButtonEnabled" Value="False" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="DefaultUiTextBoxTextSelectionEnabledControlTemplate" TargetType="{x:Type controls:TextBox}">
        <!--
            A text-selection-only TextBox should subtract the CaretElement.BidiCaretIndicatorWidth margin,
            since there is no caret to worry about being clipped.
        -->
        <controls:PassiveScrollViewer
            x:Name="PART_ContentHost"
            Margin="-2,0"
            Focusable="false"
            HorizontalScrollBarVisibility="Hidden"
            VerticalScrollBarVisibility="Hidden" />
    </ControlTemplate>

    <Style x:Key="{x:Static t:StyleKeys.DefaultUiTextBoxStyle}" TargetType="{x:Type controls:TextBox}">
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="AllowDrop" Value="true" />
        <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="CaretBrush" Value="{Binding Foreground, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Background" Value="{m:BrushResource ControlFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{m:BrushResource ControlStrokeColorSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="{m:VariableResource TextControlThemeMinHeight}" />
        <Setter Property="MinWidth" Value="{m:VariableResource TextControlThemeMinWidth}" />
        <Setter Property="Padding" Value="{m:VariableResource TextControlThemePadding}" />
        <Setter Property="Border.CornerRadius" Value="{m:VariableResource ControlCornerRadius}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Validation.ErrorTemplate" Value="{m:StyleResource DefaultValidationTemplate}" />
        <Setter Property="ContextMenu" Value="{StaticResource DefaultEditorContextMenu}" />
        <Style.Triggers>
            <Trigger Property="IsTextSelectionEnabled" Value="False">
                <Setter Property="Template" Value="{StaticResource DefaultUiTextBoxControlTemplate}" />
            </Trigger>
            <Trigger Property="IsTextSelectionEnabled" Value="True">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Template" Value="{StaticResource DefaultUiTextBoxTextSelectionEnabledControlTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource {x:Static t:StyleKeys.DefaultUiTextBoxStyle}}" TargetType="{x:Type controls:TextBox}" />

</ResourceDictionary>
