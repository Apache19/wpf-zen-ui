<ui:FluentWindow
    x:Class="Wpf.Ui.Gallery.Views.Windows.SandboxWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.Gallery.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="SandboxWindow"
    Width="1450"
    Height="802"
    MinWidth="900"
    d:DataContext="{d:DesignInstance local:SandboxWindow,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="650"
    d:DesignWidth="1000"
    d:Background="{ui:BrushResource WindowBackgroundBrush}"
    d:Foreground="{ui:BrushResource TextFillColorPrimaryBrush}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <StackPanel>
        <ui:TitleBar
            x:Name="TitleBar"
            Title="WPF UI Gallery - Sandbox"
            Margin="0"
            IsIconInteractionEnabled="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/wpfui.png" />
            </ui:TitleBar.Icon>
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Menu HorizontalAlignment="Left">
                    <ui:MenuItem Header="File">
                        <ui:MenuItem Header="New" />
                        <ui:MenuItem Header="New window" />
                        <ui:MenuItem Header="Open..." />
                        <ui:MenuItem Header="Save" />
                        <ui:MenuItem Header="Save As..." />
                        <ui:Separator />
                        <ui:MenuItem Header="Exit" />
                    </ui:MenuItem>
                    <ui:MenuItem Header="Debug">
                        <ui:MenuItem Header="Undo" />
                        <ui:Separator />
                        <ui:MenuItem Header="Cut" />
                        <ui:MenuItem Header="Copy" />
                        <ui:MenuItem Header="Paste" />
                        <ui:MenuItem Header="Delete" IsEnabled="False" />
                        <ui:Separator />
                        <ui:MenuItem Header="Search with browser" />
                        <ui:MenuItem Header="Find..." />
                        <ui:MenuItem Header="Find next" />
                        <ui:Separator />
                        <ui:MenuItem Header="Select All" />
                    </ui:MenuItem>
                </ui:Menu>
                <ui:Menu Grid.Column="1" HorizontalAlignment="Right">
                    <ui:MenuItem Foreground="{ui:BrushResource PaletteDeepOrangeBrush}" Icon="{ui:SymbolIcon Fire24, True}" />
                    <ui:MenuItem Foreground="{ui:BrushResource PaletteGreenBrush}" Icon="{ui:SymbolIcon Play24}" />
                    <ui:MenuItem Foreground="{ui:BrushResource PaletteRedBrush}" Icon="{ui:SymbolIcon Stop24}" />
                    <ui:MenuItem Foreground="{ui:BrushResource PaletteLightBlueBrush}" Icon="{ui:SymbolIcon ArrowClockwise24}" />
                </ui:Menu>
            </Grid>
        </ui:TitleBar>

        <StackPanel Margin="24">
            <TextBlock Text="Hello World!" />

            <ui:AutoSuggestBox
                Margin="0,24,0,0"
                Text="{Binding ViewModel.AutoSuggestBoxText, Mode=TwoWay}"
                TextChanged="OnAutoSuggestBoxTextChanged" />

            <ui:DropDownButton Content="Hello" Icon="{ui:SymbolIcon Fluent24}">
                <ui:DropDownButton.Flyout>
                    <ui:ContextMenu>
                        <ui:MenuItem Command="ApplicationCommands.Undo" />
                        <ui:MenuItem Command="ApplicationCommands.Redo" />
                        <ui:Separator />
                        <ui:MenuItem Command="ApplicationCommands.Cut" />
                        <ui:MenuItem Command="ApplicationCommands.Copy" />
                        <ui:MenuItem Command="ApplicationCommands.Paste" />
                        <ui:MenuItem Header="OCR Paste" InputGestureText="Ctrl + Shift + V" />
                        <ui:Separator />
                        <ui:MenuItem Header="Isolate Selected Text" InputGestureText="Ctrl + I" />
                        <ui:MenuItem Header="Select Line" InputGestureText="Ctrl + L" />
                        <ui:MenuItem Header="Toggle Case" InputGestureText="Shift + F3" />
                        <ui:Separator />
                        <ui:MenuItem Header="Move Selection _Up" InputGestureText="Alt + Up" />
                        <ui:MenuItem Header="Move Selection _Down" InputGestureText="Alt + Down" />
                    </ui:ContextMenu>
                </ui:DropDownButton.Flyout>
            </ui:DropDownButton>
        </StackPanel>

        <ui:NavigationView x:Name="MyTestNavigationView" />
    </StackPanel>
</ui:FluentWindow>
