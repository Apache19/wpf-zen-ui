<Page
    x:Class="Wpf.Ui.Gallery.Views.Pages.AllControlsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:g="clr-namespace:Wpf.Ui.Gallery.Controls"
    xmlns:local="clr-namespace:Wpf.Ui.Gallery.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Wpf.Ui.Gallery.ViewModels.Pages"
    Title="All Controls Page"
    Style="{ui:StyleResource DynamicScrollPageStyle}"
    d:DataContext="{d:DesignInstance vm:AllControlsViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignWidth="800"
    g:PageControlDocumentation.Show="False"
    d:Background="{ui:BrushResource WindowBackgroundBrush}"
    Foreground="{ui:BrushResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <g:GalleryNavigationPresenter
        Margin="0,0,0,24"
        Background="Red"
        ItemsSource="{Binding NavigationCards, Mode=OneWay}" />
</Page>
