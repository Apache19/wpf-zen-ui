<Page
    x:Class="Wpf.Ui.Gallery.Views.Pages.DateAndTime.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.Gallery.Views.Pages.DateAndTime"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Wpf.Ui.Gallery.ViewModels.Pages.DateAndTime"
    Title="CalendarPage"
    Style="{ui:StyleResource DynamicScrollPageStyle}"
    d:DataContext="{d:DesignInstance vm:CalendarViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignWidth="800"
    d:Background="{ui:BrushResource WindowBackgroundBrush}"
    Foreground="{ui:BrushResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid Margin="0,0,0,24">
        <controls:ControlExample Margin="0" HeaderText="A basic Calendar control.">
            <controls:ControlExample.XamlCode>
                &lt;Calendar/&gt;
            </controls:ControlExample.XamlCode>
            <Calendar HorizontalAlignment="Left" />
        </controls:ControlExample>
    </Grid>
</Page>
