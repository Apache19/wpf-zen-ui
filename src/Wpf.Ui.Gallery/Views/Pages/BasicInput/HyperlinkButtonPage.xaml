<Page
    x:Class="Wpf.Ui.Gallery.Views.Pages.BasicInput.HyperlinkButtonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Wpf.Ui.Gallery.ViewModels.Pages.BasicInput"
    Title="HyperlinkButtonPage"
    controls:PageControlDocumentation.DocumentationType="{x:Type ui:HyperlinkButton}"
    d:Background="{ui:BrushResource WindowBackgroundBrush}"
    d:DataContext="{d:DesignInstance vm:HyperlinkButtonViewModel, IsDesignTimeCreatable=False}"
    d:DesignWidth="800"
    Foreground="{ui:BrushResource TextFillColorPrimaryBrush}"
    Style="{ui:StyleResource DynamicScrollPageStyle}"
    mc:Ignorable="d">

    <StackPanel Margin="0,0,0,24">
        <controls:ControlExample
            Margin="0"
            HeaderText="WPF UI hyperlink."
            XamlCode="&lt;ui:HyperlinkButton NavigateUri=&quot;https://&quot; /&gt;">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:HyperlinkButton
                    Grid.Column="0"
                    Content="WPF UI hyperlink"
                    Icon="{ui:SymbolIcon Link24}"
                    IsEnabled="{Binding IsHyperlinkDisabled, Converter={StaticResource BoolInvertConverter}}"
                    NavigateUri="https://lepo.co/" />
                <ui:CheckBox
                    Grid.Column="1"
                    Content="Disable hyperlink"
                    IsChecked="{Binding IsHyperlinkDisabled, Mode=TwoWay}" />
            </Grid>
        </controls:ControlExample>

        <controls:ControlExample
            Margin="0,32,0,0"
            HeaderText="WPF UI hyperlink with FontIcon."
            XamlCode="&lt;ui:HyperlinkButton NavigateUri=&quot;https://&quot; /&gt;">
            <ui:HyperlinkButton
                Content="WPF UI hyperlink"
                Icon="{ui:FontIcon '&#x1F308;'}"
                IsEnabled="{Binding IsHyperlinkDisabled, Converter={StaticResource BoolInvertConverter}}"
                NavigateUri="https://lepo.co/" />
        </controls:ControlExample>

        <controls:ControlExample
            Margin="0,32,0,0"
            HeaderText="WPF UI hyperlink with ImageIcon."
            XamlCode="&lt;ui:HyperlinkButton NavigateUri=&quot;https://&quot; /&gt;">
            <ui:HyperlinkButton
                Content="WPF UI hyperlink"
                Icon="{ui:ImageIcon 'pack://application:,,,/Assets/wpfui.png'}"
                IsEnabled="{Binding IsHyperlinkDisabled, Converter={StaticResource BoolInvertConverter}}"
                NavigateUri="https://lepo.co/" />
        </controls:ControlExample>
    </StackPanel>
</Page>
