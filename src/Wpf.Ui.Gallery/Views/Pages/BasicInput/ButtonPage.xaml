<Page
    x:Class="Wpf.Ui.Gallery.Views.Pages.BasicInput.ButtonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.Gallery.ViewModels.Pages.BasicInput"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="ButtonPage"
    controls:PageControlDocumentation.DocumentationType="{x:Type ui:Button}"
    d:Background="{ui:BrushResource WindowBackgroundBrush}"
    d:DataContext="{d:DesignInstance local:ButtonViewModel, IsDesignTimeCreatable=True}"
    d:DesignHeight="1250"
    d:DesignWidth="800"
    Foreground="{ui:BrushResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Controls/Button/Button.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="ViewBoxCustomButtonContentTemplate">
                <Viewbox
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Stretch="Uniform"
                    StretchDirection="Both">
                    <ContentPresenter
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Content="{TemplateBinding Content}" />
                </Viewbox>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <StackPanel Margin="0,0,0,24">
        <controls:ControlExample
            Margin="0"
            HeaderText="Standard button."
            XamlCode="&lt;Button Content=&quot;Standard WPF button&quot; /&gt;">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    MinWidth="200"
                    Padding="{ui:VariableResource TextControlThemePadding}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="Standard WPF button"
                    IsDefault="{Binding ElementName=WpfButtonIsDefaultBox, Path=IsChecked}"
                    IsEnabled="{Binding IsSimpleButtonEnabled, Mode=OneWay}"
                    Style="{ui:StyleResource ButtonStyle}" />
                <StackPanel Grid.Column="1">
                    <ui:CheckBox Content="Enable button" IsChecked="{Binding IsSimpleButtonEnabled}" />
                    <ui:Separator Margin="0,4" Orientation="Horizontal" />
                    <ui:CheckBox x:Name="WpfButtonIsDefaultBox" Content="IsDefault" />
                </StackPanel>

            </Grid>
        </controls:ControlExample>

        <controls:ControlExample
            Margin="0,32,0,0"
            HeaderText="WPF UI button."
            XamlCode="&lt;ui:Button Content=&quot;WPF UI button&quot; Icon=&quot;Fluent24&quot; /&gt;">
            <controls:ControlExample.Resources>
                <ObjectDataProvider
                    x:Key="AppearanceList"
                    MethodName="GetValues"
                    ObjectType="{x:Type ui:ControlAppearance}">
                    <ObjectDataProvider.MethodParameters>
                        <x:Type TypeName="ui:ControlAppearance" />
                    </ObjectDataProvider.MethodParameters>
                </ObjectDataProvider>
            </controls:ControlExample.Resources>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button
                    Grid.Column="0"
                    MinWidth="200"
                    Padding="{ui:VariableResource TextControlThemePadding}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Appearance="{Binding ButtonAppearance}"
                    Content="WPF UI button"
                    Icon="{ui:SymbolIcon Fluent24}"
                    IsDefault="{Binding ElementName=ButtonIsDefaultBox, Path=IsChecked}"
                    IsEnabled="{Binding IsUiButtonEnabled, Mode=OneWay}" />
                <StackPanel Grid.Column="1" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Text="Appearance" />
                        <ui:ComboBox
                            MinWidth="130"
                            ItemsSource="{Binding Source={StaticResource AppearanceList}}"
                            SelectedItem="{Binding ButtonAppearance}" />
                    </StackPanel>
                    <ui:Separator Margin="0,4" Orientation="Horizontal" />
                    <ui:CheckBox Content="Enable button" IsChecked="{Binding IsUiButtonEnabled}" />
                    <ui:Separator Margin="0,4" Orientation="Horizontal" />
                    <ui:CheckBox x:Name="ButtonIsDefaultBox" Content="IsDefault" />
                </StackPanel>
            </Grid>
        </controls:ControlExample>

        <controls:ControlExample
            Margin="0,32,0,0"
            HeaderText="WPF UI Default button."
            XamlCode="&lt;ui:Button Appearance=&quot;Primary&quot; /&gt;">
            <ui:Button
                MinWidth="200"
                Padding="{ui:VariableResource TextControlThemePadding}"
                HorizontalAlignment="Left"
                Appearance="Normal"
                Content="WPF UI button"
                Icon="{ui:SymbolIcon Fluent24}"
                IsDefault="True" />
        </controls:ControlExample>

        <controls:ControlExample
            Margin="0,32,0,0"
            HeaderText="WPF UI button with FontIcon."
            XamlCode="&lt;ui:Button Appearance=&quot;Primary&quot; /&gt;">
            <ui:Button
                MinWidth="200"
                Padding="{ui:VariableResource TextControlThemePadding}"
                HorizontalAlignment="Left"
                Appearance="Normal"
                Content="WPF UI button with font icon"
                Icon="{ui:FontIcon '&#x1F308;'}" />
        </controls:ControlExample>

        <controls:ControlExample
            Margin="0,32,0,0"
            HeaderText="WPF UI button with ImageIcon."
            XamlCode="&lt;ui:Button Appearance=&quot;Primary&quot; /&gt;">
            <ui:Button
                MinWidth="200"
                Padding="{ui:VariableResource TextControlThemePadding}"
                HorizontalAlignment="Left"
                Appearance="Normal"
                Content="WPF UI button with image icon"
                Icon="{ui:ImageIcon 'pack://application:,,,/Assets/wpfui.png'}" />
        </controls:ControlExample>

        <controls:ControlExample
            Margin="0,32,0,0"
            HeaderText="WPF UI button with modified content template."
            XamlCode="&lt;ui:Button Appearance=&quot;Primary&quot; /&gt;">
            <ui:Button
                Width="40"
                Padding="{ui:VariableResource TextControlThemePadding}"
                HorizontalAlignment="Left"
                ContentTemplate="{StaticResource ViewBoxCustomButtonContentTemplate}">
                <Canvas Width="47" Height="99">
                    <Path Data="M0,19H18V84h29v15H0V19Z" Fill="{ui:BrushResource TextFillColorSecondaryBrush}" />
                    <Path Data="M46,80H29V15H0V0H46V80Z" Fill="{ui:BrushResource TextFillColorSecondaryBrush}" />
                </Canvas>
            </ui:Button>
        </controls:ControlExample>
    </StackPanel>
</Page>
