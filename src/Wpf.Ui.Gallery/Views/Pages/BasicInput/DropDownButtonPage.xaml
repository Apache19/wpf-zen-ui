<Page
    x:Class="Wpf.Ui.Gallery.Views.Pages.BasicInput.DropDownButtonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Wpf.Ui.Gallery.ViewModels.Pages.BasicInput"
    Title="DropDownButtonPage"
    controls:PageControlDocumentation.DocumentationType="{x:Type ui:DropDownButton}"
    d:Background="{ui:BrushResource WindowBackgroundBrush}"
    d:DataContext="{d:DesignInstance vm:DropDownButtonViewModel, IsDesignTimeCreatable=False}"
    d:DesignHeight="1200"
    d:DesignWidth="800"
    Foreground="{ui:BrushResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <StackPanel Margin="0,0,0,24">
        <!-- ============================================================ -->
        <!--  1. DropDownButton with comprehensive flyout menu              -->
        <!-- ============================================================ -->
        <controls:ControlExample
            Margin="0"
            HeaderText="A DropDownButton with file and edit operations."
            XamlCode="&lt;ui:DropDownButton Content=&quot;Menu&quot; Icon=&quot;{ui:SymbolIcon Fluent24}&quot;&gt;
    &lt;ui:DropDownButton.Flyout&gt;
        &lt;ContextMenu&gt;
            &lt;!-- File --&gt;
            &lt;MenuItem Header=&quot;New&quot; Icon=&quot;{ui:SymbolIcon Add24}&quot; /&gt;
            &lt;MenuItem Header=&quot;Open...&quot; Icon=&quot;{ui:SymbolIcon Open24}&quot; /&gt;
            &lt;MenuItem Header=&quot;Save&quot; Icon=&quot;{ui:SymbolIcon Save24}&quot; /&gt;
            &lt;MenuItem Header=&quot;Save As...&quot; Icon=&quot;{ui:SymbolIcon SaveCopy24}&quot; /&gt;
            &lt;Separator /&gt;
            &lt;MenuItem Header=&quot;Print...&quot; Icon=&quot;{ui:SymbolIcon Print24}&quot; /&gt;
            &lt;MenuItem Header=&quot;Exit&quot; Icon=&quot;{ui:SymbolIcon DoorArrowRight24}&quot; /&gt;
            &lt;Separator /&gt;
            &lt;!-- Edit --&gt;
            &lt;MenuItem Header=&quot;Undo&quot; Icon=&quot;{ui:SymbolIcon ArrowUndo24}&quot; /&gt;
            &lt;MenuItem Header=&quot;Redo&quot; Icon=&quot;{ui:SymbolIcon ArrowRedo24}&quot; /&gt;
            &lt;Separator /&gt;
            &lt;MenuItem Header=&quot;Cut&quot; Icon=&quot;{ui:SymbolIcon Cut24}&quot; /&gt;
            &lt;MenuItem Header=&quot;Copy&quot; Icon=&quot;{ui:SymbolIcon Copy24}&quot; /&gt;
            &lt;MenuItem Header=&quot;Paste&quot; Icon=&quot;{ui:SymbolIcon ClipboardPaste24}&quot; /&gt;
            &lt;MenuItem Header=&quot;Delete&quot; Icon=&quot;{ui:SymbolIcon Delete24}&quot; /&gt;
            &lt;Separator /&gt;
            &lt;MenuItem Header=&quot;Select All&quot; Icon=&quot;{ui:SymbolIcon SelectAllOn24}&quot; /&gt;
        &lt;/ContextMenu&gt;
    &lt;/ui:DropDownButton.Flyout&gt;
&lt;/ui:DropDownButton&gt;">
            <StackPanel>
                <ui:DropDownButton
                    MinWidth="250"
                    HorizontalAlignment="Left"
                    Content="Menu"
                    Icon="{ui:SymbolIcon Fluent24}">
                    <ui:DropDownButton.Flyout>
                        <ContextMenu>
                            <!-- File operations -->
                            <MenuItem
                                Command="{Binding NewCommand}"
                                Header="New"
                                Icon="{ui:SymbolIcon Add24}"
                                InputGestureText="Ctrl+N" />
                            <MenuItem
                                Command="{Binding OpenCommand}"
                                Header="Open..."
                                Icon="{ui:SymbolIcon Open24}"
                                InputGestureText="Ctrl+O" />
                            <MenuItem
                                Command="{Binding SaveCommand}"
                                Header="Save"
                                Icon="{ui:SymbolIcon Save24}"
                                InputGestureText="Ctrl+S" />
                            <MenuItem
                                Command="{Binding SaveAsCommand}"
                                Header="Save As..."
                                Icon="{ui:SymbolIcon SaveCopy24}"
                                InputGestureText="Ctrl+Shift+S" />
                            <Separator />
                            <MenuItem
                                Command="{Binding PrintCommand}"
                                Header="Print..."
                                Icon="{ui:SymbolIcon Print24}"
                                InputGestureText="Ctrl+P" />
                            <MenuItem
                                Command="{Binding ExitCommand}"
                                Header="Exit"
                                Icon="{ui:SymbolIcon DoorArrowRight20}" />
                            <Separator />
                            <!-- Edit operations -->
                            <MenuItem
                                Command="{Binding UndoCommand}"
                                Header="Undo"
                                Icon="{ui:SymbolIcon ArrowUndo24}"
                                InputGestureText="Ctrl+Z" />
                            <MenuItem
                                Command="{Binding RedoCommand}"
                                Header="Redo"
                                Icon="{ui:SymbolIcon ArrowRedo24}"
                                InputGestureText="Ctrl+Y" />
                            <Separator />
                            <MenuItem
                                Command="{Binding CutCommand}"
                                Header="Cut"
                                Icon="{ui:SymbolIcon Cut24}"
                                InputGestureText="Ctrl+X" />
                            <MenuItem
                                Command="{Binding CopyCommand}"
                                Header="Copy"
                                Icon="{ui:SymbolIcon Copy24}"
                                InputGestureText="Ctrl+C" />
                            <MenuItem
                                Command="{Binding PasteCommand}"
                                Header="Paste"
                                Icon="{ui:SymbolIcon ClipboardPaste24}"
                                InputGestureText="Ctrl+V" />
                            <MenuItem
                                Command="{Binding DeleteCommand}"
                                Header="Delete"
                                Icon="{ui:SymbolIcon Delete24}"
                                InputGestureText="Del" />
                            <Separator />
                            <MenuItem
                                Command="{Binding SelectAllCommand}"
                                Header="Select All"
                                Icon="{ui:SymbolIcon SelectAllOn24}"
                                InputGestureText="Ctrl+A" />
                        </ContextMenu>
                    </ui:DropDownButton.Flyout>
                </ui:DropDownButton>

                <!-- Status feedback -->
                <TextBlock
                    Margin="12,12,0,0"
                    FontSize="13"
                    Foreground="{ui:BrushResource TextFillColorSecondaryBrush}"
                    Text="{Binding StatusMessage}" />
            </StackPanel>
        </controls:ControlExample>

        <!-- ============================================================ -->
        <!--  2. Right-click context menu on a control                     -->
        <!-- ============================================================ -->
        <controls:ControlExample
            Margin="0,24,0,0"
            HeaderText="A control with right-click context menu."
            XamlCode="&lt;Border Background=&quot;{ui:BrushResource CardBackgroundFillColorDefaultBrush}&quot;
        BorderBrush=&quot;{ui:BrushResource CardStrokeColorDefaultBrush}&quot;
        BorderThickness=&quot;1&quot;
        CornerRadius=&quot;8&quot;
        Padding=&quot;24&quot;&gt;
    &lt;Border.ContextMenu&gt;
        &lt;ContextMenu&gt;
            &lt;MenuItem Header=&quot;Cut&quot; Icon=&quot;{ui:SymbolIcon Cut24}&quot; /&gt;
            &lt;MenuItem Header=&quot;Copy&quot; Icon=&quot;{ui:SymbolIcon Copy24}&quot; /&gt;
            &lt;MenuItem Header=&quot;Paste&quot; Icon=&quot;{ui:SymbolIcon ClipboardPaste24}&quot; /&gt;
            &lt;Separator /&gt;
            &lt;MenuItem Header=&quot;Select All&quot; Icon=&quot;{ui:SymbolIcon SelectAllOn24}&quot; /&gt;
        &lt;/ContextMenu&gt;
    &lt;/Border.ContextMenu&gt;
    &lt;TextBlock Text=&quot;Right-click here to show context menu.&quot; /&gt;
&lt;/Border&gt;">
            <!-- A card-like control with right-click ContextMenu -->
            <Border
                MinWidth="320"
                Background="{ui:BrushResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ui:BrushResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Cursor="Hand"
                Focusable="True"
                Padding="24"
                ToolTip="Right-click or press Shift+F10 to open context menu">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem
                            Command="{Binding CutCommand}"
                            Header="Cut"
                            Icon="{ui:SymbolIcon Cut24}"
                            InputGestureText="Ctrl+X" />
                        <MenuItem
                            Command="{Binding CopyCommand}"
                            Header="Copy"
                            Icon="{ui:SymbolIcon Copy24}"
                            InputGestureText="Ctrl+C" />
                        <MenuItem
                            Command="{Binding PasteCommand}"
                            Header="Paste"
                            Icon="{ui:SymbolIcon ClipboardPaste24}"
                            InputGestureText="Ctrl+V" />
                        <MenuItem
                            Command="{Binding DeleteCommand}"
                            Header="Delete"
                            Icon="{ui:SymbolIcon Delete24}"
                            InputGestureText="Del" />
                        <Separator />
                        <MenuItem
                            Command="{Binding SelectAllCommand}"
                            Header="Select All"
                            Icon="{ui:SymbolIcon SelectAllOn24}"
                            InputGestureText="Ctrl+A" />
                        <Separator />
                        <MenuItem
                            Command="{Binding RefreshCommand}"
                            Header="Refresh"
                            Icon="{ui:SymbolIcon ArrowClockwise24}"
                            InputGestureText="F5" />
                        <MenuItem
                            Command="{Binding SettingsCommand}"
                            Header="Settings..."
                            Icon="{ui:SymbolIcon Settings24}" />
                    </ContextMenu>
                </Border.ContextMenu>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            VerticalAlignment="Center"
                            Filled="True"
                            FontSize="20"
                            Foreground="{ui:BrushResource TextFillColorSecondaryBrush}"
                            Symbol="Cursor24" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="Interaction Area" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="13"
                        Foreground="{ui:BrushResource TextFillColorSecondaryBrush}"
                        Text="Right-click here to show context menu."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </controls:ControlExample>

        <!-- ============================================================ -->
        <!--  3. Very tall menu — DropDownButton with scrolling flyout     -->
        <!-- ============================================================ -->
        <controls:ControlExample
            Margin="0,24,0,0"
            HeaderText="A DropDownButton with a very long menu to demonstrate scrolling."
            XamlCode="&lt;ui:DropDownButton Content=&quot;Languages&quot; Icon=&quot;{ui:SymbolIcon Code24}&quot;&gt;
    &lt;ui:DropDownButton.Flyout&gt;
        &lt;ContextMenu&gt;
            &lt;MenuItem Header=&quot;C# / .NET&quot; Icon=&quot;{ui:SymbolIcon Code24}&quot; /&gt;
            &lt;MenuItem Header=&quot;F#&quot; /&gt;
            &lt;MenuItem Header=&quot;Visual Basic&quot; /&gt;
            &lt;Separator /&gt;
            &lt;MenuItem Header=&quot;Rust&quot; /&gt;
            &lt;MenuItem Header=&quot;Go&quot; /&gt;
            &lt;MenuItem Header=&quot;Zig&quot; /&gt;
            &lt;Separator /&gt;
            &lt;MenuItem Header=&quot;Java&quot; /&gt;
            &lt;MenuItem Header=&quot;Kotlin&quot; /&gt;
            &lt;MenuItem Header=&quot;Scala&quot; /&gt;
            &lt;Separator /&gt;
            &lt;MenuItem Header=&quot;Python&quot; Icon=&quot;{ui:SymbolIcon Code24}&quot; /&gt;
            &lt;MenuItem Header=&quot;Ruby&quot; /&gt;
            &lt;Separator /&gt;
            &lt;MenuItem Header=&quot;JavaScript&quot; Icon=&quot;{ui:SymbolIcon Code24}&quot; /&gt;
            &lt;MenuItem Header=&quot;TypeScript&quot; /&gt;
            &lt;Separator /&gt;
            &lt;MenuItem Header=&quot;HTML / XML&quot; /&gt;
            &lt;MenuItem Header=&quot;CSS / SCSS&quot; /&gt;
            &lt;Separator /&gt;
            &lt;MenuItem Header=&quot;SQL / T-SQL&quot; /&gt;
            &lt;MenuItem Header=&quot;PowerShell&quot; /&gt;
            &lt;MenuItem Header=&quot;Bash / Shell&quot; /&gt;
            &lt;Separator /&gt;
            &lt;MenuItem Header=&quot;Dart&quot; /&gt;
            &lt;MenuItem Header=&quot;Swift&quot; /&gt;
            &lt;MenuItem Header=&quot;C / C++&quot; /&gt;
        &lt;/ContextMenu&gt;
    &lt;/ui:DropDownButton.Flyout&gt;
&lt;/ui:DropDownButton&gt;">
            <StackPanel>
                <ui:DropDownButton
                    MinWidth="250"
                    HorizontalAlignment="Left"
                    Content="Languages"
                    Icon="{ui:SymbolIcon Code24}">
                    <ui:DropDownButton.Flyout>
                        <ContextMenu>
                            <MenuItem
                                Command="{Binding CutCommand}"
                                Header="C# / .NET"
                                Icon="{ui:SymbolIcon Code24}" />
                            <MenuItem Command="{Binding CutCommand}" Header="F#" />
                            <MenuItem Command="{Binding CutCommand}" Header="Visual Basic" />
                            <Separator />
                            <MenuItem Command="{Binding CutCommand}" Header="Rust" />
                            <MenuItem Command="{Binding CutCommand}" Header="Go" />
                            <MenuItem Command="{Binding CutCommand}" Header="Zig" />
                            <Separator />
                            <MenuItem Command="{Binding CutCommand}" Header="Java" />
                            <MenuItem Command="{Binding CutCommand}" Header="Kotlin" />
                            <MenuItem Command="{Binding CutCommand}" Header="Scala" />
                            <Separator />
                            <MenuItem
                                Command="{Binding CutCommand}"
                                Header="Python"
                                Icon="{ui:SymbolIcon Code24}" />
                            <MenuItem Command="{Binding CutCommand}" Header="Ruby" />
                            <Separator />
                            <MenuItem
                                Command="{Binding CutCommand}"
                                Header="JavaScript"
                                Icon="{ui:SymbolIcon Code24}" />
                            <MenuItem Command="{Binding CutCommand}" Header="TypeScript" />
                            <Separator />
                            <MenuItem Command="{Binding CutCommand}" Header="HTML / XML" />
                            <MenuItem Command="{Binding CutCommand}" Header="CSS / SCSS / Less" />
                            <Separator />
                            <MenuItem Command="{Binding CutCommand}" Header="SQL / T-SQL" />
                            <MenuItem Command="{Binding CutCommand}" Header="PowerShell" />
                            <MenuItem Command="{Binding CutCommand}" Header="Bash / Shell" />
                            <Separator />
                            <MenuItem Command="{Binding CutCommand}" Header="Dart" />
                            <MenuItem Command="{Binding CutCommand}" Header="Swift" />
                            <MenuItem Command="{Binding CutCommand}" Header="C / C++" />
                        </ContextMenu>
                    </ui:DropDownButton.Flyout>
                </ui:DropDownButton>
            </StackPanel>
        </controls:ControlExample>

        <!-- ============================================================ -->
        <!--  4. Very tall right-click context menu                        -->
        <!-- ============================================================ -->
        <controls:ControlExample
            Margin="0,24,0,0"
            HeaderText="A control with a very long right-click context menu."
            XamlCode="&lt;Border Background=&quot;{ui:BrushResource CardBackgroundFillColorDefaultBrush}&quot;
        BorderBrush=&quot;{ui:BrushResource CardStrokeColorDefaultBrush}&quot;
        BorderThickness=&quot;1&quot;
        CornerRadius=&quot;8&quot;
        Padding=&quot;24&quot;&gt;
    &lt;Border.ContextMenu&gt;
        &lt;ContextMenu&gt;
            &lt;MenuItem Header=&quot;New File&quot; Icon=&quot;{ui:SymbolIcon Add24}&quot; /&gt;
            &lt;MenuItem Header=&quot;Open File...&quot; Icon=&quot;{ui:SymbolIcon Open24}&quot; /&gt;
            &lt;!-- ... many more items ... --&gt;
            &lt;MenuItem Header=&quot;Exit&quot; Icon=&quot;{ui:SymbolIcon DoorArrowRight24}&quot; /&gt;
        &lt;/ContextMenu&gt;
    &lt;/Border.ContextMenu&gt;
    &lt;TextBlock Text=&quot;Right-click here for a tall scrolling menu.&quot; /&gt;
&lt;/Border&gt;">
            <Border
                MinWidth="320"
                Background="{ui:BrushResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ui:BrushResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Cursor="Hand"
                Focusable="True"
                Padding="24"
                ToolTip="Right-click or press Shift+F10 to open a very long scrolling context menu">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem
                            Command="{Binding NewCommand}"
                            Header="New File"
                            Icon="{ui:SymbolIcon Add24}"
                            InputGestureText="Ctrl+N" />
                        <MenuItem
                            Command="{Binding OpenCommand}"
                            Header="Open File..."
                            Icon="{ui:SymbolIcon Open24}"
                            InputGestureText="Ctrl+O" />
                        <MenuItem
                            Command="{Binding OpenCommand}"
                            Header="Open Folder..."
                            Icon="{ui:SymbolIcon FolderOpen24}"
                            InputGestureText="Ctrl+K, Ctrl+O" />
                        <Separator />
                        <MenuItem
                            Command="{Binding SaveCommand}"
                            Header="Save"
                            Icon="{ui:SymbolIcon Save24}"
                            InputGestureText="Ctrl+S" />
                        <MenuItem
                            Command="{Binding SaveAsCommand}"
                            Header="Save As..."
                            Icon="{ui:SymbolIcon SaveCopy24}"
                            InputGestureText="Ctrl+Shift+S" />
                        <MenuItem
                            Command="{Binding SaveAsCommand}"
                            Header="Save All"
                            Icon="{ui:SymbolIcon SaveMultiple24}"
                            InputGestureText="Ctrl+K, S" />
                        <Separator />
                        <MenuItem
                            Command="{Binding UndoCommand}"
                            Header="Undo"
                            Icon="{ui:SymbolIcon ArrowUndo24}"
                            InputGestureText="Ctrl+Z" />
                        <MenuItem
                            Command="{Binding RedoCommand}"
                            Header="Redo"
                            Icon="{ui:SymbolIcon ArrowRedo24}"
                            InputGestureText="Ctrl+Y" />
                        <Separator />
                        <MenuItem
                            Command="{Binding CutCommand}"
                            Header="Cut"
                            Icon="{ui:SymbolIcon Cut24}"
                            InputGestureText="Ctrl+X" />
                        <MenuItem
                            Command="{Binding CopyCommand}"
                            Header="Copy"
                            Icon="{ui:SymbolIcon Copy24}"
                            InputGestureText="Ctrl+C" />
                        <MenuItem
                            Command="{Binding PasteCommand}"
                            Header="Paste"
                            Icon="{ui:SymbolIcon ClipboardPaste24}"
                            InputGestureText="Ctrl+V" />
                        <MenuItem
                            Command="{Binding DeleteCommand}"
                            Header="Delete"
                            Icon="{ui:SymbolIcon Delete24}"
                            InputGestureText="Del" />
                        <Separator />
                        <MenuItem
                            Command="{Binding SelectAllCommand}"
                            Header="Select All"
                            Icon="{ui:SymbolIcon SelectAllOn24}"
                            InputGestureText="Ctrl+A" />
                        <Separator />
                        <MenuItem
                            Command="{Binding CutCommand}"
                            Header="Find..."
                            Icon="{ui:SymbolIcon Search24}"
                            InputGestureText="Ctrl+F" />
                        <MenuItem
                            Command="{Binding CutCommand}"
                            Header="Find in Files..."
                            Icon="{ui:SymbolIcon SearchSettings20}"
                            InputGestureText="Ctrl+Shift+F" />
                        <MenuItem
                            Command="{Binding CutCommand}"
                            Header="Replace..."
                            Icon="{ui:SymbolIcon ArrowSwap24}"
                            InputGestureText="Ctrl+H" />
                        <Separator />
                        <MenuItem
                            Command="{Binding CutCommand}"
                            Header="Go to Line..."
                            Icon="{ui:SymbolIcon NumberSymbol24}"
                            InputGestureText="Ctrl+G" />
                        <MenuItem
                            Command="{Binding CutCommand}"
                            Header="Go to Symbol..."
                            Icon="{ui:SymbolIcon Symbols24}"
                            InputGestureText="Ctrl+T" />
                        <Separator />
                        <MenuItem
                            Command="{Binding CutCommand}"
                            Header="Toggle Breakpoint"
                            Icon="{ui:SymbolIcon Circle24}"
                            InputGestureText="F9" />
                        <MenuItem
                            Command="{Binding CutCommand}"
                            Header="Start Debugging"
                            Icon="{ui:SymbolIcon Play24}"
                            InputGestureText="F5" />
                        <Separator />
                        <MenuItem
                            Command="{Binding RefreshCommand}"
                            Header="Refresh"
                            Icon="{ui:SymbolIcon ArrowClockwise24}" />
                        <MenuItem
                            Command="{Binding SettingsCommand}"
                            Header="Settings"
                            Icon="{ui:SymbolIcon Settings24}" />
                        <Separator />
                        <MenuItem
                            Command="{Binding ExitCommand}"
                            Header="Exit"
                            Icon="{ui:SymbolIcon DoorArrowRight20}" />
                    </ContextMenu>
                </Border.ContextMenu>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            VerticalAlignment="Center"
                            Filled="True"
                            FontSize="20"
                            Foreground="{ui:BrushResource PaletteLightBlueBrush}"
                            Symbol="List24" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="Scrolling Context Menu" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="13"
                        Foreground="{ui:BrushResource TextFillColorSecondaryBrush}"
                        Text="Right-click here to show a very long scrolling context menu with many items."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </controls:ControlExample>
    </StackPanel>
</Page>
