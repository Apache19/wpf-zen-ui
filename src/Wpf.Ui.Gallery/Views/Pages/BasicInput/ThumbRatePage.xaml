<Page
    x:Class="Wpf.Ui.Gallery.Views.Pages.BasicInput.ThumbRatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Wpf.Ui.Gallery.ViewModels.Pages.BasicInput"
    Title="ThumbRatePage"
    controls:PageControlDocumentation.DocumentationType="{x:Type ui:ThumbRate}"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DataContext="{d:DesignInstance vm:ThumbRateViewModel, IsDesignTimeCreatable=False}"
    d:DesignWidth="800"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    Style="{ui:DynamicStyle DynamicScrollPage}"
    mc:Ignorable="d">

    <Grid Margin="0,0,0,24">
        <controls:ControlExample
            Margin="0"
            HeaderText="WPF UI thumb rate."
            XamlCode="{Binding ThumbRateStateCodeText}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:ThumbRate HorizontalAlignment="Left" State="{Binding ThumbRateState, Mode=TwoWay}" />
                <StackPanel
                    Grid.Column="1"
                    MinWidth="60"
                    VerticalAlignment="Center">
                    <Label Content="State:" Foreground="{ui:DynamicBrush TextFillTertiary}" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding ThumbRateStateText}" />
                </StackPanel>
            </Grid>
        </controls:ControlExample>
    </Grid>
</Page>
