<Page
    x:Class="Wpf.Ui.Gallery.Views.Pages.DesignGuidance.ColorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Wpf.Ui.Gallery.ViewModels.Pages.DesignGuidance"
    Title="ColorsPage"
    d:Background="{ui:BrushResource WindowBackgroundBrush}"
    d:DataContext="{d:DesignInstance vm:ColorsViewModel, IsDesignTimeCreatable=False}"
    d:DesignWidth="800"
    Foreground="{ui:BrushResource TextFillColorPrimaryBrush}"
    Style="{ui:StyleResource DynamicScrollPageStyle}"
    mc:Ignorable="d">

    <StackPanel Margin="0,0,0,24">
        <StackPanel.Resources>
            <Style TargetType="{x:Type ui:TextBox}">
                <Setter Property="UseTextBlockAppearance" Value="True" />
                <Setter Property="FontSize" Value="12"></Setter>
            </Style>
        </StackPanel.Resources>
        <ui:TextBlock Text="Color provides an intuitive way of communicating information to users in your app: it can be used to indicate interactivity, give feedback to user actions, and give your interface a sense of visual continuity." TextWrapping="WrapWithOverflow" />
        <ui:TextBlock
            Margin="0,12,0,0"
            FontTypography="BodyStrong"
            Text="Using colors"
            TextWrapping="WrapWithOverflow" />
        <ui:TextBlock Text="The colors below are provided as part of WPF UI. You can reference them in your app using DynamicResource bindings." TextWrapping="WrapWithOverflow" />

        <ui:TextBlock
            Margin="0,48,0,0"
            FontTypography="Subtitle"
            Text="Text"
            TextWrapping="WrapWithOverflow" />
        <Border
            Margin="0,12,0,0"
            Padding="12"
            Background="{ui:BrushResource ControlFillColorPrimaryBrush}"
            CornerRadius="8">
            <StackPanel>
                <ui:TextBlock Text="For UI labels and static text" />
                <ui:TextBlock
                    Margin="0,12,0,24"
                    HorizontalAlignment="Center"
                    FontSize="42"
                    FontWeight="SemiBold"
                    Text="Aa" />
            </StackPanel>
        </Border>

        <!--  文本色  -->
        <Grid MinHeight="120" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                Grid.Column="0"
                Background="{ui:BrushResource TextFillColorPrimaryBrush}"
                CornerRadius="8,0,0,8"
                TextElement.Foreground="{ui:BrushResource TextFillColorInverseBrush}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:TextBlock
                        Grid.Row="0"
                        FontTypography="BodyStrong"
                        Text="Text / Primary" />
                    <ui:TextBlock Grid.Row="1" Text="Rest or hover" />
                    <ui:TextBlock Grid.Row="2" Text="TextFillColorPrimaryBrush" />
                </Grid>
            </Border>
            <Border
                Grid.Column="1"
                Background="{ui:BrushResource TextFillColorSecondaryBrush}"
                CornerRadius="0"
                TextElement.Foreground="{ui:BrushResource TextFillColorInverseBrush}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:TextBlock
                        Grid.Row="0"
                        FontTypography="BodyStrong"
                        Text="Text / Secondary" />
                    <ui:TextBlock Grid.Row="1" Text="Rest or hover" />
                    <ui:TextBlock Grid.Row="2" Text="TextFillColorSecondaryBrush" />
                </Grid>
            </Border>
            <Border
                Grid.Column="2"
                Background="{ui:BrushResource TextFillColorTertiaryBrush}"
                CornerRadius="0"
                TextElement.Foreground="{ui:BrushResource TextFillColorInverseBrush}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:TextBlock
                        Grid.Row="0"
                        FontTypography="BodyStrong"
                        Text="Text / Tertiary" />
                    <ui:TextBlock Grid.Row="1" Text="Pressed only (not accessible)" />
                    <ui:TextBlock Grid.Row="2" Text="TextFillColorTertiaryBrush" />
                </Grid>
            </Border>
            <Border
                Grid.Column="3"
                Background="{ui:BrushResource TextFillColorDisabledBrush}"
                CornerRadius="0,8,8,0"
                TextElement.Foreground="{ui:BrushResource TextFillColorInverseBrush}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:TextBlock
                        Grid.Row="0"
                        FontTypography="BodyStrong"
                        Text="Text / Disabled" />
                    <ui:TextBlock Grid.Row="1" Text="Disabled only (not accessible)" />
                    <ui:TextBlock Grid.Row="2" Text="TextFillColorDisabledBrush" />
                </Grid>
            </Border>
        </Grid>

        <ui:TextBlock
            Margin="0,48,0,0"
            FontTypography="Subtitle"
            Text="Accent roles"
            TextWrapping="WrapWithOverflow" />
        <ui:TextBlock
            Margin="0,4,0,0"
            Text="Controls choose how to map these hierarchy-based resources to their own interaction states."
            TextWrapping="WrapWithOverflow" />

        <UniformGrid
            Margin="0,12,0,0"
            Columns="4"
            Rows="2">
            <Border
                MinHeight="110"
                Background="{ui:BrushResource AccentFillPrimaryBrush}"
                CornerRadius="8 0 0 0"
                TextElement.Foreground="{ui:BrushResource TextOnAccentPrimaryBrush}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:TextBlock Grid.Row="0" FontTypography="BodyStrong" Text="Accent Fill / Primary" />
                    <ui:TextBlock Grid.Row="1" FontSize="12" Text="Rest or hover" />
                    <ui:TextBox Grid.Row="2" Text="AccentFillPrimaryBrush" />
                </Grid>
            </Border>
            <Border
                MinHeight="110"
                Background="{ui:BrushResource AccentFillSecondaryBrush}"
                CornerRadius="0"
                TextElement.Foreground="{ui:BrushResource TextOnAccentPrimaryBrush}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:TextBlock Grid.Row="0" FontTypography="BodyStrong" Text="Accent Fill / Secondary" />
                    <ui:TextBlock Grid.Row="1" FontSize="12" Text="Rest or hover" />
                    <ui:TextBox Grid.Row="2" Text="AccentFillSecondaryBrush" />
                </Grid>
            </Border>
            <Border
                MinHeight="110"
                Background="{ui:BrushResource AccentFillTertiaryBrush}"
                TextElement.Foreground="{ui:BrushResource TextOnAccentPrimaryBrush}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:TextBlock Grid.Row="0" FontTypography="BodyStrong" Text="Accent Fill / Tertiary" />
                    <ui:TextBlock Grid.Row="1" FontSize="12" Text="Pressed" />
                    <ui:TextBox Grid.Row="2" Text="AccentFillTertiaryBrush" />
                </Grid>
            </Border>
            <Border
                MinHeight="110"
      
                Background="{ui:BrushResource AccentSelectionBrush}"
                CornerRadius="0 8 0 0"
                TextElement.Foreground="{ui:BrushResource TextOnAccentPrimaryBrush}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:TextBlock Grid.Row="0" FontTypography="BodyStrong" Text="Accent / Selection" />
                    <ui:TextBlock Grid.Row="1" FontSize="12" Text="用在选择和焦点指示" />
                    <ui:TextBox  Grid.Row="2" Text="AccentSelectionBrush" />
                </Grid>
            </Border>
            <Border
                MinHeight="110"
        
                Background="{ui:BrushResource AccentTextPrimaryBrush}"
                CornerRadius="0 0 0 8"
                TextElement.Foreground="{ui:BrushResource TextFillColorInverseBrush}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:TextBlock Grid.Row="0" FontTypography="BodyStrong" Text="Accent Text / Primary" />
                    <ui:TextBlock Grid.Row="1" FontSize="12" Text="Rest or hover" />
                    <ui:TextBox  Grid.Row="2" Text="AccentTextPrimaryBrush" />
                </Grid>
            </Border>
            <Border
                MinHeight="110"
                Background="{ui:BrushResource AccentTextSecondaryBrush}"
                CornerRadius="0"
                TextElement.Foreground="{ui:BrushResource TextFillColorInverseBrush}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:TextBlock Grid.Row="0" FontTypography="BodyStrong" Text="Accent Text / Secondary" />
                    <ui:TextBlock Grid.Row="1" FontSize="12" Text="Rest or hover" />
                    <ui:TextBox Grid.Row="2" Text="AccentTextSecondaryBrush" />
                </Grid>
            </Border>

            <Border
                MinHeight="110"
     
                Background="{ui:BrushResource AccentStrokeBrush}"
                CornerRadius="0"
                TextElement.Foreground="{ui:BrushResource TextFillColorInverseBrush}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:TextBlock Grid.Row="0" FontTypography="BodyStrong" Text="Accent / Stroke" />
                    <ui:TextBlock Grid.Row="1" FontSize="12" Text="用在边框类场景" />
                    <ui:TextBox Grid.Row="2" Text="AccentStrokeBrush" />
                </Grid>
            </Border>
            <Border
                MinHeight="110"
          
                Background="{ui:BrushResource TextOnAccentPrimaryBrush}"
                CornerRadius="0 0 8 0"
                TextElement.Foreground="{ui:BrushResource TextFillColorPrimaryBrush}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:TextBlock Grid.Row="0" FontTypography="BodyStrong" Text="Text on Accent" />
                    <ui:TextBlock Grid.Row="1" Foreground="{ui:BrushResource TextFillColorTertiaryBrush}" TextWrapping="WrapWithOverflow" FontSize="12" Text="Used for text on accent colored controls or fills" />
                    <ui:TextBox Grid.Row="2" Text="TextOnAccentPrimaryBrush" />
                </Grid>
            </Border>
        </UniformGrid>
    </StackPanel>
</Page>
