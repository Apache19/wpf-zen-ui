<Page
    x:Class="Wpf.Ui.Gallery.Views.Pages.DialogsAndFlyouts.MessageBoxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.Gallery.Views.Pages.DialogsAndFlyouts"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Wpf.Ui.Gallery.ViewModels.Pages.DialogsAndFlyouts"
    Title="MessageBoxPage"
    Style="{ui:StyleResource DynamicScrollPageStyle}"
    controls:PageControlDocumentation.DocumentationType="{x:Type ui:MessageBox}"
    d:DataContext="{d:DesignInstance vm:MessageBoxViewModel,
                                     IsDesignTimeCreatable=False}"
    d:Background="{ui:BrushResource WindowBackgroundBrush}"
    Foreground="{ui:BrushResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <StackPanel Margin="0,0,0,24">
        <controls:ControlExample
            Margin="0"
            HeaderText="Standard MessageBox."
            XamlCode="&lt;MessageBox /&gt;">
            <ui:Button
                Command="{Binding OpenStandardMessageBoxCommand, Mode=OneWay}"
                CommandParameter="{Binding RelativeSource={RelativeSource Self}, Mode=OneWay}"
                Content="Open standard MessageBox" />
        </controls:ControlExample>

        <controls:ControlExample Margin="0,36,0,0" HeaderText="WPF UI MessageBox.">
            <ui:Button
                Command="{Binding OpenCustomMessageBoxCommand, Mode=OneWay}"
                CommandParameter="{Binding RelativeSource={RelativeSource Self}, Mode=OneWay}"
                Content="Open custom MessageBox" />
        </controls:ControlExample>
    </StackPanel>
</Page>
