<Page
    x:Class="Wpf.Ui.Gallery.Views.Pages.DialogsAndFlyouts.ContentDialogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Wpf.Ui.Gallery.ViewModels.Pages.DialogsAndFlyouts"
    Title="ContentDialog"
    controls:PageControlDocumentation.DocumentationType="{x:Type ui:ContentDialog}"
    d:Background="{ui:BrushResource WindowBackgroundBrush}"
    d:DataContext="{d:DesignInstance vm:ContentDialogViewModel, IsDesignTimeCreatable=False}"
    d:DesignWidth="850"
    Foreground="{ui:BrushResource TextFillColorPrimaryBrush}"
    Style="{ui:StyleResource DynamicScrollPageStyle}"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <StackPanel x:Key="DialogContent">
                <TextBlock Text="Lorem ipsum dolor sit amet, adipisicing elit." TextWrapping="Wrap" />
                <CheckBox Content="Upload your content to the cloud." />
            </StackPanel>
        </ResourceDictionary>
    </Page.Resources>

    <StackPanel Margin="0,0,0,24">
        <controls:ControlExample HeaderText="ContentDialog">
            <StackPanel Orientation="Horizontal">
                <ui:Button
                    Command="{Binding ShowDialogCommand}"
                    CommandParameter="{StaticResource DialogContent}"
                    Content="Show" />

                <ui:TextBlock
                    Margin="15,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Text="{Binding DialogResultText}" />
            </StackPanel>
        </controls:ControlExample>

        <controls:ControlExample Margin="0,36,0,0" HeaderText="Terms of Use ContentDialog example">
            <ui:Button
                HorizontalAlignment="Left"
                Command="{Binding ShowSignInContentDialogCommand}"
                Content="Show" />
        </controls:ControlExample>
    </StackPanel>
</Page>
