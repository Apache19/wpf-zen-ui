<Page
    x:Class="Wpf.Ui.Gallery.Views.Pages.StatusAndInfo.ProgressBarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Wpf.Ui.Gallery.ViewModels.Pages.StatusAndInfo"
    Title="ProgressBarPage"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DataContext="{d:DesignInstance vm:ProgressBarViewModel, IsDesignTimeCreatable=False}"
    d:DesignWidth="800"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    Style="{ui:DynamicStyle DynamicScrollPage}"
    mc:Ignorable="d">

    <controls:ControlExample
        Margin="0"
        HeaderText="An indeterminate progress bar."
        XamlCode="&lt;ProgressBar IsIndeterminate=&quot;True&quot; /&gt;">
        <ProgressBar Margin="24" IsIndeterminate="True" />
    </controls:ControlExample>
</Page>
