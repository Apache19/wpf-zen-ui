<Page
    x:Class="Wpf.Ui.Gallery.Views.Pages.Text.AutoSuggestBoxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.Gallery.Views.Pages.Text"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Wpf.Ui.Gallery.ViewModels.Pages.Text"
    Title="AutoSuggestBoxPage"
    controls:PageControlDocumentation.DocumentationType="{x:Type ui:AutoSuggestBox}"
    d:Background="{ui:BrushResource WindowBackgroundBrush}"
    d:DataContext="{d:DesignInstance vm:AutoSuggestBoxViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignWidth="800"
    Foreground="{ui:BrushResource TextFillColorPrimaryBrush}"
    Style="{ui:StyleResource DynamicScrollPageStyle}"
    mc:Ignorable="d">

    <controls:ControlExample
        Margin="0"
        HeaderText="WPF UI AutoSuggestBox."
        XamlCode="&lt;ui:AutoSuggestBox Icon=&quot;{ui:SymbolIcon Search24}&quot; OriginalItemsSource=&quot;{Binding AutoSuggestBoxSuggestions, Mode=OneWay}&quot; PlaceholderText=&quot;Search...&quot; ClearButtonEnabled=&quot;{Binding ShowClearButtonDisabled, Converter={StaticResource BoolInvertConverter}}&quot; /&gt;">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:AutoSuggestBox
                Grid.Column="0"
                ClearButtonEnabled="{Binding ShowClearButtonDisabled, Converter={StaticResource BoolInvertConverter}}"
                Icon="{ui:SymbolIcon Search24}"
                OriginalItemsSource="{Binding AutoSuggestBoxSuggestions, Mode=OneWay}"
                PlaceholderText="Search..." />
            <ui:CheckBox
                Grid.Column="1"
                Content="Show clear button"
                IsChecked="{Binding ShowClearButtonDisabled}" />
        </Grid>
    </controls:ControlExample>
</Page>
