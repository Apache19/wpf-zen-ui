<Page
    x:Class="Wpf.Ui.Gallery.Views.Pages.Text.NumberBoxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.Gallery.Views.Pages.Text"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:vm="clr-namespace:Wpf.Ui.Gallery.ViewModels.Pages.Text"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="NumberBoxPage"
    controls:PageControlDocumentation.DocumentationType="{x:Type ui:NumberBox}"
    d:Background="{ui:BrushResource WindowBackgroundBrush}"
    d:DataContext="{d:DesignInstance vm:NumberBoxViewModel, IsDesignTimeCreatable=False}"
    d:DesignWidth="800"
    Foreground="{ui:BrushResource TextFillColorPrimaryBrush}"
    Style="{ui:StyleResource DynamicScrollPageStyle}"
    mc:Ignorable="d">

    <StackPanel Margin="0,0,0,24">
        <controls:ControlExample
            Margin="0"
            HeaderText="WPF UI NumberBox."
            XamlCode="&lt;ui:NumberBox PlaceholderText=&quot;Enter your age&quot; /&gt;">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="8" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:NumberBox
                    Grid.RowSpan="3"
                    MinWidth="260"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    AcceptsExpression="{Binding ElementName=AcceptsExpBox, Path=SelectedValue}"
                    PlaceholderText="Enter your age"
                    SpinButtonPlacementMode="{Binding ElementName=SpinButtonPlacementBox, Path=SelectedValue}" />
                <ui:TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Text="SpinButton placement" />
                <ComboBox
                    x:Name="SpinButtonPlacementBox"
                    Grid.Row="0"
                    Grid.Column="2"
                    MinWidth="120"
                    SelectedIndex="0"
                    SelectedValuePath="Content">
                    <ComboBoxItem Content="{x:Static ui:NumberBoxSpinButtonPlacementMode.Inline}" />
                    <ComboBoxItem Content="{x:Static ui:NumberBoxSpinButtonPlacementMode.Classic}" />
                    <ComboBoxItem Content="{x:Static ui:NumberBoxSpinButtonPlacementMode.Compact}" />
                    <ComboBoxItem Content="{x:Static ui:NumberBoxSpinButtonPlacementMode.Hidden}" />
                </ComboBox>

                <ui:TextBlock
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Text="Accepts expression" />
                <ComboBox
                    x:Name="AcceptsExpBox"
                    Grid.Row="2"
                    Grid.Column="2"
                    MinWidth="120"
                    SelectedIndex="0"
                    SelectedValuePath="Content">
                    <ComboBoxItem>
                        <ComboBoxItem.Content>
                            <system:Boolean>True</system:Boolean>
                        </ComboBoxItem.Content>
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <ComboBoxItem.Content>
                            <system:Boolean>False</system:Boolean>
                        </ComboBoxItem.Content>
                    </ComboBoxItem>
                </ComboBox>

            </Grid>
        </controls:ControlExample>

        <controls:ControlExample
            Margin="0,36,0,0"
            HeaderText="WPF UI NumberBox with icon."
            XamlCode="&lt;ui:NumberBox Icon=&quot;NumberSymbolSquare24&quot; PlaceholderText=&quot;Enter your age&quot; /&gt;">
            <ui:NumberBox
                MinWidth="260"
                HorizontalAlignment="Left"
                DecimalPlaces="2"
                Icon="{ui:SymbolIcon NumberSymbolSquare24}"
                LargeChange="2.25"
                Maximum="10"
                Minimum="-10"
                PlaceholderText="Enter your age"
                SmallChange="0.25"
                SpinButtonPlacementMode="Hidden"
                Value="1.50" />
        </controls:ControlExample>

        <controls:ControlExample
            Margin="0,36,0,0"
            HeaderText="WPF UI NumberBox without decimal places."
            XamlCode="&lt;ui:NumberBox DecimalPlaces=&quot;0&quot; /&gt;">
            <ui:NumberBox
                MinWidth="260"
                HorizontalAlignment="Left"
                Icon="{ui:SymbolIcon NumberSymbolSquare24}"
                MaxDecimalPlaces="0"
                Maximum="100"
                Minimum="0"
                PlaceholderText="Enter your age"
                SmallChange="1"
                Value="12" />
        </controls:ControlExample>
    </StackPanel>
</Page>
