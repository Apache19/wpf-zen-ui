<Application
    x:Class="Wpf.Ui.Gallery.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:Wpf.Ui.Gallery.Helpers"
    xmlns:local="clr-namespace:Wpf.Ui.Gallery"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syntax="http://schemas.lepo.co/wpfui/2022/xaml/syntax"
    xmlns:theming="http://schemas.lepo.co/wpfui/2022/xaml/theming"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    DispatcherUnhandledException="OnDispatcherUnhandledException"
    Exit="OnExit"
    Startup="OnStartup"
    mc:Ignorable="d">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <ui:ThemeManagerOptions ThemeMode="Dark" UseSystemAccentColor="True" />

                <syntax:SyntaxHighlightDictionary />

                <ResourceDictionary Source="Controls/GalleryNavigationPresenter.xaml" />
                <ResourceDictionary Source="Controls/ControlExample.xaml" />
                <ResourceDictionary Source="Controls/TypographyControl.xaml" />
                <ResourceDictionary Source="Controls/PageControlDocumentation.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
            <helpers:PaneDisplayModeToIndexConverter x:Key="PaneDisplayModeToIndexConverter" />
            <helpers:BoolInvertConverter x:Key="BoolInvertConverter" />

            <!--
                Gallery pages explicitly opt into page-owned scrolling. NavigationView itself
                remains layout-neutral and never wraps arbitrary application content.
            -->
            <!--
                Style.BasedOn is not a dependency property, so it deliberately uses a static
                ComponentResourceKey lookup instead of the dynamic StyleResource extension.
            -->
            <Style BasedOn="{StaticResource {x:Static theming:StyleKeys.DynamicScrollPageStyle}}" TargetType="{x:Type Page}" />
        </ResourceDictionary>

    </Application.Resources>
</Application>
