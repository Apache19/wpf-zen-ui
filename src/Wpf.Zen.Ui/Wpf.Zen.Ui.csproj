<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Wpf.Zen.Ui</PackageId>
    <TargetFrameworks>net472;net8.0-windows</TargetFrameworks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Description>WPF controls, themes, navigation, and dialogs for .NET Framework 4.7.2 and .NET 8 or later. An independently maintained and refactored fork of WPF UI.</Description>
    <PackageReleaseNotes>First release under the Wpf.Zen.Ui package name. Versioning starts at 1.0.0; APIs and XAML namespaces differ from upstream WPF UI.</PackageReleaseNotes>
    <UseWPF>true</UseWPF>
    <LangVersion>preview</LangVersion>
    <PolySharpExcludeGeneratedTypes>System.Runtime.CompilerServices.OverloadResolutionPriorityAttribute;System.Diagnostics.CodeAnalysis.UnscopedRefAttribute</PolySharpExcludeGeneratedTypes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="VisualStudioToolsManifest.xml" Pack="true" PackagePath="tools" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Fonts\FluentSystemIcons-Filled.ttf" />
    <Resource Include="Resources\Fonts\FluentSystemIcons-Regular.ttf" />
    <Resource Include="Effects\ColorAdjustment.ps" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Controls\AutoSuggestBox\AutoSuggestBox.bmp" />
    <EmbeddedResource Include="Controls\Button\Badge.bmp" />
    <EmbeddedResource Include="Controls\CardAction\CardAction.bmp" />
    <EmbeddedResource Include="Controls\Card\Card.bmp" />
    <EmbeddedResource Include="Controls\ScrollViewer\UiScrollViewer.bmp" />
    <EmbeddedResource Include="Controls\ScrollViewer\UiScrollBar.bmp" />
    <EmbeddedResource Include="Controls\ScrollViewer\DynamicScrollViewer.bmp" />
    <EmbeddedResource Include="Controls\NavigationView\NavigationView.bmp" />
    <EmbeddedResource Include="Controls\NavigationView\NavigationViewItem.bmp" />
    <EmbeddedResource Include="Controls\NumberBox\NumberBox.bmp" />
    <EmbeddedResource Include="Controls\ProgressRing\ProgressRing.bmp" />
    <EmbeddedResource Include="Controls\RatingControl\RatingControl.bmp" />
    <EmbeddedResource Include="Controls\Icon\FontIcon.bmp" />
    <EmbeddedResource Include="Controls\ThumbRate\ThumbRate.bmp" />
    <EmbeddedResource Include="Controls\ToggleSwitch\ToggleSwitch.bmp" />
    <EmbeddedResource Include="Controls\FluentWindow\FluentWindow.bmp" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Condition="'$(TargetFramework)' == 'net472'" />
    <PackageReference Include="Microsoft.Windows.CsWin32">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
