<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:converters="clr-namespace:Wpf.Zen.Ui.Converters"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup"
    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">

    <converters:DoubleToDoubleConverter x:Key="IconSizeConverter" Add="2" />

    <!--
        Kept as a separate public customization seam through CloseButtonStyle. Applications can
        replace this style without copying the InfoBar template. InfoBar applies it to the named
        part from OnApplyTemplate so custom templates do not need to duplicate a TemplateBinding.
    -->
    <Style x:Key="DefaultInfoBarCloseButtonStyle" TargetType="{x:Type primitives:ButtonBase}">
        <Setter Property="Padding" Value="4" />
        <Setter Property="controls:Button.Appearance" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="controls:IconAssist.Icon" Value="{m:FluentIconSource Dismiss24}" />
        <Setter Property="ToolTip" Value="Close" />
    </Style>

    <Style TargetType="{x:Type controls:InfoBar}">
        <Setter Property="controls:IconAssist.IconMargin" Value="0,0,12,-6" />
        <Setter Property="Background" Value="{m:DynamicBrush ControlFillPrimary}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="BorderBrush" Value="{m:DynamicBrush CardStrokeDefault}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{m:DynamicValue ControlCornerRadius}" />
        <Setter Property="CloseButtonStyle" Value="{StaticResource DefaultInfoBarCloseButtonStyle}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:InfoBar}">
                    <Grid
                        x:Name="InfoBarRoot"
                        SnapsToDevicePixels="True"
                        Visibility="Collapsed">
                        <Border
                            x:Name="ContentBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    x:Name="IconHost"
                                    Margin="{TemplateBinding controls:IconAssist.IconMargin}"
                                    VerticalAlignment="Top"
                                    TextElement.FontSize="{TemplateBinding FontSize, Converter={StaticResource IconSizeConverter}}">
                                    <controls:FluentIcon
                                        x:Name="FluentIcon"
                                        VerticalAlignment="Top"
                                        Filled="True"
                                        Visibility="Collapsed" />
                                    <ContentPresenter
                                        x:Name="CustomIconPresenter"
                                        VerticalAlignment="Top"
                                        Content="{TemplateBinding controls:IconAssist.Icon}"
                                        ContentTemplate="{TemplateBinding IconTemplate}" />
                                </Grid>

                                <WrapPanel Grid.Column="1">
                                    <ContentPresenter
                                        x:Name="TitlePresenter"
                                        Margin="0,0,12,0"
                                        Content="{TemplateBinding Title}"
                                        RecognizesAccessKey="True"
                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                        TextElement.FontWeight="SemiBold" />
                                    <ContentPresenter
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        RecognizesAccessKey="True"
                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                        <ContentPresenter.Resources>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                            </Style>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>
                                </WrapPanel>

                                <controls:Button
                                    x:Name="PART_CloseButton"
                                    Grid.Column="2"
                                    Margin="12,-3,0,-6"
                                    VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsOpen" Value="True">
                            <Setter TargetName="InfoBarRoot" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="IsClosable" Value="False">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="controls:IconAssist.Icon" Value="{x:Null}">
                            <Setter TargetName="FluentIcon" Property="Visibility" Value="Visible" />
                            <Setter TargetName="CustomIconPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="IsIconVisible" Value="False">
                            <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="TitlePresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="TitlePresenter" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="Title" Value="">
                            <Setter TargetName="TitlePresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="TitlePresenter" Property="Margin" Value="0" />
                        </Trigger>

                        <Trigger Property="Severity" Value="Informational">
                            <Setter TargetName="FluentIcon" Property="Symbol" Value="Info24" />
                            <Setter TargetName="IconHost" Property="TextElement.Foreground" Value="{m:DynamicBrush SystemFillAttentionForeground}" />
                            <Setter TargetName="ContentBorder" Property="Background" Value="{m:DynamicBrush SystemFillAttentionBackground}" />
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{m:DynamicBrush SystemFillAttentionBorder}" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Success">
                            <Setter TargetName="FluentIcon" Property="Symbol" Value="CheckmarkCircle24" />
                            <Setter TargetName="IconHost" Property="TextElement.Foreground" Value="{m:DynamicBrush SystemFillSuccessForeground}" />
                            <Setter TargetName="ContentBorder" Property="Background" Value="{m:DynamicBrush SystemFillSuccessBackground}" />
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{m:DynamicBrush SystemFillSuccessBorder}" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Warning">
                            <Setter TargetName="FluentIcon" Property="Symbol" Value="ErrorCircle24" />
                            <Setter TargetName="IconHost" Property="TextElement.Foreground" Value="{m:DynamicBrush SystemFillCautionForeground}" />
                            <Setter TargetName="ContentBorder" Property="Background" Value="{m:DynamicBrush SystemFillCautionBackground}" />
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{m:DynamicBrush SystemFillCautionBorder}" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Error">
                            <Setter TargetName="FluentIcon" Property="Symbol" Value="DismissCircle24" />
                            <Setter TargetName="IconHost" Property="TextElement.Foreground" Value="{m:DynamicBrush SystemFillCriticalForeground}" />
                            <Setter TargetName="ContentBorder" Property="Background" Value="{m:DynamicBrush SystemFillCriticalBackground}" />
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{m:DynamicBrush SystemFillCriticalBorder}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
