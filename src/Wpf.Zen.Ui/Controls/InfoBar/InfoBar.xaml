<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup">

    <Thickness x:Key="InfoBarPadding">14,8,14,8</Thickness>
    <Thickness x:Key="InfoBarBorderThemeThickness">1</Thickness>

    <!--
        Kept as a separate public customization seam through CloseButtonStyle. Applications can
        replace this style without copying the InfoBar template, while the template part remains
        responsible only for forwarding clicks to the control.
    -->
    <Style x:Key="DefaultInfoBarCloseButtonStyle" TargetType="{x:Type controls:Button}">
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="IsEnabled" Value="True" />
        <Setter Property="Icon" Value="{m:FluentIconSource Dismiss24}" />
    </Style>

    <Style TargetType="{x:Type controls:InfoBar}">
        <Setter Property="Background" Value="{m:DynamicBrush ControlFillPrimary}" />
        <Setter Property="Foreground" Value="{m:DynamicBrush TextFillPrimary}" />
        <Setter Property="Padding" Value="{StaticResource InfoBarPadding}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{m:DynamicBrush CardStrokeDefault}" />
        <Setter Property="BorderThickness" Value="{StaticResource InfoBarBorderThemeThickness}" />
        <Setter Property="FontSize" Value="{m:DynamicValue ControlContentThemeFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="CornerRadius" Value="{m:DynamicValue ControlCornerRadius}" />
        <Setter Property="CloseButtonStyle" Value="{StaticResource DefaultInfoBarCloseButtonStyle}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:InfoBar}">
                    <Grid x:Name="InfoBarRoot">
                        <Border
                            x:Name="ContentBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    x:Name="IconHost"
                                    Margin="0,2,14,0"
                                    VerticalAlignment="Top">
                                    <controls:FluentIcon
                                        x:Name="FluentIcon"
                                        VerticalAlignment="Top"
                                        Filled="True"
                                        IconSize="16"
                                        Visibility="Collapsed" />
                                    <ContentPresenter
                                        x:Name="CustomIconPresenter"
                                        VerticalAlignment="Top"
                                        Content="{TemplateBinding Icon}"
                                        ContentTemplate="{TemplateBinding IconTemplate}" />
                                </Grid>

                                <WrapPanel Grid.Column="1">

                                    <ContentPresenter
                                        x:Name="TitlePresenter"
                                        Margin="0,0,14,0"
                                        Content="{TemplateBinding Title}"
                                        RecognizesAccessKey="True"
                                        TextElement.FontSize="{TemplateBinding FontSize}"
                                        TextElement.FontWeight="SemiBold" />

                                    <ContentPresenter
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        ContentSource="Content"
                                        RecognizesAccessKey="True"
                                        TextElement.FontSize="{TemplateBinding FontSize}">
                                        <ContentPresenter.Resources>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                            </Style>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>

                                </WrapPanel>

                                <Border
                                    x:Name="CloseButtonHost"
                                    Grid.Column="2"
                                    Margin="12,-2,0,0"
                                    VerticalAlignment="Top">
                                    <controls:Button
                                        x:Name="PART_CloseButton"
                                        Style="{TemplateBinding CloseButtonStyle}"
                                        ToolTip="{TemplateBinding CloseButtonToolTip}" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsOpen" Value="True">
                            <Setter TargetName="InfoBarRoot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsOpen" Value="False">
                            <Setter TargetName="InfoBarRoot" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                
                        <Trigger Property="IsClosable" Value="False">
                            <Setter TargetName="CloseButtonHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="FluentIcon" Property="Visibility" Value="Visible" />
                            <Setter TargetName="CustomIconPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="IsIconVisible" Value="False">
                            <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="TitlePresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="TitlePresenter" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="Title" Value="">
                            <Setter TargetName="TitlePresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="TitlePresenter" Property="Margin" Value="0" />
                        </Trigger>

                        <Trigger Property="Severity" Value="Informational">
                            <Setter TargetName="IconHost" Property="TextElement.Foreground" Value="{m:DynamicBrush AccentFillPrimary}" />
                            <Setter TargetName="FluentIcon" Property="Symbol" Value="Info24" />
                            <Setter TargetName="ContentBorder" Property="Background" Value="{m:DynamicBrush SystemFillAttentionBackground}" />
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{m:DynamicBrush CardStrokeDefault}" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Success">
                            <Setter TargetName="IconHost" Property="TextElement.Foreground" Value="{m:DynamicBrush SystemFillSuccess}" />
                            <Setter TargetName="FluentIcon" Property="Symbol" Value="CheckmarkCircle24" />
                            <Setter TargetName="ContentBorder" Property="Background" Value="{m:DynamicBrush SystemFillSuccessBackground}" />
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{m:DynamicBrush CardStrokeDefault}" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Warning">
                            <Setter TargetName="IconHost" Property="TextElement.Foreground" Value="{m:DynamicBrush SystemFillCaution}" />
                            <Setter TargetName="FluentIcon" Property="Symbol" Value="ErrorCircle24" />
                            <Setter TargetName="ContentBorder" Property="Background" Value="{m:DynamicBrush SystemFillCautionBackground}" />
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{m:DynamicBrush CardStrokeDefault}" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Error">
                            <Setter TargetName="IconHost" Property="TextElement.Foreground" Value="{m:DynamicBrush SystemFillCritical}" />
                            <Setter TargetName="FluentIcon" Property="Symbol" Value="DismissCircle24" />
                            <Setter TargetName="ContentBorder" Property="Background" Value="{m:DynamicBrush SystemFillCriticalBackground}" />
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{m:DynamicBrush CardStrokeDefault}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
