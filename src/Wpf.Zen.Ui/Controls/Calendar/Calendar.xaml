<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="InteractionBrushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="DefaultCalendarDayButtonStyle" BasedOn="{StaticResource CalendarInteractionButtonStyle}" TargetType="{x:Type CalendarDayButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <!--  设置圆角半径，让焦点视觉样式显示为圆形  -->
        <Setter Property="Border.CornerRadius" Value="20" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="controls:Interaction.Palette" Value="{StaticResource CalendarSubtleInteractionBrushes}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarDayButton}">
                    <Grid SnapsToDevicePixels="True">
                        <Ellipse
                            x:Name="OuterCircle"
                            Fill="{m:InteractionBrush}"
                            Stroke="{m:InteractionBrush Palette={StaticResource CalendarAccentInteractionBrushes}}"
                            StrokeThickness="0" />
                        <Ellipse
                            x:Name="InnerCircle"
                            Margin="2"
                            Fill="{m:InteractionBrush}"
                            Visibility="Collapsed" />
                        <ContentPresenter
                            x:Name="DayText"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        <Path
                            x:Name="Blackout"
                            Margin="10"
                            Data="M 0,0 L 1,1 M 0,1 L 1,0"
                            IsHitTestVisible="False"
                            Opacity="0"
                            Stretch="Fill"
                            Stroke="{m:DynamicBrush TextFillPrimary}"
                            StrokeThickness="2" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="OuterCircle" Property="StrokeThickness" Value="1" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        </Trigger>

                        <!--  组合状态：今天、开启今天高亮、选中，外圈+内实心圆  -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsToday, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsTodayHighlighted, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="True" />
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="OuterCircle" Property="Fill" Value="Transparent" />
                            <Setter TargetName="InnerCircle" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>

                        <Trigger Property="IsBlackedOut" Value="True">
                            <Setter TargetName="Blackout" Property="Opacity" Value="0.35" />
                            <Setter TargetName="DayText" Property="Opacity" Value="0.35" />
                        </Trigger>

                        <!--  禁用时：减弱  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="OuterCircle" Property="Opacity" Value="0.35" />
                            <Setter TargetName="InnerCircle" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsInactive" Value="True">
                <Setter Property="Foreground" Value="{m:DynamicBrush TextFillDisabled}" />
            </Trigger>
            <!--
                Calendar 在拖动时使用 IsHighlighted 表示临时范围。
                它共享悬停反馈，但不得覆盖按下或禁用反馈。
            -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsHighlighted" Value="True" />
                    <Condition Property="IsPressed" Value="False" />
                    <Condition Property="controls:CalendarInteraction.IsPointerPressed" Value="False" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="controls:Interaction.State" Value="PointerOver" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="controls:CalendarInteraction.IsPointerPressed" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="controls:Interaction.State" Value="Pressed" />
            </MultiTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsToday, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding IsTodayHighlighted, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="controls:Interaction.Palette" Value="{StaticResource CalendarAccentInteractionBrushes}" />
                <Setter Property="Foreground" Value="{m:DynamicBrush TextOnAccentPrimary}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        月份、年份按钮用强调色填充高亮包含 DisplayDate 的项，交互反馈与日期按钮共用调色板。
        HasSelectedDays 由 WPF 根据 DisplayDate 设置，表示当前浏览位置。
    -->
    <Style x:Key="DefaultCalendarButtonStyle" BasedOn="{StaticResource CalendarInteractionButtonStyle}" TargetType="{x:Type CalendarButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <!--  设置圆角半径，让焦点视觉样式显示为圆形  -->
        <Setter Property="Border.CornerRadius" Value="30" />
        <Setter Property="Width" Value="60" />
        <Setter Property="Height" Value="60" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="controls:Interaction.Palette" Value="{StaticResource CalendarSubtleInteractionBrushes}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarButton}">
                    <Grid SnapsToDevicePixels="True">
                        <Ellipse x:Name="ButtonBackground" Fill="{m:InteractionBrush}" />
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBackground" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!--  相邻年代的年份仍可导航，使用弱化文字区分其所属范围。  -->
            <Trigger Property="IsInactive" Value="True">
                <Setter Property="Foreground" Value="{m:DynamicBrush TextFillDisabled}" />
            </Trigger>
            <Trigger Property="HasSelectedDays" Value="True">
                <Setter Property="controls:Interaction.Palette" Value="{StaticResource CalendarAccentInteractionBrushes}" />
                <Setter Property="Foreground" Value="{m:DynamicBrush TextOnAccentPrimary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{m:DynamicBrush TextFillDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DefaultCalendarItemStyle" TargetType="{x:Type CalendarItem}">
        <Setter Property="OverridesDefaultStyle" Value="True"></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarItem}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{Binding (Border.CornerRadius), RelativeSource={RelativeSource AncestorType={x:Type Calendar}}}"
                        SnapsToDevicePixels="True">
                        <Grid x:Name="PART_Root">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0">
                                <DockPanel.Resources>
                                    <Style TargetType="{x:Type controls:Button}">
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="MinWidth" Value="32" />
                                        <Setter Property="Margin" Value="8" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Appearance" Value="Transparent" />
                                        <Setter Property="controls:IconPresenter.IconSize" Value="16" />
                                    </Style>
                                </DockPanel.Resources>
                                <controls:Button
                                    x:Name="PART_PreviousButton"
                                    AutomationProperties.Name="Previous"
                                    Content="{m:FluentIconSource CaretUp16, Filled=True}"
                                    DockPanel.Dock="Right" />
                                <controls:Button
                                    x:Name="PART_NextButton"
                                    AutomationProperties.Name="Next"
                                    Content="{m:FluentIconSource CaretDown16, Filled=True}"
                                    DockPanel.Dock="Right" />
                                <controls:Button
                                    x:Name="PART_HeaderButton"
                                    Padding="8,0"
                                    HorizontalContentAlignment="Left"
                                    FontWeight="SemiBold" />
                            </DockPanel>
                            <Border
                                Grid.Row="1"
                                Height="1"
                                BorderBrush="{m:DynamicBrush ControlStrokeDefault}"
                                BorderThickness="0,0,0,0.5" />
                            <Grid
                                x:Name="PART_MonthView"
                                Grid.Row="2"
                                Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                            </Grid>

                            <Grid
                                x:Name="PART_YearView"
                                Grid.Row="2"
                                Margin="{TemplateBinding Padding}"
                                Visibility="Hidden">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType={x:Type Calendar}}}" Value="Year">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType={x:Type Calendar}}}" Value="Decade">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                    <ControlTemplate.Resources>
                        <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                            <TextBlock
                                Width="40"
                                Margin="1"
                                Padding="0,10"
                                FontWeight="Bold"
                                Text="{Binding}"
                                TextAlignment="Center" />
                        </DataTemplate>
                    </ControlTemplate.Resources>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Calendar}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="controls:CalendarInteraction.IsEnabled" Value="True" />
        <Setter Property="CalendarButtonStyle" Value="{StaticResource DefaultCalendarButtonStyle}" />
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource DefaultCalendarDayButtonStyle}" />
        <Setter Property="CalendarItemStyle" Value="{StaticResource DefaultCalendarItemStyle}" />
        <Setter Property="Foreground" Value="{m:DynamicBrush TextFillPrimary}" />
        <Setter Property="FontSize" Value="{m:DynamicValue DefaultThemeFontSize}" />
        <Setter Property="Background" Value="{m:DynamicBrush AcrylicBackgroundFillDefault}" />
        <Setter Property="BorderBrush" Value="{m:DynamicBrush ControlStrokeDefault}" />
        <Setter Property="Border.CornerRadius" Value="{m:DynamicValue ControlCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4,0,4,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Calendar}">
                    <CalendarItem
                        x:Name="PART_CalendarItem"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Style="{TemplateBinding CalendarItemStyle}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{m:DynamicBrush TextFillDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
