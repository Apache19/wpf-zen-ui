<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:converters="clr-namespace:Wpf.Zen.Ui.Converters"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Wpf.Zen.Ui;component/Resources/InteractionBrushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  Geometry expresses today/selection; the shared palette expresses input feedback.  -->
    <Style x:Key="DefaultCalendarDayButtonStyle" BasedOn="{StaticResource InteractionButtonStyle}" TargetType="{x:Type CalendarDayButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Border.CornerRadius" Value="20" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="FontSize" Value="{m:DynamicValue DefaultThemeFontSize}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{m:DynamicBrush TextFillPrimary}" />
        <Setter Property="controls:Interaction.Palette" Value="{StaticResource SubtleInteractionBrushes}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Grid  SnapsToDevicePixels="True">
                        <Ellipse
                            x:Name="OuterCircle"
                            Fill="{m:InteractionBrush}"
                            Stroke="{m:InteractionBrush Palette={StaticResource AccentInteractionBrushes}}"
                            StrokeThickness="0" />
                        <Ellipse
                            x:Name="InnerCircle"
                            Margin="3"
                            Fill="{m:InteractionBrush}"
                            Visibility="Collapsed" />
                        <ContentPresenter
                            x:Name="DayText"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        <Path
                            x:Name="Blackout"
                            Margin="6"
                            Data="M 0,0 L 1,1 M 0,1 L 1,0"
                            IsHitTestVisible="False"
                            Opacity="0"
                            Stretch="Fill"
                            Stroke="{m:DynamicBrush TextFillPrimary}"
                            StrokeThickness="2" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="OuterCircle" Property="StrokeThickness" Value="1" />
                        </Trigger>
                        <!--  A real geometry combination: keep a clear gap between ring and inner disk.  -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsToday, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsTodayHighlighted, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="True" />
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="OuterCircle" Property="Fill" Value="Transparent" />
                            <Setter TargetName="InnerCircle" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                        <Trigger Property="IsBlackedOut" Value="True">
                            <Setter TargetName="Blackout" Property="Opacity" Value="0.35" />
                            <Setter TargetName="DayText" Property="Opacity" Value="0.35" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="OuterCircle" Property="Opacity" Value="0.35" />
                            <Setter TargetName="InnerCircle" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsInactive" Value="True">
                <Setter Property="Foreground" Value="{m:DynamicBrush TextFillDisabled}" />
            </Trigger>
            <!--
                Calendar uses IsHighlighted for the provisional range while dragging.
                It shares hover feedback but must not override press or disabled feedback.
            -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsHighlighted" Value="True" />
                    <Condition Property="IsPressed" Value="False" />
                    <Condition Property="controls:CalendarInteraction.IsPointerPressed" Value="False" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="controls:Interaction.State" Value="PointerOver" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="controls:CalendarInteraction.IsPointerPressed" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="controls:Interaction.State" Value="Pressed" />
            </MultiTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsToday, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding IsTodayHighlighted, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="controls:Interaction.Palette" Value="{StaticResource AccentInteractionBrushes}" />
                <Setter Property="Foreground" Value="{m:DynamicBrush TextOnAccentPrimary}" />
            </MultiDataTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{m:DynamicBrush TextFillDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!--
        月份、年份按钮用强调色填充高亮包含 DisplayDate 的项，交互反馈与日期按钮共用调色板。
        HasSelectedDays 由 WPF 根据 DisplayDate 设置，表示当前浏览位置。
    -->
    <Style x:Key="DefaultCalendarButtonStyle" BasedOn="{StaticResource InteractionButtonStyle}" TargetType="{x:Type CalendarButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="55" />
        <Setter Property="Height" Value="55" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="FontSize" Value="{m:DynamicValue DefaultThemeFontSize}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{m:DynamicBrush TextFillPrimary}" />
        <Setter Property="controls:Interaction.Palette" Value="{StaticResource SubtleInteractionBrushes}" />
        <Setter Property="Border.CornerRadius" Value="27.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarButton">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Ellipse x:Name="ButtonBackground" Fill="{m:InteractionBrush}" />
                        <ContentPresenter
                            Margin="1,0,1,1"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBackground" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!--  相邻年代的年份仍可导航，使用弱化文字区分其所属范围。  -->
            <Trigger Property="IsInactive" Value="True">
                <Setter Property="Foreground" Value="{m:DynamicBrush TextFillDisabled}" />
            </Trigger>
            <Trigger Property="HasSelectedDays" Value="True">
                <Setter Property="controls:Interaction.Palette" Value="{StaticResource AccentInteractionBrushes}" />
                <Setter Property="Foreground" Value="{m:DynamicBrush TextOnAccentPrimary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{m:DynamicBrush TextFillDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DefaultCalendarItemStyle" TargetType="{x:Type CalendarItem}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarItem}">
                    <Grid x:Name="PART_Root">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  HINT: Header with title and navigation buttons  -->
                            <Grid Grid.Row="0" KeyboardNavigation.TabIndex="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <controls:Button
                                    x:Name="PART_HeaderButton"
                                    Grid.Column="0"
                                    MinHeight="0"
                                    Margin="7,6,3,7"
                                    Padding="8,7,8,8"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Focusable="True"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{m:DynamicBrush TextFillPrimary}"
                                    MouseOverBackground="{m:DynamicBrush SubtleFillSecondary}"
                                    PressedBackground="{m:DynamicBrush SubtleFillTertiary}" />

                                <controls:Button
                                    x:Name="PART_PreviousButton"
                                    Grid.Column="1"
                                    Width="32"
                                    MinHeight="0"
                                    Margin="7,6,7,7"
                                    Padding="0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    AutomationProperties.Name="Previous"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Focusable="True"
                                    Foreground="{m:DynamicBrush TextFillPrimary}"
                                    MouseOverBackground="{m:DynamicBrush SubtleFillSecondary}"
                                    PressedBackground="{m:DynamicBrush SubtleFillTertiary}">
                                    <controls:Button.Content>
                                        <controls:FontIcon FontSize="16" Source="{m:FluentIconSource CaretUp16, Filled=True}">
                                            <controls:FontIcon.Style>
                                                <Style TargetType="controls:FontIcon">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type controls:Button}}}" Value="True">
                                                            <Setter Property="Foreground" Value="{m:DynamicBrush TextFillSecondary}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:FontIcon.Style>
                                        </controls:FontIcon>
                                    </controls:Button.Content>
                                </controls:Button>

                                <controls:Button
                                    x:Name="PART_NextButton"
                                    Grid.Column="2"
                                    Width="32"
                                    MinHeight="0"
                                    Margin="7,6,7,7"
                                    Padding="0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    AutomationProperties.Name="Next"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Focusable="True"
                                    Foreground="{m:DynamicBrush TextFillPrimary}"
                                    MouseOverBackground="{m:DynamicBrush SubtleFillSecondary}"
                                    PressedBackground="{m:DynamicBrush SubtleFillTertiary}">
                                    <controls:Button.Content>
                                        <controls:FontIcon FontSize="16" Source="{m:FluentIconSource CaretDown16, Filled=True}">
                                            <controls:FontIcon.Style>
                                                <Style TargetType="controls:FontIcon">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type controls:Button}}}" Value="True">
                                                            <Setter Property="Foreground" Value="{m:DynamicBrush TextFillSecondary}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:FontIcon.Style>
                                        </controls:FontIcon>
                                    </controls:Button.Content>
                                </controls:Button>
                            </Grid>

                            <Border
                                Grid.Row="1"
                                Height="0.5"
                                Background="{m:DynamicBrush ControlStrokeDefault}" />

                            <!--  HINT: Day picker  -->
                            <Grid
                                x:Name="PART_MonthView"
                                Grid.Row="2"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                KeyboardNavigation.TabIndex="1"
                                KeyboardNavigation.TabNavigation="Once"
                                Visibility="Visible">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                            </Grid>

                            <!--  todo: 调查，从年份、月份视图回到日期视图是否有其它途径，如果有，应实现UI  -->
                            <Grid
                                x:Name="PART_YearView"
                                Grid.Row="2"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                KeyboardNavigation.TabIndex="1"
                                KeyboardNavigation.TabNavigation="Once"
                                Visibility="Hidden">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                            </Grid>

                            <!--  todo: 似乎没什么意义  -->
                            <Rectangle
                                x:Name="PART_DisabledVisual"
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Fill="{m:DynamicBrush ControlFillPrimary}"
                                KeyboardNavigation.TabIndex="1"
                                KeyboardNavigation.TabNavigation="Once"
                                Opacity="0"
                                RadiusX="2"
                                RadiusY="2"
                                Stretch="Fill"
                                Stroke="Transparent"
                                StrokeThickness="0"
                                Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_DisabledVisual" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}}" Value="Year">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}}" Value="Decade">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                    <ControlTemplate.Resources>
                        <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                            <TextBlock
                                Margin="1"
                                Padding="12"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="{m:DynamicBrush TextFillPrimary}"
                                Text="{Binding}" />
                        </DataTemplate>
                    </ControlTemplate.Resources>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  https://developer.microsoft.com/en-us/fluentui#/controls/web/datepicker  -->

    <Style TargetType="{x:Type Calendar}">
        <Setter Property="controls:CalendarInteraction.IsEnabled" Value="True" />
        <!--  todo: 各部件都有默认样式键，应改为默认样式，不应主动为其设置属性，否则会破坏样式查找机制  -->
        <Setter Property="CalendarButtonStyle" Value="{StaticResource DefaultCalendarButtonStyle}" />
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource DefaultCalendarDayButtonStyle}" />
        <Setter Property="CalendarItemStyle" Value="{StaticResource DefaultCalendarItemStyle}" />
        <Setter Property="Foreground" Value="{m:DynamicBrush TextFillPrimary}" />
        <Setter Property="Background" Value="{m:DynamicBrush AcrylicBackgroundFillDefault}" />
        <Setter Property="BorderBrush" Value="{m:DynamicBrush ControlStrokeDefault}" />
        <Setter Property="Border.CornerRadius" Value="{m:DynamicValue ControlCornerRadius}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Calendar}">
                    <!--  todo: 考虑把外观交给 CalendarItem，并给 Calendar 实现默认样式  -->
                    <Border
                        x:Name="PART_Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding Border.CornerRadius}">
                        <CalendarItem
                            x:Name="PART_CalendarItem"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Style="{TemplateBinding CalendarItemStyle}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>