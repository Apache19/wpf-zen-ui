<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup">

    <!-- Shared colors remain overridable through the control's brush properties. -->
    <Style TargetType="{x:Type controls:InfoBadge}">
        <Setter Property="Background" Value="{m:DynamicBrush SystemFillInformationalForeground}" />
        <Setter Property="Foreground" Value="{m:DynamicBrush TextFillInverse}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:InfoBadge}">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter
                                x:Name="IconPresenter"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                ContentSource="Icon"
                                RecognizesAccessKey="False" />
                            <Border x:Name="IconSpacing" Grid.Column="1" Width="4" />
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Grid.Column="2"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                ContentSource="Content"
                                RecognizesAccessKey="False"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IconPlacement" Value="Right">
                            <Setter TargetName="IconPresenter" Property="Grid.Column" Value="2" />
                            <Setter TargetName="ContentPresenter" Property="Grid.Column" Value="0" />
                        </Trigger>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IconSpacing" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Icon" Value="">
                            <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IconSpacing" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <!-- A template can provide visible content even when Content is null. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Content" Value="{x:Null}" />
                                <Condition Property="ContentTemplate" Value="{x:Null}" />
                                <Condition Property="ContentTemplateSelector" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="IconSpacing" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Content" Value="" />
                                <Condition Property="ContentTemplate" Value="{x:Null}" />
                                <Condition Property="ContentTemplateSelector" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="IconSpacing" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Severity" Value="Attention">
                <Setter Property="Background" Value="{m:DynamicBrush SystemFillAttentionForeground}" />
            </Trigger>
            <Trigger Property="Severity" Value="Success">
                <Setter Property="Background" Value="{m:DynamicBrush SystemFillSuccessForeground}" />
            </Trigger>
            <Trigger Property="Severity" Value="Caution">
                <Setter Property="Background" Value="{m:DynamicBrush SystemFillCautionForeground}" />
            </Trigger>
            <Trigger Property="Severity" Value="Critical">
                <Setter Property="Background" Value="{m:DynamicBrush SystemFillCriticalForeground}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
