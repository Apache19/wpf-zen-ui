<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:converters="clr-namespace:Wpf.Zen.Ui.Converters"
    xmlns:t="clr-namespace:Wpf.Zen.Ui.Theming">

    <ResourceDictionary.MergedDictionaries>
        <!--
            This dictionary is also useful in isolation (for design tools and focused tests), so
            it imports the base Button resources instead of depending on sibling merge order in
            Generic.xaml.
        -->
        <ResourceDictionary Source="pack://application:,,,/Wpf.Zen.Ui;component/Controls/Button/Button.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        The chevron is control chrome rather than user content. Keeping it in this dedicated
        template prevents the general Button API and template from acquiring a second, ambiguous
        icon slot solely to implement DropDownButton.
    -->
    <ControlTemplate x:Key="UiDropDownButtonControlTemplate" TargetType="{x:Type controls:DropDownButton}">
        <controls:UiBorder
            x:Name="border"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding VisualBackground}"
            BorderBrush="{TemplateBinding VisualBorderBrush}"
            BorderPlacement="{TemplateBinding controls:UiBorder.BorderPlacement}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}"
            SnapsToDevicePixels="True">
            <Grid HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ContentPresenter
                    x:Name="iconPresenter"
                    Grid.Column="0"
                    Margin="{TemplateBinding IconMargin}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    Content="{TemplateBinding Icon}"
                    Focusable="False"
                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                    TextElement.FontSize="{TemplateBinding FontSize, Converter={converters:DoubleToDoubleConverter Add=1}}"
                    TextElement.Foreground="{TemplateBinding VisualForeground}" />

                <ContentPresenter
                    Grid.Column="1"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    Focusable="False"
                    RecognizesAccessKey="True"
                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                    TextElement.Foreground="{TemplateBinding VisualForeground}" />

                <controls:FluentIcon
                    x:Name="DropDownChevron"
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{TemplateBinding VisualForeground}"
                    IsHitTestVisible="False"
                    Symbol="ChevronDown24" />
            </Grid>
        </controls:UiBorder>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="iconPresenter" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsDropDownArrowVisible" Value="False">
                <Setter TargetName="DropDownChevron" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="Icon" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <Setter TargetName="DropDownChevron" Property="Margin" Value="0" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="" />
                    <Condition Property="Icon" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <Setter TargetName="DropDownChevron" Property="Margin" Value="0" />
            </MultiTrigger>
            <Trigger Property="Appearance" Value="Normal">
                <Setter TargetName="border" Property="BorderPlacement" Value="Outside" />
            </Trigger>
            <Trigger Property="Appearance" Value="Transparent">
                <Setter TargetName="border" Property="BorderPlacement" Value="Outside" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="UiDropDownButtonStyle" BasedOn="{StaticResource {x:Static t:StyleKeys.UiButtonStyle}}" TargetType="{x:Type controls:DropDownButton}">
        <Setter Property="Template" Value="{StaticResource UiDropDownButtonControlTemplate}" />
    </Style>

    <Style BasedOn="{StaticResource UiDropDownButtonStyle}" TargetType="{x:Type controls:DropDownButton}" />

</ResourceDictionary>
