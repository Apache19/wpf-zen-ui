<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:converters="clr-namespace:Wpf.Zen.Ui.Converters"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup">

    <!--
        The TextViewer has a default padding of 2,0,2,0. To keep the watermark aligned
        with the text, this converter offsets the margin accordingly.
    -->
    <converters:ThicknessTransformConverter x:Key="DatePickerTextBoxWatermarkMarginConverter" Offset="2,0,2,0" />

    <ControlTemplate x:Key="DatePickerTextBoxTemplate" TargetType="{x:Type DatePickerTextBox}">
        <Grid>
            <ContentControl
                x:Name="PART_Watermark"
                Margin="{TemplateBinding Padding, Converter={StaticResource DatePickerTextBoxWatermarkMarginConverter}}"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                Focusable="False"
                Foreground="{m:DynamicBrush TextPlaceholder}"
                IsHitTestVisible="False"
                Opacity="0" />
            <controls:UiScrollViewer
                x:Name="PART_ContentHost"
                Grid.Column="0"
                controls:ScrollViewerAssist.OverlayMode="Traditional"
                Focusable="false"
                HorizontalScrollBarVisibility="Hidden"
                ScrollSpillMode="Disabled"
                VerticalScrollBarVisibility="Hidden" />
            <!--
                DatePickerTextBox extends TextBox and is responsible for the pointer, focus, and
                watermark states used by the native DatePicker implementation. CommonStates and
                FocusStates are intentionally declared even though the shared DatePicker chrome is
                rendered in the parent template: this preserves WPF's template-state contract, while
                the parent bridges the corresponding child properties across the template namescope.
            -->
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="MouseOver" />
                    <VisualState x:Name="Disabled">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Watermark" Storyboard.TargetProperty="Foreground">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{m:DynamicBrush TextFillDisabled}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Unfocused" />
                    <VisualState x:Name="Focused" />
                </VisualStateGroup>
                <VisualStateGroup x:Name="WatermarkStates">
                    <VisualState x:Name="Unwatermarked" />
                    <VisualState x:Name="Watermarked">
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="PART_ContentHost"
                                Storyboard.TargetProperty="Opacity"
                                To="0"
                                Duration="0" />
                            <DoubleAnimation
                                Storyboard.TargetName="PART_Watermark"
                                Storyboard.TargetProperty="Opacity"
                                To="1"
                                Duration="0" />
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="DefaultDatePickerTemplate" TargetType="{x:Type DatePicker}">
        <Grid>
            <Border
                x:Name="RootBorder"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding Border.CornerRadius}"
                SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--
                        Chromeless DatePickerTextBox — fills the text area without
                        rendering a background or border; inherits foreground.
                    -->
                    <DatePickerTextBox
                        x:Name="PART_TextBox"
                        MinHeight="0"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        CaretBrush="{Binding Foreground, RelativeSource={RelativeSource Self}}"
                        Focusable="{TemplateBinding Focusable}"
                        OverridesDefaultStyle="True"
                        Template="{StaticResource DatePickerTextBoxTemplate}" />

                    <!--
                        The container tracks VerticalContentAlignment while its content is top-aligned.
                        When VerticalContentAlignment is Stretch, the button aligns to the top just as
                        the TextViewer text does, keeping the layout simple and predictable.
                    -->
                    <Border
                        Grid.Column="1"
                        Margin="4,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                        <controls:Button
                            x:Name="PART_Button"
                            MinWidth="24"
                            MinHeight="24"
                            Padding="0"
                            VerticalAlignment="Top"
                            Appearance="Transparent"
                            BorderThickness="0"
                            Focusable="False"
                            IsTabStop="False">
                            <controls:FontIcon FontSize="16" Source="{m:FluentIconSource CalendarRtl24}" />
                        </controls:Button>
                    </Border>

                    <Popup
                        x:Name="PART_Popup"
                        Grid.Column="0"
                        controls:PopupShadow.IsEnabled="True"
                        controls:PopupSlideAnimator.IsEnabled="True"
                        AllowsTransparency="True"
                        Placement="Bottom"
                        PlacementTarget="{Binding ElementName=RootBorder}"
                        PopupAnimation="Slide"
                        StaysOpen="False" />
                </Grid>
            </Border>

            <Border
                x:Name="FocusIndicator"
                BorderBrush="{m:DynamicBrush AccentStroke}"
                BorderThickness="0,0,0,2"
                CornerRadius="{TemplateBinding Border.CornerRadius}"
                IsHitTestVisible="False"
                Visibility="Collapsed" />
            <!--
                DatePicker.ChangeVisualState only enters Normal or Disabled; hover and focus are
                owned by PART_TextBox in WPF's implementation. Keep the framework-driven disabled
                state in VSM so programmatic IsEnabled changes follow the same lifecycle as the
                platform template instead of relying on input events.
            -->
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{m:DynamicBrush ControlFillDisabled}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="BorderBrush">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{m:DynamicBrush ControlStrokeDefault}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="(TextElement.Foreground)">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{m:DynamicBrush TextFillDisabled}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusIndicator" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
        <ControlTemplate.Triggers>
            <!--
                PART_TextBox owns MouseOver and Focused in the native state machine. A trigger is
                required here because a storyboard in the child template cannot target RootBorder
                across WPF template namescopes. Restricting the source to PART_TextBox also leaves
                the calendar button's own hover/pressed visuals independent, matching native input
                routing while keeping one TextBox-like surface.
            -->
            <Trigger SourceName="PART_TextBox" Property="IsMouseOver" Value="True">
                <Setter TargetName="RootBorder" Property="Background" Value="{m:DynamicBrush ControlFillPrimary}" />
            </Trigger>
            <Trigger SourceName="PART_TextBox" Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="RootBorder" Property="Background" Value="{m:DynamicBrush ControlFillInputActive}" />
                <Setter TargetName="FocusIndicator" Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type DatePicker}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="MinHeight" Value="{m:DynamicValue DefaultControlMinHeight}" />
        <Setter Property="IsTodayHighlighted" Value="True" />
        <Setter Property="SelectedDateFormat" Value="Short" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="{m:DynamicBrush ControlFillSecondary}" />
        <Setter Property="Padding" Value="{m:DynamicValue TextControlThemePadding}" />
        <Setter Property="BorderBrush" Value="{m:DynamicBrush ControlStrokeSecondary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="{m:DynamicValue ControlCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Validation.ErrorTemplate" Value="{m:DynamicTemplate DefaultValidation}" />
        <Setter Property="Template" Value="{StaticResource DefaultDatePickerTemplate}" />
        <Setter Property="CalendarStyle" Value="{DynamicResource {x:Type Calendar}}" />
    </Style>

</ResourceDictionary>
