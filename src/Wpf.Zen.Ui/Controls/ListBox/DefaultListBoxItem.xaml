<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup">

    <Style x:Key="ListBoxItemFocusVisualStyle" TargetType="{x:Type controls:FocusVisualPresenter}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:FocusVisualPresenter}">
                    <Rectangle
                        SnapsToDevicePixels="True"
                        Stroke="{m:DynamicBrush KeyboardFocusBorder}"
                        StrokeThickness="1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="DefaultListBoxItemTemplate" TargetType="{x:Type ListBoxItem}">
        <controls:UiBorder
            x:Name="ContentBorder"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding Border.CornerRadius}"
            SnapsToDevicePixels="true"
            IsPaddingCompressible="True">
            <ContentPresenter
                x:Name="ContentPresenter"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
        </controls:UiBorder>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ContentBorder" Property="Background" Value="{m:DynamicBrush ControlFillTertiary}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ContentBorder" Property="Background" Value="{m:DynamicBrush AccentSelection}" />
                <Setter Property="Foreground" Value="{m:DynamicBrush TextOnAccentPrimary}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Selector.IsSelectionActive" Value="False" />
                    <Condition Property="IsSelected" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="ContentBorder" Property="Background" Value="{m:DynamicBrush ControlStrongFillDisabled}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{m:DynamicBrush TextFillDisabled}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="False" />
                    <Condition Property="IsSelected" Value="True" />
                </MultiTrigger.Conditions>
                <!--
                    Theme styles can be shared by WPF's process-wide SystemResources table across several STA
                    dispatchers. A SolidColorBrush whose Color contains a DynamicResource cannot freeze, so embedding
                    one in this template binds the sealed template to the dispatcher that first loads it. Keep the
                    dynamic brush as a per-control resource expression and apply disabled opacity to the generated
                    content instead; this preserves the visual result without an unshareable Freezable.
                -->
                <Setter Property="Foreground" Value="{m:DynamicBrush TextOnAccentPrimary}" />
                <Setter TargetName="ContentPresenter" Property="Opacity" Value="0.6" />
            </MultiTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="DefaultListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
        <Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="controls:FocusVisual.PresenterStyle" Value="{StaticResource ListBoxItemFocusVisualStyle}" />
        <Setter Property="Template" Value="{StaticResource DefaultListBoxItemTemplate}" />
    </Style>

</ResourceDictionary>
