<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup">

    <!--
        Track and thumb state are deliberately split into independent styles. A skin can replace
        either style (and its template) without copying the ToggleSwitch control template or the
        thumb-motion implementation. The ToggleSwitchPart state properties keep these triggers
        local and remove ancestor bindings from consumer-authored part styles.
    -->
    <Style x:Key="DefaultToggleSwitchTrackStyle" TargetType="{x:Type controls:ToggleSwitchPart}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Background" Value="{m:DynamicBrush ControlAltFillSecondary}" />
        <Setter Property="BorderBrush" Value="{m:DynamicBrush ControlStrongStrokeDefault}" />
        <Setter Property="CheckedBackground" Value="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type controls:ToggleSwitch}}}" />
        <Setter Property="CheckedBorderBrush" Value="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type controls:ToggleSwitch}}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ToggleSwitchPart}">
                    <!--
                        Both endpoint visuals remain alive for the complete transition. The owner
                        publishes the same eased progress that moves the thumb, so reversing the
                        switch also reverses this cross-fade without replacing a brush or clock.
                    -->
                    <Grid>
                        <controls:UiBorder
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderPlacement="Inside"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                        <controls:UiBorder
                            x:Name="CheckedVisual"
                            Background="{TemplateBinding CheckedBackground}"
                            BorderPlacement="Inside"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Opacity="{TemplateBinding TransitionProgress}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="40" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsPointerOver" Value="True" />
                    <Condition Property="IsPressed" Value="False" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{m:DynamicBrush ControlAltFillTertiary}" />
                <Setter Property="CheckedBackground" Value="{m:DynamicBrush AccentFillPrimary}" />
                <Setter Property="CheckedBorderBrush" Value="{m:DynamicBrush AccentFillPrimary}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsPressed" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{m:DynamicBrush ControlAltFillQuarternary}" />
                <Setter Property="CheckedBackground" Value="{m:DynamicBrush AccentFillTertiary}" />
                <Setter Property="CheckedBorderBrush" Value="{m:DynamicBrush AccentFillTertiary}" />
            </MultiTrigger>

            <!--  Disabled triggers remain last so input state cannot override disabled appearance.  -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{m:DynamicBrush ControlAltFillDisabled}" />
                <Setter Property="BorderBrush" Value="{m:DynamicBrush ControlStrongStrokeDisabled}" />
                <Setter Property="CheckedBackground" Value="{m:DynamicBrush ControlFillDisabled}" />
                <Setter Property="CheckedBorderBrush" Value="{m:DynamicBrush ControlFillDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DefaultToggleSwitchThumbStyle" TargetType="{x:Type controls:ToggleSwitchPart}">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="Background" Value="{m:DynamicBrush TextFillSecondary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ToggleSwitchPart}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{m:DynamicBrush TextOnAccentPrimary}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsPointerOver" Value="True" />
                    <Condition Property="IsPressed" Value="False" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Width" Value="14" />
                <Setter Property="Height" Value="14" />
                <Setter Property="Margin" Value="3" />
                <Setter Property="CornerRadius" Value="7" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Orientation" Value="Horizontal" />
                    <Condition Property="IsPressed" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Width" Value="17" />
                <Setter Property="Height" Value="14" />
                <Setter Property="Margin" Value="3" />
                <Setter Property="CornerRadius" Value="7" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Orientation" Value="Vertical" />
                    <Condition Property="IsPressed" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <!-- The pressed thumb stretches along its active travel axis. -->
                <Setter Property="Width" Value="14" />
                <Setter Property="Height" Value="17" />
                <Setter Property="Margin" Value="3" />
                <Setter Property="CornerRadius" Value="7" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{m:DynamicBrush TextFillDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DefaultUiToggleSwitchStyle" TargetType="{x:Type controls:ToggleSwitch}">
        <Setter Property="Background" Value="{m:DynamicBrush AccentFillSecondary}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TrackStyle" Value="{StaticResource DefaultToggleSwitchTrackStyle}" />
        <Setter Property="ThumbStyle" Value="{StaticResource DefaultToggleSwitchThumbStyle}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ToggleSwitch}">
                    <!--
                        PART_Thumb is laid out at the unchecked endpoint. ToggleSwitch mirrors that
                        resting inset across PART_Track and owns only the outer RenderTransform;
                        visual state styles never need animation coordinates.
                    -->
                    <Grid Margin="{TemplateBinding Padding}" Background="Transparent">
                        <controls:ToggleSwitchPart
                            x:Name="PART_Track"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Style="{TemplateBinding TrackStyle}" />
                        <controls:ToggleSwitchPart
                            x:Name="PART_Thumb"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Style="{TemplateBinding ThumbStyle}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource DefaultUiToggleSwitchStyle}" TargetType="{x:Type controls:ToggleSwitch}" />

</ResourceDictionary>
