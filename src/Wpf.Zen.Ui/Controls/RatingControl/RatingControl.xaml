<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup">

    <Style TargetType="{x:Type controls:RatingControl}">
        <Setter Property="Foreground" Value="{m:DynamicBrush TextFillSecondary}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Padding" Value="0,6,8,6" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate DataType="{x:Type controls:RatingItem}">
                    <!--
                        RatingItem exposes semantic state only. The default theme chooses Fluent
                        icons here so replacing ItemTemplate also replaces the visual vocabulary
                        without any icon-system dependency in RatingControl or its item model.
                    -->
                    <controls:FontIcon
                        x:Name="Icon"
                        RenderTransformOrigin="0.5,0.5"
                        Source="{m:FluentIconSource Star24}" />
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static controls:RatingItemState.QuarterStar}">
                            <Setter TargetName="Icon" Property="Source" Value="{m:FluentIconSource StarOneQuarter24}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static controls:RatingItemState.HalfStar}">
                            <Setter TargetName="Icon" Property="Source" Value="{m:FluentIconSource StarHalf24}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static controls:RatingItemState.ThreeQuarterStar}">
                            <Setter TargetName="Icon" Property="Source" Value="{m:FluentIconSource StarThreeQuarter24}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static controls:RatingItemState.FullStar}">
                            <Setter TargetName="Icon" Property="Variant" Value="Filled" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding DisplayMode}" Value="{x:Static controls:RatingItemDisplayMode.Rating}">
                            <Setter TargetName="Icon" Property="Foreground" Value="{m:DynamicBrush AccentFillSecondary}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DisplayMode}" Value="{x:Static controls:RatingItemDisplayMode.Preview}">
                            <Setter TargetName="Icon" Property="Foreground" Value="{m:DynamicBrush AccentFillSecondary}" />
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Icon" Property="Foreground" Value="{m:DynamicBrush TextFillDisabled}" />
                        </Trigger>

                        <!--
                            Fluent System Icons contains only left-filled partial stars. The panel
                            already reverses item layout under RTL; these state-specific transforms
                            also reverse the partial glyph itself while leaving symmetric empty and
                            full stars untouched. Custom item templates own the equivalent policy
                            for their own content.
                        -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding State}" Value="{x:Static controls:RatingItemState.QuarterStar}" />
                                <Condition Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type controls:RatingControl}}}" Value="RightToLeft" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Icon" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="-1" />
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding State}" Value="{x:Static controls:RatingItemState.HalfStar}" />
                                <Condition Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type controls:RatingControl}}}" Value="RightToLeft" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Icon" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="-1" />
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding State}" Value="{x:Static controls:RatingItemState.ThreeQuarterStar}" />
                                <Condition Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type controls:RatingControl}}}" Value="RightToLeft" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Icon" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="-1" />
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:RatingControl}">
                    <controls:UiBorder
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding Border.CornerRadius}"
                        SnapsToDevicePixels="True"
                        IsPaddingCompressible="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!--
                                A star always maps its first segment to the smallest non-zero
                                precision step. Keeping zero in a separate hit target preserves
                                that predictable mapping and gives zero an equally stable location
                                for every Precision. The template trigger below swaps the columns
                                in RTL because WPF does not reorder Grid children automatically.
                                
                                Background is intentionally transparent rather than null: an empty
                                Border otherwise contributes layout but cannot become the original
                                source of a mouse event. Custom templates may change its size or
                                appearance, but should retain a hit-testable surface. RatingControl
                                also extends this region through the padding at the low-rating edge
                                so that the outermost pixels do not become dead space.
                            -->
                            <Border
                                x:Name="PART_ZeroRatingTarget"
                                Width="8"
                                Background="Transparent" />
                            <ItemsControl
                                x:Name="PART_ItemsHost"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Focusable="False"
                                FontSize="{TemplateBinding FontSize}"
                                Foreground="{TemplateBinding Foreground}"
                                IsTabStop="False"
                                ItemTemplate="{TemplateBinding ItemTemplate}"
                                OverridesDefaultStyle="True"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                <ItemsControl.Template>
                                    <ControlTemplate>
                                        <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                    </controls:UiBorder>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="IsReadOnly" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Cursor" Value="Hand" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="Transparent" />
                            <!--  todo: 主题资源里没有适合用于边框禁用状态的颜色，暂时用透明色  -->
                            <Setter Property="BorderBrush" Value="Transparent" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
