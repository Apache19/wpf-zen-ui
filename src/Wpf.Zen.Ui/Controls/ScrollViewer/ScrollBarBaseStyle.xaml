<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:converters="clr-namespace:Wpf.Zen.Ui.Converters"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <Duration x:Key="ScrollAnimationDuration">0:0:0.16</Duration>

    <Style x:Key="ScrollBarTransparentRepeatButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border
                        x:Name="Border"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{m:DynamicBrush ControlStrongFillPrimary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="{m:DynamicBrush ControlStrongFillTertiary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{m:DynamicBrush ControlStrongFillDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VerticalScrollBarThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border
                            x:Name="ThumbBorder"
                            Width="4"
                            HorizontalAlignment="Center"
                            Background="{TemplateBinding Foreground}"
                            CornerRadius="{converters:PillCornerConverter Factor=0.55}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ScrollBar}}}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ThumbBorder"
                                            Storyboard.TargetProperty="Width"
                                            To="6"
                                            Duration="{StaticResource ScrollAnimationDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ThumbBorder"
                                            Storyboard.TargetProperty="Width"
                                            To="4"
                                            Duration="{StaticResource ScrollAnimationDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{m:DynamicBrush ControlStrongFillPrimary}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{m:DynamicBrush ControlStrongFillTertiary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{m:DynamicBrush ControlStrongFillDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HorizontalScrollBarThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border
                            x:Name="ThumbBorder"
                            Height="4"
                            VerticalAlignment="Center"
                            Background="{TemplateBinding Foreground}"
                            CornerRadius="{converters:PillCornerConverter Factor=0.55}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ScrollBar}}}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ThumbBorder"
                                            Storyboard.TargetProperty="Height"
                                            To="6"
                                            Duration="{StaticResource ScrollAnimationDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ThumbBorder"
                                            Storyboard.TargetProperty="Height"
                                            To="4"
                                            Duration="{StaticResource ScrollAnimationDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{m:DynamicBrush ControlStrongFillPrimary}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{m:DynamicBrush ControlStrongFillTertiary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{m:DynamicBrush ControlStrongFillDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
        <Grid Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="4" />
                <RowDefinition Height="0.00001*" />
                <RowDefinition Height="Auto" MinHeight="4" />
            </Grid.RowDefinitions>
            <Border
                x:Name="BackBorder"
                Grid.RowSpan="3"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{converters:PillCornerConverter Factor=0.55}"
                Opacity="0" />
            <RepeatButton
                x:Name="UpButton"
                Grid.Row="0"
                Padding="0,1,0,2"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Command="ScrollBar.LineUpCommand"
                Content="{m:FluentIconSource CaretUp24, Filled=True}"
                FontSize="11"
                Opacity="0"
                Style="{StaticResource ScrollBarTransparentRepeatButton}" />
            <Track
                x:Name="PART_Track"
                Grid.Row="1"
                IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollBarTransparentRepeatButton}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource VerticalScrollBarThumbStyle}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollBarTransparentRepeatButton}" />
                </Track.IncreaseRepeatButton>
            </Track>
            <RepeatButton
                x:Name="DownButton"
                Grid.Row="2"
                Padding="0,2,0,1"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Command="ScrollBar.LineDownCommand"
                Content="{m:FluentIconSource CaretDown24, Filled=True}"
                FontSize="11"
                Opacity="0"
                Style="{StaticResource ScrollBarTransparentRepeatButton}" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="controls:ScrollViewerAssist.HideButtons" Value="True">
                <!--
                    Collapsing the RepeatButtons, rather than merely making them transparent,
                    removes their Auto-sized rows so PART_Track receives the reclaimed space.
                -->
                <Setter TargetName="UpButton" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="DownButton" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="controls:DynamicScrollViewer.IsManagedScrollBar" Value="True">
                <Setter TargetName="PART_Track" Property="Opacity" Value="0.0" />
            </Trigger>
            <Trigger Property="controls:DynamicScrollViewer.IsVerticalScrollBarActive" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard TargetProperty="Opacity" TargetName="PART_Track">
                            <DoubleAnimation To="1.0" Duration="{StaticResource ScrollAnimationDuration}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard TargetProperty="Opacity" TargetName="PART_Track">
                            <DoubleAnimation To="0.0" Duration="{StaticResource ScrollAnimationDuration}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="BackBorder"
                                Storyboard.TargetProperty="Opacity"
                                To="1.0"
                                Duration="{StaticResource ScrollAnimationDuration}" />
                            <DoubleAnimation
                                Storyboard.TargetName="UpButton"
                                Storyboard.TargetProperty="Opacity"
                                To="1.0"
                                Duration="{StaticResource ScrollAnimationDuration}" />
                            <DoubleAnimation
                                Storyboard.TargetName="DownButton"
                                Storyboard.TargetProperty="Opacity"
                                To="1.0"
                                Duration="{StaticResource ScrollAnimationDuration}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="BackBorder"
                                Storyboard.TargetProperty="Opacity"
                                To="0.0"
                                Duration="{StaticResource ScrollAnimationDuration}" />
                            <DoubleAnimation
                                Storyboard.TargetName="UpButton"
                                Storyboard.TargetProperty="Opacity"
                                To="0.0"
                                Duration="{StaticResource ScrollAnimationDuration}" />
                            <DoubleAnimation
                                Storyboard.TargetName="DownButton"
                                Storyboard.TargetProperty="Opacity"
                                To="0.0"
                                Duration="{StaticResource ScrollAnimationDuration}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
        <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="4" />
                <ColumnDefinition Width="0.00001*" />
                <ColumnDefinition Width="Auto" MinWidth="4" />
            </Grid.ColumnDefinitions>
            <Border
                x:Name="BackBorder"
                Grid.ColumnSpan="3"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{converters:PillCornerConverter Factor=0.55}"
                Opacity="0" />
            <RepeatButton
                x:Name="LeftButton"
                Grid.Column="0"
                Padding="1,0,2,0"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Command="ScrollBar.LineLeftCommand"
                Content="{m:FluentIconSource CaretLeft24, Filled=True}"
                FontSize="11"
                Opacity="0"
                Style="{StaticResource ScrollBarTransparentRepeatButton}" />
            <Track x:Name="PART_Track" Grid.Column="1">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollBarTransparentRepeatButton}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource HorizontalScrollBarThumbStyle}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollBarTransparentRepeatButton}" />
                </Track.IncreaseRepeatButton>
            </Track>
            <RepeatButton
                x:Name="RightButton"
                Grid.Column="2"
                Padding="2,0,1,0"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Command="ScrollBar.LineRightCommand"
                Content="{m:FluentIconSource CaretRight24, Filled=True}"
                FontSize="11"
                Opacity="0"
                Style="{StaticResource ScrollBarTransparentRepeatButton}" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="controls:ScrollViewerAssist.HideButtons" Value="True">
                <!--  Keep horizontal and vertical behavior symmetrical, including layout reclaim.  -->
                <Setter TargetName="LeftButton" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="RightButton" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="FlowDirection" Value="RightToLeft">
                <Setter TargetName="LeftButton" Property="Content" Value="{m:FluentIconSource CaretRight24, Filled=True}" />
                <Setter TargetName="RightButton" Property="Content" Value="{m:FluentIconSource CaretLeft24, Filled=True}" />
            </Trigger>
            <Trigger Property="controls:DynamicScrollViewer.IsManagedScrollBar" Value="True">
                <Setter TargetName="PART_Track" Property="Opacity" Value="0.0" />
            </Trigger>
            <Trigger Property="controls:DynamicScrollViewer.IsHorizontalScrollBarActive" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard TargetProperty="Opacity" TargetName="PART_Track">
                            <DoubleAnimation To="1.0" Duration="{StaticResource ScrollAnimationDuration}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard TargetProperty="Opacity" TargetName="PART_Track">
                            <DoubleAnimation To="0.0" Duration="{StaticResource ScrollAnimationDuration}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="BackBorder"
                                Storyboard.TargetProperty="Opacity"
                                To="1.0"
                                Duration="{StaticResource ScrollAnimationDuration}" />
                            <DoubleAnimation
                                Storyboard.TargetName="LeftButton"
                                Storyboard.TargetProperty="Opacity"
                                To="1.0"
                                Duration="{StaticResource ScrollAnimationDuration}" />
                            <DoubleAnimation
                                Storyboard.TargetName="RightButton"
                                Storyboard.TargetProperty="Opacity"
                                To="1.0"
                                Duration="{StaticResource ScrollAnimationDuration}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="BackBorder"
                                Storyboard.TargetProperty="Opacity"
                                To="0.0"
                                Duration="{StaticResource ScrollAnimationDuration}" />
                            <DoubleAnimation
                                Storyboard.TargetName="LeftButton"
                                Storyboard.TargetProperty="Opacity"
                                To="0.0"
                                Duration="{StaticResource ScrollAnimationDuration}" />
                            <DoubleAnimation
                                Storyboard.TargetName="RightButton"
                                Storyboard.TargetProperty="Opacity"
                                To="0.0"
                                Duration="{StaticResource ScrollAnimationDuration}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="ScrollBarBaseStyle" TargetType="{x:Type ScrollBar}">
        <Style.Resources>
            <!--
                ThumbMinLength = Floor(buttonSize × 0.5). To achieve the intended 18 DIP minimum,
                buttonSize must be set to 36, compensating for the halving formula.
            -->
            <system:Double x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">36</system:Double>
            <system:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}">36</system:Double>
        </Style.Resources>
        <Setter Property="Background" Value="{m:DynamicBrush AcrylicBackgroundFillDefault}" />
        <Setter Property="Foreground" Value="{m:DynamicBrush ControlStrongFillSecondary}" />
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="false" />
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="12" />
                <Setter Property="MinHeight" Value="12" />
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
