<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ani="clr-namespace:Wpf.Zen.Ui.Animations"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:converters="clr-namespace:Wpf.Zen.Ui.Converters"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:theming="clr-namespace:Wpf.Zen.Ui.Theming">

    <Thickness x:Key="ExpanderPadding">11,11,11,11</Thickness>
    <Thickness x:Key="ExpanderBorderThemeThickness">1</Thickness>
    <system:Double x:Key="ExpanderChevronSize">16.0</system:Double>

    <converters:CornerRadiusTransformConverter x:Key="ExpanderDownHeaderCornerRadiusConverter" CopyCorners="Top" />

    <!--  ExpandDirection == Down  -->
    <ControlTemplate x:Key="ExpanderDownToggleButtonTemplate" TargetType="{x:Type controls:ToggleButton}">
        <Border
            x:Name="border"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}"
            SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter
                    Grid.Column="0"
                    Margin="{TemplateBinding Padding}"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    RecognizesAccessKey="True" />
                <Border
                    x:Name="chevronBorder"
                    Grid.Column="1"
                    Margin="8"
                    Padding="8"
                    CornerRadius="6">
                    <controls:FluentIcon
                        x:Name="chevronIcon"
                        IconForeground="{m:DynamicBrush TextFillSecondary}"
                        IconSize="12"
                        RenderTransformOrigin="0.5, 0.5"
                        Symbol="ChevronDown24">
                        <controls:FluentIcon.RenderTransform>
                            <RotateTransform Angle="0" />
                        </controls:FluentIcon.RenderTransform>
                    </controls:FluentIcon>
                </Border>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="chevronBorder" Property="Background" Value="{m:DynamicBrush ControlFillSecondary}" />
                <Setter TargetName="chevronIcon" Property="IconForeground" Value="{m:DynamicBrush TextFillPrimary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="chevronBorder" Property="Background" Value="{m:DynamicBrush ControlFillTertiary}" />
                <Setter TargetName="chevronIcon" Property="IconForeground" Value="{m:DynamicBrush TextFillTertiary}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="border" Property="CornerRadius" Value="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ExpanderDownHeaderCornerRadiusConverter}}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="chevronIcon" Property="IconForeground" Value="{m:DynamicBrush TextFillDisabled}" />
            </Trigger>

            <Trigger Property="IsChecked" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ani:InterruptibleDoubleAnimation
                                Storyboard.TargetName="chevronIcon"
                                Storyboard.TargetProperty="(controls:FluentIcon.RenderTransform).(RotateTransform.Angle)"
                                From="0"
                                To="180"
                                Duration="00:00:00.167" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ani:InterruptibleDoubleAnimation
                                Storyboard.TargetName="chevronIcon"
                                Storyboard.TargetProperty="(controls:FluentIcon.RenderTransform).(RotateTransform.Angle)"
                                From="180"
                                To="0"
                                Duration="00:00:00.167" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="ExpanderDownContentControlTemplate" TargetType="{x:Type ContentControl}" />

    <!--  ExpandDirection == Up  -->
    <ControlTemplate x:Key="ExpanderUpToggleButtonTemplate" TargetType="{x:Type ToggleButton}">
        <Grid Margin="{TemplateBinding Padding}" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentPresenter
                x:Name="ContentPresenter"
                Grid.Column="0"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                RecognizesAccessKey="True" />
            <Grid
                x:Name="ChevronGrid"
                Grid.Column="1"
                Margin="0"
                VerticalAlignment="Center"
                Background="Transparent"
                RenderTransformOrigin="0.5, 0.5">
                <Grid.RenderTransform>
                    <RotateTransform Angle="0" />
                </Grid.RenderTransform>
                <controls:FluentIcon
                    x:Name="ControlChevronIcon"
                    FontSize="{StaticResource ExpanderChevronSize}"
                    Foreground="{TemplateBinding Foreground}"
                    Symbol="ChevronDown24" />
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="ChevronGrid"
                                Storyboard.TargetProperty="(Grid.RenderTransform).(RotateTransform.Angle)"
                                To="180"
                                Duration="00:00:00.167" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="ChevronGrid"
                                Storyboard.TargetProperty="(Grid.RenderTransform).(RotateTransform.Angle)"
                                To="0"
                                Duration="00:00:00.167" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="ExpanderUpContentControlTemplate" TargetType="{x:Type ContentControl}">
        <!--  用可视属性来驱动动画，不必跨模板去找 Expander.IsExpanded  -->
        <Grid Grid.Row="1" ClipToBounds="True">
            <Border
                x:Name="ContentPresenterBorder"
                Background="{m:DynamicBrush CardBackgroundFillSecondary}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1,0,1,1"
                CornerRadius="0,0,4,4"
                Visibility="Collapsed">
                <ContentPresenter
                    x:Name="ContentPresenter"
                    Margin="{TemplateBinding Padding}"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                <Border.RenderTransform>
                    <TranslateTransform>
                        <TranslateTransform.Y>
                            <MultiBinding Converter="{StaticResource AnimationFactorToValueConverter}" ConverterParameter="negative">
                                <Binding ElementName="ContentPresenterBorder" Path="ActualHeight" />
                                <Binding ElementName="ContentPresenterBorder" Path="(ani:AnimationProperties.AnimationTagValue)" />
                            </MultiBinding>
                        </TranslateTransform.Y>
                    </TranslateTransform>
                </Border.RenderTransform>
            </Border>
        </Grid>
    </ControlTemplate>

    <!--  ExpandDirection == Left  -->
    <ControlTemplate x:Key="ExpanderLeftToggleButtonTemplate" TargetType="{x:Type controls:ToggleButton}" />
    <ControlTemplate x:Key="ExpanderLeftContentControlTemplate" TargetType="{x:Type ContentControl}" />

    <!--  ExpandDirection == Right  -->
    <ControlTemplate x:Key="ExpanderRightToggleButtonTemplate" TargetType="{x:Type controls:ToggleButton}" />
    <ControlTemplate x:Key="ExpanderRightContentControlTemplate" TargetType="{x:Type ContentControl}" />

    <Style x:Key="DefaultExpanderStyle" TargetType="{x:Type Expander}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource {x:Static theming:StyleKeys.DefaultControlFocusVisualStyle}}" />
        <Setter Property="Background" Value="{m:DynamicBrush CardBackgroundFillDefault}" />
        <Setter Property="BorderBrush" Value="{m:DynamicBrush CardStrokeDefault}" />
        <Setter Property="BorderThickness" Value="{StaticResource ExpanderBorderThemeThickness}" />
        <Setter Property="Padding" Value="{StaticResource ExpanderPadding}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Border.CornerRadius" Value="{m:DynamicValue ControlCornerRadius}" />
        <Setter Property="IsExpanded" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Expander}">
                    <!--
                        结构说明：一个 ToggleButton 用于显示 Header 及交互，下面是一个 Border 包裹的 ContentPresenter 用于显示内容。
                        通过绑定 IsExpanded 属性来控制内容的显示和隐藏，并使用动画效果实现展开和收起的过渡。
                        ToggleButton 完全替代整个 Header 区域，内容区域的显示和隐藏通过动画实现。
                    -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Header 直接用 ToggleButton 包裹，这样可以让整个 Header 区域都具有交互功能  -->
                        <controls:ToggleButton
                            x:Name="headerToggleButton"
                            Grid.Row="0"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            Content="{TemplateBinding Header}"
                            ContentStringFormat="{TemplateBinding HeaderStringFormat}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                            ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                            CornerRadius="{TemplateBinding Border.CornerRadius}"
                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                            OverridesDefaultStyle="True"
                            Style="{x:Null}"
                            Template="{StaticResource ExpanderDownToggleButtonTemplate}" />

                        <ContentControl
                            x:Name="contentControl"
                            Grid.Row="1"
                            Content="{TemplateBinding Content}"
                            ContentStringFormat="{TemplateBinding ContentStringFormat}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                            Template="{StaticResource ExpanderDownContentControlTemplate}" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!--  根据方向切换部件模板：默认是 ExpandDirection.Down 向下扩展，所以触发器里只处理剩下的三个方向  -->
                        <!--  todo: 别忘了根据形态切换部件的焦点视觉样式  -->
                        <Trigger Property="ExpandDirection" Value="Up">
                            <Setter TargetName="headerToggleButton" Property="Template" Value="{StaticResource ExpanderUpToggleButtonTemplate}" />
                            <Setter TargetName="contentControl" Property="Template" Value="{StaticResource ExpanderUpContentControlTemplate}" />
                        </Trigger>
                        <Trigger Property="ExpandDirection" Value="Left">
                            <Setter TargetName="headerToggleButton" Property="Template" Value="{StaticResource ExpanderLeftToggleButtonTemplate}" />
                            <Setter TargetName="contentControl" Property="Template" Value="{StaticResource ExpanderLeftContentControlTemplate}" />
                        </Trigger>
                        <Trigger Property="ExpandDirection" Value="Right">
                            <Setter TargetName="headerToggleButton" Property="Template" Value="{StaticResource ExpanderRightToggleButtonTemplate}" />
                            <Setter TargetName="contentControl" Property="Template" Value="{StaticResource ExpanderRightContentControlTemplate}" />
                        </Trigger>


                        <!--
                        <Trigger Property="IsExpanded" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenterBorder" Storyboard.TargetProperty="(Border.Visibility)">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenterBorder" Storyboard.TargetProperty="(ani:AnimationProperties.AnimationTagValue)">
                                            <DiscreteDoubleKeyFrame KeyTime="0" Value="1.0" />
                                            <SplineDoubleKeyFrame
                                                KeySpline="0.0, 0.0, 0.0, 1.0"
                                                KeyTime="0:0:0.333"
                                                Value="0.0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenterBorder" Storyboard.TargetProperty="(Border.Visibility)">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenterBorder" Storyboard.TargetProperty="(ani:AnimationProperties.AnimationTagValue)">
                                            <DiscreteDoubleKeyFrame KeyTime="0" Value="0.0" />
                                            <SplineDoubleKeyFrame
                                                KeySpline="1.0, 1.0, 0.0, 1.0"
                                                KeyTime="0:0:0.167"
                                                Value="1.0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        -->

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{m:DynamicBrush TextFillDisabled}" />
                            <Setter Property="BorderBrush" Value="{m:DynamicBrush CardStrokeDefault}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource DefaultExpanderStyle}" TargetType="{x:Type Expander}" />

</ResourceDictionary>
