<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ani="clr-namespace:Wpf.Zen.Ui.Animations"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:converters="clr-namespace:Wpf.Zen.Ui.Converters"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup">

    <converters:CornerRadiusTransformConverter x:Key="ExpanderDownHeaderCornerRadiusConverter" CopyCorners="Top" />
    <converters:CornerRadiusTransformConverter x:Key="ExpanderUpHeaderCornerRadiusConverter" CopyCorners="Bottom" />
    <converters:CornerRadiusTransformConverter x:Key="ExpanderLeftHeaderCornerRadiusConverter" CopyCorners="Right" />
    <converters:CornerRadiusTransformConverter x:Key="ExpanderRightHeaderCornerRadiusConverter" CopyCorners="Left" />

    <converters:CornerRadiusTransformConverter x:Key="ExpanderDownContentCornerRadiusConverter" CopyCorners="Bottom" />
    <converters:CornerRadiusTransformConverter x:Key="ExpanderUpContentCornerRadiusConverter" CopyCorners="Top" />
    <converters:CornerRadiusTransformConverter x:Key="ExpanderLeftContentCornerRadiusConverter" CopyCorners="Left" />
    <converters:CornerRadiusTransformConverter x:Key="ExpanderRightContentCornerRadiusConverter" CopyCorners="Right" />

    <converters:ThicknessTransformConverter x:Key="ExpanderDownContentBorderThicknessConverter" CopySides="Left,Bottom,Right" />
    <converters:ThicknessTransformConverter x:Key="ExpanderUpContentBorderThicknessConverter" CopySides="Left,Top,Right" />
    <converters:ThicknessTransformConverter x:Key="ExpanderLeftContentBorderThicknessConverter" CopySides="Left,Top,Bottom" />
    <converters:ThicknessTransformConverter x:Key="ExpanderRightContentBorderThicknessConverter" CopySides="Top,Right,Bottom" />

    <Style x:Key="ExpanderHeaderToggleButtonStyle" TargetType="{x:Type controls:ToggleButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="CornerRadius" Value="{Binding Path=(Border.CornerRadius), RelativeSource={RelativeSource AncestorType={x:Type Expander}}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ToggleButton}">
                    <Border
                        x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter
                                x:Name="contentPresenter"
                                Grid.Column="0"
                                RecognizesAccessKey="True" />
                            <Border
                                x:Name="chevronBorder"
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="8"
                                Padding="8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                CornerRadius="6">
                                <controls:FluentIcon
                                    x:Name="chevronIcon"
                                    IconForeground="{m:DynamicBrush TextFillSecondary}"
                                    IconSize="12"
                                    RenderTransformOrigin="0.5, 0.5"
                                    Symbol="ChevronDown24">
                                    <controls:FluentIcon.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </controls:FluentIcon.RenderTransform>
                                </controls:FluentIcon>
                            </Border>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="chevronBorder" Property="Background" Value="{m:DynamicBrush ControlFillSecondary}" />
                            <Setter TargetName="chevronIcon" Property="IconForeground" Value="{m:DynamicBrush TextFillPrimary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="chevronBorder" Property="Background" Value="{m:DynamicBrush ControlFillTertiary}" />
                            <Setter TargetName="chevronIcon" Property="IconForeground" Value="{m:DynamicBrush TextFillTertiary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="chevronIcon" Property="IconForeground" Value="{m:DynamicBrush TextFillDisabled}" />
                        </Trigger>

                        <DataTrigger Binding="{Binding ExpandDirection, RelativeSource={RelativeSource AncestorType={x:Type Expander}}}" Value="Up">
                            <Setter TargetName="chevronIcon" Property="Symbol" Value="ChevronUp24" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ExpandDirection, RelativeSource={RelativeSource AncestorType={x:Type Expander}}}" Value="Left">
                            <Setter TargetName="chevronBorder" Property="Grid.Column" Value="0" />
                            <Setter TargetName="chevronBorder" Property="Grid.ColumnSpan" Value="2" />
                            <Setter TargetName="contentPresenter" Property="Grid.Row" Value="1" />
                            <Setter TargetName="contentPresenter" Property="Grid.ColumnSpan" Value="2" />
                            <Setter TargetName="chevronIcon" Property="Symbol" Value="ChevronLeft24" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ExpandDirection, RelativeSource={RelativeSource AncestorType={x:Type Expander}}}" Value="Right">
                            <Setter TargetName="chevronBorder" Property="Grid.Column" Value="0" />
                            <Setter TargetName="chevronBorder" Property="Grid.ColumnSpan" Value="2" />
                            <Setter TargetName="contentPresenter" Property="Grid.Row" Value="1" />
                            <Setter TargetName="contentPresenter" Property="Grid.ColumnSpan" Value="2" />
                            <Setter TargetName="chevronIcon" Property="Symbol" Value="ChevronRight24" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        </DataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ExpandDirection, RelativeSource={RelativeSource AncestorType={x:Type Expander}}}" Value="Left" />
                                <Condition Binding="{Binding FlowDirection, RelativeSource={RelativeSource Self}}" Value="RightToLeft" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="chevronIcon" Property="Symbol" Value="ChevronRight24" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ExpandDirection, RelativeSource={RelativeSource AncestorType={x:Type Expander}}}" Value="Right" />
                                <Condition Binding="{Binding FlowDirection, RelativeSource={RelativeSource Self}}" Value="RightToLeft" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="chevronIcon" Property="Symbol" Value="ChevronLeft24" />
                        </MultiDataTrigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ani:InterruptibleDoubleAnimation
                                            Storyboard.TargetName="chevronIcon"
                                            Storyboard.TargetProperty="(controls:FluentIcon.RenderTransform).(RotateTransform.Angle)"
                                            From="0"
                                            To="180"
                                            Duration="00:00:00.167" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ani:InterruptibleDoubleAnimation
                                            Storyboard.TargetName="chevronIcon"
                                            Storyboard.TargetProperty="(controls:FluentIcon.RenderTransform).(RotateTransform.Angle)"
                                            From="180"
                                            To="0"
                                            Duration="00:00:00.167" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="ExpanderContentHostTemplate" TargetType="{x:Type controls:ExpanderContentHost}">
        <Border
            x:Name="PART_ContentSurface"
            Padding="{TemplateBinding Padding}"
            Background="{m:DynamicBrush CardBackgroundFillSecondary}"
            BorderBrush="{TemplateBinding BorderBrush}"
            SnapsToDevicePixels="True">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="BorderThickness" Value="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType={x:Type Expander}}, Converter={StaticResource ExpanderDownContentBorderThicknessConverter}}" />
                    <Setter Property="CornerRadius" Value="{Binding Path=(Border.CornerRadius), RelativeSource={RelativeSource AncestorType={x:Type Expander}}, Converter={StaticResource ExpanderDownContentCornerRadiusConverter}}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ExpandDirection, RelativeSource={RelativeSource AncestorType={x:Type Expander}}}" Value="Up">
                            <Setter Property="BorderThickness" Value="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType={x:Type Expander}}, Converter={StaticResource ExpanderUpContentBorderThicknessConverter}}" />
                            <Setter Property="CornerRadius" Value="{Binding Path=(Border.CornerRadius), RelativeSource={RelativeSource AncestorType={x:Type Expander}}, Converter={StaticResource ExpanderUpContentCornerRadiusConverter}}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ExpandDirection, RelativeSource={RelativeSource AncestorType={x:Type Expander}}}" Value="Left">
                            <Setter Property="BorderThickness" Value="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType={x:Type Expander}}, Converter={StaticResource ExpanderLeftContentBorderThicknessConverter}}" />
                            <Setter Property="CornerRadius" Value="{Binding Path=(Border.CornerRadius), RelativeSource={RelativeSource AncestorType={x:Type Expander}}, Converter={StaticResource ExpanderLeftContentCornerRadiusConverter}}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ExpandDirection, RelativeSource={RelativeSource AncestorType={x:Type Expander}}}" Value="Right">
                            <Setter Property="BorderThickness" Value="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType={x:Type Expander}}, Converter={StaticResource ExpanderRightContentBorderThicknessConverter}}" />
                            <Setter Property="CornerRadius" Value="{Binding Path=(Border.CornerRadius), RelativeSource={RelativeSource AncestorType={x:Type Expander}}, Converter={StaticResource ExpanderRightContentCornerRadiusConverter}}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ContentPresenter
                x:Name="ContentPresenter"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
        </Border>
    </ControlTemplate>

    <Style TargetType="{x:Type Expander}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="{m:DynamicBrush CardBackgroundFillDefault}" />
        <Setter Property="BorderBrush" Value="{m:DynamicBrush CardStrokeDefault}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="11" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Border.CornerRadius" Value="{m:DynamicValue ControlCornerRadius}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Expander}">
                    <DockPanel x:Name="root">
                        <controls:ToggleButton
                            x:Name="headerToggleButton"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Content="{TemplateBinding Header}"
                            ContentStringFormat="{TemplateBinding HeaderStringFormat}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                            ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                            DockPanel.Dock="Top"
                            IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                            Style="{StaticResource ExpanderHeaderToggleButtonStyle}" />
                        <controls:ExpanderContentHost
                            x:Name="contentHost"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Content="{TemplateBinding Content}"
                            ContentStringFormat="{TemplateBinding ContentStringFormat}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                            DockPanel.Dock="Bottom"
                            ExpandDirection="{TemplateBinding ExpandDirection}"
                            ExpandDuration="0:0:0.333"
                            Focusable="False"
                            IsExpanded="{TemplateBinding IsExpanded}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                            Template="{StaticResource ExpanderContentHostTemplate}" />
                    </DockPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="ExpandDirection" Value="Up">
                            <Setter TargetName="headerToggleButton" Property="DockPanel.Dock" Value="Bottom" />
                            <Setter TargetName="contentHost" Property="DockPanel.Dock" Value="Top" />
                        </Trigger>
                        <Trigger Property="ExpandDirection" Value="Left">
                            <Setter TargetName="headerToggleButton" Property="DockPanel.Dock" Value="Right" />
                            <Setter TargetName="contentHost" Property="DockPanel.Dock" Value="Left" />
                        </Trigger>
                        <Trigger Property="ExpandDirection" Value="Right">
                            <Setter TargetName="headerToggleButton" Property="DockPanel.Dock" Value="Left" />
                            <Setter TargetName="contentHost" Property="DockPanel.Dock" Value="Right" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition SourceName="contentHost" Property="Visibility" Value="Visible" />
                                <Condition Property="ExpandDirection" Value="Down" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="headerToggleButton" Property="CornerRadius" Value="{Binding Path=(Border.CornerRadius), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ExpanderDownHeaderCornerRadiusConverter}}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition SourceName="contentHost" Property="Visibility" Value="Visible" />
                                <Condition Property="ExpandDirection" Value="Up" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="headerToggleButton" Property="CornerRadius" Value="{Binding Path=(Border.CornerRadius), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ExpanderUpHeaderCornerRadiusConverter}}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition SourceName="contentHost" Property="Visibility" Value="Visible" />
                                <Condition Property="ExpandDirection" Value="Left" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="headerToggleButton" Property="CornerRadius" Value="{Binding Path=(Border.CornerRadius), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ExpanderLeftHeaderCornerRadiusConverter}}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition SourceName="contentHost" Property="Visibility" Value="Visible" />
                                <Condition Property="ExpandDirection" Value="Right" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="headerToggleButton" Property="CornerRadius" Value="{Binding Path=(Border.CornerRadius), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ExpanderRightHeaderCornerRadiusConverter}}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{m:DynamicBrush TextFillDisabled}" />
                            <Setter Property="BorderBrush" Value="{m:DynamicBrush CardStrokeDefault}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
