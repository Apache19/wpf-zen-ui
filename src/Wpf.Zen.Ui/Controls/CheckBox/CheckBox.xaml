<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup">

    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="{m:DynamicBrush ControlAltFillSecondary}" />
        <Setter Property="BorderBrush" Value="{m:DynamicBrush ControlStrongStrokeDefault}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="11,5,11,6" />
        <Setter Property="Border.CornerRadius" Value="{m:DynamicValue ControlCornerRadius}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <BulletDecorator
                        Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalAlignment}"
                        Background="Transparent">
                        <BulletDecorator.Bullet>
                            <Border
                                x:Name="ControlBorderIconPresenter"
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding Border.CornerRadius}">
                                <Border
                                    x:Name="StrokeBorder"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding Border.CornerRadius}">
                                    <controls:FontIcon
                                        x:Name="ControlIcon"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        controls:ClipExtensions.ClipPercentage="1"
                                        controls:ClipExtensions.ObserveSizeChanges="True"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="{m:DynamicBrush TextOnAccentPrimary}"
                                        Source="{m:FluentIconSource Checkmark48}"
                                        Visibility="Collapsed" />
                                </Border>
                            </Border>
                        </BulletDecorator.Bullet>
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Margin="8,0,0,0"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True" />
                    </BulletDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="ContentPresenter" Property="Margin" Value="0" />
                            <Setter Property="MinWidth" Value="30" />
                        </Trigger>
                        <Trigger Property="Content" Value="">
                            <Setter TargetName="ContentPresenter" Property="Margin" Value="0" />
                            <Setter Property="MinWidth" Value="30" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="ControlIcon" Property="Source" Value="{m:FluentIconSource Subtract16}" />
                            <Setter TargetName="ControlIcon" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ControlBorderIconPresenter" Property="Background" Value="{m:DynamicBrush AccentFillSecondary}" />
                            <Setter TargetName="StrokeBorder" Property="BorderBrush" Value="{m:DynamicBrush SubtleFillTransparent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ControlIcon" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ControlBorderIconPresenter" Property="Background" Value="{m:DynamicBrush AccentFillSecondary}" />
                            <Setter TargetName="StrokeBorder" Property="BorderBrush" Value="{m:DynamicBrush SubtleFillTransparent}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard Name="SlideIn">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ControlIcon"
                                            Storyboard.TargetProperty="(controls:ClipExtensions.ClipPercentage)"
                                            From="0"
                                            To="1"
                                            Duration="00:00:00.250">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                        <!--  Skip the animation when it becomes visible  -->
                        <Trigger Property="Visibility" Value="Visible">
                            <Trigger.EnterActions>
                                <SeekStoryboard BeginStoryboardName="SlideIn" Offset="00:00:00.250" />
                            </Trigger.EnterActions>
                        </Trigger>
                        <!--  Skip the animation on load  -->
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <SeekStoryboard BeginStoryboardName="SlideIn" Offset="00:00:00.250" />
                        </EventTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsPressed" Value="False" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="StrokeBorder" Property="Background" Value="{m:DynamicBrush ControlAltFillTertiary}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="StrokeBorder" Property="Background" Value="{m:DynamicBrush ControlAltFillQuarternary}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsPressed" Value="False" />
                                <Condition Property="IsChecked" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ControlBorderIconPresenter" Property="Background" Value="{m:DynamicBrush AccentFillPrimary}" />
                            <Setter TargetName="StrokeBorder" Property="BorderBrush" Value="{m:DynamicBrush SubtleFillTransparent}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsChecked" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ControlBorderIconPresenter" Property="Background" Value="{m:DynamicBrush AccentFillTertiary}" />
                            <Setter TargetName="StrokeBorder" Property="BorderBrush" Value="{m:DynamicBrush SubtleFillTransparent}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsPressed" Value="False" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ControlBorderIconPresenter" Property="Background" Value="{m:DynamicBrush AccentFillPrimary}" />
                            <Setter TargetName="StrokeBorder" Property="BorderBrush" Value="{m:DynamicBrush SubtleFillTransparent}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ControlBorderIconPresenter" Property="Background" Value="{m:DynamicBrush AccentFillTertiary}" />
                            <Setter TargetName="StrokeBorder" Property="BorderBrush" Value="{m:DynamicBrush SubtleFillTransparent}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ControlBorderIconPresenter" Property="Background" Value="{m:DynamicBrush ControlAltFillDisabled}" />
                            <Setter TargetName="StrokeBorder" Property="BorderBrush" Value="{m:DynamicBrush ControlStrongStrokeDisabled}" />
                            <Setter TargetName="ControlIcon" Property="Foreground" Value="{m:DynamicBrush TextFillDisabled}" />
                            <Setter Property="Foreground" Value="{m:DynamicBrush TextFillDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
