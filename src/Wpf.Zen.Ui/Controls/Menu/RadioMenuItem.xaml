<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup">

    <Style x:Key="TopLevelMenuItemFocusVisualStyle">
        <Setter Property="Control.Margin" Value="4,4" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle
                        RadiusX="4"
                        RadiusY="4"
                        SnapsToDevicePixels="True"
                        Stroke="{m:DynamicBrush KeyboardFocusBorder}"
                        StrokeThickness="1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MenuItemFocusVisualStyle" BasedOn="{StaticResource TopLevelMenuItemFocusVisualStyle}">
        <Setter Property="Control.Margin" Value="4,1" />
    </Style>

    <ControlTemplate x:Key="RadioMenuItemTopLevelItemTemplate" TargetType="{x:Type controls:RadioMenuItem}">
        <Grid Background="Transparent">
            <Border
                x:Name="TopLevelItemBorder"
                Margin="2"
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="6"
                SnapsToDevicePixels="True">
                <Grid Margin="10,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid
                        x:Name="RadioIndicator"
                        Grid.Column="0"
                        Width="16"
                        Height="16"
                        MinWidth="16"
                        Margin="0,0,6,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Hidden">
                        <!--
                        <Ellipse
                            Fill="Transparent"
                            Stroke="{m:DynamicBrush ControlStrongStrokeDefault}"
                            StrokeThickness="1" />
                        -->
                        <Ellipse
                            Width="8"
                            Height="8"
                            Fill="{m:DynamicBrush TextFillPrimary}" />
                    </Grid>

                    <ContentPresenter
                        x:Name="HeaderPresenter"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        ContentSource="Header"
                        RecognizesAccessKey="True"
                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                        UseLayoutRounding="True" />
                </Grid>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Header" Value="{x:Null}">
                <Setter TargetName="RadioIndicator" Property="Margin" Value="0" />
                <Setter TargetName="HeaderPresenter" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="RadioIndicator" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TopLevelItemBorder" Property="Background" Value="{m:DynamicBrush SubtleFillSecondary}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="TopLevelItemBorder" Property="Background" Value="{m:DynamicBrush SubtleFillSecondary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="TopLevelItemBorder" Property="Background" Value="{m:DynamicBrush SubtleFillTertiary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{m:DynamicBrush TextFillDisabled}" />
                <Setter TargetName="RadioIndicator" Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="RadioMenuItemSubmenuItemTemplate" TargetType="{x:Type controls:RadioMenuItem}">
        <Grid Background="Transparent">
            <Border
                x:Name="SubmenuItemBorder"
                Margin="4,1,4,1"
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="4"
                SnapsToDevicePixels="True">
                <Grid Margin="8,7,8,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Icon" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
                    </Grid.ColumnDefinitions>

                    <Grid
                        x:Name="RadioIndicator"
                        Grid.Column="0"
                        Width="16"
                        Height="16"
                        MinWidth="16"
                        Margin="0,0,6,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Hidden">
                        <!--
                        <Ellipse
                            Fill="Transparent"
                            Stroke="{m:DynamicBrush ControlStrongStrokeDefault}"
                            StrokeThickness="1" />
                        -->                        
                        <Ellipse
                            Width="8"
                            Height="8"
                            Fill="{m:DynamicBrush TextFillPrimary}" />
                    </Grid>

                    <ContentPresenter
                        x:Name="HeaderPresenter"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        ContentSource="Header"
                        RecognizesAccessKey="True"
                        UseLayoutRounding="True" />

                    <TextBlock
                        x:Name="InputGesture"
                        Grid.Column="2"
                        Margin="25,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{m:DynamicBrush TextFillDisabled}"
                        Text="{TemplateBinding InputGestureText}"
                        UseLayoutRounding="True" />
                </Grid>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Header" Value="{x:Null}">
                <Setter TargetName="RadioIndicator" Property="Margin" Value="0" />
                <Setter TargetName="HeaderPresenter" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="RadioIndicator" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="">
                <Setter TargetName="InputGesture" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="SubmenuItemBorder" Property="Background" Value="{m:DynamicBrush SubtleFillSecondary}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="SubmenuItemBorder" Property="Background" Value="{m:DynamicBrush SubtleFillSecondary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="SubmenuItemBorder" Property="Background" Value="{m:DynamicBrush SubtleFillTertiary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{m:DynamicBrush TextFillDisabled}" />
                <Setter TargetName="RadioIndicator" Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="UiRadioMenuItemStyle" TargetType="{x:Type controls:RadioMenuItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource MenuItemFocusVisualStyle}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="KeyboardNavigation.IsTabStop" Value="True" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ScrollViewer.PanningMode" Value="Both" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="FocusVisualStyle" Value="{StaticResource TopLevelMenuItemFocusVisualStyle}" />
                <Setter Property="Template" Value="{StaticResource RadioMenuItemTopLevelItemTemplate}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{StaticResource RadioMenuItemSubmenuItemTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource UiRadioMenuItemStyle}" TargetType="{x:Type controls:RadioMenuItem}" />

</ResourceDictionary>
