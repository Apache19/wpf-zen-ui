<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup">

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="{m:DynamicBrush ControlAltFillTertiary}" />
        <Setter Property="Margin" Value="0,2,0,2" />
        <Setter Property="Focusable" Value="false" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border
                        x:Name="Border"
                        Height="1"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="true" />
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Path=(controls:OrientationAssist.Orientation), RelativeSource={RelativeSource Self}}" Value="Vertical">
                            <Setter TargetName="Border" Property="Height" Value="Auto" />
                            <Setter TargetName="Border" Property="Width" Value="1" />
                            <Setter Property="Margin" Value="3,6" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TopLevelMenuItemFocusVisualStyle" TargetType="{x:Type controls:FocusVisualPresenter}">
        <Setter Property="Margin" Value="4,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:FocusVisualPresenter}">
                    <Rectangle
                        RadiusX="4"
                        RadiusY="4"
                        SnapsToDevicePixels="True"
                        Stroke="{m:DynamicBrush KeyboardFocusBorder}"
                        StrokeThickness="1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="MenuItemFocusVisualStyle"
        BasedOn="{StaticResource TopLevelMenuItemFocusVisualStyle}"
        TargetType="{x:Type controls:FocusVisualPresenter}">
        <Setter Property="Margin" Value="4,1" />
    </Style>

    <!--  TopLevelHeader  -->
    <ControlTemplate x:Key="{x:Static MenuItem.TopLevelHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid Background="Transparent">
            <Border
                x:Name="TopLevelHeaderBorder"
                Margin="2"
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="6"
                SnapsToDevicePixels="True">
                <Grid Margin="10,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:IconPresenter
                        x:Name="IconPresenter"
                        Grid.Column="0"
                        Margin="0,0,6,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ContentSource="Icon"
                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                        TextElement.FontSize="16" />
                    <controls:FluentIcon
                        x:Name="Checkmark"
                        Grid.Column="0"
                        Margin="0,0,6,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Symbol="Checkmark24"
                        Visibility="Collapsed" />
                    <ContentPresenter
                        x:Name="HeaderPresenter"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        ContentSource="Header"
                        RecognizesAccessKey="True"
                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                        UseLayoutRounding="True" />
                </Grid>
            </Border>
            <Popup
                x:Name="Popup"
                controls:PopupSlideAnimator.IsEnabled="{TemplateBinding controls:PopupSlideAnimator.IsEnabled}"
                controls:PopupShadow.IsEnabled="True"
                AllowsTransparency="True"
                Focusable="False"
                IsOpen="{TemplateBinding IsSubmenuOpen}"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=TopLevelHeaderBorder}"
                PopupAnimation="{TemplateBinding Popup.PopupAnimation}"
                VerticalOffset="1">
                <Border
                    x:Name="SubmenuBorder"
                    Padding="0,3,0,3"
                    Background="{m:DynamicBrush AcrylicBackgroundFillDefault}"
                    BorderBrush="{m:DynamicBrush SurfaceStrokeFlyout}"
                    BorderThickness="1"
                    CornerRadius="8"
                    SnapsToDevicePixels="True">
                    <controls:UiScrollViewer
                        CanContentScroll="False"
                        HorizontalScrollBarVisibility="Disabled"
                        ScrollSpillMode="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel
                            Grid.IsSharedSizeScope="True"
                            IsItemsHost="True"
                            KeyboardNavigation.DirectionalNavigation="Cycle"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </controls:UiScrollViewer>
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <!--  布局触发器  -->
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Header" Value="{x:Null}">
                <Setter TargetName="IconPresenter" Property="Margin" Value="0" />
                <Setter TargetName="HeaderPresenter" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsCheckable" Value="true">
                <Setter TargetName="Checkmark" Property="Visibility" Value="Hidden" />
                <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsCheckable" Value="true" />
                    <Condition Property="IsChecked" Value="true" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Checkmark" Property="Visibility" Value="Visible" />
                <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
            </MultiTrigger>

            <!--  视觉状态触发器  -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TopLevelHeaderBorder" Property="Background" Value="{m:DynamicBrush SubtleFillSecondary}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="TopLevelHeaderBorder" Property="Background" Value="{m:DynamicBrush SubtleFillSecondary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="TopLevelHeaderBorder" Property="Background" Value="{m:DynamicBrush SubtleFillTertiary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{m:DynamicBrush TextFillDisabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  TopLevelItem  -->
    <ControlTemplate x:Key="{x:Static MenuItem.TopLevelItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid Background="Transparent">
            <Border
                x:Name="TopLevelItemBorder"
                Margin="2"
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="6"
                SnapsToDevicePixels="True">
                <Grid Margin="10,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:IconPresenter
                        x:Name="IconPresenter"
                        Grid.Column="0"
                        Margin="0,0,6,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ContentSource="Icon"
                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                        TextElement.FontSize="16" />
                    <controls:FluentIcon
                        x:Name="Checkmark"
                        Grid.Column="0"
                        Margin="0,0,6,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Symbol="Checkmark24"
                        Visibility="Collapsed" />
                    <ContentPresenter
                        x:Name="HeaderPresenter"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        ContentSource="Header"
                        RecognizesAccessKey="True"
                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                        UseLayoutRounding="True" />
                </Grid>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <!--  布局触发器  -->
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Header" Value="{x:Null}">
                <Setter TargetName="IconPresenter" Property="Margin" Value="0" />
                <Setter TargetName="HeaderPresenter" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsCheckable" Value="true">
                <Setter TargetName="Checkmark" Property="Visibility" Value="Hidden" />
                <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsCheckable" Value="true" />
                    <Condition Property="IsChecked" Value="true" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Checkmark" Property="Visibility" Value="Visible" />
                <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
            </MultiTrigger>

            <!--  视觉状态触发器  -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TopLevelItemBorder" Property="Background" Value="{m:DynamicBrush SubtleFillSecondary}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="TopLevelItemBorder" Property="Background" Value="{m:DynamicBrush SubtleFillSecondary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="TopLevelItemBorder" Property="Background" Value="{m:DynamicBrush SubtleFillTertiary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{m:DynamicBrush TextFillDisabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  SubmenuItem  -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid Background="Transparent">
            <Border
                x:Name="SubmenuItemBorder"
                Margin="4,1,4,1"
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="4"
                SnapsToDevicePixels="True">
                <Grid Margin="8,7,8,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Icon" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
                    </Grid.ColumnDefinitions>

                    <!--  选中对勾应该与图标在同一列  -->
                    <controls:FluentIcon
                        x:Name="Checkmark"
                        Grid.Column="0"
                        Margin="0,0,6,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Symbol="Checkmark24"
                        Visibility="Collapsed" />

                    <controls:IconPresenter
                        x:Name="IconPresenter"
                        Grid.Column="0"
                        Margin="0,0,6,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ContentSource="Icon"
                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                        TextElement.FontSize="16" />

                    <ContentPresenter
                        x:Name="Header"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        ContentSource="Header"
                        RecognizesAccessKey="True"
                        UseLayoutRounding="True" />

                    <TextBlock
                        x:Name="InputGesture"
                        Grid.Column="2"
                        Margin="25,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{m:DynamicBrush TextFillDisabled}"
                        Text="{TemplateBinding InputGestureText}"
                        UseLayoutRounding="True" />
                </Grid>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <!--  布局触发器  -->
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsCheckable" Value="True">
                <Setter TargetName="Checkmark" Property="Visibility" Value="Hidden" />
                <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsCheckable" Value="True" />
                    <Condition Property="IsChecked" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Checkmark" Property="Visibility" Value="Visible" />
                <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
            </MultiTrigger>
            <Trigger Property="InputGestureText" Value="">
                <Setter TargetName="InputGesture" Property="Visibility" Value="Collapsed" />
            </Trigger>

            <!--  视觉状态触发器  -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="SubmenuItemBorder" Property="Background" Value="{m:DynamicBrush SubtleFillSecondary}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="SubmenuItemBorder" Property="Background" Value="{m:DynamicBrush SubtleFillSecondary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="SubmenuItemBorder" Property="Background" Value="{m:DynamicBrush SubtleFillTertiary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{m:DynamicBrush TextFillDisabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  SubItem with Subitems  -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid Background="Transparent">
            <Border
                x:Name="SubmenuHeaderBorder"
                Margin="4,1,4,1"
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="4"
                SnapsToDevicePixels="True">
                <Grid Margin="8,7,8,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Icon" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
                    </Grid.ColumnDefinitions>
                    <controls:FluentIcon
                        x:Name="Checkmark"
                        Grid.Column="0"
                        Margin="0,0,6,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Symbol="Checkmark24"
                        Visibility="Collapsed" />

                    <controls:IconPresenter
                        x:Name="IconPresenter"
                        Grid.Column="0"
                        Margin="0,0,6,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ContentSource="Icon"
                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                        TextElement.FontSize="16" />

                    <ContentPresenter
                        x:Name="Header"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        ContentSource="Header"
                        RecognizesAccessKey="True"
                        UseLayoutRounding="True" />

                    <controls:FluentIcon
                        x:Name="Chevron"
                        Grid.Column="2"
                        Margin="25,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Symbol="ChevronRight20" />
                </Grid>
            </Border>
            <Popup
                x:Name="Popup"
                controls:PopupSlideAnimator.IsEnabled="{TemplateBinding controls:PopupSlideAnimator.IsEnabled}"
                controls:PopupShadow.IsEnabled="True"
                AllowsTransparency="True"
                Focusable="False"
                IsOpen="{TemplateBinding IsSubmenuOpen}"
                Placement="Right"
                PlacementTarget="{Binding ElementName=SubmenuHeaderBorder}"
                PopupAnimation="{TemplateBinding Popup.PopupAnimation}"
                VerticalOffset="-5">
                <Border
                    x:Name="SubmenuBorder"
                    Padding="0,3,0,3"
                    Background="{m:DynamicBrush AcrylicBackgroundFillDefault}"
                    BorderBrush="{m:DynamicBrush SurfaceStrokeFlyout}"
                    BorderThickness="1"
                    CornerRadius="8"
                    SnapsToDevicePixels="True">
                    <controls:UiScrollViewer
                        CanContentScroll="False"
                        Focusable="False"
                        HorizontalScrollBarVisibility="Disabled"
                        ScrollSpillMode="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel
                            Grid.IsSharedSizeScope="True"
                            IsItemsHost="True"
                            KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </controls:UiScrollViewer>
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <!--  布局触发器  -->
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="IconPresenter" Property="Margin" Value="0" />
                <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsCheckable" Value="True">
                <Setter TargetName="Checkmark" Property="Visibility" Value="Hidden" />
                <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsCheckable" Value="True" />
                    <Condition Property="IsChecked" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Checkmark" Property="Visibility" Value="Visible" />
                <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
            </MultiTrigger>

            <!--  视觉状态触发器  -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="SubmenuHeaderBorder" Property="Background" Value="{m:DynamicBrush SubtleFillSecondary}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="true">
                <Setter TargetName="SubmenuHeaderBorder" Property="Background" Value="{m:DynamicBrush SubtleFillSecondary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="SubmenuHeaderBorder" Property="Background" Value="{m:DynamicBrush SubtleFillTertiary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter Property="Foreground" Value="{m:DynamicBrush TextFillDisabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="UiMenuItemStyle" TargetType="{x:Type MenuItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="controls:FocusVisual.PresenterStyle" Value="{StaticResource MenuItemFocusVisualStyle}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="KeyboardNavigation.IsTabStop" Value="True" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ScrollViewer.PanningMode" Value="Both" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="controls:MenuItemCommandIcon.AutoSetIcon" Value="True" />
        <Setter Property="controls:OrientationAssist.Orientation" Value="Horizontal" />
        <!--
            MenuItem owns the Popup used for cascading submenus. Keep the shortened native Slide as
            the ordinary default, but pass both animation settings through the template so a specialized
            menu style can select a different native animation without duplicating the role templates.
        -->
        <Setter Property="controls:PopupSlideAnimator.IsEnabled" Value="True" />
        <Setter Property="Popup.PopupAnimation" Value="Slide" />
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="controls:FocusVisual.PresenterStyle" Value="{StaticResource TopLevelMenuItemFocusVisualStyle}" />
                <Setter Property="Grid.IsSharedSizeScope" Value="True" />
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.TopLevelHeaderTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="controls:FocusVisual.PresenterStyle" Value="{StaticResource TopLevelMenuItemFocusVisualStyle}" />
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.TopLevelItemTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuHeaderTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuItemTemplateKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource UiMenuItemStyle}" TargetType="{x:Type MenuItem}" />

</ResourceDictionary>
