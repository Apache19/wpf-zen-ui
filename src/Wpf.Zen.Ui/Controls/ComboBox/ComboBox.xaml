<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ani="clr-namespace:Wpf.Zen.Ui.Animations"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:converters="clr-namespace:Wpf.Zen.Ui.Converters"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup"
    xmlns:t="clr-namespace:Wpf.Zen.Ui.Theming">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Wpf.Zen.Ui;component/Resources/DefaultEditorContextMenu.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Wpf.Zen.Ui;component/Controls/ComboBox/ComboBoxBaseStyle.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Wpf.Zen.Ui;component/Controls/ComboBox/ComboBoxItem.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Wpf.Zen.Ui;component/Controls/ListBox/DefaultListBoxItem.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <converters:ThicknessTransformConverter x:Key="IconTopPaddingConverter" CopySides="Top" Offset="0 1 0 0" />
    <converters:ThicknessTransformConverter x:Key="IconBottomPaddingConverter" CopySides="Bottom" Offset="0 0 0 -1" />
    <converters:ThicknessTransformConverter x:Key="ContentPaddingConverter" Offset="2,0" />

    <ControlTemplate x:Key="UiComboBoxTemplate" TargetType="{x:Type controls:ComboBox}">
        <Grid>
            <Border
                x:Name="ContentBorder"
                Background="{TemplateBinding VisualBackground}"
                BorderBrush="{TemplateBinding VisualBorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding Border.CornerRadius}"
                SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="IconContainer"
                        Grid.Column="0"
                        Margin="{TemplateBinding IconMargin}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        IsHitTestVisible="False">
                        <controls:IconPresenter
                            x:Name="IconPresenter"
                            VerticalAlignment="Top"
                            Content="{TemplateBinding Icon}"
                            TextElement.FontSize="{TemplateBinding FontSize, Converter={converters:DoubleToDoubleConverter Add=1}}"
                            TextElement.Foreground="{TemplateBinding VisualForeground}" />
                    </Border>

                    <!--  Placeholder (watermark) control. Uses Margin to match the TextEditor's default 2,0,2,0 padding.  -->
                    <controls:PlaceholderControl
                        x:Name="PART_Placeholder"
                        Grid.Column="1"
                        Margin="2,0"
                        Padding="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        Foreground="{m:DynamicBrush TextPlaceholder}" />

                    <!--  A converter is used to simulate the TextEditor's 2,0,2,0 margin, since Padding may not be honored.  -->
                    <ContentPresenter
                        Name="PART_ContentPresenter"
                        Grid.Column="1"
                        Margin="{TemplateBinding Padding, Converter={StaticResource ContentPaddingConverter}}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        Content="{TemplateBinding SelectionBoxItem}"
                        ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                        ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                        TextElement.Foreground="{TemplateBinding VisualForeground}" />

                    <controls:FontIcon
                        x:Name="ChevronIcon"
                        Grid.Column="2"
                        Margin="8,0,10,0"
                        VerticalAlignment="Center"
                        IconForeground="{m:DynamicBrush TextFillSecondary}"
                        IconSize="11"
                        RenderTransformOrigin="0.5, 0.5"
                        Source="{m:FluentIconSource ChevronDown24}">
                        <controls:FontIcon.RenderTransform>
                            <RotateTransform Angle="0" />
                        </controls:FontIcon.RenderTransform>
                    </controls:FontIcon>

                    <!--  Editable text box input area, visible only when the ComboBox is in editable mode.  -->
                    <controls:TextBox
                        x:Name="PART_EditableTextBox"
                        Grid.Column="1"
                        MinHeight="0"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        CaretBrush="{Binding Foreground, RelativeSource={RelativeSource Self}}"
                        ContextMenu="{StaticResource DefaultEditorContextMenu}"
                        FocusVisualStyle="{x:Null}"
                        Foreground="{TemplateBinding VisualForeground}"
                        IsEnabled="{TemplateBinding IsEditable}"
                        IsReadOnly="{TemplateBinding IsReadOnly}"
                        OverridesDefaultStyle="True"
                        VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                        Visibility="Hidden">
                        <controls:TextBox.Template>
                            <ControlTemplate TargetType="{x:Type TextBox}">
                                <controls:UiScrollViewer
                                    x:Name="PART_ContentHost"
                                    controls:ScrollViewerAssist.OverlayMode="Traditional"
                                    Focusable="false"
                                    HorizontalScrollBarVisibility="Hidden"
                                    ScrollSpillMode="Disabled"
                                    VerticalScrollBarVisibility="Hidden" />
                            </ControlTemplate>
                        </controls:TextBox.Template>
                    </controls:TextBox>

                    <!--
                        Fully transparent ToggleButton overlay that sits on top to receive input.
                        When editable it collapses into the icon column; when non-editable it spans both
                        columns and fills the entire control.
                        OverridesDefaultStyle strips all visual appearance — the control template
                        contains only a single transparent Border.
                    -->
                    <ToggleButton
                        Name="ToggleButton"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        MinHeight="0"
                        ClickMode="Press"
                        Focusable="False"
                        IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                        IsTabStop="False"
                        OverridesDefaultStyle="True">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                <Border Background="Transparent" SnapsToDevicePixels="True" />
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </Grid>
            </Border>
            <Border
                x:Name="AccentBorder"
                BorderBrush="{m:DynamicBrush AccentStroke}"
                BorderThickness="0,0,0,2"
                CornerRadius="{TemplateBinding Border.CornerRadius}"
                IsHitTestVisible="False"
                Visibility="Collapsed" />

            <!--  Drop-down popup. Shadow is rendered via PopupShadow; animation is handled by PopupSlideAnimator.  -->
            <Popup
                x:Name="Popup"
                controls:PopupPlacementGap.Vertical="1"
                controls:PopupPlacementTracker.IsEnabled="True"
                controls:PopupShadow.IsEnabled="True"
                controls:PopupSlideAnimator.IsEnabled="True"
                AllowsTransparency="True"
                IsOpen="{TemplateBinding IsDropDownOpen}"
                Placement="{TemplateBinding Popup.Placement}"
                PopupAnimation="{TemplateBinding Popup.PopupAnimation}">
                <Border
                    x:Name="DropDownBorder"
                    MinWidth="{TemplateBinding ActualWidth}"
                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                    Padding="0,4"
                    Background="{m:DynamicBrush AcrylicBackgroundFillDefault}"
                    BorderBrush="{m:DynamicBrush SurfaceStrokeDefault}"
                    BorderThickness="1"
                    CornerRadius="{m:DynamicValue PopupCornerRadius}"
                    SnapsToDevicePixels="True">
                    <Grid>
                        <controls:UiScrollViewer
                            x:Name="SearchItemsScrollViewer"
                            Margin="0"
                            HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                            SnapsToDevicePixels="True"
                            VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ItemsPresenter
                                x:Name="ItemsPresenter"
                                KeyboardNavigation.DirectionalNavigation="Contained"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </controls:UiScrollViewer>
                        <!--  todo: 待优化  -->
                        <ListBox
                            x:Name="PART_SearchResults"
                            Background="Transparent"
                            BorderThickness="0"
                            DisplayMemberPath="Text"
                            Focusable="False"
                            Foreground="{TemplateBinding Foreground}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            Visibility="Collapsed">
                            <ListBox.ItemContainerStyle>
                                <Style BasedOn="{StaticResource DefaultListBoxItemStyle}" TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Padding" Value="8,6" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsTextSearchFiltering" Value="True">
                <Setter TargetName="SearchItemsScrollViewer" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PART_SearchResults" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="VerticalContentAlignment" Value="Stretch">
                <Setter TargetName="IconPresenter" Property="Margin" Value="{Binding Padding, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IconTopPaddingConverter}}" />
            </Trigger>
            <Trigger Property="VerticalContentAlignment" Value="Top">
                <Setter TargetName="IconPresenter" Property="Margin" Value="{Binding Padding, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IconTopPaddingConverter}}" />
            </Trigger>
            <Trigger Property="VerticalContentAlignment" Value="Bottom">
                <Setter TargetName="IconPresenter" Property="Margin" Value="{Binding Padding, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IconBottomPaddingConverter}}" />
            </Trigger>

            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="IconContainer" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="IconContainer" Property="Margin" Value="0" />
            </Trigger>

            <Trigger Property="IsDropDownOpen" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ani:InterruptibleDoubleAnimation
                                Storyboard.TargetName="ChevronIcon"
                                Storyboard.TargetProperty="(controls:FontIcon.RenderTransform).(RotateTransform.Angle)"
                                From="0"
                                To="180"
                                Duration="00:00:00.167" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ani:InterruptibleDoubleAnimation
                                Storyboard.TargetName="ChevronIcon"
                                Storyboard.TargetProperty="(controls:FontIcon.RenderTransform).(RotateTransform.Angle)"
                                From="180"
                                To="0"
                                Duration="00:00:00.167" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="HasItems" Value="False">
                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="32.0" />
            </Trigger>
            <Trigger SourceName="Popup" Property="Popup.AllowsTransparency" Value="False">
                <Setter TargetName="DropDownBorder" Property="CornerRadius" Value="0" />
            </Trigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsGrouping" Value="true" />
                    <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="false" />
                </MultiTrigger.Conditions>
                <Setter Property="ScrollViewer.CanContentScroll" Value="false" />
            </MultiTrigger>

            <Trigger Property="IsEditable" Value="True">
                <Setter Property="IsTabStop" Value="False" />
                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                <Setter TargetName="PART_ContentPresenter" Property="Visibility" Value="Hidden" />
                <Setter TargetName="ToggleButton" Property="Grid.Column" Value="2" />
                <Setter TargetName="ToggleButton" Property="Grid.ColumnSpan" Value="1" />
            </Trigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsKeyboardFocusWithin" Value="True" />
                    <Condition Property="IsEditable" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="AccentBorder" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="PART_Placeholder" Property="Opacity" Value="0.5" />
                <Setter TargetName="ChevronIcon" Property="IconForeground" Value="{m:DynamicBrush TextFillDisabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="{x:Static t:StyleKeys.UiComboBoxStyle}" BasedOn="{StaticResource ComboBoxBaseStyle}" TargetType="{x:Type controls:ComboBox}">
        <Setter Property="IconMargin" Value="10,0,0,0" />
        <!--  ComboBoxItem.xaml is merged above, so the standard implicit type key is available in this dictionary.  -->
        <Setter Property="ItemContainerStyle" Value="{StaticResource {x:Type ComboBoxItem}}" />
        <Setter Property="Template" Value="{StaticResource UiComboBoxTemplate}" />
        <Setter Property="MouseOverBackground" Value="{m:DynamicBrush ControlFillPrimary}" />
        <Setter Property="FocusedBackground" Value="{m:DynamicBrush ControlFillInputActive}" />
        <Setter Property="DropDownOpenBackground" Value="{m:DynamicBrush ControlFillTertiary}" />
        <Setter Property="DisabledForeground" Value="{m:DynamicBrush TextFillDisabled}" />
        <Setter Property="DisabledBackground" Value="{m:DynamicBrush ControlFillDisabled}" />
        <Setter Property="DisabledBorderBrush" Value="{m:DynamicBrush ControlStrokeDefault}" />
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEditable" Value="True" />
                    <Condition Property="IsReadOnly" Value="True" />
                </MultiTrigger.Conditions>
                <!--
                    IsReadOnly has meaning only for the embedded editor. Giving that editor a
                    quieter focused fill matches TextBox while leaving non-editable selectors
                    unaffected; a local FocusedBackground still has higher precedence.
                -->
                <Setter Property="FocusedBackground" Value="{m:DynamicBrush ControlFillTertiary}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource {x:Static t:StyleKeys.UiComboBoxStyle}}" TargetType="{x:Type controls:ComboBox}" />

</ResourceDictionary>
