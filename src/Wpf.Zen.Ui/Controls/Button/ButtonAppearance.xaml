<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup">

    <Style x:Key="UiButtonAppearanceStyle">
        <Setter Property="controls:Button.PressedForeground" Value="{m:DynamicBrush TextFillTertiary}" />
        <Setter Property="Control.Background" Value="{m:DynamicBrush ControlFillSecondary}" />
        <Setter Property="controls:Button.MouseOverBackground" Value="{m:DynamicBrush ControlFillPrimary}" />
        <Setter Property="controls:Button.PressedBackground" Value="{m:DynamicBrush ControlFillTertiary}" />
        <Setter Property="Control.BorderBrush" Value="{m:DynamicBrush ControlElevationBorder}" />
        <Setter Property="controls:Button.MouseOverBorderBrush" Value="{m:DynamicBrush ControlElevationBorder}" />
        <Setter Property="controls:Button.PressedBorderBrush" Value="{m:DynamicBrush ControlStrokeDefault}" />
        <Setter Property="controls:Button.DisabledBackground" Value="{m:DynamicBrush ControlFillDisabled}" />
        <Setter Property="controls:Button.DisabledBorderBrush" Value="{m:DynamicBrush ControlStrokeDefault}" />
        <Setter Property="controls:Button.DisabledForeground" Value="{m:DynamicBrush TextFillDisabled}" />

        <Style.Triggers>
            <!--  TRANSPARENT  -->
            <Trigger Property="controls:Button.Appearance" Value="Transparent">
                <Setter Property="Control.Background" Value="Transparent" />
                <!-- A transparent button must not acquire the default disabled fill. -->
                <Setter Property="controls:Button.DisabledBackground" Value="Transparent" />
            </Trigger>

            <!--  ACCENT  -->
            <Trigger Property="controls:Button.Appearance" Value="Accent">
                <Setter Property="Control.Background" Value="{m:DynamicBrush AccentFillSecondary}" />
                <Setter Property="controls:Button.MouseOverBackground" Value="{m:DynamicBrush AccentFillPrimary}" />
                <Setter Property="controls:Button.PressedBackground" Value="{m:DynamicBrush AccentFillTertiary}" />
                <Setter Property="Control.Foreground" Value="{m:DynamicBrush TextOnAccentPrimary}" />
                <Setter Property="controls:Button.PressedForeground" Value="{m:DynamicBrush TextOnAccentSecondary}" />
                <Setter Property="Control.BorderBrush" Value="{m:DynamicBrush AccentControlElevationBorder}" />
                <Setter Property="controls:Button.MouseOverBorderBrush" Value="{m:DynamicBrush AccentControlElevationBorder}" />
                <Setter Property="controls:Button.PressedBorderBrush" Value="Transparent" />
            </Trigger>

            <!--  DARK  -->
            <Trigger Property="controls:Button.Appearance" Value="Dark">
                <Setter Property="Control.Background" Value="{m:DynamicBrush ControlStrongFillDark}" />
                <Setter Property="Control.Foreground" Value="{m:DynamicBrush TextFillLightPrimary}" />
                <Setter Property="controls:Button.MouseOverBackground" Value="#62000000" />
                <Setter Property="controls:Button.PressedBackground" Value="#52000000" />
                <Setter Property="controls:Button.PressedForeground" Value="{m:DynamicBrush TextFillLightSecondary}" />
                <Setter Property="controls:Button.PressedBorderBrush" Value="Transparent" />
                <Setter Property="Control.BorderBrush" Value="{m:DynamicBrush AccentControlElevationBorder}" />
                <Setter Property="controls:Button.MouseOverBorderBrush" Value="{m:DynamicBrush AccentControlElevationBorder}" />
            </Trigger>

            <!--  LIGHT  -->
            <Trigger Property="controls:Button.Appearance" Value="Light">
                <Setter Property="Control.Background" Value="{m:DynamicBrush ControlStrongFillLight}" />
                <Setter Property="Control.Foreground" Value="{m:DynamicBrush TextFillDarkPrimary}" />
                <Setter Property="controls:Button.MouseOverBackground" Value="#D3FFFFFF" />
                <Setter Property="controls:Button.PressedBackground" Value="#F3FFFFFF" />
                <Setter Property="controls:Button.PressedForeground" Value="{m:DynamicBrush TextFillDarkSecondary}" />
                <Setter Property="controls:Button.PressedBorderBrush" Value="Transparent" />
                <Setter Property="Control.BorderBrush" Value="{m:DynamicBrush AccentControlElevationBorder}" />
                <Setter Property="controls:Button.MouseOverBorderBrush" Value="{m:DynamicBrush AccentControlElevationBorder}" />
            </Trigger>

            <!--  INFO  -->
            <Trigger Property="controls:Button.Appearance" Value="Info">
                <Setter Property="Control.Background" Value="{m:DynamicBrush PaletteBlue}" />
                <Setter Property="controls:Button.MouseOverBackground" Value="{m:DynamicBrush PaletteBlueBright}" />
                <Setter Property="controls:Button.PressedBackground" Value="{m:DynamicBrush PaletteBlueDim}" />
                <Setter Property="Control.BorderBrush" Value="{m:DynamicBrush AccentControlElevationBorder}" />
                <Setter Property="controls:Button.MouseOverBorderBrush" Value="{m:DynamicBrush AccentControlElevationBorder}" />
            </Trigger>

            <!--  DANGER  -->
            <Trigger Property="controls:Button.Appearance" Value="Danger">
                <Setter Property="Control.Background" Value="{m:DynamicBrush PaletteRed}" />
                <Setter Property="controls:Button.MouseOverBackground" Value="{m:DynamicBrush PaletteRedBright}" />
                <Setter Property="controls:Button.PressedBackground" Value="{m:DynamicBrush PaletteRedDim}" />
                <Setter Property="Control.BorderBrush" Value="{m:DynamicBrush AccentControlElevationBorder}" />
                <Setter Property="controls:Button.MouseOverBorderBrush" Value="{m:DynamicBrush AccentControlElevationBorder}" />
                <Setter Property="controls:Button.PressedBorderBrush" Value="Transparent" />
            </Trigger>

            <!--  SUCCESS  -->
            <Trigger Property="controls:Button.Appearance" Value="Success">
                <Setter Property="Control.Background" Value="{m:DynamicBrush PaletteGreen}" />
                <Setter Property="controls:Button.MouseOverBackground" Value="{m:DynamicBrush PaletteGreenBright}" />
                <Setter Property="controls:Button.PressedBackground" Value="{m:DynamicBrush PaletteGreenDim}" />
                <Setter Property="Control.BorderBrush" Value="{m:DynamicBrush AccentControlElevationBorder}" />
                <Setter Property="controls:Button.MouseOverBorderBrush" Value="{m:DynamicBrush AccentControlElevationBorder}" />
                <Setter Property="controls:Button.PressedBorderBrush" Value="Transparent" />
            </Trigger>

            <!--  CAUTION  -->
            <Trigger Property="controls:Button.Appearance" Value="Caution">
                <Setter Property="Control.Background" Value="{m:DynamicBrush PaletteOrange}" />
                <Setter Property="controls:Button.MouseOverBackground" Value="{m:DynamicBrush PaletteOrangeBright}" />
                <Setter Property="controls:Button.PressedBackground" Value="{m:DynamicBrush PaletteOrangeDim}" />
                <Setter Property="Control.BorderBrush" Value="{m:DynamicBrush AccentControlElevationBorder}" />
                <Setter Property="controls:Button.MouseOverBorderBrush" Value="{m:DynamicBrush AccentControlElevationBorder}" />
                <Setter Property="controls:Button.PressedBorderBrush" Value="Transparent" />
            </Trigger>

            <!--
                todo: 高对比度模式应有一套专用色，不使用语义色，否则很难周全
            -->
        </Style.Triggers>
    </Style>

</ResourceDictionary>
