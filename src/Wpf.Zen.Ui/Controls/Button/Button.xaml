<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:converters="clr-namespace:Wpf.Zen.Ui.Converters"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup"
    xmlns:t="clr-namespace:Wpf.Zen.Ui.Theming">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Wpf.Zen.Ui;component/Controls/Button/ButtonAppearance.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <converters:CornerRadiusTransformConverter
        x:Key="FocusCornerRadiusConverter"
        PreserveZeroCorners="True"
        Offset="2 2 2 2" />

    <!--
        Button's focus ring sits outside its strongly colored surface. This style is applied to the presenter inside
        the global focus visual, so it does not shadow SystemParameters.FocusVisualStyleKey or alter WPF's implicit
        focus-style resource lookup. The complete template is intentional: specialized presenter styles are also the
        extension point for controls whose focus outline is not a rounded rectangle.
    -->
    <Style x:Key="UiButtonFocusVisualPresenterStyle" TargetType="{x:Type controls:FocusVisualPresenter}">
        <Setter Property="Margin" Value="-2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:FocusVisualPresenter}">
                    <Border
                        BorderBrush="{m:DynamicBrush KeyboardFocusBorder}"
                        BorderThickness="1"
                        CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource FocusCornerRadiusConverter}}"
                        IsHitTestVisible="False"
                        SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="UiButtonControlTemplate" TargetType="{x:Type controls:Button}">
        <controls:UiBorder
            x:Name="border"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding VisualBackground}"
            BorderBrush="{TemplateBinding VisualBorderBrush}"
            BorderPlacement="{TemplateBinding controls:UiBorder.BorderPlacement}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}"
            SnapsToDevicePixels="True">
            <Grid HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:IconPresenter
                    x:Name="iconPresenter"
                    Grid.Column="0"
                    Margin="{TemplateBinding IconMargin}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    Content="{TemplateBinding Icon}"
                    Focusable="False"
                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                    TextElement.FontSize="{TemplateBinding FontSize, Converter={converters:DoubleToDoubleConverter Add=1}}"
                    TextElement.Foreground="{TemplateBinding VisualForeground}" />
                <ContentPresenter
                    Grid.Column="1"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    Focusable="False"
                    RecognizesAccessKey="True"
                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                    TextElement.Foreground="{TemplateBinding VisualForeground}" />
            </Grid>
        </controls:UiBorder>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="iconPresenter" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="iconPresenter" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="iconPresenter" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="Content" Value="">
                <Setter TargetName="iconPresenter" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="Appearance" Value="Normal">
                <Setter TargetName="border" Property="BorderPlacement" Value="Outside" />
            </Trigger>
            <Trigger Property="Appearance" Value="Transparent">
                <Setter TargetName="border" Property="BorderPlacement" Value="Outside" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="{x:Static t:StyleKeys.UiButtonStyle}" BasedOn="{StaticResource UiButtonAppearanceStyle}" TargetType="{x:Type controls:Button}">
        <Setter Property="Padding" Value="{m:DynamicValue ButtonThemePadding}" />
        <Setter Property="CornerRadius" Value="{m:DynamicValue ControlCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template" Value="{StaticResource UiButtonControlTemplate}" />
        <Setter Property="controls:UiBorder.BorderPlacement" Value="Inside" />
        <Setter Property="IconMargin" Value="0,0,8,0" />
        <Setter Property="controls:FocusVisual.PresenterStyle" Value="{StaticResource UiButtonFocusVisualPresenterStyle}" />
    </Style>

    <Style BasedOn="{StaticResource {x:Static t:StyleKeys.UiButtonStyle}}" TargetType="{x:Type controls:Button}" />

</ResourceDictionary>
