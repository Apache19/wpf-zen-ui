<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup">

    <Style BasedOn="{m:StaticStyle UiButton}" TargetType="{x:Type controls:HyperlinkButton}">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="IconMargin" Value="0,0,8,0" />
        <Setter Property="Background" Value="{m:DynamicBrush SubtleFillTransparent}" />
        <Setter Property="Foreground" Value="{m:DynamicBrush AccentTextPrimary}" />
        <Setter Property="PressedForeground" Value="{m:DynamicBrush AccentTextSecondary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="{x:Null}" />
        <Setter Property="Padding" Value="11,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Appearance" Value="Normal" />
    </Style>

</ResourceDictionary>
