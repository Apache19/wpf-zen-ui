<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup"
    xmlns:t="clr-namespace:Wpf.Zen.Ui.Theming">

    <!-- Solid severity fills use contrasting text and no default border. -->
    <Style x:Key="{x:Static t:StyleKeys.UiBadgeStyle}" TargetType="{x:Type controls:Badge}">
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{m:DynamicBrush TextFillInverse}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="Severity" Value="Informational">
                <Setter Property="Background" Value="{m:DynamicBrush SystemFillInformationalForeground}" />
            </Trigger>
            <Trigger Property="Severity" Value="Attention">
                <Setter Property="Background" Value="{m:DynamicBrush SystemFillAttentionForeground}" />
            </Trigger>
            <Trigger Property="Severity" Value="Success">
                <Setter Property="Background" Value="{m:DynamicBrush SystemFillSuccessForeground}" />
            </Trigger>
            <Trigger Property="Severity" Value="Caution">
                <Setter Property="Background" Value="{m:DynamicBrush SystemFillCautionForeground}" />
            </Trigger>
            <Trigger Property="Severity" Value="Critical">
                <Setter Property="Background" Value="{m:DynamicBrush SystemFillCriticalForeground}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource {x:Static t:StyleKeys.UiBadgeStyle}}" TargetType="{x:Type controls:Badge}" />
</ResourceDictionary>
