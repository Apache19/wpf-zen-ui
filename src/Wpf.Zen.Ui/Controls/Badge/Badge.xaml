<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup"
    xmlns:t="clr-namespace:Wpf.Zen.Ui.Theming">

    <Style x:Key="{x:Static t:StyleKeys.UiBadgeStyle}" TargetType="{x:Type controls:Badge}">
        <Setter Property="Foreground" Value="{m:DynamicBrush TextOnAccentPrimary}" />
        <Setter Property="Background" Value="{m:DynamicBrush AccentFillSecondary}" />
        <!--<Setter Property="BorderBrush" Value="{m:DynamicBrush AccentStroke}" />-->
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Badge}">
                    <Border
                        x:Name="Border"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Appearance" Value="Transparent">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{m:DynamicBrush ControlElevationBorder}" />
                            <Setter TargetName="Border" Property="Background" Value="Transparent" />
                        </Trigger>
                        <Trigger Property="Appearance" Value="Normal">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{m:DynamicBrush ControlElevationBorder}" />
                            <Setter TargetName="Border" Property="Background" Value="{m:DynamicBrush ControlFillSecondary}" />
                        </Trigger>
                        <Trigger Property="Appearance" Value="Info">
                            <Setter TargetName="Border" Property="Background" Value="{m:DynamicBrush PaletteLightBlue}" />
                        </Trigger>
                        <Trigger Property="Appearance" Value="Caution">
                            <Setter TargetName="Border" Property="Background" Value="{m:DynamicBrush PaletteOrange}" />
                        </Trigger>
                        <Trigger Property="Appearance" Value="Danger">
                            <Setter TargetName="Border" Property="Background" Value="{m:DynamicBrush PaletteRed}" />
                        </Trigger>
                        <Trigger Property="Appearance" Value="Success">
                            <Setter TargetName="Border" Property="Background" Value="{m:DynamicBrush PaletteGreen}" />
                        </Trigger>
                        <Trigger Property="Appearance" Value="Dark">
                            <Setter TargetName="Border" Property="Background" Value="{m:DynamicBrush ControlStrongFillDark}" />
                            <Setter Property="Foreground" Value="{m:DynamicBrush TextFillLightPrimary}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{m:DynamicBrush ControlElevationBorder}" />
                        </Trigger>
                        <Trigger Property="Appearance" Value="Light">
                            <Setter TargetName="Border" Property="Background" Value="{m:DynamicBrush ControlStrongFillLight}" />
                            <Setter Property="Foreground" Value="{m:DynamicBrush TextFillDarkPrimary}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{m:DynamicBrush ControlElevationBorder}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource {x:Static t:StyleKeys.UiBadgeStyle}}" TargetType="{x:Type controls:Badge}" />

</ResourceDictionary>
