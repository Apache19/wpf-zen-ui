<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:t="clr-namespace:Wpf.Zen.Ui.Theming">

    <Style x:Key="UiDynamicScrollViewer" TargetType="{x:Type controls:DynamicScrollViewer}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="PanningMode" Value="Both" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:DynamicScrollViewer}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>


                        <Border
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Padding="{TemplateBinding Padding}">
                            <ScrollContentPresenter CanContentScroll="{TemplateBinding CanContentScroll}" />
                        </Border>

                        <controls:DynamicScrollBar
                            x:Name="PART_VerticalScrollBar"
                            Grid.Row="0"
                            Grid.Column="1"
                            IsScrolling="{TemplateBinding IsScrollingVertically}"
                            Maximum="{TemplateBinding ScrollableHeight}"
                            ViewportSize="{TemplateBinding ViewportHeight}"
                            Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                            Value="{TemplateBinding VerticalOffset}" />

                        <controls:DynamicScrollBar
                            x:Name="PART_HorizontalScrollBar"
                            Grid.Row="1"
                            Grid.Column="0"
                            IsScrolling="{TemplateBinding IsScrollingHorizontally}"
                            Maximum="{TemplateBinding ScrollableWidth}"
                            Orientation="Horizontal"
                            ViewportSize="{TemplateBinding ViewportWidth}"
                            Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                            Value="{TemplateBinding HorizontalOffset}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource UiDynamicScrollViewer}" TargetType="{x:Type controls:DynamicScrollViewer}" />

    <!--
        Navigation surfaces deliberately do not impose scrolling on their content. This keyed
        style is an explicit page-owned opt-in for applications that want the former convenient
        full-page DynamicScrollViewer behavior. Because the viewer lives in the Page template,
        ScrollViewer.CanContentScroll keeps its normal WPF meaning for controls inside the page.
    -->
    <Style x:Key="{x:Static t:StyleKeys.DynamicScrollPageStyle}" TargetType="{x:Type Page}">
        <!--
            The viewer consumes NavigationView.ContentPadding inside its viewport, so the host
            must not apply the same inset outside the Page.
        -->
        <Setter Property="controls:NavigationView.IsContentPaddingHandled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Page}">
                    <Border Background="{TemplateBinding Background}">
                        <!--
                            ScrollViewer.OnPreApplyTemplate otherwise auto-binds CanContentScroll
                            to the Page templated parent. Pin pixel scrolling on this actual viewer
                            so an unrelated attached value on Page cannot alter its layout mode.
                        -->
                        <controls:DynamicScrollViewer
                            Padding="{Binding Path=(controls:NavigationView.ContentPadding), RelativeSource={RelativeSource Self}}"
                            CanContentScroll="False"
                            FlowDirection="{TemplateBinding FlowDirection}"
                            Focusable="False">
                            <ContentPresenter Content="{TemplateBinding Page.Content}" />
                        </controls:DynamicScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
