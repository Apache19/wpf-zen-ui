<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup"
    xmlns:theming="clr-namespace:Wpf.Zen.Ui.Theming">

    <Style x:Key="{x:Static theming:StyleKeys.UiBreadcrumbBarItemStyle}" TargetType="{x:Type controls:BreadcrumbBarItem}">
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Foreground" Value="{m:DynamicBrush TextFillSecondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:BreadcrumbBarItem}">
                    <StackPanel Background="{TemplateBinding Background}" Orientation="Horizontal">
                        <Button
                            x:Name="PART_Button"
                            MinHeight="0"
                            Padding="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Background="Transparent"
                            Command="{TemplateBinding Command}"
                            CommandParameter="{TemplateBinding CommandParameter}"
                            CommandTarget="{TemplateBinding CommandTarget}"
                            Content="{TemplateBinding Content}"
                            ContentStringFormat="{TemplateBinding ContentStringFormat}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                            OverridesDefaultStyle="True">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <controls:UiBorder
                                        Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}"
                                        SnapsToDevicePixels="True"
                                        IsPaddingCompressible="True">
                                        <ContentPresenter
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            RecognizesAccessKey="True"
                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    </controls:UiBorder>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="{m:DynamicBrush TextFillPrimary}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Foreground" Value="{m:DynamicBrush TextFillTertiary}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsLast, RelativeSource={RelativeSource AncestorType=controls:BreadcrumbBarItem}}" Value="True">
                                            <Setter Property="Foreground" Value="{m:DynamicBrush TextFillPrimary}" />
                                        </DataTrigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Foreground" Value="{m:DynamicBrush TextFillDisabled}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <controls:FontIcon
                            x:Name="icon"
                            Margin="4,0"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Foreground="{m:DynamicBrush TextFillSecondary}"
                            IsHitTestVisible="False"
                            Source="{m:FluentIconSource ChevronRight24}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="FlowDirection" Value="RightToLeft">
                            <Setter TargetName="icon" Property="Source" Value="{m:FluentIconSource ChevronLeft24}" />
                        </Trigger>
                        <Trigger Property="IsLast" Value="True">
                            <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="controls:IconPresenter.IconForeground" Value="{m:DynamicBrush TextFillDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static theming:StyleKeys.UiBreadcrumbBarStyle}" TargetType="{x:Type controls:BreadcrumbBar}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel IsItemsHost="True" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:BreadcrumbBar}">
                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{m:StaticStyle UiBreadcrumbBarItem}" TargetType="{x:Type controls:BreadcrumbBarItem}" />
    <Style BasedOn="{m:StaticStyle UiBreadcrumbBar}" TargetType="{x:Type controls:BreadcrumbBar}" />

</ResourceDictionary>
