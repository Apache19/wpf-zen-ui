<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup"
    xmlns:t="clr-namespace:Wpf.Zen.Ui.Theming">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Wpf.Zen.Ui;component/Controls/GridView/GridViewColumnHeader.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <ControlTemplate x:Key="DefaultListViewTemplate" TargetType="{x:Type ListView}">
        <Border
            x:Name="RootBorder"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            SnapsToDevicePixels="True">
            <controls:PassiveScrollViewer
                x:Name="PART_ContentHost"
                CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                Focusable="False"
                HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                ScrollSpillMode="{TemplateBinding controls:PassiveScrollViewer.ScrollSpillMode}"
                VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
            </controls:PassiveScrollViewer>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="RootBorder" Property="Opacity" Value="0.56" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--
        Keep WPF's native GridView presenters as the template contract. They own shared Auto
        measurement, column reordering, horizontal synchronization, virtualization awareness, and
        automation. GridLength star allocation is orthogonal and is attached once to the outer
        ScrollViewer in GridViewTemplate; it must not be duplicated by every realized row.
    -->
    <ControlTemplate x:Key="GridViewScrollViewerTemplate" TargetType="{x:Type controls:PassiveScrollViewer}">
        <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel
                Grid.RowSpan="2"
                Grid.ColumnSpan="2"
                Margin="{TemplateBinding Padding}">

                <Border
                    Background="{m:DynamicBrush LayerFillAlt}"
                    BorderBrush="{m:DynamicBrush DividerStrokeDefault}"
                    BorderThickness="0,0,0,1"
                    DockPanel.Dock="Top">
                    <ScrollViewer
                        Focusable="False"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Hidden">
                        <!--
                            This presenter must remain the ScrollViewer's direct content: WPF's native
                            GridView scrolling contract synchronizes it with the body by that structure.
                            The leading margin reserves the selection-indicator gutter without replacing
                            the presenter or altering its native column logic.
                        -->
                        <GridViewHeaderRowPresenter
                            Margin="12,0,0,0"
                            controls:ColumnHeaderResizeBehavior.IsEnabled="True"
                            AllowsColumnReorder="{Binding TemplatedParent.View.AllowsColumnReorder, RelativeSource={RelativeSource TemplatedParent}}"
                            ColumnHeaderContainerStyle="{Binding TemplatedParent.View.ColumnHeaderContainerStyle, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue={m:StaticStyle GridViewColumnHeader}}"
                            ColumnHeaderContextMenu="{Binding TemplatedParent.View.ColumnHeaderContextMenu, RelativeSource={RelativeSource TemplatedParent}}"
                            ColumnHeaderStringFormat="{Binding TemplatedParent.View.ColumnHeaderStringFormat, RelativeSource={RelativeSource TemplatedParent}}"
                            ColumnHeaderTemplate="{Binding TemplatedParent.View.ColumnHeaderTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                            ColumnHeaderTemplateSelector="{Binding TemplatedParent.View.ColumnHeaderTemplateSelector, RelativeSource={RelativeSource TemplatedParent}}"
                            ColumnHeaderToolTip="{Binding TemplatedParent.View.ColumnHeaderToolTip, RelativeSource={RelativeSource TemplatedParent}}"
                            Columns="{Binding TemplatedParent.View.Columns, RelativeSource={RelativeSource TemplatedParent}}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </ScrollViewer>
                </Border>

                <ScrollContentPresenter
                    x:Name="PART_ScrollContentPresenter"
                    CanContentScroll="{TemplateBinding CanContentScroll}"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    KeyboardNavigation.DirectionalNavigation="Local"
                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />

            </DockPanel>

            <!--
                Horizontal visibility intentionally differs from the vertical binding below. GridView
                columns, headers, cells, and the viewport are measured and rounded independently, which
                can leave a sub-pixel horizontal overflow when column widths are adjusted. This template
                configures a 1-DIP HorizontalScrollBarVisibilityThreshold, so EffectiveHorizontalScrollBarVisibility
                preserves WPF's computed result except that it suppresses such insignificant overflow in Auto mode.
                Vertical scrolling has no equivalent rounding tolerance and therefore continues to use WPF's
                ComputedVerticalScrollBarVisibility directly.
            -->
            <ScrollBar
                x:Name="PART_HorizontalScrollBar"
                Grid.Row="1"
                Grid.Column="0"
                Cursor="Arrow"
                Maximum="{TemplateBinding ScrollableWidth}"
                Minimum="0"
                Orientation="Horizontal"
                Style="{m:DynamicStyle DefaultScrollBar}"
                ViewportSize="{TemplateBinding ViewportWidth}"
                Visibility="{TemplateBinding EffectiveHorizontalScrollBarVisibility}"
                Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
            <ScrollBar
                x:Name="PART_VerticalScrollBar"
                Grid.Row="0"
                Grid.Column="1"
                Cursor="Arrow"
                Maximum="{TemplateBinding ScrollableHeight}"
                Minimum="0"
                Orientation="Vertical"
                Style="{m:DynamicStyle DefaultScrollBar}"
                ViewportSize="{TemplateBinding ViewportHeight}"
                Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
        </Grid>
    </ControlTemplate>

    <!--
        GridView-scoped style for the inner PassiveScrollViewer. It is self-contained: the template,
        intrinsic constants, and templated-parent routing are all declared here so a custom
        GridViewTemplate only needs a one-liner <controls:PassiveScrollViewer Style="{m:StaticStyle GridViewScrollViewer}">.

        This style is MEANT ONLY for a PassiveScrollViewer placed inside a ListView ControlTemplate
        whose active View is a WPF Zen UI GridView. The TemplatedParent bindings resolve against the
        hosting ListView. Using this style anywhere else will produce silent binding errors and
        is unsupported — pick the generic DefaultScrollBarStyle or a local style instead.
    -->
    <Style x:Key="{x:Static t:StyleKeys.GridViewScrollViewerStyle}" TargetType="{x:Type controls:PassiveScrollViewer}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalScrollBarVisibilityThreshold" Value="1" />
        <Setter Property="controls:GridViewColumnSizing.LeadingContentWidth" Value="12" />
        <Setter Property="Padding" Value="{Binding Padding, RelativeSource={RelativeSource TemplatedParent}}" />
        <Setter Property="controls:GridViewColumnSizing.Columns" Value="{Binding View.Columns, RelativeSource={RelativeSource TemplatedParent}}" />
        <Setter Property="CanContentScroll" Value="{Binding (ScrollViewer.CanContentScroll), RelativeSource={RelativeSource TemplatedParent}}" />
        <Setter Property="HorizontalScrollBarVisibility" Value="{Binding (ScrollViewer.HorizontalScrollBarVisibility), RelativeSource={RelativeSource TemplatedParent}}" />
        <Setter Property="VerticalScrollBarVisibility" Value="{Binding (ScrollViewer.VerticalScrollBarVisibility), RelativeSource={RelativeSource TemplatedParent}}" />
        <Setter Property="ScrollSpillMode" Value="{Binding (controls:PassiveScrollViewer.ScrollSpillMode), RelativeSource={RelativeSource TemplatedParent}}" />
        <Setter Property="Template" Value="{StaticResource GridViewScrollViewerTemplate}" />
    </Style>

    <ControlTemplate x:Key="GridViewTemplate" TargetType="{x:Type ListView}">
        <Border
            x:Name="RootBorder"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            SnapsToDevicePixels="True">
            <controls:PassiveScrollViewer Style="{m:StaticStyle GridViewScrollViewer}">
                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
            </controls:PassiveScrollViewer>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="RootBorder" Property="Opacity" Value="0.56" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="DefaultListViewBaseStyle" TargetType="{x:Type ListView}">
        <Setter Property="BorderBrush" Value="{m:DynamicBrush DividerStrokeDefault}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.PanningMode" Value="Both" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="controls:PassiveScrollViewer.ScrollSpillMode" Value="Disabled" />
        <Setter Property="Template" Value="{StaticResource DefaultListViewTemplate}" />
        <Style.Triggers>
            <!--
                WPF can virtualize grouped items when IsVirtualizingWhenGrouping is enabled. Logical
                scrolling must only be disabled for the legacy non-virtualizing grouping path; doing
                it for every grouped view silently realizes the complete collection.
            -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsGrouping" Value="True" />
                    <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!--
        ViewBase is not a FrameworkElement and therefore has no Style property. WPF asks the active
        view for these two keys and applies the returned styles to ListView and ListViewItem. The
        lightweight Wpf.Zen.Ui GridView type exists solely to select these Fluent XAML resources.
    -->
    <Style x:Key="{x:Static t:StyleKeys.GridViewListViewStyle}" BasedOn="{StaticResource DefaultListViewBaseStyle}" TargetType="{x:Type ListView}">
        <!--
            ListView changes to this view-specific style through ViewBase.DefaultStyleKey. Keeping
            the selector here (instead of DefaultListViewBaseStyle) makes the rule follow the
            GridView lifecycle automatically, including a View replacement at runtime. No mirrored
            "has view" dependency property or trigger is necessary.

            WPF keeps the ordinary Style selected here separate from the ThemeStyle resolved through
            GridView.ItemContainerDefaultStyleKey. Consequently this style only needs to override
            the trailing divider; the Fluent row template and remaining setters continue to come
            from the GridView theme style.
        -->
        <Setter Property="ItemContainerStyleSelector">
            <Setter.Value>
                <controls:ListItemContainerStyleSelector>
                    <controls:ListItemContainerStyleSelector.LastItemStyle>
                        <Style TargetType="{x:Type ListViewItem}">
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </controls:ListItemContainerStyleSelector.LastItemStyle>
                </controls:ListItemContainerStyleSelector>
            </Setter.Value>
        </Setter>
        <Setter Property="Template" Value="{StaticResource GridViewTemplate}" />
    </Style>

    <Style BasedOn="{StaticResource DefaultListViewBaseStyle}" TargetType="{x:Type controls:ListView}" />

</ResourceDictionary>
