<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup"
    xmlns:t="clr-namespace:Wpf.Zen.Ui.Theming">

    <Style x:Key="SoftKeyboardToolButtonStyle" TargetType="{x:Type controls:Button}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Appearance" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="{x:Static t:StyleKeys.UiSoftKeyboardStyle}" TargetType="{x:Type controls:SoftKeyboard}">
        <Setter Property="Background" Value="{m:DynamicBrush SolidBackgroundFillSecondary}" />
        <Setter Property="BorderBrush" Value="{m:DynamicBrush ControlStrokeDefault}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SoftKeyboard}">
                    <Border
                        x:Name="KeyboardRoot"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        RenderTransformOrigin="0.5,1"
                        SnapsToDevicePixels="True">
                        <Border.RenderTransform>
                            <TranslateTransform />
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                <!--
                                    候选栏左边的设置按钮，常驻，可撑起候选栏高度
                                    将来为其实现弹出菜单用来设置软键盘参数
                                -->
                                <controls:Button
                                    Padding="10,8"
                                    Content="{m:FluentIconSource Settings24}"
                                    DockPanel.Dock="Left"
                                    FontSize="18"
                                    Style="{StaticResource SoftKeyboardToolButtonStyle}" />

                                <Grid>
                                    <!--  候选栏 填充剩余空间  -->
                                    <DockPanel
                                        x:Name="CandidateBar"
                                        Margin="4,0,0,0"
                                        AutomationProperties.Name="Input method candidates"
                                        ClipToBounds="True">

                                        <!--  下一页按钮 停靠最右  -->
                                        <controls:Button
                                            x:Name="PART_NextCandidatePageButton"
                                            AutomationProperties.Name="Next candidate page"
                                            DockPanel.Dock="Right"
                                            FontSize="20"
                                            IsEnabled="{Binding CanGoToNextCandidatePage, RelativeSource={RelativeSource TemplatedParent}}">
                                            <controls:Button.Style>
                                                <Style BasedOn="{StaticResource SoftKeyboardToolButtonStyle}" TargetType="{x:Type controls:Button}">
                                                    <Setter Property="Content" Value="{m:FluentIconSource ChevronRight24}" />
                                                    <Style.Triggers>
                                                        <Trigger Property="FlowDirection" Value="RightToLeft">
                                                            <Setter Property="Content" Value="{m:FluentIconSource ChevronLeft24}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:Button.Style>
                                        </controls:Button>

                                        <!--  上一页按钮 停靠在下一页按钮左边  -->
                                        <controls:Button
                                            x:Name="PART_PreviousCandidatePageButton"
                                            Margin="4,0"
                                            AutomationProperties.Name="Previous candidate page"
                                            DockPanel.Dock="Right"
                                            FontSize="20"
                                            IsEnabled="{Binding CanGoToPreviousCandidatePage, RelativeSource={RelativeSource TemplatedParent}}">
                                            <controls:Button.Style>
                                                <Style BasedOn="{StaticResource SoftKeyboardToolButtonStyle}" TargetType="{x:Type controls:Button}">
                                                    <Setter Property="Content" Value="{m:FluentIconSource ChevronLeft24}" />
                                                    <Style.Triggers>
                                                        <Trigger Property="FlowDirection" Value="RightToLeft">
                                                            <Setter Property="Content" Value="{m:FluentIconSource ChevronRight24}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:Button.Style>
                                        </controls:Button>

                                        <!--  候选词列表 填充剩余空间  -->
                                        <controls:SoftKeyboardCandidateList
                                            x:Name="PART_Candidates"
                                            Candidates="{Binding Candidates, RelativeSource={RelativeSource TemplatedParent}}"
                                            SelectedCandidateIndex="{Binding SelectedCandidateIndex, RelativeSource={RelativeSource TemplatedParent}}" />
                                    </DockPanel>
                                </Grid>
                            </DockPanel>

                            <ItemsControl
                                x:Name="PART_Keys"
                                Grid.Row="1"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                ItemsSource="{Binding CurrentLayout.Keys, RelativeSource={RelativeSource TemplatedParent}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <!--  todo: 应该把间距拿掉，让键帽自己把空白留出来且能交互，防止触摸到空白处没有反应  -->
                                        <controls:SoftKeyboardPanel
                                            ColumnCount="{Binding CurrentLayout.ColumnCount, RelativeSource={RelativeSource AncestorType={x:Type controls:SoftKeyboard}}}"
                                            ColumnSpacing="{Binding ColumnSpacing, RelativeSource={RelativeSource AncestorType={x:Type controls:SoftKeyboard}}}"
                                            RowSpacing="{Binding RowSpacing, RelativeSource={RelativeSource AncestorType={x:Type controls:SoftKeyboard}}}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="{x:Type ContentPresenter}">
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="VerticalAlignment" Value="Stretch" />
                                        <Setter Property="controls:SoftKeyboardPanel.Row" Value="{Binding Row}" />
                                        <Setter Property="controls:SoftKeyboardPanel.Column" Value="{Binding Column}" />
                                        <Setter Property="controls:SoftKeyboardPanel.ColumnSpan" Value="{Binding ColumnSpan}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type controls:SoftKeyboardKey}">
                                        <controls:SoftKeyboardKeyControl
                                            Key="{Binding}"
                                            AutomationProperties.Name="{Binding AutomationName}"
                                            Content="{Binding Content}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--  Closing remains immediate so the IsOpen=false measurement contract stays exactly zero.  -->
                        <Trigger Property="IsOpen" Value="False">
                            <Setter TargetName="KeyboardRoot" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsOpen" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="KeyboardRoot"
                                            Storyboard.TargetProperty="Opacity"
                                            From="0"
                                            To="1"
                                            Duration="0:0:0.12" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="KeyboardRoot"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                            From="10"
                                            To="0"
                                            Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                        <!--
                            Candidate creation and composition updates are transient. Keep the bar's
                            fixed header slot for every input state so every keystroke
                            does not move the key rows. Only candidate-specific navigation disappears
                            while the reserved surface is empty.
                        -->

                        <Trigger Property="HasCandidates" Value="False">
                            <Setter TargetName="CandidateBar" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_PreviousCandidatePageButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_NextCandidatePageButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="KeyboardRoot" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource {x:Static t:StyleKeys.UiSoftKeyboardStyle}}" TargetType="{x:Type controls:SoftKeyboard}" />
</ResourceDictionary>
