<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup"
    xmlns:t="clr-namespace:Wpf.Zen.Ui.Theming">

    <Style x:Key="{x:Static t:StyleKeys.UiSoftKeyboardKeyControlStyle}" TargetType="{x:Type controls:SoftKeyboardKeyControl}">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{m:DynamicBrush ControlFillSecondary}" />
        <Setter Property="Foreground" Value="{m:DynamicBrush TextFillPrimary}" />
        <Setter Property="BorderBrush" Value="{m:DynamicBrush ControlStrokeDefault}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="controls:IconPresenter.IconSize" Value="20" />
        <Setter Property="Content" Value="{Binding Key.Content, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SoftKeyboardKeyControl}">
                    <Grid>
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
                        </Border>
                        <!--
                            The key owns this optional surface. It lives outside measurement and
                            reports selections through the key's semantic request event.
                        -->
                        <Popup
                            x:Name="PART_AlternatePopup"
                            HorizontalAlignment="Center"
                            AllowsTransparency="True"
                            Focusable="False"
                            Placement="Top"
                            StaysOpen="True">
                            <Border
                                Margin="2"
                                Padding="4"
                                Background="{m:DynamicBrush SolidBackgroundFillTertiary}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <ItemsControl ItemsSource="{Binding Key.Alternates, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel MaxWidth="440" HorizontalAlignment="Center" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:Button
                                                MinWidth="44"
                                                MinHeight="44"
                                                AutomationProperties.Name="{Binding}"
                                                Content="{Binding}"
                                                Focusable="False"
                                                IsTabStop="False" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{m:DynamicBrush ControlFillPrimary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{m:DynamicBrush ControlFillTertiary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource {x:Static t:StyleKeys.UiSoftKeyboardKeyControlStyle}}" TargetType="{x:Type controls:SoftKeyboardKeyControl}" />
</ResourceDictionary>

