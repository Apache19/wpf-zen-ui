<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup"
    xmlns:t="clr-namespace:Wpf.Zen.Ui.Theming">

    <Style x:Key="UiAutoSuggestBoxItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Border.CornerRadius" Value="4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="6,10" />
        <Setter Property="FocusVisualStyle" Value="{m:DynamicStyle DefaultControlFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border
                        x:Name="ContentBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding Border.CornerRadius}">
                        <Grid>
                            <ContentPresenter Margin="12,0,0,0" />
                            <Rectangle
                                x:Name="ActiveRectangle"
                                Width="3"
                                Height="18"
                                Margin="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Fill="{m:DynamicBrush AccentSelection}"
                                RadiusX="2"
                                RadiusY="2"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ContentBorder" Property="Background" Value="{m:DynamicBrush SubtleFillSecondary}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ContentBorder" Property="Background" Value="{m:DynamicBrush SubtleFillSecondary}" />
                            <Setter TargetName="ActiveRectangle" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static t:StyleKeys.UiAutoSuggestBoxStyle}" TargetType="{x:Type controls:AutoSuggestBox}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="MaxSuggestionListHeight" Value="247" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource UiAutoSuggestBoxItemStyle}" />
        <Setter Property="Validation.ErrorTemplate" Value="{m:DynamicTemplate DefaultValidation}" />
        <Setter Property="controls:IconAssist.Icon" Value="{m:FluentIconSource Search24}" />
        <Setter Property="controls:IconAssist.IconMargin" Value="0,0,10,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:AutoSuggestBox}">
                    <Grid>
                        <!--  直接使用 TextBox 默认外观  -->
                        <controls:TextBox
                            x:Name="PART_TextBox"
                            Grid.Row="0"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            ClearButtonEnabled="{TemplateBinding ClearButtonEnabled}"
                            controls:IconAssist.Icon="{TemplateBinding controls:IconAssist.Icon}"
                            controls:IconAssist.IconMargin="{TemplateBinding controls:IconAssist.IconMargin}"
                            IconPlacement="Right"
                            IsTabStop="{TemplateBinding IsTabStop}"
                            PlaceholderText="{TemplateBinding PlaceholderText}"
                            TabIndex="{TemplateBinding TabIndex}"
                            Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Popup
                            x:Name="SuggestionPopup"
                            MinWidth="{TemplateBinding ActualWidth}"
                            MinHeight="{TemplateBinding ActualHeight}"
                            controls:PopupSlideAnimator.IsEnabled="True"
                            controls:PopupPlacement.IsEnabled="True"
                            controls:PopupShadow.IsEnabled="True"
                            AllowsTransparency="True"
                            Focusable="False"
                            IsOpen="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsSuggestionListOpen, Mode=TwoWay}"
                            PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                            PopupAnimation="Slide"
                            StaysOpen="False">
                            <Border
                                x:Name="SuggestionsBorder"
                                Background="{m:DynamicBrush AcrylicBackgroundFillDefault}"
                                BorderBrush="{m:DynamicBrush SurfaceStrokeFlyout}"
                                BorderThickness="1"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                                <ListView
                                    x:Name="PART_SuggestionsList"
                                    MaxHeight="{TemplateBinding MaxSuggestionListHeight}"
                                    Padding="4"
                                    DisplayMemberPath="{TemplateBinding DisplayMemberPath}"
                                    ItemContainerStyle="{TemplateBinding ItemContainerStyle}"
                                    ItemStringFormat="{TemplateBinding ItemStringFormat}"
                                    ItemTemplate="{TemplateBinding ItemTemplate}"
                                    ItemTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                    ItemsSource="{TemplateBinding ItemsSource}"
                                    KeyboardNavigation.DirectionalNavigation="Cycle"
                                    OverridesDefaultStyle="True"
                                    SelectionMode="Single">
                                    <ListView.Template>
                                        <ControlTemplate TargetType="{x:Type ListView}">
                                            <controls:PassiveScrollViewer
                                                Padding="{TemplateBinding Padding}"
                                                CanContentScroll="True"
                                                Focusable="false"
                                                ScrollSpillMode="Disabled">
                                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                            </controls:PassiveScrollViewer>
                                        </ControlTemplate>
                                    </ListView.Template>
                                    <ListView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel
                                                IsItemsHost="True"
                                                IsVirtualizing="True"
                                                VirtualizationMode="Recycling" />
                                        </ItemsPanelTemplate>
                                    </ListView.ItemsPanel>
                                </ListView>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--
                            Popup.Placement only describes the requested side; WPF can flip the HWND to the opposite
                            side after measuring available monitor space. These triggers consume the resolved side so
                            the editor and suggestions surface share one silhouette in either vertical direction.
                        -->
                        <Trigger SourceName="SuggestionPopup" Property="controls:PopupPlacement.ActualPlacement" Value="Bottom">
                            <Setter TargetName="PART_TextBox" Property="CornerRadius" Value="4,4,0,0" />
                            <Setter TargetName="SuggestionsBorder" Property="BorderThickness" Value="1,0,1,1" />
                            <Setter TargetName="SuggestionsBorder" Property="CornerRadius" Value="0,0,8,8" />
                        </Trigger>
                        <Trigger SourceName="SuggestionPopup" Property="controls:PopupPlacement.ActualPlacement" Value="Top">
                            <Setter TargetName="PART_TextBox" Property="CornerRadius" Value="0,0,4,4" />
                            <Setter TargetName="SuggestionsBorder" Property="BorderThickness" Value="1,1,1,0" />
                            <Setter TargetName="SuggestionsBorder" Property="CornerRadius" Value="8,8,0,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource {x:Static t:StyleKeys.UiAutoSuggestBoxStyle}}" TargetType="{x:Type controls:AutoSuggestBox}" />

</ResourceDictionary>
