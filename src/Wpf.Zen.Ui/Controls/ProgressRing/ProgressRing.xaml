<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup">

    <Style TargetType="{x:Type controls:ProgressRing}">
        <Setter Property="Height" Value="60" />
        <Setter Property="Width" Value="60" />
        <Setter Property="Foreground" Value="{m:DynamicBrush AccentFillSecondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <!--
                    ProgressRing owns its geometry and renders beneath the template visual tree.
                    The empty root preserves the normal Control template contract without exposing
                    presentation details as parts that custom templates would need to reproduce.
                -->
                <ControlTemplate TargetType="{x:Type controls:ProgressRing}">
                    <Grid Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
