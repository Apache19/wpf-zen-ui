<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls">

    <!--
        导航视图 Bottom 模式布局：
        Pane 横向置于视图底部，外观和交互模式类似菜单栏。
        没有后退/Pane开闭切换按钮，横向容纳不下时会显示省略号按钮/菜单项。
        
        此模式尚未完成，行为尚不确定。
    -->

    <ControlTemplate x:Key="BottomNavigationViewTemplate" TargetType="{x:Type controls:NavigationView}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Header  -->
                <ContentPresenter
                    Grid.Row="0"
                    Margin="0"
                    Content="{TemplateBinding Header}"
                    Visibility="{TemplateBinding HeaderVisibility}" />

                <!--  Page content  -->
                <!--
                    NavigationView owns the frame so changing PaneDisplayMode does not destroy
                    the current page together with this template's generated visual tree.
                -->
                <ContentPresenter x:Name="PART_NavigationFrameHost" Grid.Row="1" />

                <!--  Overlay  -->
                <ContentPresenter
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Margin="0"
                    Content="{TemplateBinding ContentOverlay}" />
            </Grid>
            <Grid x:Name="PaneGrid" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  NavigationView dynamically supplies the commands that remain in the pane.  -->
                <ContentPresenter
                    x:Name="PART_PaneButtonsPresenter"
                    Grid.Column="0"
                    VerticalAlignment="Center" />

                <!--  Pane header  -->
                <ContentPresenter
                    Grid.Column="1"
                    Margin="0"
                    Content="{TemplateBinding PaneHeader}" />

                <controls:NavigationViewList
                    x:Name="PART_MenuItemsList"
                    Grid.Column="2"
                    AutomationProperties.AutomationId="NavigationItems"
                    Focusable="False"
                    ItemContainerStyle="{TemplateBinding MenuItemContainerStyle}"
                    ItemContainerStyleSelector="{TemplateBinding MenuItemContainerStyleSelector}"
                    ItemTemplate="{TemplateBinding MenuItemTemplate}"
                    ItemTemplateSelector="{TemplateBinding MenuItemTemplateSelector}"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <controls:NavigationViewList.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel
                                Margin="0"
                                IsItemsHost="True"
                                Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </controls:NavigationViewList.ItemsPanel>
                </controls:NavigationViewList>

                <!--  Auto Suggest Box  -->
                <ContentPresenter Grid.Column="3" Content="{TemplateBinding AutoSuggestBox}" />

                <!--  Pane footer  -->
                <ContentPresenter
                    Grid.Column="4"
                    Margin="0"
                    Content="{TemplateBinding PaneFooter}" />

                <controls:NavigationViewList
                    x:Name="PART_FooterMenuItemsList"
                    Grid.Column="5"
                    AutomationProperties.AutomationId="NavigationFooterItems"
                    Focusable="False"
                    ItemContainerStyle="{TemplateBinding FooterMenuItemContainerStyle}"
                    ItemContainerStyleSelector="{TemplateBinding FooterMenuItemContainerStyleSelector}"
                    ItemTemplate="{TemplateBinding FooterMenuItemTemplate}"
                    ItemTemplateSelector="{TemplateBinding FooterMenuItemTemplateSelector}"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <controls:NavigationViewList.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel
                                Margin="0"
                                IsItemsHost="True"
                                Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </controls:NavigationViewList.ItemsPanel>
                </controls:NavigationViewList>
            </Grid>
        </Grid>
    </ControlTemplate>

</ResourceDictionary>
