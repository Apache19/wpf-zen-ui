<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:converters="clr-namespace:Wpf.Zen.Ui.Converters"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Wpf.Zen.Ui;component/Controls/NavigationView/NavigationViewFrameHost.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        导航视图 Left 模式布局：
        顶部有 按钮区、PaneHeader、自动建议矿和配套的搜索按钮（图标与自动建议框一样）、分割线、顶部菜单列表；
        底部有 分割线、底部菜单列表、PaneFooter。
        Pane 有开/闭两种模式，目标宽度分别对应 LeftPaneOpenWidth/LeftPaneCompactWidth，有开闭动画。
        PaneGrid 的基础宽度绑定 LeftPaneWidth；该只读值由控件在离开 Left 模式前保存，切回模板时直接恢复。
        此模式的导航菜单项一般使用小图标，文本置于图标右边，Pane 闭合时刚好能把文本遮住，剩下小图标可见。
    -->

    <ControlTemplate x:Key="LeftNavigationViewTemplate" TargetType="{x:Type controls:NavigationView}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--
                VisualState objects are not nodes in the template's logical or visual tree, and the
                CLR-only VisualStateGroup.States collection breaks their inheritance-context chain.
                A Timeline therefore cannot climb from itself to the templated NavigationView.
                PaneGrid is already a named template element and gives the Timeline an explicit
                source. Its public TemplatedParent property leads to NavigationView, allowing the
                retained origin and both endpoints to stay on the control itself.
            -->
            <Grid
                x:Name="PaneGrid"
                Grid.Column="0"
                Width="{TemplateBinding LeftPaneWidth}"
                Margin="4,0">
                <Border x:Name="PaneBorder">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Pane Header (Fixed)  -->
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--
                                NavigationView owns and routes its command buttons because a command
                                can move to TitleBar.LeftContent. The template only supplies a pane slot.
                            -->
                            <ContentPresenter
                                x:Name="PART_PaneButtonsPresenter"
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Margin="0,0,0,5" />

                            <!--
                                Pane Header
                                内容自己负责布局，布局时注意搜索框已经有了 6 的上边距
                            -->
                            <ContentPresenter Grid.Row="2" Content="{TemplateBinding PaneHeader}" />

                            <!--
                                搜索框和按钮包装器，以便让两个控件垂直对齐，保证搜索图标在一条水平线上
                                没有搜索框时，隐藏该包装器，释放其空间
                            -->
                            <Grid
                                x:Name="SearchGrid"
                                Grid.Row="3"
                                Margin="0,0,0,6">
                                <ContentPresenter
                                    x:Name="AutoSuggestBoxContentPresenter"
                                    Margin="13,0"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding AutoSuggestBox}" />
                                <controls:NavigationViewButton
                                    x:Name="PART_AutoSuggestBoxSymbolButton"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="NavigationAutoSuggestBoxButton"
                                    Icon="{m:FluentIconSource Search24}"
                                    Visibility="Hidden" />
                            </Grid>
                        </Grid>

                        <!--  Separator/Shadow for Top  -->
                        <Border
                            x:Name="PART_TopSeparator"
                            Grid.Row="1"
                            Height="1"
                            Margin="0,4,0,4"
                            Background="{m:DynamicBrush LeftNavigationViewSeparator}" />

                        <!--  Scrollable Menu Items  -->
                        <controls:NavigationViewList
                            x:Name="PART_MenuItemsList"
                            Grid.Row="2"
                            Margin="0,0,-4,0"
                            Padding="0,0,4,0"
                            AutomationProperties.AutomationId="NavigationItems"
                            Focusable="False"
                            IsDynamicScrollViewerEnabled="True"
                            ItemContainerStyle="{TemplateBinding MenuItemContainerStyle}"
                            ItemContainerStyleSelector="{TemplateBinding MenuItemContainerStyleSelector}"
                            ItemTemplate="{TemplateBinding MenuItemTemplate}"
                            ItemTemplateSelector="{TemplateBinding MenuItemTemplateSelector}"
                            KeyboardNavigation.DirectionalNavigation="Contained"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <controls:NavigationViewList.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Margin="0" IsItemsHost="True" />
                                </ItemsPanelTemplate>
                            </controls:NavigationViewList.ItemsPanel>
                        </controls:NavigationViewList>

                        <!--  Separator/Shadow for Footer  -->
                        <Border
                            x:Name="PART_FooterSeparator"
                            Grid.Row="3"
                            Height="1"
                            Margin="0,4,0,4"
                            Background="{m:DynamicBrush LeftNavigationViewSeparator}" />

                        <!--  Footer (Fixed)  -->
                        <Grid Grid.Row="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <controls:NavigationViewList
                                x:Name="PART_FooterMenuItemsList"
                                Grid.Row="0"
                                Margin="0,0,0,4"
                                AutomationProperties.AutomationId="NavigationFooterItems"
                                Focusable="False"
                                ItemContainerStyle="{TemplateBinding FooterMenuItemContainerStyle}"
                                ItemContainerStyleSelector="{TemplateBinding FooterMenuItemContainerStyleSelector}"
                                ItemTemplate="{TemplateBinding FooterMenuItemTemplate}"
                                ItemTemplateSelector="{TemplateBinding FooterMenuItemTemplateSelector}"
                                KeyboardNavigation.DirectionalNavigation="Contained"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <controls:NavigationViewList.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Margin="0" IsItemsHost="True" />
                                    </ItemsPanelTemplate>
                                </controls:NavigationViewList.ItemsPanel>
                            </controls:NavigationViewList>

                            <ContentPresenter
                                Grid.Row="1"
                                Margin="0"
                                Content="{TemplateBinding PaneFooter}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border
                Grid.Column="1"
                Margin="{TemplateBinding FrameMargin}"
                Background="{m:DynamicBrush LayerFillDefault}"
                BorderBrush="{m:DynamicBrush CardStrokeDefault}"
                BorderThickness="1,1,0,0"
                CornerRadius="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Header (e.g., BreadcrumbBar)  -->
                    <ContentPresenter
                        x:Name="HeaderPresenter"
                        Grid.Row="0"
                        Margin="{Binding Padding, RelativeSource={RelativeSource TemplatedParent}, Converter={converters:ThicknessTransformConverter CopySides='Left,Top,Right'}}"
                        Content="{TemplateBinding Header}"
                        Visibility="{TemplateBinding HeaderVisibility}" />

                    <!--  Page content  -->
                    <!--
                        NavigationView owns the frame so changing PaneDisplayMode does not destroy
                        the current page together with this template's generated visual tree.
                    -->
                    <ContentControl
                        x:Name="PART_NavigationFrameHost"
                        Grid.Row="1"
                        Padding="{Binding Padding, RelativeSource={RelativeSource TemplatedParent}, Converter={converters:ThicknessTransformConverter CopySides='Left,Right,Bottom'}}"
                        Style="{StaticResource NavigationFrameHostStyle}" />

                </Grid>
            </Border>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup Name="PaneStates">
                    <!--
                        NavigationView enters this empty state before a PaneDisplayMode trigger
                        replaces the template. It removes template-owned width and opacity clocks
                        before their targets and TemplateBinding values are detached.
                    -->
                    <VisualState Name="PaneReset" />
                    <VisualState Name="PaneOpen">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="AutoSuggestBoxContentPresenter" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation
                                AccelerationRatio="0.4"
                                Storyboard.TargetName="PaneGrid"
                                Storyboard.TargetProperty="Width"
                                From="{Binding TemplatedParent.LeftPaneWidth, Source={x:Reference PaneGrid}}"
                                To="{Binding TemplatedParent.LeftPaneOpenWidth, Source={x:Reference PaneGrid}}"
                                Duration="0:0:.16" />
                            <DoubleAnimation
                                AccelerationRatio="0.4"
                                Storyboard.TargetName="AutoSuggestBoxContentPresenter"
                                Storyboard.TargetProperty="Opacity"
                                From="0"
                                To="1"
                                Duration="0:0:.16" />
                        </Storyboard>
                    </VisualState>
                    <VisualState Name="PaneCompact">
                        <Storyboard>
                            <DoubleAnimation
                                AccelerationRatio="0.4"
                                Storyboard.TargetName="AutoSuggestBoxContentPresenter"
                                Storyboard.TargetProperty="Opacity"
                                From="1"
                                To="0"
                                Duration="0:0:.16" />
                            <DoubleAnimation
                                AccelerationRatio="0.4"
                                Storyboard.TargetName="PART_AutoSuggestBoxSymbolButton"
                                Storyboard.TargetProperty="Opacity"
                                From="0"
                                To="1"
                                Duration="0:0:.16" />
                            <DoubleAnimation
                                AccelerationRatio="0.4"
                                Storyboard.TargetName="PaneGrid"
                                Storyboard.TargetProperty="Width"
                                From="{Binding TemplatedParent.LeftPaneWidth, Source={x:Reference PaneGrid}}"
                                To="{Binding TemplatedParent.LeftPaneCompactWidth, Source={x:Reference PaneGrid}}"
                                Duration="0:0:.16" />
                            <ObjectAnimationUsingKeyFrames
                                BeginTime="0:0:0.16"
                                Storyboard.TargetName="AutoSuggestBoxContentPresenter"
                                Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Hidden}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>

        <ControlTemplate.Triggers>
            <!--  Pane layout states  -->
            <Trigger Property="IsPaneOpen" Value="False">
                <Setter TargetName="PART_AutoSuggestBoxSymbolButton" Property="Visibility" Value="Visible" />
                <Setter TargetName="PART_AutoSuggestBoxSymbolButton" Property="Opacity" Value="1" />
                <Setter TargetName="AutoSuggestBoxContentPresenter" Property="IsEnabled" Value="False" />
                <Setter TargetName="AutoSuggestBoxContentPresenter" Property="Opacity" Value="0" />
            </Trigger>

            <!--  Optional content visibility  -->

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsBackButtonVisible" Value="Collapsed" />
                    <Condition Property="IsPaneToggleVisible" Value="False" />
                    <Condition Property="AutoSuggestBox" Value="{x:Null}" />
                    <Condition Property="PaneHeader" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_TopSeparator" Property="Visibility" Value="Collapsed" />
            </MultiTrigger>

            <!--
                Auto collapses the back command while the journal cannot go back. Mirror that
                effective state here so an otherwise empty command presenter does not retain its
                bottom margin or keep the optional separator alive.
            -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsBackButtonVisible" Value="Auto" />
                    <Condition Property="IsBackEnabled" Value="False" />
                    <Condition Property="IsPaneToggleVisible" Value="False" />
                    <Condition Property="AutoSuggestBox" Value="{x:Null}" />
                    <Condition Property="PaneHeader" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_TopSeparator" Property="Visibility" Value="Collapsed" />
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsBackButtonVisible" Value="Collapsed" />
                    <Condition Property="IsPaneToggleVisible" Value="False" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_PaneButtonsPresenter" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PART_PaneButtonsPresenter" Property="Margin" Value="0" />
            </MultiTrigger>

            <Trigger Property="HeaderVisibility" Value="Collapsed">
                <Setter TargetName="PART_NavigationFrameHost" Property="Padding" Value="{Binding Padding, RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsBackButtonVisible" Value="Auto" />
                    <Condition Property="IsBackEnabled" Value="False" />
                    <Condition Property="IsPaneToggleVisible" Value="False" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_PaneButtonsPresenter" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PART_PaneButtonsPresenter" Property="Margin" Value="0" />
            </MultiTrigger>

            <Trigger Property="AutoSuggestBox" Value="{x:Null}">
                <Setter TargetName="SearchGrid" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsTopSeparatorVisible" Value="False">
                <Setter TargetName="PART_TopSeparator" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsFooterSeparatorVisible" Value="False">
                <Setter TargetName="PART_FooterSeparator" Property="Visibility" Value="Collapsed" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

</ResourceDictionary>
