<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Wpf.Zen.Ui;component/Controls/NavigationView/NavigationViewItem_Submenu.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Shared header rendering for both open and compact Left presentations. Input is owned by the
        Button itself; the NavigationViewItem contains this bounded surface and its ItemsPresenter as
        siblings, so focusing or pressing the row can never include descendants.
    -->
    <ControlTemplate x:Key="NavigationViewItemLeftHeaderButtonTemplate" TargetType="{x:Type Button}">
        <Border
            x:Name="HeaderSurface"
            MinWidth="40"
            MinHeight="40"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{Binding (Border.CornerRadius), RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationViewItem}}}">
            <Grid Margin="{Binding Indentation, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationViewItem}}}" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="IconColumn" Width="40" SharedSizeGroup="Icon" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="ExpandColumn" Width="0" />
                </Grid.ColumnDefinitions>

                <ContentPresenter
                    x:Name="IconPresenter"
                    Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="{Binding Icon, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationViewItem}}}"
                    TextElement.FontSize="16"
                    TextElement.Foreground="{m:DynamicBrush TextFillPrimary}" />
                <Rectangle
                    x:Name="ActiveIndicator"
                    Grid.Column="0"
                    Width="3"
                    Height="16"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Fill="{m:DynamicBrush AccentSelection}"
                    Opacity="0"
                    RadiusX="2"
                    RadiusY="2" />
                <ContentPresenter
                    x:Name="HeaderPresenter"
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                    RecognizesAccessKey="True" />
                <ContentPresenter
                    x:Name="InfoBadgePresenter"
                    Grid.Column="2"
                    Margin="8,0,4,0"
                    VerticalAlignment="Center"
                    Content="{Binding InfoBadge, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationViewItem}}}" />
                <!--
                    Only the expanded Left pane has enough room and a persistent inline state to
                    benefit from a Chevron. Compact presentations intentionally keep the icon-only
                    surface used before the control-model refactor.
                -->
                <controls:SymbolIcon
                    x:Name="ChevronIcon"
                    Grid.Column="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{m:DynamicBrush TextFillPrimary}"
                    IsHitTestVisible="False"
                    RenderTransformOrigin="0.5,0.5"
                    Symbol="ChevronDown24"
                    Visibility="Collapsed">
                    <controls:SymbolIcon.RenderTransform>
                        <RotateTransform Angle="0" />
                    </controls:SymbolIcon.RenderTransform>
                </controls:SymbolIcon>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HeaderSurface" Property="Background" Value="{m:DynamicBrush SubtleFillSecondary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="HeaderSurface" Property="Background" Value="{m:DynamicBrush SubtleFillTertiary}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationViewItem}}}" Value="True">
                <Setter TargetName="ActiveIndicator" Property="Opacity" Value="1" />
                <Setter TargetName="HeaderSurface" Property="Background" Value="{m:DynamicBrush SubtleFillSecondary}" />
            </DataTrigger>
            <!--
                Once an inline branch is collapsed, its active descendant no longer has a visible
                row of its own. Surface that semantic branch state on the parent, but remove the
                duplicate indicator as soon as expansion makes the active descendant visible again.
            -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsBranchActive, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationViewItem}}}" Value="True" />
                    <Condition Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationViewItem}}}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="ActiveIndicator" Property="Opacity" Value="1" />
                <Setter TargetName="HeaderSurface" Property="Background" Value="{m:DynamicBrush SubtleFillSecondary}" />
            </MultiDataTrigger>
            <!--
                IsExpanded is intentionally preserved when the Left pane closes. In that detached
                presentation the descendants are hidden regardless of the stale inline expansion,
                so pane state takes precedence when deciding whether the branch indicator is needed.
            -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsBranchActive, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationViewItem}}}" Value="True" />
                    <Condition Binding="{Binding PaneDisplayMode, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationViewItem}}}" Value="{x:Static controls:NavigationViewPaneDisplayMode.Left}" />
                    <Condition Binding="{Binding IsPaneOpen, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationViewItem}}}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="ActiveIndicator" Property="Opacity" Value="1" />
                <Setter TargetName="HeaderSurface" Property="Background" Value="{m:DynamicBrush SubtleFillSecondary}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsBranchActive, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationViewItem}}}" Value="True" />
                    <Condition Binding="{Binding PaneDisplayMode, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationViewItem}}}" Value="{x:Static controls:NavigationViewPaneDisplayMode.LeftMinimal}" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="ActiveIndicator" Property="Opacity" Value="1" />
                <Setter TargetName="HeaderSurface" Property="Background" Value="{m:DynamicBrush SubtleFillSecondary}" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding IsSubmenuOpen, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationViewItem}}}" Value="True">
                <Setter TargetName="HeaderSurface" Property="Background" Value="{m:DynamicBrush SubtleFillSecondary}" />
            </DataTrigger>

            <DataTrigger Binding="{Binding Icon, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationViewItem}}}" Value="{x:Null}">
                <Setter TargetName="IconColumn" Property="Width" Value="3" />
                <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="HeaderPresenter" Property="Margin" Value="10,0,0,0" />
            </DataTrigger>

            <DataTrigger Binding="{Binding IsSubItem, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationViewItem}}}" Value="True">
                <Setter TargetName="IconColumn" Property="Width" Value="Auto" />
                <Setter TargetName="IconPresenter" Property="Margin" Value="10,0,8,0" />
                <Setter TargetName="IconPresenter" Property="Visibility" Value="Visible" />
                <Setter TargetName="HeaderPresenter" Property="Margin" Value="0,0,0,0" />
            </DataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSubItem, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationViewItem}}}" Value="True" />
                    <Condition Binding="{Binding Icon, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationViewItem}}}" Value="{x:Null}" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="IconPresenter" Property="Margin" Value="10,0,0,0" />
            </MultiDataTrigger>

            <DataTrigger Binding="{Binding InfoBadge, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationViewItem}}}" Value="{x:Null}">
                <Setter TargetName="InfoBadgePresenter" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding PaneDisplayMode, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationViewItem}}}" Value="{x:Static controls:NavigationViewPaneDisplayMode.Left}" />
                    <Condition Binding="{Binding IsPaneOpen, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationViewItem}}}" Value="True" />
                    <Condition Binding="{Binding HasItems, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationViewItem}}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="ExpandColumn" Property="Width" Value="36" />
                <Setter TargetName="ChevronIcon" Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
            <!--
                IsExpanded is persistent tree state and may remain true while the pane temporarily
                uses a ContextMenu projection. Restrict the animation to the inline Left presentation so a
                stale inline state never rotates an icon in a compact mode.
            -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding PaneDisplayMode, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationViewItem}}}" Value="{x:Static controls:NavigationViewPaneDisplayMode.Left}" />
                    <Condition Binding="{Binding IsPaneOpen, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationViewItem}}}" Value="True" />
                    <Condition Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType={x:Type controls:NavigationViewItem}}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="ChevronIcon"
                                Storyboard.TargetProperty="(Control.RenderTransform).(RotateTransform.Angle)"
                                To="-180"
                                Duration="00:00:00.167" />
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="ChevronIcon"
                                Storyboard.TargetProperty="(Control.RenderTransform).(RotateTransform.Angle)"
                                To="0"
                                Duration="00:00:00.167" />
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.ExitActions>
            </MultiDataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  The only template that presents descendants inline.  -->
    <ControlTemplate x:Key="NavigationViewItemLeftTemplate" TargetType="{x:Type controls:NavigationViewItem}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button
                x:Name="PART_HeaderButton"
                Grid.Row="0"
                HorizontalContentAlignment="Stretch"
                Background="{m:DynamicBrush SubtleFillTransparent}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Content="{TemplateBinding Header}"
                ContentTemplate="{TemplateBinding HeaderTemplate}"
                ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                OverridesDefaultStyle="True"
                Style="{x:Null}"
                Template="{StaticResource NavigationViewItemLeftHeaderButtonTemplate}" />
            <ItemsPresenter
                x:Name="PART_ItemsPresenter"
                Grid.Row="1"
                Grid.IsSharedSizeScope="True"
                KeyboardNavigation.DirectionalNavigation="Contained"
                Opacity="0"
                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                Visibility="Collapsed" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="PART_ItemsPresenter" Property="Visibility" Value="Visible" />
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="PART_ItemsPresenter"
                                Storyboard.TargetProperty="Opacity"
                                From="0"
                                To="1"
                                Duration="00:00:00.167" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="PART_ItemsPresenter"
                                Storyboard.TargetProperty="Opacity"
                                From="1"
                                To="0"
                                Duration="00:00:00.167" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--
        Compact Left replaces the inline ItemsPresenter with a template-owned ContextMenu. The
        control prepares source containers through ItemContainerGenerator and projects them into
        independent MenuItems, so the inline NavigationViewItem visuals are never reparented.
    -->
    <ControlTemplate x:Key="NavigationViewItemLeftCompactTemplate" TargetType="{x:Type controls:NavigationViewItem}">
        <Grid>
            <Button
                x:Name="PART_HeaderButton"
                HorizontalContentAlignment="Stretch"
                Background="{m:DynamicBrush SubtleFillTransparent}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Content="{TemplateBinding Header}"
                ContentTemplate="{TemplateBinding HeaderTemplate}"
                ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                OverridesDefaultStyle="True"
                Style="{x:Null}"
                Template="{StaticResource NavigationViewItemLeftHeaderButtonTemplate}">
                <Button.ContextMenu>
                    <!--  See NavigationViewItemTopTemplate for the native projection contract.  -->
                    <ContextMenu
                        x:Name="PART_SubMenuContextMenu"
                        HorizontalOffset="8"
                        Placement="Right"
                        Style="{Binding SubmenuContextMenuStyle, RelativeSource={RelativeSource TemplatedParent}}" />
                </Button.ContextMenu>
            </Button>
        </Grid>
    </ControlTemplate>

</ResourceDictionary>
