<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Wpf.Zen.Ui;component/Resources/DefaultEditorContextMenu.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <ControlTemplate x:Key="DefaultRichTextBoxTemplate" TargetType="{x:Type RichTextBox}">
        <Border
            x:Name="MainBorder"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding Border.CornerRadius}"
            SnapsToDevicePixels="True">
            <controls:UiScrollViewer
                x:Name="PART_ContentHost"
                controls:ScrollViewerAssist.OverlayMode="Traditional"
                Focusable="false"
                HorizontalScrollBarVisibility="Hidden"
                ScrollSpillMode="Disabled"
                VerticalScrollBarVisibility="Hidden" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="MainBorder" Property="Background" Value="{m:DynamicBrush ControlFillPrimary}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="MainBorder" Property="Background" Value="{m:DynamicBrush ControlFillInputActive}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="MainBorder" Property="Background" Value="{m:DynamicBrush ControlFillDisabled}" />
                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{m:DynamicBrush ControlStrokeDefault}" />
                <Setter Property="Foreground" Value="{m:DynamicBrush TextFillDisabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="RichTextBoxBaseStyle" TargetType="{x:Type RichTextBox}">
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="AllowDrop" Value="true" />
        <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="CaretBrush" Value="{Binding Foreground, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Background" Value="{m:DynamicBrush ControlFillSecondary}" />
        <Setter Property="BorderBrush" Value="{m:DynamicBrush ControlStrokeSecondary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="{m:DynamicValue TextControlThemePadding}" />
        <Setter Property="Border.CornerRadius" Value="{m:DynamicValue ControlCornerRadius}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Validation.ErrorTemplate" Value="{m:DynamicTemplate DefaultValidation}" />
        <Setter Property="ContextMenu" Value="{StaticResource DefaultEditorContextMenu}" />
        <Setter Property="Template" Value="{StaticResource DefaultRichTextBoxTemplate}" />
    </Style>

</ResourceDictionary>