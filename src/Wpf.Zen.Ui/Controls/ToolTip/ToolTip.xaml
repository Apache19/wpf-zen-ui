<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup">

    <Style x:Key="UiToolTipStyle" TargetType="{x:Type ToolTip}">
        <Setter Property="MaxWidth" Value="260" />
        <Setter Property="FontSize" Value="{m:DynamicValue ControlContentThemeFontSize}" />
        <Setter Property="Foreground" Value="{m:DynamicBrush TextFillPrimary}" />
        <Setter Property="Background" Value="{m:DynamicBrush AcrylicBackgroundFillDefault}" />
        <Setter Property="BorderBrush" Value="{m:DynamicBrush SurfaceStrokeFlyout}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Popup.PopupAnimation" Value="Slide" />
        <Setter Property="controls:PopupSlideAnimator.IsEnabled" Value="True" />
        <Setter Property="controls:PopupShadow.PopupShadowChrome">
            <Setter.Value>
                <controls:PopupShadowChrome
                    AnimationMode="DynamicContentBounds"
                    BlurRadius="10"
                    Direction="270"
                    Opacity="0.175"
                    ShadowDepth="3"
                    ShadowThickness="15"
                    Color="#202020" />
            </Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border
                        Name="Border"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6"
                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                            <ContentPresenter.Resources>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="TextWrapping" Value="WrapWithOverflow" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource UiToolTipStyle}" TargetType="{x:Type ToolTip}" />

</ResourceDictionary>
