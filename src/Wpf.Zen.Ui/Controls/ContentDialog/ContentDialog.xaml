<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:converters="clr-namespace:Wpf.Zen.Ui.Converters"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup">

    <converters:BoolToVisibilityConverter x:Key="DialogBoolToVisibilityConverter" />

    <Style TargetType="{x:Type controls:ContentDialogFooterContainer}">
        <Setter Property="Background" Value="{m:DynamicBrush SolidBackgroundFillBase}" />
        <Setter Property="BorderBrush" Value="{m:DynamicBrush CardStrokeDefaultSolid}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="24,20" />
    </Style>

    <Style TargetType="{x:Type controls:ContentDialogActionBar}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <controls:AdaptiveUniformGrid
                        ColumnSpacing="{Binding ColumnSpacing, RelativeSource={RelativeSource AncestorType={x:Type controls:ContentDialogActionBar}}}"
                        Columns="{Binding Columns, RelativeSource={RelativeSource AncestorType={x:Type controls:ContentDialogActionBar}}}"
                        IsRowStretchEnabled="{Binding IsRowStretchEnabled, RelativeSource={RelativeSource AncestorType={x:Type controls:ContentDialogActionBar}}}"
                        RowSpacing="{Binding RowSpacing, RelativeSource={RelativeSource AncestorType={x:Type controls:ContentDialogActionBar}}}" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ContentDialogActionBar}">
                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="DefaultContentDialogTemplate" TargetType="{x:Type controls:ContentDialog}">
        <controls:ClippingBorder
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            ClipContent="True"
            CornerRadius="{TemplateBinding CornerRadius}"
            SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="headerBorder" Padding="{TemplateBinding HeaderPadding}">
                    <ContentPresenter
                        controls:TextBlock.FontTypography="Subtitle"
                        ContentSource="Header"
                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <ContentPresenter.Resources>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </ContentPresenter.Resources>
                    </ContentPresenter>
                </Border>

                <controls:UiScrollViewer
                    x:Name="PART_ContentScroll"
                    Grid.Row="1"
                    Padding="{TemplateBinding Padding}"
                    CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                    HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                    ScrollSpillMode="Disabled"
                    VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                    <ContentPresenter
                        x:Name="PART_ContentPresenter"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        Content="{TemplateBinding Content}"
                        ContentStringFormat="{TemplateBinding ContentStringFormat}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}">
                        <ContentPresenter.Resources>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                        </ContentPresenter.Resources>
                    </ContentPresenter>
                </controls:UiScrollViewer>

                <controls:ContentDialogFooterContainer x:Name="footerContainer" Grid.Row="2">
                    <ContentPresenter ContentSource="Footer" />
                </controls:ContentDialogFooterContainer>

                <!--  对话框右上角的关闭按钮  -->
                <controls:Button
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    Margin="8"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Command="{x:Static controls:ContentDialog.DismissCommand}"
                    Visibility="{TemplateBinding IsDismissible, Converter={StaticResource DialogBoolToVisibilityConverter}}">
                    <controls:Button.Style>
                        <Style TargetType="{x:Type controls:Button}">
                            <Setter Property="Appearance" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Content" Value="{m:FluentIconSource Dismiss24}" />
                            <Setter Property="FontSize" Value="16" />
                            <Setter Property="Foreground" Value="{m:DynamicBrush TextFillPrimary}" />
                            <Setter Property="MouseOverForeground" Value="White" />
                            <Setter Property="PressedForeground" Value="White" />
                            <Setter Property="MouseOverBackground" Value="#E81123" />
                            <Setter Property="PressedBackground" Value="#A80014" />
                            <Setter Property="Padding" Value="7,6" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter Property="AutomationProperties.AutomationId" Value="DismissButton" />
                            <Setter Property="AutomationProperties.Name" Value="Close" />
                        </Style>
                    </controls:Button.Style>
                </controls:Button>
            </Grid>
        </controls:ClippingBorder>
        <ControlTemplate.Triggers>
            <Trigger Property="Header" Value="{x:Null}">
                <Setter TargetName="headerBorder" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Footer" Value="{x:Null}">
                <Setter TargetName="footerContainer" Property="Visibility" Value="Collapsed" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="{x:Type controls:ContentDialog}" TargetType="{x:Type controls:ContentDialog}">
        <Setter Property="Background" Value="{m:DynamicBrush SolidBackgroundFillQuarternary}" />
        <Setter Property="CornerRadius" Value="{m:DynamicValue PopupCornerRadius}" />
        <Setter Property="BorderBrush" Value="{m:DynamicBrush SurfaceStrokeDefault}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinWidth" Value="320" />
        <Setter Property="MinHeight" Value="84" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{m:DynamicBrush TextFillPrimary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="KeyboardNavigation.ControlTabNavigation" Value="Cycle" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle" />
        <Setter Property="HeaderPadding" Value="24,20,24,0" />
        <Setter Property="Padding" Value="24,20" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template" Value="{StaticResource DefaultContentDialogTemplate}" />
        <Style.Triggers>
            <!--
                Default maximums keep automatically sized content compact. Each limit applies only
                while that dimension is Auto and its axis is not stretched. Explicit dimensions
                release the corresponding default limit; application-supplied maximums retain
                their normal WPF dependency-property precedence.
            -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Width" Value="Auto" />
                    <Condition Property="HorizontalAlignment" Value="Left" />
                </MultiTrigger.Conditions>
                <Setter Property="MaxWidth" Value="640" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Width" Value="Auto" />
                    <Condition Property="HorizontalAlignment" Value="Center" />
                </MultiTrigger.Conditions>
                <Setter Property="MaxWidth" Value="640" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Width" Value="Auto" />
                    <Condition Property="HorizontalAlignment" Value="Right" />
                </MultiTrigger.Conditions>
                <Setter Property="MaxWidth" Value="640" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Height" Value="Auto" />
                    <Condition Property="VerticalAlignment" Value="Top" />
                </MultiTrigger.Conditions>
                <Setter Property="MaxHeight" Value="850" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Height" Value="Auto" />
                    <Condition Property="VerticalAlignment" Value="Center" />
                </MultiTrigger.Conditions>
                <Setter Property="MaxHeight" Value="850" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Height" Value="Auto" />
                    <Condition Property="VerticalAlignment" Value="Bottom" />
                </MultiTrigger.Conditions>
                <Setter Property="MaxHeight" Value="850" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
