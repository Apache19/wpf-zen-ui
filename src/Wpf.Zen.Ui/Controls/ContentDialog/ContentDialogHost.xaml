<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup">

    <!--
        This presenter is the complete visual-transition boundary. Its named parts expose stable
        rendering surfaces, while timing, interruption, and completion remain owned by the control.
        A replacement template may omit either part to disable only that visual effect.
    -->
    <Style x:Key="DefaultContentDialogTransitionPresenterStyle" TargetType="{x:Type controls:ContentDialogTransitionPresenter}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ContentDialogTransitionPresenter}">
                    <!--  A transparent background keeps the modal surface hit-testable during exit.  -->
                    <Grid Background="Transparent">
                        <Border x:Name="PART_Backdrop" Background="{TemplateBinding Backdrop}" />
                        <!--  Keep host clearance separate from the dialog's own Margin.  -->
                        <controls:TouchKeyboardAvoidanceDecorator Margin="24">
                            <ContentPresenter
                                x:Name="PART_DialogRoot"
                                Content="{TemplateBinding Dialog}"
                                RenderTransformOrigin="0.5,0.5">
                                <!--
                                    Generate the shadow after the dialog's layout clip. Fractional
                                    content sizes can require that clip even when ClipToBounds is
                                    false; an effect on the dialog itself would also be clipped.
                                    This surface keeps the shadow inside the opacity/scale transition.
                                -->
                                <ContentPresenter.Effect>
                                    <DropShadowEffect
                                        BlurRadius="24"
                                        Opacity="0.24"
                                        ShadowDepth="4" />
                                </ContentPresenter.Effect>
                            </ContentPresenter>
                        </controls:TouchKeyboardAvoidanceDecorator>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource DefaultContentDialogTransitionPresenterStyle}" TargetType="{x:Type controls:ContentDialogTransitionPresenter}" />

    <Style x:Key="DefaultContentDialogHostStyle" TargetType="{x:Type controls:ContentDialogHost}">
        <Setter Property="Background" Value="{m:DynamicBrush SmokeFillDefault}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ContentDialogHost}">
                    <Grid>
                        <ContentPresenter x:Name="PART_ContentRoot" ContentSource="Content" />
                        <controls:ContentDialogTransitionPresenter
                            x:Name="PART_DialogPresenter"
                            Backdrop="{TemplateBinding Background}"
                            CloseDuration="{TemplateBinding CloseDuration}"
                            ClosingEasingFunction="{TemplateBinding ClosingEasingFunction}"
                            ClosingScale="{TemplateBinding ClosingScale}"
                            Dialog="{TemplateBinding CurrentDialog}"
                            OpenDuration="{TemplateBinding OpenDuration}"
                            OpeningEasingFunction="{TemplateBinding OpeningEasingFunction}"
                            OpeningScale="{TemplateBinding OpeningScale}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="CurrentDialog" Value="{x:Null}">
                            <Setter TargetName="PART_DialogPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource DefaultContentDialogHostStyle}" TargetType="{x:Type controls:ContentDialogHost}" />
</ResourceDictionary>
