<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup">

    <controls:DateTimePickerLocalization x:Key="DateTimePickerLocalization" />

    <!--  Native buttons retain keyboard, touch and automation behavior in customized templates.  -->
    <Style x:Key="DateTimePickerStepButton" BasedOn="{m:StaticStyle UiButton}" TargetType="{x:Type controls:Button}">
        <Setter Property="Appearance" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="DateTimePickerActionButton" BasedOn="{StaticResource DateTimePickerStepButton}" TargetType="{x:Type controls:Button}">
        <Setter Property="MinWidth" Value="52" />
        <Setter Property="Margin" Value="2,0" />
    </Style>

    <Style TargetType="{x:Type controls:DateTimePickerTimeColumn}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="56" />
        <!--  Display time field digits left to right, consistent with the hour, minute, second reading order.  -->
        <Setter Property="FlowDirection" Value="LeftToRight" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:DateTimePickerTimeColumn}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <controls:TextBox
                            x:Name="PART_Input"
                            Margin="0,0,0,6"
                            HorizontalContentAlignment="Center"
                            AutoSelect="True"
                            AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}"
                            IsClearButtonEnabled="False"
                            MaxLength="2"
                            Style="{m:StaticStyle DefaultUiTextBox}"
                            TextAlignment="Center" />
                        <controls:RepeatButton
                            Grid.Row="1"
                            AutomationProperties.Name="{Binding Language, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DateTimePickerLocalization}, ConverterParameter=PreviousValue}"
                            Command="{x:Static controls:DateTimePickerTimeColumn.StepCommand}"
                            CommandParameter="-1"
                            CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                            FontSize="16"
                            Icon="{m:FluentIconSource CaretUp16, Filled=True}"
                            Style="{StaticResource DateTimePickerStepButton}" />
                        <controls:Button
                            Grid.Row="2"
                            Command="{x:Static controls:DateTimePickerTimeColumn.StepCommand}"
                            CommandParameter="-2"
                            CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                            Content="{Binding VisibleValues[0], RelativeSource={RelativeSource TemplatedParent}}"
                            Style="{StaticResource DateTimePickerStepButton}" />
                        <controls:Button
                            Grid.Row="3"
                            Command="{x:Static controls:DateTimePickerTimeColumn.StepCommand}"
                            CommandParameter="-1"
                            CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                            Content="{Binding VisibleValues[1], RelativeSource={RelativeSource TemplatedParent}}"
                            Style="{StaticResource DateTimePickerStepButton}" />
                        <controls:Button
                            Grid.Row="4"
                            Appearance="Accent"
                            Command="{x:Static controls:DateTimePickerTimeColumn.StepCommand}"
                            CommandParameter="0"
                            CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                            Content="{Binding VisibleValues[2], RelativeSource={RelativeSource TemplatedParent}}"
                            FontWeight="SemiBold"
                            Style="{StaticResource DateTimePickerStepButton}" />
                        <controls:Button
                            Grid.Row="5"
                            Command="{x:Static controls:DateTimePickerTimeColumn.StepCommand}"
                            CommandParameter="1"
                            CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                            Content="{Binding VisibleValues[3], RelativeSource={RelativeSource TemplatedParent}}"
                            Style="{StaticResource DateTimePickerStepButton}" />
                        <controls:Button
                            Grid.Row="6"
                            Command="{x:Static controls:DateTimePickerTimeColumn.StepCommand}"
                            CommandParameter="2"
                            CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                            Content="{Binding VisibleValues[4], RelativeSource={RelativeSource TemplatedParent}}"
                            Style="{StaticResource DateTimePickerStepButton}" />
                        <controls:RepeatButton
                            Grid.Row="7"
                            AutomationProperties.Name="{Binding Language, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DateTimePickerLocalization}, ConverterParameter=NextValue}"
                            Command="{x:Static controls:DateTimePickerTimeColumn.StepCommand}"
                            CommandParameter="1"
                            CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                            FontSize="16"
                            Icon="{m:FluentIconSource CaretDown16, Filled=True}"
                            Style="{StaticResource DateTimePickerStepButton}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasValidInput" Value="False">
                            <Setter TargetName="PART_Input" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" />
                            <Setter TargetName="PART_Input" Property="ToolTip" Value="{Binding Language, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DateTimePickerLocalization}, ConverterParameter=InvalidNumber}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:DateTimePicker}">
        <Setter Property="MinWidth" Value="{m:DynamicValue DefaultControlMinWidth}" />
        <Setter Property="MinHeight" Value="{m:DynamicValue DefaultControlMinHeight}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Padding" Value="{m:DynamicValue TextControlThemePadding}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="{m:DynamicBrush ControlFillSecondary}" />
        <Setter Property="BorderBrush" Value="{m:DynamicBrush ControlStrokeSecondary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{m:DynamicValue ControlCornerRadius}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:DateTimePicker}">
                    <Grid>
                        <Border
                            x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="{x:Type controls:Button}">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="MinWidth" Value="24" />
                                        <Setter Property="MinHeight" Value="24" />
                                        <Setter Property="VerticalAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource TemplatedParent}}" />
                                        <Setter Property="Appearance" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="IsTabStop" Value="False" />
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </Grid.Resources>
                                <controls:TextBox
                                    x:Name="PART_TextBox"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="0"
                                    DisabledBackground="Transparent"
                                    FocusedBackground="Transparent"
                                    IsClearButtonEnabled="False"
                                    IsFocusIndicatorVisible="False"
                                    MouseOverBackground="Transparent"
                                    Style="{m:StaticStyle DefaultUiTextBox}" />
                                <controls:PlaceholderControl
                                    x:Name="PART_Placeholder"
                                    Grid.Column="0"
                                    Margin="2,0"
                                    Padding="{TemplateBinding Padding}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding controls:PlaceholderService.Content}"
                                    Visibility="Collapsed" />
                                <controls:Button
                                    x:Name="PART_ClearButton"
                                    Grid.Column="1"
                                    Margin="4,0,0,0"
                                    AutomationProperties.Name="{Binding Language, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DateTimePickerLocalization}, ConverterParameter=ClearDateTime}"
                                    Icon="{m:FluentIconSource Dismiss24}"
                                    IsEnabled="{TemplateBinding IsClearButtonEnabled}"
                                    ToolTip="{Binding Language, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DateTimePickerLocalization}, ConverterParameter=Clear}" />
                                <controls:Button
                                    x:Name="PART_Button"
                                    Grid.Column="2"
                                    Margin="4,0"
                                    AutomationProperties.Name="{Binding Language, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DateTimePickerLocalization}, ConverterParameter=ChooseDateTime}"
                                    Icon="{m:FluentIconSource CalendarRtl24}"
                                    ToolTip="{Binding Language, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DateTimePickerLocalization}, ConverterParameter=ChooseDateTimeHint}" />
                            </Grid>
                        </Border>
                        <Border
                            x:Name="FocusIndicator"
                            BorderBrush="{m:DynamicBrush AccentStroke}"
                            BorderThickness="0,0,0,2"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />
                        <Popup
                            x:Name="PART_Popup"
                            controls:PopupShadow.IsEnabled="True"
                            AllowsTransparency="True"
                            Focusable="False"
                            Placement="Bottom"
                            PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                            PopupAnimation="Fade"
                            StaysOpen="False">
                            <Border
                                Padding="12"
                                Background="{m:DynamicBrush SolidBackgroundFillTertiary}"
                                BorderBrush="{m:DynamicBrush ControlStrokeDefault}"
                                BorderThickness="1"
                                CornerRadius="6"
                                KeyboardNavigation.TabNavigation="Cycle"
                                TextElement.FontSize="{TemplateBinding FontSize}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ContentControl
                                        x:Name="PART_CalendarHost"
                                        Margin="0,0,16,0"
                                        VerticalAlignment="Top"
                                        Focusable="False" />

                                    <!--  Time field selectors.  -->
                                    <Border
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Height="{Binding ActualHeight, ElementName=PART_CalendarHost}"
                                        Padding="12,16,12,12"
                                        Background="{m:DynamicBrush AcrylicBackgroundFillDefault}"
                                        BorderBrush="{m:DynamicBrush ControlStrokeDefault}"
                                        BorderThickness="1"
                                        CornerRadius="{m:DynamicValue ControlCornerRadius}">
                                        <!--  Keep hours, minutes and seconds in left-to-right order when the surrounding layout uses RTL.  -->
                                        <Grid FlowDirection="LeftToRight">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Margin="0,0,0,8"
                                                HorizontalAlignment="Center"
                                                Text="{Binding Language, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DateTimePickerLocalization}, ConverterParameter=Hour}" />
                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="2"
                                                Margin="0,0,0,8"
                                                HorizontalAlignment="Center"
                                                Text="{Binding Language, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DateTimePickerLocalization}, ConverterParameter=Minute}" />
                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="4"
                                                Margin="0,0,0,8"
                                                HorizontalAlignment="Center"
                                                Text="{Binding Language, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DateTimePickerLocalization}, ConverterParameter=Second}" />
                                            <controls:DateTimePickerTimeColumn
                                                x:Name="PART_Hour"
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                AutomationProperties.Name="{Binding Language, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DateTimePickerLocalization}, ConverterParameter=Hour}"
                                                Maximum="23" />
                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Margin="0,6,0,0"
                                                HorizontalAlignment="Center"
                                                Text=":" />
                                            <controls:DateTimePickerTimeColumn
                                                x:Name="PART_Minute"
                                                Grid.Row="1"
                                                Grid.Column="2"
                                                AutomationProperties.Name="{Binding Language, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DateTimePickerLocalization}, ConverterParameter=Minute}" />
                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.Column="3"
                                                Margin="0,6,0,0"
                                                HorizontalAlignment="Center"
                                                Text=":" />
                                            <controls:DateTimePickerTimeColumn
                                                x:Name="PART_Second"
                                                Grid.Row="1"
                                                Grid.Column="4"
                                                AutomationProperties.Name="{Binding Language, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DateTimePickerLocalization}, ConverterParameter=Second}" />
                                        </Grid>
                                    </Border>

                                    <DockPanel
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Margin="0,12,0,0"
                                        LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <controls:Button
                                                Command="{x:Static controls:DateTimePicker.CommitCommand}"
                                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                Content="{m:FluentIconSource Checkmark24}"
                                                FontSize="18"
                                                Style="{StaticResource DateTimePickerActionButton}" />
                                            <controls:Button
                                                Command="{x:Static controls:DateTimePicker.CancelCommand}"
                                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                Content="{m:FluentIconSource Dismiss24}"
                                                FontSize="18"
                                                Style="{StaticResource DateTimePickerActionButton}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,0" Orientation="Horizontal">
                                            <controls:Button
                                                Command="{x:Static controls:DateTimePicker.SelectShortcutCommand}"
                                                CommandParameter="Year"
                                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                Content="{Binding Language, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DateTimePickerLocalization}, ConverterParameter=Year}"
                                                Style="{StaticResource DateTimePickerActionButton}" />
                                            <controls:Button
                                                Command="{x:Static controls:DateTimePicker.SelectShortcutCommand}"
                                                CommandParameter="Month"
                                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                Content="{Binding Language, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DateTimePickerLocalization}, ConverterParameter=Month}"
                                                Style="{StaticResource DateTimePickerActionButton}" />
                                            <controls:Button
                                                Command="{x:Static controls:DateTimePicker.SelectShortcutCommand}"
                                                CommandParameter="Week"
                                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                Content="{Binding Language, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DateTimePickerLocalization}, ConverterParameter=Week}"
                                                Style="{StaticResource DateTimePickerActionButton}" />
                                            <controls:Button
                                                Command="{x:Static controls:DateTimePicker.SelectShortcutCommand}"
                                                CommandParameter="Today"
                                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                Content="{Binding Language, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DateTimePickerLocalization}, ConverterParameter=Today}"
                                                Style="{StaticResource DateTimePickerActionButton}" />
                                            <controls:Button
                                                Command="{x:Static controls:DateTimePicker.SelectShortcutCommand}"
                                                CommandParameter="Now"
                                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                Content="{Binding Language, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DateTimePickerLocalization}, ConverterParameter=Now}"
                                                Style="{StaticResource DateTimePickerActionButton}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsClearButtonEnabled" Value="False">
                            <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="False">
                            <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="PART_Placeholder" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Text" Value="{x:Null}">
                            <Setter TargetName="PART_Placeholder" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{m:DynamicBrush ControlFillPrimary}" />
                        </Trigger>

                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusIndicator" Property="Visibility" Value="Visible" />
                            <Setter Property="Background" Value="{m:DynamicBrush ControlFillInputActive}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Placeholder" Property="Opacity" Value="0.5" />
                            <Setter Property="IsClearButtonEnabled" Value="False" />
                            <Setter Property="Foreground" Value="{m:DynamicBrush TextFillDisabled}" />
                            <Setter Property="Background" Value="{m:DynamicBrush ControlFillDisabled}" />
                            <Setter Property="BorderBrush" Value="{m:DynamicBrush ControlStrokeDefault}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
