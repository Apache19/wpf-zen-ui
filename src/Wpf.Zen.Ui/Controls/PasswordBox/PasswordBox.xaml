<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup"
    xmlns:ui="clr-namespace:Wpf.Zen.Ui">

    <ControlTemplate x:Key="UiPasswordBoxTemplate" TargetType="{x:Type controls:PasswordBox}">
        <Grid>
            <Border
                x:Name="ContentBorder"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding Border.CornerRadius}"
                SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ContentPresenter
                        x:Name="iconPresenter"
                        Grid.Column="0"
                        Margin="{TemplateBinding IconMargin}"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Icon}"
                        Focusable="False"
                        IsHitTestVisible="False"
                        TextElement.FontSize="16" />

                    <TextBlock
                        x:Name="PlaceholderTextBox"
                        Grid.Column="1"
                        Margin="2,0"
                        Padding="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        Foreground="{m:DynamicBrush TextPlaceholder}"
                        Text="{TemplateBinding PlaceholderText}" />

                    <controls:UiScrollViewer
                        x:Name="PART_ContentHost"
                        Grid.Column="1"
                        controls:ScrollViewerAssist.OverlayMode="Traditional"
                        Focusable="false"
                        HorizontalScrollBarVisibility="Hidden"
                        ScrollSpillMode="Disabled"
                        VerticalScrollBarVisibility="Hidden" />

                    <!--  Buttons and Icons have no padding from the main element to allow absolute positions if height is larger than the text entry zone  -->
                    <controls:Button
                        x:Name="PART_ClearButton"
                        Grid.Column="2"
                        Width="24"
                        Height="24"
                        Margin="0,0,4,0"
                        Padding="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Focusable="False"
                        Foreground="{m:DynamicBrush TextFillSecondary}"
                        Icon="{m:FluentIconSource Dismiss24}"
                        IsEnabled="{TemplateBinding IsClearButtonEnabled}"
                        IsTabStop="False"
                        MouseOverBackground="{m:DynamicBrush SubtleFillSecondary}"
                        MouseOverBorderBrush="Transparent"
                        PressedBackground="{m:DynamicBrush SubtleFillTertiary}"
                        PressedBorderBrush="Transparent" />

                    <controls:Button
                        x:Name="PART_RevealButton"
                        Grid.Column="3"
                        Width="24"
                        Height="24"
                        Margin="0,0,4,0"
                        Padding="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Focusable="False"
                        Foreground="{m:DynamicBrush TextFillSecondary}"
                        Icon="{m:FluentIconSource Eye24}"
                        IsEnabled="{TemplateBinding RevealButtonEnabled}"
                        IsTabStop="False"
                        MouseOverBackground="{m:DynamicBrush SubtleFillSecondary}"
                        MouseOverBorderBrush="Transparent"
                        PressedBackground="{m:DynamicBrush SubtleFillTertiary}"
                        PressedBorderBrush="Transparent" />
                </Grid>
            </Border>
            <Border
                x:Name="FocusIndicator"
                BorderBrush="{m:DynamicBrush AccentStroke}"
                BorderThickness="0,0,0,2"
                CornerRadius="{TemplateBinding Border.CornerRadius}"
                IsHitTestVisible="False"
                Visibility="Collapsed" />
        </Grid>
        <ControlTemplate.Triggers>

            <!--  布局触发器  -->

            <Trigger Property="IsPlaceholderVisible" Value="False">
                <Setter TargetName="PlaceholderTextBox" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsClearButtonVisible" Value="False">
                <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PART_ClearButton" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IsClearButtonEnabled" Value="False">
                <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PART_ClearButton" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PART_ClearButton" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="RevealButtonEnabled" Value="False">
                <Setter TargetName="PART_RevealButton" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PART_RevealButton" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IsPasswordRevealed" Value="True">
                <Setter TargetName="PART_RevealButton" Property="Icon" Value="{m:FluentIconSource EyeOff24}" />
            </Trigger>
            <Trigger Property="IconPlacement" Value="Right">
                <Setter TargetName="iconPresenter" Property="Grid.Column" Value="3" />
                <Setter TargetName="iconPresenter" Property="Margin" Value="0,0,10,0" />
            </Trigger>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="iconPresenter" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="iconPresenter" Property="Margin" Value="0" />
            </Trigger>

            <!--  视觉触发器  -->

            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ContentBorder" Property="Background" Value="{m:DynamicBrush ControlFillPrimary}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ContentBorder" Property="Background" Value="{m:DynamicBrush ControlFillInputActive}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsKeyboardFocused" Value="True" />
                    <Condition Property="IsFocusIndicatorVisible" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="FocusIndicator" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsReadOnly" Value="True" />
                    <Condition Property="IsKeyboardFocused" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="ContentBorder" Property="Background" Value="{m:DynamicBrush ControlFillTertiary}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ContentBorder" Property="Background" Value="{m:DynamicBrush ControlFillDisabled}" />
                <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{m:DynamicBrush ControlStrokeDefault}" />
                <Setter TargetName="FocusIndicator" Property="BorderBrush" Value="{m:DynamicBrush ControlStrokeDefault}" />
                <Setter TargetName="PlaceholderTextBox" Property="Foreground" Value="{m:DynamicBrush TextFillDisabled}" />
                <Setter Property="Foreground" Value="{m:DynamicBrush TextFillDisabled}" />
                <Setter Property="IsClearButtonEnabled" Value="False" />
                <Setter Property="RevealButtonEnabled" Value="False" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="DefaultUiPasswordBoxStyle" TargetType="{x:Type controls:PasswordBox}">
        <Setter Property="IconMargin" Value="10,0,0,0" />
        <Setter Property="PasswordChar" Value="●" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="AllowDrop" Value="true" />
        <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="CaretBrush" Value="{Binding Foreground, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Background" Value="{m:DynamicBrush ControlFillSecondary}" />
        <Setter Property="BorderBrush" Value="{m:DynamicBrush ControlStrokeSecondary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="{m:DynamicValue TextControlThemePadding}" />
        <Setter Property="Border.CornerRadius" Value="{m:DynamicValue ControlCornerRadius}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Validation.ErrorTemplate" Value="{m:DynamicTemplate DefaultValidation}" />
        <Setter Property="Template" Value="{StaticResource UiPasswordBoxTemplate}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static ui:WpfCompatibility.IsModernTextSelectionRenderingEnabled}, Mode=OneTime}" Value="True">
                <Setter Property="SelectionBrush" Value="{m:DynamicBrush AccentTextSecondary}" />
            </DataTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsInactiveSelectionHighlightEnabled" Value="true" />
                    <Condition Property="IsSelectionActive" Value="false" />
                </MultiTrigger.Conditions>
                <Setter Property="SelectionBrush" Value="{m:DynamicBrush SubtleFillSecondary}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource DefaultUiPasswordBoxStyle}" TargetType="{x:Type controls:PasswordBox}" />

</ResourceDictionary>
