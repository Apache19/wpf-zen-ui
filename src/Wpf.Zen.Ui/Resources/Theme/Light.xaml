<!--  ReSharper disable Xaml.InvalidResourceType  -->

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:t="clr-namespace:Wpf.Zen.Ui.Theming">

    <!--
        Accent roles are generated at runtime from the configured base color. These values keep
        design-time and standalone dictionary loading useful before ThemeManager adds its overlay.
        Primary/Secondary/Tertiary describe color hierarchy, not a mandatory control state.
    -->
    <Color x:Key="{x:Static t:ColorKeys.AccentFillPrimary}">#0071C8</Color>
    <Color x:Key="{x:Static t:ColorKeys.AccentFillSecondary}">#0064B2</Color>
    <Color x:Key="{x:Static t:ColorKeys.AccentFillTertiary}">#005498</Color>
    <Color x:Key="{x:Static t:ColorKeys.AccentTextPrimary}">#0075D0</Color>
    <Color x:Key="{x:Static t:ColorKeys.AccentTextSecondary}">#298BE8</Color>
    <Color x:Key="{x:Static t:ColorKeys.TextOnAccentPrimary}">#FFFFFF</Color>
    <Color x:Key="{x:Static t:ColorKeys.AccentStroke}">#0075D0</Color>
    <Color x:Key="{x:Static t:ColorKeys.AccentSelection}">#0064B2</Color>

    <!--  Windows theme 主要在高对比度模式下生效，普通主题则不使用，但仍然需要定义，以便覆盖残留的颜色值  -->
    <DynamicResource x:Key="{x:Static t:ColorKeys.SystemColorWindowTextColor}" ResourceKey="{x:Static SystemColors.WindowTextColorKey}" />
    <DynamicResource x:Key="{x:Static t:ColorKeys.SystemColorWindowColor}" ResourceKey="{x:Static SystemColors.WindowColorKey}" />
    <DynamicResource x:Key="{x:Static t:ColorKeys.SystemColorHighlightTextColor}" ResourceKey="{x:Static SystemColors.HighlightTextColorKey}" />
    <DynamicResource x:Key="{x:Static t:ColorKeys.SystemColorHighlightColor}" ResourceKey="{x:Static SystemColors.HighlightColorKey}" />
    <DynamicResource x:Key="{x:Static t:ColorKeys.SystemColorControlTextColor}" ResourceKey="{x:Static SystemColors.ControlTextColorKey}" />
    <DynamicResource x:Key="{x:Static t:ColorKeys.SystemColorControlColor}" ResourceKey="{x:Static SystemColors.ControlColorKey}" />
    <DynamicResource x:Key="{x:Static t:ColorKeys.SystemColorHotTrackColor}" ResourceKey="{x:Static SystemColors.HotTrackColorKey}" />
    <DynamicResource x:Key="{x:Static t:ColorKeys.SystemColorGrayTextColor}" ResourceKey="{x:Static SystemColors.GrayTextColorKey}" />
    <DynamicResource x:Key="{x:Static t:ColorKeys.SystemColorWindowFrameColor}" ResourceKey="{x:Static SystemColors.WindowFrameColorKey}" />

    <SolidColorBrush x:Key="{x:Static t:BrushKeys.SystemColorWindowTextBrush}" Color="{StaticResource {x:Static t:ColorKeys.SystemColorWindowTextColor}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.SystemColorWindowBrush}" Color="{StaticResource {x:Static t:ColorKeys.SystemColorWindowColor}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.SystemColorHighlightTextBrush}" Color="{StaticResource {x:Static t:ColorKeys.SystemColorHighlightTextColor}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.SystemColorHighlightBrush}" Color="{StaticResource {x:Static t:ColorKeys.SystemColorHighlightColor}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.SystemColorControlTextBrush}" Color="{StaticResource {x:Static t:ColorKeys.SystemColorControlTextColor}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.SystemColorControlBrush}" Color="{StaticResource {x:Static t:ColorKeys.SystemColorControlColor}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.SystemColorHotTrackBrush}" Color="{StaticResource {x:Static t:ColorKeys.SystemColorHotTrackColor}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.SystemColorGrayTextBrush}" Color="{StaticResource {x:Static t:ColorKeys.SystemColorGrayTextColor}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.SystemColorWindowFrameBrush}" Color="{StaticResource {x:Static t:ColorKeys.SystemColorWindowFrameColor}}" />

    <Color x:Key="{x:Static t:ColorKeys.WindowBackgroundColor}">#FFFAFAFA</Color>
    <Color x:Key="{x:Static t:ColorKeys.WindowBorderColor}">#FF707070</Color>
    <Color x:Key="{x:Static t:ColorKeys.WindowBorderColorInactive}">#FFAAAAAA</Color>

    <Color x:Key="{x:Static t:ColorKeys.KeyboardFocusBorderColor}">#BE000000</Color>
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.KeyboardFocusBorderColorBrush}" Color="{StaticResource {x:Static t:ColorKeys.KeyboardFocusBorderColor}}" />

    <!--  Colors  -->

    <Color x:Key="{x:Static t:ColorKeys.TextFillColorPrimary}">#E4000000</Color>
    <Color x:Key="{x:Static t:ColorKeys.TextFillColorSecondary}">#9E000000</Color>
    <Color x:Key="{x:Static t:ColorKeys.TextFillColorTertiary}">#72000000</Color>
    <Color x:Key="{x:Static t:ColorKeys.TextFillColorDisabled}">#5C000000</Color>
    <Color x:Key="{x:Static t:ColorKeys.TextPlaceholderColor}">#9E000000</Color>
    <Color x:Key="{x:Static t:ColorKeys.TextFillColorInverse}">#FFFFFF</Color>

    <!--  建议值：#0F000000（白色alpha在白色背景上无意义，改用黑色alpha）  -->
    <Color x:Key="{x:Static t:ColorKeys.ControlFillColorPrimary}">#B3FFFFFF</Color>
    <!--  建议值：#1A000000（改用黑色alpha，与其他Fill系列保持一致）  -->
    <Color x:Key="{x:Static t:ColorKeys.ControlFillColorSecondary}">#80F0F0F0</Color>
    <!--  建议值：#08000000（改用黑色alpha，且须与Disabled区分）  -->
    <Color x:Key="{x:Static t:ColorKeys.ControlFillColorTertiary}">#4DF9F9F9</Color>
    <!--  建议值：#05000000（当前与Tertiary相同值，无法区分）  -->
    <Color x:Key="{x:Static t:ColorKeys.ControlFillColorDisabled}">#4DF9F9F9</Color>
    <Color x:Key="{x:Static t:ColorKeys.ControlFillColorInputActive}">#FFFFFF</Color>

    <Color x:Key="{x:Static t:ColorKeys.ControlStrongFillColorDefault}">#72000000</Color>
    <Color x:Key="{x:Static t:ColorKeys.ControlStrongFillColorDisabled}">#51000000</Color>

    <Color x:Key="{x:Static t:ColorKeys.ControlSolidFillColorDefault}">#FFFFFF</Color>

    <Color x:Key="{x:Static t:ColorKeys.SubtleFillColorTransparent}">#00FFFFFF</Color>
    <Color x:Key="{x:Static t:ColorKeys.SubtleFillColorSecondary}">#09000000</Color>
    <!--  建议值：#05000000（当前与ControlAltFillColorSecondary、SystemFillColorNeutralBackground 共享 #06000000）  -->
    <Color x:Key="{x:Static t:ColorKeys.SubtleFillColorTertiary}">#06000000</Color>
    <Color x:Key="{x:Static t:ColorKeys.SubtleFillColorDisabled}">#00FFFFFF</Color>

    <Color x:Key="{x:Static t:ColorKeys.ControlAltFillColorTransparent}">#00FFFFFF</Color>
    <!--  建议值：#0D000000（当前与SubtleFillColorTertiary、SystemFillColorNeutralBackground 共享 #06000000）  -->
    <Color x:Key="{x:Static t:ColorKeys.ControlAltFillColorSecondary}">#06000000</Color>
    <Color x:Key="{x:Static t:ColorKeys.ControlAltFillColorTertiary}">#0F000000</Color>
    <Color x:Key="{x:Static t:ColorKeys.ControlAltFillColorQuarternary}">#18000000</Color>
    <Color x:Key="{x:Static t:ColorKeys.ControlAltFillColorDisabled}">#00FFFFFF</Color>

    <Color x:Key="{x:Static t:ColorKeys.ControlOnImageFillColorDefault}">#C9FFFFFF</Color>
    <Color x:Key="{x:Static t:ColorKeys.ControlOnImageFillColorSecondary}">#F3F3F3</Color>
    <Color x:Key="{x:Static t:ColorKeys.ControlOnImageFillColorTertiary}">#EBEBEB</Color>
    <Color x:Key="{x:Static t:ColorKeys.ControlOnImageFillColorDisabled}">#00FFFFFF</Color>

    <!--  建议值：保持 #0F000000（当前与 CardStrokeColorDefault、DividerStrokeColorDefault、SurfaceStrokeColorFlyout、ControlStrokeColorOnAccentDisabled 共享此值）  -->
    <Color x:Key="{x:Static t:ColorKeys.ControlStrokeColorDefault}">#0F000000</Color>
    <Color x:Key="{x:Static t:ColorKeys.ControlStrokeColorSecondary}">#29000000</Color>
    <Color x:Key="{x:Static t:ColorKeys.ControlStrokeColorTertiary}">#9E000000</Color>
    <Color x:Key="{x:Static t:ColorKeys.ControlStrokeColorOnAccentDefault}">#14FFFFFF</Color>
    <Color x:Key="{x:Static t:ColorKeys.ControlStrokeColorOnAccentSecondary}">#66000000</Color>
    <Color x:Key="{x:Static t:ColorKeys.ControlStrokeColorOnAccentTertiary}">#37000000</Color>
    <!--  建议值：#08000000（当前与 ControlStrokeColorDefault 等共享 #0F000000，Disabled 应更淡）  -->
    <Color x:Key="{x:Static t:ColorKeys.ControlStrokeColorOnAccentDisabled}">#0F000000</Color>

    <Color x:Key="{x:Static t:ColorKeys.ControlStrokeColorForStrongFillWhenOnImage}">#59FFFFFF</Color>

    <!--  建议值：#19000000（当前与 ControlStrokeColorDefault 等共享 #0F000000，卡片描边应更明显）  -->
    <Color x:Key="{x:Static t:ColorKeys.CardStrokeColorDefault}">#0F000000</Color>
    <Color x:Key="{x:Static t:ColorKeys.CardStrokeColorDefaultSolid}">#D4D4D4</Color>

    <Color x:Key="{x:Static t:ColorKeys.ControlStrongStrokeColorDefault}">#72000000</Color>
    <Color x:Key="{x:Static t:ColorKeys.ControlStrongStrokeColorDisabled}">#37000000</Color>

    <Color x:Key="{x:Static t:ColorKeys.SurfaceStrokeColorDefault}">#66757575</Color>
    <!--  建议值：#1A000000（当前与 ControlStrokeColorDefault 等共享 #0F000000，浮层描边应更明显）  -->
    <Color x:Key="{x:Static t:ColorKeys.SurfaceStrokeColorFlyout}">#0F000000</Color>
    <Color x:Key="{x:Static t:ColorKeys.SurfaceStrokeColorInverse}">#15FFFFFF</Color>

    <!--  建议值：#08000000（当前与 ControlStrokeColorDefault 等共享 #0F000000，分割线应更淡）  -->
    <Color x:Key="{x:Static t:ColorKeys.DividerStrokeColorDefault}">#0F000000</Color>

    <Color x:Key="{x:Static t:ColorKeys.FocusStrokeColorOuter}">#E4000000</Color>
    <Color x:Key="{x:Static t:ColorKeys.FocusStrokeColorInner}">#B3FFFFFF</Color>

    <Color x:Key="{x:Static t:ColorKeys.CardBackgroundFillColorDefault}">#08000000</Color>
    <!--  原始：#B3FFFFFF  建议值：#0A000000（改用黑色alpha）  -->
    <Color x:Key="{x:Static t:ColorKeys.CardBackgroundFillColorSecondary}">#80F6F6F6</Color>

    <!--  建议值：#06000000  -->
    <Color x:Key="{x:Static t:ColorKeys.EmbeddedFillColorDefault}">#08F0F0F0</Color>
    <!--  建议值：#0F000000  -->
    <Color x:Key="{x:Static t:ColorKeys.EmbeddedFillColorStrong}">#12E8E8E8</Color>
    <!--  建议值：#19000000  -->
    <Color x:Key="{x:Static t:ColorKeys.EmbeddedFillColorDeep}">#1EE0E0E0</Color>

    <Color x:Key="{x:Static t:ColorKeys.SmokeFillColorDefault}">#4D000000</Color>

    <Color x:Key="{x:Static t:ColorKeys.LayerFillColorDefault}">#80FFFFFF</Color>
    <Color x:Key="{x:Static t:ColorKeys.LayerFillColorAlt}">#FFFFFF</Color>
    <Color x:Key="{x:Static t:ColorKeys.LayerOnAcrylicFillColorDefault}">#40FFFFFF</Color>
    <Color x:Key="{x:Static t:ColorKeys.LayerOnAccentAcrylicFillColorDefault}">#40FFFFFF</Color>

    <Color x:Key="{x:Static t:ColorKeys.SnowflakeGradientTop}">#2E4053</Color>
    <Color x:Key="{x:Static t:ColorKeys.SnowflakeGradientBottom}">#CCCCCC</Color>

    <!--  Fallback color for missing Acrylic used for e.g. Flyouts  -->
    <Color x:Key="{x:Static t:ColorKeys.AcrylicBackgroundFillColorDefault}">#F9F9F9</Color>

    <Color x:Key="{x:Static t:ColorKeys.LayerOnMicaBaseAltFillColorDefault}">#B3FFFFFF</Color>
    <Color x:Key="{x:Static t:ColorKeys.LayerOnMicaBaseAltFillColorSecondary}">#0A000000</Color>
    <Color x:Key="{x:Static t:ColorKeys.LayerOnMicaBaseAltFillColorTertiary}">#F9F9F9</Color>
    <Color x:Key="{x:Static t:ColorKeys.LayerOnMicaBaseAltFillColorTransparent}">#00000000</Color>

    <Color x:Key="{x:Static t:ColorKeys.SolidBackgroundFillColorBase}">#F3F3F3</Color>
    <Color x:Key="{x:Static t:ColorKeys.SolidBackgroundFillColorSecondary}">#EEEEEE</Color>
    <Color x:Key="{x:Static t:ColorKeys.SolidBackgroundFillColorTertiary}">#F9F9F9</Color>
    <Color x:Key="{x:Static t:ColorKeys.SolidBackgroundFillColorQuarternary}">#FFFFFF</Color>
    <Color x:Key="{x:Static t:ColorKeys.SolidBackgroundFillColorTransparent}">#00F3F3F3</Color>
    <Color x:Key="{x:Static t:ColorKeys.SolidBackgroundFillColorBaseAlt}">#DADADA</Color>

    <Color x:Key="{x:Static t:ColorKeys.SystemFillColorAttention}">#0078d4</Color>
    <Color x:Key="{x:Static t:ColorKeys.SystemFillColorInformational}">#8A8A8A</Color>
    <Color x:Key="{x:Static t:ColorKeys.SystemFillColorSuccess}">#0F7B0F</Color>
    <Color x:Key="{x:Static t:ColorKeys.SystemFillColorCaution}">#9D5D00</Color>
    <Color x:Key="{x:Static t:ColorKeys.SystemFillColorCritical}">#C42B1C</Color>
    <Color x:Key="{x:Static t:ColorKeys.SystemFillColorNeutral}">#72000000</Color>
    <Color x:Key="{x:Static t:ColorKeys.SystemFillColorSolidNeutral}">#8A8A8A</Color>
    <!--  建议值：#0A000000（改用黑色alpha，或考虑带 Accent 色调的浅色）  -->
    <Color x:Key="{x:Static t:ColorKeys.SystemFillColorAttentionBackground}">#80F6F6F6</Color>
    <Color x:Key="{x:Static t:ColorKeys.SystemFillColorSuccessBackground}">#DFF6DD</Color>
    <Color x:Key="{x:Static t:ColorKeys.SystemFillColorCautionBackground}">#FFF4CE</Color>
    <Color x:Key="{x:Static t:ColorKeys.SystemFillColorCriticalBackground}">#FDE7E9</Color>
    <!--  建议值：#08000000（当前与 SubtleFillColorTertiary、ControlAltFillColorSecondary 共享 #06000000）  -->
    <Color x:Key="{x:Static t:ColorKeys.SystemFillColorNeutralBackground}">#06000000</Color>
    <Color x:Key="{x:Static t:ColorKeys.SystemFillColorSolidAttentionBackground}">#F7F7F7</Color>
    <Color x:Key="{x:Static t:ColorKeys.SystemFillColorSolidNeutralBackground}">#F3F3F3</Color>

    <!--  Brushes  -->

    <SolidColorBrush x:Key="{x:Static t:BrushKeys.AccentFillPrimaryBrush}" Color="{StaticResource {x:Static t:ColorKeys.AccentFillPrimary}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.AccentFillSecondaryBrush}" Color="{StaticResource {x:Static t:ColorKeys.AccentFillSecondary}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.AccentFillTertiaryBrush}" Color="{StaticResource {x:Static t:ColorKeys.AccentFillTertiary}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.AccentTextPrimaryBrush}" Color="{StaticResource {x:Static t:ColorKeys.AccentTextPrimary}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.AccentTextSecondaryBrush}" Color="{StaticResource {x:Static t:ColorKeys.AccentTextSecondary}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.TextOnAccentPrimaryBrush}" Color="{StaticResource {x:Static t:ColorKeys.TextOnAccentPrimary}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.AccentStrokeBrush}" Color="{StaticResource {x:Static t:ColorKeys.AccentStroke}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.AccentSelectionBrush}" Color="{StaticResource {x:Static t:ColorKeys.AccentSelection}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.SystemFillColorAttentionBrush}" Color="{StaticResource {x:Static t:ColorKeys.SystemFillColorAttention}}" />

    <SolidColorBrush x:Key="{x:Static t:BrushKeys.TextFillColorPrimaryBrush}" Color="{StaticResource {x:Static t:ColorKeys.TextFillColorPrimary}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.TextFillColorSecondaryBrush}" Color="{StaticResource {x:Static t:ColorKeys.TextFillColorSecondary}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.TextFillColorTertiaryBrush}" Color="{StaticResource {x:Static t:ColorKeys.TextFillColorTertiary}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.TextFillColorDisabledBrush}" Color="{StaticResource {x:Static t:ColorKeys.TextFillColorDisabled}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.TextPlaceholderColorBrush}" Color="{StaticResource {x:Static t:ColorKeys.TextPlaceholderColor}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.TextFillColorInverseBrush}" Color="{StaticResource {x:Static t:ColorKeys.TextFillColorInverse}}" />

    <SolidColorBrush x:Key="{x:Static t:BrushKeys.ControlFillColorPrimaryBrush}" Color="{StaticResource {x:Static t:ColorKeys.ControlFillColorPrimary}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.ControlFillColorSecondaryBrush}" Color="{StaticResource {x:Static t:ColorKeys.ControlFillColorSecondary}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.ControlFillColorTertiaryBrush}" Color="{StaticResource {x:Static t:ColorKeys.ControlFillColorTertiary}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.ControlFillColorDisabledBrush}" Color="{StaticResource {x:Static t:ColorKeys.ControlFillColorDisabled}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.ControlFillColorInputActiveBrush}" Color="{StaticResource {x:Static t:ColorKeys.ControlFillColorInputActive}}" />

    <SolidColorBrush x:Key="{x:Static t:BrushKeys.ControlStrongFillColorDefaultBrush}" Color="{StaticResource {x:Static t:ColorKeys.ControlStrongFillColorDefault}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.ControlStrongFillColorDisabledBrush}" Color="{StaticResource {x:Static t:ColorKeys.ControlStrongFillColorDisabled}}" />

    <SolidColorBrush x:Key="{x:Static t:BrushKeys.ControlSolidFillColorDefaultBrush}" Color="{StaticResource {x:Static t:ColorKeys.ControlSolidFillColorDefault}}" />

    <SolidColorBrush x:Key="{x:Static t:BrushKeys.SubtleFillColorTransparentBrush}" Color="{StaticResource {x:Static t:ColorKeys.SubtleFillColorTransparent}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.SubtleFillColorSecondaryBrush}" Color="{StaticResource {x:Static t:ColorKeys.SubtleFillColorSecondary}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.SubtleFillColorTertiaryBrush}" Color="{StaticResource {x:Static t:ColorKeys.SubtleFillColorTertiary}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.SubtleFillColorDisabledBrush}" Color="{StaticResource {x:Static t:ColorKeys.SubtleFillColorDisabled}}" />

    <SolidColorBrush x:Key="{x:Static t:BrushKeys.ControlAltFillColorTransparentBrush}" Color="{StaticResource {x:Static t:ColorKeys.ControlAltFillColorTransparent}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.ControlAltFillColorSecondaryBrush}" Color="{StaticResource {x:Static t:ColorKeys.ControlAltFillColorSecondary}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.ControlAltFillColorTertiaryBrush}" Color="{StaticResource {x:Static t:ColorKeys.ControlAltFillColorTertiary}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.ControlAltFillColorQuarternaryBrush}" Color="{StaticResource {x:Static t:ColorKeys.ControlAltFillColorQuarternary}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.ControlAltFillColorDisabledBrush}" Color="{StaticResource {x:Static t:ColorKeys.ControlAltFillColorDisabled}}" />

    <SolidColorBrush x:Key="{x:Static t:BrushKeys.ControlOnImageFillColorDefaultBrush}" Color="{StaticResource {x:Static t:ColorKeys.ControlOnImageFillColorDefault}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.ControlOnImageFillColorSecondaryBrush}" Color="{StaticResource {x:Static t:ColorKeys.ControlOnImageFillColorSecondary}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.ControlOnImageFillColorTertiaryBrush}" Color="{StaticResource {x:Static t:ColorKeys.ControlOnImageFillColorTertiary}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.ControlOnImageFillColorDisabledBrush}" Color="{StaticResource {x:Static t:ColorKeys.ControlOnImageFillColorDisabled}}" />

    <SolidColorBrush x:Key="{x:Static t:BrushKeys.ControlStrokeColorDefaultBrush}" Color="{StaticResource {x:Static t:ColorKeys.ControlStrokeColorDefault}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.ControlStrokeColorSecondaryBrush}" Color="{StaticResource {x:Static t:ColorKeys.ControlStrokeColorSecondary}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.ControlStrokeColorTertiaryBrush}" Color="{StaticResource {x:Static t:ColorKeys.ControlStrokeColorTertiary}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.ControlStrokeColorOnAccentDefaultBrush}" Color="{StaticResource {x:Static t:ColorKeys.ControlStrokeColorOnAccentDefault}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.ControlStrokeColorOnAccentSecondaryBrush}" Color="{StaticResource {x:Static t:ColorKeys.ControlStrokeColorOnAccentSecondary}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.ControlStrokeColorOnAccentTertiaryBrush}" Color="{StaticResource {x:Static t:ColorKeys.ControlStrokeColorOnAccentTertiary}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.ControlStrokeColorOnAccentDisabledBrush}" Color="{StaticResource {x:Static t:ColorKeys.ControlStrokeColorOnAccentDisabled}}" />

    <SolidColorBrush x:Key="{x:Static t:BrushKeys.ControlStrokeColorForStrongFillWhenOnImageBrush}" Color="{StaticResource {x:Static t:ColorKeys.ControlStrokeColorForStrongFillWhenOnImage}}" />

    <SolidColorBrush x:Key="{x:Static t:BrushKeys.CardStrokeColorDefaultBrush}" Color="{StaticResource {x:Static t:ColorKeys.CardStrokeColorDefault}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.CardStrokeColorDefaultSolidBrush}" Color="{StaticResource {x:Static t:ColorKeys.CardStrokeColorDefaultSolid}}" />

    <SolidColorBrush x:Key="{x:Static t:BrushKeys.ControlStrongStrokeColorDefaultBrush}" Color="{StaticResource {x:Static t:ColorKeys.ControlStrongStrokeColorDefault}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.ControlStrongStrokeColorDisabledBrush}" Color="{StaticResource {x:Static t:ColorKeys.ControlStrongStrokeColorDisabled}}" />

    <SolidColorBrush x:Key="{x:Static t:BrushKeys.SurfaceStrokeColorDefaultBrush}" Color="{StaticResource {x:Static t:ColorKeys.SurfaceStrokeColorDefault}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.SurfaceStrokeColorFlyoutBrush}" Color="{StaticResource {x:Static t:ColorKeys.SurfaceStrokeColorFlyout}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.SurfaceStrokeColorInverseBrush}" Color="{StaticResource {x:Static t:ColorKeys.SurfaceStrokeColorInverse}}" />

    <SolidColorBrush x:Key="{x:Static t:BrushKeys.DividerStrokeColorDefaultBrush}" Color="{StaticResource {x:Static t:ColorKeys.DividerStrokeColorDefault}}" />

    <SolidColorBrush x:Key="{x:Static t:BrushKeys.FocusStrokeColorOuterBrush}" Color="{StaticResource {x:Static t:ColorKeys.FocusStrokeColorOuter}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.FocusStrokeColorInnerBrush}" Color="{StaticResource {x:Static t:ColorKeys.FocusStrokeColorInner}}" />

    <SolidColorBrush x:Key="{x:Static t:BrushKeys.CardBackgroundFillColorDefaultBrush}" Color="{StaticResource {x:Static t:ColorKeys.CardBackgroundFillColorDefault}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.CardBackgroundFillColorSecondaryBrush}" Color="{StaticResource {x:Static t:ColorKeys.CardBackgroundFillColorSecondary}}" />

    <SolidColorBrush x:Key="{x:Static t:BrushKeys.EmbeddedFillColorDefaultBrush}" Color="{StaticResource {x:Static t:ColorKeys.EmbeddedFillColorDefault}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.EmbeddedFillColorStrongBrush}" Color="{StaticResource {x:Static t:ColorKeys.EmbeddedFillColorStrong}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.EmbeddedFillColorDeepBrush}" Color="{StaticResource {x:Static t:ColorKeys.EmbeddedFillColorDeep}}" />

    <SolidColorBrush x:Key="{x:Static t:BrushKeys.SmokeFillColorDefaultBrush}" Color="{StaticResource {x:Static t:ColorKeys.SmokeFillColorDefault}}" />

    <SolidColorBrush x:Key="{x:Static t:BrushKeys.LayerFillColorDefaultBrush}" Color="{StaticResource {x:Static t:ColorKeys.LayerFillColorDefault}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.LayerFillColorAltBrush}" Color="{StaticResource {x:Static t:ColorKeys.LayerFillColorAlt}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.LayerOnAcrylicFillColorDefaultBrush}" Color="{StaticResource {x:Static t:ColorKeys.LayerOnAcrylicFillColorDefault}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.LayerOnAccentAcrylicFillColorDefaultBrush}" Color="{StaticResource {x:Static t:ColorKeys.LayerOnAccentAcrylicFillColorDefault}}" />

    <SolidColorBrush x:Key="{x:Static t:BrushKeys.LayerOnMicaBaseAltFillColorDefaultBrush}" Color="{StaticResource {x:Static t:ColorKeys.LayerOnMicaBaseAltFillColorDefault}}" />
    <SolidColorBrush x:Key="{x:Static t:BrushKeys.LayerOnMicaBaseAltFillColorSecondaryBrush}" Color="{StaticResource {x:Static t:ColorKeys.LayerOnMicaBaseAltFillColorSecondary}}" />
