<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Zen.Ui.Controls"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup"
    xmlns:t="clr-namespace:Wpf.Zen.Ui.Theming">

    <!--
        ====================================================================
        GlobalResourceLoader installs these defaults in the system theme at
        library initialization and after Windows reloads its theme dictionary.
        Library component keys are installed when Generic.xaml is loaded.
        ====================================================================
    -->

    <!--
        The focus style selected by WPF remains a single process-wide resource. Per-control variations are applied
        to this inner presenter instead of shadowing SystemParameters.FocusVisualStyleKey in a control's resources;
        this preserves FrameworkElement.FindResourceInternal's normal element-to-application lookup chain.
    -->
    <Style x:Key="{x:Static t:StyleKeys.DefaultFocusVisualPresenterStyle}" TargetType="{x:Type controls:FocusVisualPresenter}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:FocusVisualPresenter}">
                    <Border
                        BorderBrush="{m:DynamicBrush KeyboardFocusBorder}"
                        BorderThickness="1"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        IsHitTestVisible="False"
                        SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <!--
                        FocusVisualPresenter discovers WPF's focus Adorner after it enters the visual tree. It then
                        resolves both the target-specific presenter style and rounded-rectangle geometry in code, so
                        controls without a CornerRadius property never create a failing binding path.
                    -->
                    <controls:FocusVisualPresenter Style="{StaticResource {x:Static t:StyleKeys.DefaultFocusVisualPresenterStyle}}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
