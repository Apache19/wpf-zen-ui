<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup"
    xmlns:t="clr-namespace:Wpf.Zen.Ui.Theming">

    <ControlTemplate x:Key="{x:Static t:TemplateKeys.DefaultValidationTemplate}">
        <Grid>
            <Border
                BorderBrush="{m:DynamicBrush PaletteRed}"
                BorderThickness="1"
                CornerRadius="5"
                SnapsToDevicePixels="True">
                <AdornedElementPlaceholder x:Name="Placeholder" />
            </Border>
        </Grid>
    </ControlTemplate>
</ResourceDictionary>