<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Wpf.Zen.Ui.Converters"
    xmlns:m="clr-namespace:Wpf.Zen.Ui.Markup"
    xmlns:t="clr-namespace:Wpf.Zen.Ui.Theming">

    <Style x:Key="{x:Static t:StyleKeys.DefaultControlFocusVisualStyle}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border
                        BorderBrush="{m:DynamicBrush KeyboardFocusBorder}"
                        BorderThickness="1"
                        IsHitTestVisible="False"
                        SnapsToDevicePixels="True">
                        <Border.CornerRadius>
                            <MultiBinding Converter="{c:FocusVisualCornerRadiusConverter FallbackValue=4}">
                                <Binding Path="AdornedElement" RelativeSource="{RelativeSource AncestorType={x:Type Adorner}}" />
                                <Binding Path="AdornedElement.CornerRadius" RelativeSource="{RelativeSource AncestorType={x:Type Adorner}}" />
                                <Binding Path="AdornedElement.(Border.CornerRadius)" RelativeSource="{RelativeSource AncestorType={x:Type Adorner}}" />
                            </MultiBinding>
                        </Border.CornerRadius>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
