<Page
    x:Class="Wpf.Zen.Ui.Demo.Mvvm.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vm="clr-namespace:Wpf.Zen.Ui.Demo.Mvvm.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    Title="SettingsPage"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DataContext="{d:DesignInstance vm:SettingsViewModel, IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    Style="{ui:DynamicStyle DynamicScrollPage}"
    mc:Ignorable="d">

    <StackPanel Margin="42">
        <TextBlock
            FontSize="20"
            FontWeight="Medium"
            Text="Personalization" />
        <TextBlock Margin="0,12,0,0" Text="Theme" />
        <RadioButton
            Margin="0,12,0,0"
            Content="Light"
            GroupName="themeSelect"
            IsChecked="{Binding IsLightTheme}" />
        <RadioButton
            Margin="0,8,0,0"
            Content="Dark"
            GroupName="themeSelect"
            IsChecked="{Binding IsDarkTheme}" />
        <RadioButton
            Margin="0,8,0,0"
            Content="System"
            GroupName="themeSelect"
            IsChecked="{Binding IsSystemTheme}" />
        <TextBlock
            Margin="0,24,0,0"
            FontSize="20"
            FontWeight="Medium"
            Text="About Wpf.Zen.Ui.Demo.Mvvm" />
        <TextBlock Margin="0,12,0,0" Text="{Binding AppVersion, Mode=OneWay}" />
    </StackPanel>
</Page>
