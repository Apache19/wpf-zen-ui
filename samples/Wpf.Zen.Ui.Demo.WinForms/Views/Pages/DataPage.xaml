<Page
    x:Class="Wpf.Zen.Ui.Demo.Simple.Views.Pages.DataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Wpf.Zen.Ui.Demo.Simple.Models"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    Title="DataPage"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    d:Foreground="{ui:DynamicBrush TextFillPrimary}"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    mc:Ignorable="d">
    <Grid Margin="42">
        <ItemsControl
            x:Name="ColorsItemsControl"
            Foreground="{ui:DynamicBrush TextFillSecondary}"
            ScrollViewer.CanContentScroll="True"
            VirtualizingPanel.CacheLength="0"
            VirtualizingPanel.CacheLengthUnit="Item"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.ScrollUnit="Item"
            VirtualizingPanel.VirtualizationMode="Recycling">
            <ItemsControl.Template>
                <ControlTemplate>
                    <ui:UiScrollViewer Padding="16">
                        <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </ui:UiScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:DataColor}">
                    <ui:Button
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Appearance="Normal"
                        Background="{Binding Color, Mode=OneWay}"
                        FontSize="25"
                        Icon="{ui:FluentIconSource Fluent24}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <ui:VirtualizingWrapPanel
                        HorizontalSpacing="4"
                        ItemHeight="80"
                        ItemWidth="80"
                        VerticalSpacing="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </Grid>
</Page>
