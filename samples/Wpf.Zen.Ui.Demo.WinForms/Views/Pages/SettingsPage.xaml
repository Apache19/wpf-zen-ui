<Page
    x:Class="Wpf.Zen.Ui.Demo.Simple.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Zen.Ui.Demo.Simple.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    Title="SettingsPage"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    d:Foreground="{ui:DynamicBrush TextFillPrimary}"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    Style="{ui:DynamicStyle DynamicScrollPage}"
    mc:Ignorable="d">
    <StackPanel Margin="42">
        <!--  用两种不同的 TextBlock 测试主题功能  -->
        <TextBlock
            FontSize="20"
            FontWeight="Medium"
            Text="Personalization" />
        <ui:TextBlock Margin="0,12,0,0" Text="Theme" />
        <ui:ComboBox
            x:Name="ThemeComboBox"
            Width="150"
            SelectionChanged="ThemeComboBox_OnSelectionChanged"
            HorizontalAlignment="Left">
            <ComboBoxItem Content="Light" />
            <ComboBoxItem Content="Dark" />
            <ComboBoxItem Content="System" />
        </ui:ComboBox>
        <ui:TextBlock
            Margin="0,24,0,0"
            FontSize="20"
            FontWeight="Medium"
            Text="About WPF Zen UI - Simple Demo" />
        <ui:TextBlock x:Name="AppVersionTextBlock" Margin="0,12,0,0" />
    </StackPanel>
</Page>
