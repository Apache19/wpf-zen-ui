<UserControl
    x:Class="Wpf.Zen.Ui.Demo.WinForms.WpfContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Wpf.Zen.Ui.Demo.Simple.Views.Pages"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="{ui:DynamicBrush WindowBackground}"
    FontSize="{ui:DynamicValue ControlContentThemeFontSize}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ui:ThemeManagerOptions Preference="Dark" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            LeftPaneOpenWidth="200">

            <ui:NavigationView.AutoSuggestBox>
                <ui:AutoSuggestBox Icon="{ui:FluentIconSource Search24}" PlaceholderText="Search" />
            </ui:NavigationView.AutoSuggestBox>

            <ui:NavigationView.Header>
                <ui:BreadcrumbBar
                    Margin="42,32,0,0"
                    FontSize="28"
                    FontWeight="DemiBold" />
            </ui:NavigationView.Header>

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Header="Dashboard"
                    Icon="{ui:FluentIconSource Home24}"
                    NavigationCacheMode="Evictable"
                    TargetPageType="{x:Type pages:DashboardPage}" />
                <ui:NavigationViewItem
                    Header="Data"
                    Icon="{ui:FluentIconSource DataHistogram24}"
                    NavigationCacheMode="Evictable"
                    TargetPageType="{x:Type pages:DataPage}" />
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    Header="Settings"
                    Icon="{ui:FluentIconSource Settings24}"
                    NavigationCacheMode="Disabled"
                    TargetPageType="{x:Type pages:SettingsPage}" />
            </ui:NavigationView.FooterMenuItems>

        </ui:NavigationView>
    </Grid>
</UserControl>
