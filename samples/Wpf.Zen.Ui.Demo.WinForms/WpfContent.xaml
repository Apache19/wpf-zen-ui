<UserControl
    x:Class="Wpf.Zen.Ui.Demo.WinForms.WpfContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Wpf.Zen.Ui.Demo.Simple.Views.Pages"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="{ui:DynamicBrush WindowBackground}"
    FontSize="{ui:DynamicValue ControlContentThemeFontSize}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ui:ThemeManagerOptions EnableNativeControlStyling="True" Preference="Dark" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            LeftPaneOpenWidth="200">

            <ui:NavigationView.AutoSuggestBox>
                <ui:AutoSuggestBox PlaceholderText="Search">
                    <ui:IconAssist.Icon>
                        <ui:FluentIcon Symbol="Search24" />
                    </ui:IconAssist.Icon>
                </ui:AutoSuggestBox>
            </ui:NavigationView.AutoSuggestBox>

            <ui:NavigationView.Header>
                <ui:BreadcrumbBar
                    Margin="42,32,0,0"
                    FontSize="28"
                    FontWeight="DemiBold" />
            </ui:NavigationView.Header>

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    ui:IconAssist.Icon="{ui:FluentIconSource Home24}"
                    Header="Dashboard"
                    NavigationCacheMode="Evictable"
                    TargetPageType="{x:Type pages:DashboardPage}" />
                <ui:NavigationViewItem
                    Header="Data"
                    NavigationCacheMode="Evictable"
                    TargetPageType="{x:Type pages:DataPage}">
                    <ui:IconAssist.Icon>
                        <ui:FluentIcon Symbol="DataHistogram24" />
                    </ui:IconAssist.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    Header="Settings"
                    NavigationCacheMode="Disabled"
                    TargetPageType="{x:Type pages:SettingsPage}">
                    <ui:IconAssist.Icon>
                        <ui:FluentIcon Symbol="Settings24" />
                    </ui:IconAssist.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>

        </ui:NavigationView>
    </Grid>
</UserControl>
