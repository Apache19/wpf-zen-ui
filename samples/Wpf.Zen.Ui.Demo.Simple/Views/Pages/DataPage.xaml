<Page
    x:Class="Wpf.Zen.Ui.Demo.Simple.Views.Pages.DataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Wpf.Zen.Ui.Demo.Simple.Models"
    xmlns:pages="clr-namespace:Wpf.Zen.Ui.Demo.Simple.Views.Pages"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    Title="DataPage"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    mc:Ignorable="d">
    <ui:NavigationView.BreadcrumbPath>
        <ui:BreadcrumbPath>
            <ui:BreadcrumbPathSegment Key="samples" Content="Samples" />
            <ui:BreadcrumbPathSegment
                Key="data"
                Content="Data"
                PageType="{x:Type pages:DataPage}" />
        </ui:BreadcrumbPath>
    </ui:NavigationView.BreadcrumbPath>
    <Grid Margin="42">
        <ui:VirtualizingItemsControl
            x:Name="ColorsItemsControl"
            Foreground="{ui:DynamicBrush TextFillSecondary}"
            VirtualizingPanel.CacheLengthUnit="Item">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:DataColor}">
                    <ui:Button
                        Width="80"
                        Height="80"
                        Margin="2"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Appearance="Normal"
                        Background="{Binding Color, Mode=OneWay}"
                        FontSize="25"
                        Icon="{ui:FluentIconSource Fluent24}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ui:VirtualizingItemsControl>
    </Grid>
</Page>
