<ui:FluentWindow
    x:Class="Wpf.Zen.Ui.Demo.Simple.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Wpf.Zen.Ui.Demo.Simple.Views.Pages"
    xmlns:ui="http://schemas.thezendev.com/wpf/2027"
    Title="WPF Zen UI - Simple Demo"
    Width="1100"
    Height="650"
    d:Background="{ui:DynamicBrush WindowBackground}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Foreground="{ui:DynamicBrush TextFillPrimary}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <ui:FluentWindow.InputBindings>
        <KeyBinding
            Key="F"
            Command="{Binding ElementName=AutoSuggestBox, Path=FocusCommand}"
            Modifiers="Control" />
    </ui:FluentWindow.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="TitleBar"
            Title="WPF Zen UI - Simple Demo"
            Grid.Row="0"
            ui:IconAssist.Icon="{ui:ImageIcon Source='pack://application:,,,/Assets/applicationIcon-256.png'}" />

        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            TitleBar="{Binding ElementName=TitleBar}">

            <ui:NavigationView.NavigationMap>
                <ui:NavigationMap>
                    <ui:NavigationMapNode
                        Key="dashboard"
                        Content="Dashboard"
                        PageType="{x:Type pages:DashboardPage}" />
                    <ui:NavigationMapNode
                        Key="data"
                        Content="Data"
                        PageType="{x:Type pages:DataPage}" />
                    <ui:NavigationMapNode
                        Key="settings"
                        Content="Settings"
                        PageType="{x:Type pages:SettingsPage}" />
                </ui:NavigationMap>
            </ui:NavigationView.NavigationMap>

            <ui:NavigationView.AutoSuggestBox>
                <ui:AutoSuggestBox
                    x:Name="AutoSuggestBox"
                    ui:IconAssist.Icon="{ui:FluentIconSource Search24}"
                    PlaceholderText="Search" />
            </ui:NavigationView.AutoSuggestBox>

            <ui:NavigationView.Header>
                <ui:BreadcrumbBar
                    x:Name="BreadcrumbBar"
                    Margin="42,32,0,0"
                    FontSize="28"
                    FontWeight="DemiBold"
                    ItemsSource="{Binding ElementName=RootNavigation, Path=Breadcrumbs}" />
            </ui:NavigationView.Header>

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Header="Dashboard"
                    NavigationCacheMode="Evictable"
                    TargetPageType="{x:Type pages:DashboardPage}">
                    <ui:IconAssist.Icon>
                        <ui:FluentIcon Symbol="Home24" />
                    </ui:IconAssist.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem
                    Header="Data"
                    NavigationCacheMode="Evictable"
                    TargetPageType="{x:Type pages:DataPage}">
                    <ui:IconAssist.Icon>
                        <ui:FluentIcon Symbol="DataHistogram24" />
                    </ui:IconAssist.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    Header="Settings"
                    NavigationCacheMode="Disabled"
                    TargetPageType="{x:Type pages:SettingsPage}">
                    <ui:IconAssist.Icon>
                        <ui:FluentIcon Symbol="Settings24" />
                    </ui:IconAssist.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>

        </ui:NavigationView>

    </Grid>
</ui:FluentWindow>
